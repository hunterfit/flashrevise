function getDeckMeta(name){
  if(DECK_META[name]) return DECK_META[name];
  if(name.includes("Maths")||name.includes("Algèbre")||name.includes("Analyse")) return {icon:"📐",color:"#6366f1"};
  if(name.includes("Physique")||name.includes("PC")||name.includes("Chimie")) return {icon:"⚗️",color:"#10b981"};
  return {icon:"📚",color:"#8b5cf6"};
}

function renderHome(){
  const d=getDue(null);
  const total=d.review.length+d.new.length;
  renderExamCountdown();
  $("btn-start-all").disabled=total===0;
  $("btn-start-all").textContent=total===0?"✓ Tout révisé !":"⚡ Commencer la session";
  $("streak-val").textContent=store.streak||0;
  // Quick stats
  let learned=0,mature=0;
  if(store.cards) Object.values(store.cards).forEach(s=>{if(s.reps>0)learned++;if(s.interval>=21)mature++;});
  $("qs-total").textContent=learned;
  $("qs-mature").textContent=mature;
  const doneToday=(store.dailyStats||{})[today()]||0;
  $("qs-today").textContent=doneToday;
  const goal=settings.goalPerDay||50;
  const gc=$("goal-count");
  gc.textContent=Math.min(doneToday,goal)+" / "+goal;
  gc.classList.toggle("done",doneToday>=goal);
  $("goal-fill").style.width=Math.min(100,Math.round(doneToday/goal*100))+"%";
  // Decks
  const decks={};
  CARDS.forEach(c=>{
    if(!decks[c.deck]) decks[c.deck]={name:c.deck,count:0,niveau:c.niveau,matiere:c.matiere};
    decks[c.deck].count++;
  });
  const plevels=(settings.profile&&settings.profile.levels)||[];
  const arr=Object.values(decks);
  let html="";
  if(plevels.length){
    const mine=arr.filter(d=>plevels.includes(d.niveau));
    const others=arr.filter(d=>!plevels.includes(d.niveau));
    if(mine.length) html+='<div class="deck-group-label">Recommandés pour toi</div>'+mine.map(deckRowHTML).join("");
    if(others.length) html+='<div class="deck-group-label" style="margin-top:16px;">Autres decks</div>'+others.map(deckRowHTML).join("");
  } else {
    html=arr.map(deckRowHTML).join("");
  }
  $("home-deck-list").innerHTML=html||"<div style='text-align:center;color:var(--muted);padding:20px;'>Aucun deck</div>";
}
function deckRowHTML(d){
  const due=getDueCount(d.name);
  const m=getDeckMeta(d.name);
  return `<div class="deck-row" onclick="startReviewDeck('${d.name.replace(/'/g,"\\'")}')" >
    <div class="deck-icon" style="background:${m.color}22;color:${m.color};">${m.icon}</div>
    <div class="deck-info">
      <div class="deck-name">${esc(d.name)}</div>
      <div class="deck-sub">${d.niveau} · ${d.matiere} · ${d.count} cartes</div>
      <div class="deck-progress-mini"><div class="deck-progress-mini-fill" style="width:${getDeckPct(d.name)}%"></div></div>
    </div>
    <div class="due-badge ${due>0?'has':'zero'}">${due}</div>
  </div>`;
}

function getDeckPct(name){
  let total=0,learned=0;
  CARDS.forEach((c,i)=>{
    if(c.deck!==name) return;
    total++;
    if(getCardState(i).reps>0) learned++;
  });
  return total===0?0:Math.round(learned/total*100);
}

$("btn-start-all").addEventListener("click",()=>startReview(null));

// ===== BROWSE/DECKS =====
let browseNiveau="all",browseMatiere="all",browseType="all";
const NIVEAUX=["Collège 5e","Collège 4e","Seconde","Première","Terminale","MPSI","MP","Agrégation","Licence L1","Anglais","Espagnol","Allemand","Arabe"];
const MATIERES=["Maths","Physique-Chimie","Langues"];
const TYPES=["definition","formula","method","theorem","text"];
const TYPE_LABELS={"definition":"Définition","formula":"Formule","method":"Méthode","theorem":"Théorème","text":"Texte"};

function renderBrowse(){
  // Chips niveau
  let h1=`<button class="chip ${browseNiveau==="all"?"active":""}" onclick="setNiv('all')">Tous niveaux</button>`;
  NIVEAUX.forEach(n=>h1+=`<button class="chip ${browseNiveau===n?"active":""}" onclick="setNiv(\'${n}\')">${n}</button>`);
  $("browse-niveau-chips").innerHTML=h1;
  // Chips matière
  let h2=`<button class="chip ${browseMatiere==="all"?"active":""}" onclick="setMat('all')">Toutes matières</button>`;
  MATIERES.forEach(m=>h2+=`<button class="chip ${browseMatiere===m?"active":""}" onclick="setMat(\'${m}\')">${m}</button>`);
  $("browse-matiere-chips").innerHTML=h2;
  // Chips type
  let h3=`<button class="chip ${browseType==="all"?"active":""}" onclick="setTyp('all')">Tous types</button>`;
  TYPES.forEach(t=>h3+=`<button class="chip ${browseType===t?"active":""}" onclick="setTyp(\'${t}\')">${TYPE_LABELS[t]||t}</button>`);
  $("browse-type-chips").innerHTML=h3;
  // Filter
  const q=$("search-input").value.toLowerCase().trim();
  const filtered=CARDS.filter(c=>{
    if(browseNiveau!=="all"&&c.niveau!==browseNiveau) return false;
    if(browseMatiere!=="all"&&c.matiere!==browseMatiere) return false;
    if(browseType!=="all"&&c.type!==browseType) return false;
    if(q){const blob=(c.recto+" "+c.verso+" "+c.chapitre+" "+c.tags).toLowerCase();if(!blob.includes(q))return false;}
    return true;
  });
  $("browse-count").textContent=filtered.length+" carte"+( filtered.length>1?"s":"")+" trouvée"+(filtered.length>1?"s":"");
  const subset=filtered.slice(0,150);
  let html="";
  subset.forEach(c=>{
    const tc="type-"+(c.type||"text");
    html+=`<div class="card-browse" onclick="this.classList.toggle('open')">
      <div class="card-tags">
        <span class="tag">${esc(c.niveau)}</span>
        <span class="tag">${esc(c.matiere)}</span>
        <span class="tag ${tc}">${TYPE_LABELS[c.type]||c.type}</span>
        <span class="tag">${esc(c.chapitre.replace(/^Ch\.\d+(\.\d+)? - /,""))}</span>
      </div>
      <div class="card-front">${esc(c.recto)}</div>
      <div class="card-back">${esc(c.verso)}</div>
    </div>`;
  });
  if(filtered.length>150) html+=`<div style="text-align:center;color:var(--muted);padding:14px;font-size:.8rem;">… et ${filtered.length-150} autres (affinez la recherche)</div>`;
  $("browse-list").innerHTML=html||'<div style="text-align:center;color:var(--muted);padding:30px;">Aucune carte.</div>';
}
function setNiv(v){browseNiveau=v;renderBrowse();}
function setMat(v){browseMatiere=v;renderBrowse();}
function setTyp(v){browseType=v;renderBrowse();}

// ===== MODES PAGE =====
let selectedMode="srs", selectedDeck="all";
function selectMode(m){
  selectedMode=m;
  document.querySelectorAll(".mode-card").forEach(c=>c.classList.remove("selected"));
  $("mcard-"+m).classList.add("selected");
}
function renderModes(){
  const decks={}; CARDS.forEach(c=>{if(!decks[c.deck])decks[c.deck]={name:c.deck,count:0,niveau:c.niveau,matiere:c.matiere};decks[c.deck].count++;});
  let h=`<div class="deck-sel-item ${selectedDeck==="all"?"selected":""}" onclick="selDeck('all')">
    <div class="deck-sel-check">${selectedDeck==="all"?"✓":""}</div>
    <div><strong>Tous les decks</strong><br><small style="color:var(--muted)">${CARDS.length} cartes</small></div>
  </div>`;
  Object.values(decks).forEach(d=>{
    const m=getDeckMeta(d.name);
    h+=`<div class="deck-sel-item ${selectedDeck===d.name?"selected":""}" onclick="selDeck(\'${d.name.replace(/'/g,"\\'")}\')" >
      <div class="deck-sel-check">${selectedDeck===d.name?"✓":""}</div>
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:1.2rem;">${m.icon}</span>
        <div><div style="font-weight:600;font-size:.85rem;">${esc(d.name)}</div>
        <div style="font-size:.7rem;color:var(--muted);">${d.niveau} · ${d.count} cartes</div></div>
      </div>
    </div>`;
  });
  $("mode-deck-selector").innerHTML=h;
}
function selDeck(name){selectedDeck=name;renderModes();}
function launchSelectedMode(){
  const dn=selectedDeck==="all"?null:selectedDeck;
  if(selectedMode==="srs") startReview(dn);
  else if(selectedMode==="qcm") startQCMMode(dn);
  else if(selectedMode==="vf") startVFMode(dn);
  else if(selectedMode==="chrono") startChronoMode(dn);
  else if(selectedMode==="hard") startHardMode(dn);
}
function getLeechIndices(deckName){
  const out=[];
  CARDS.forEach((c,i)=>{
    if(deckName && c.deck!==deckName) return;
    const s=store.cards&&store.cards[i];
    if(!s) return;
    if((s.lapses||0)>=3 || (s.reps>0 && s.ease<=1.7)) out.push(i);
  });
  return out;
}
function startHardMode(deckName){
  const q=getLeechIndices(deckName);
  if(q.length===0){showToast("Aucune carte difficile 🎉");return;}
  revQueue=shuffle(q);revIdx=0;revFlipped=false;revStart=Date.now();revCorrect=0;revAgain=0;
  $("ov-rev-title").textContent="🔥 Cartes difficiles";
  $("ov-review").classList.add("active");
  $("rev-session-end").style.display="none";
  $("flip-scene").style.display="block";
  $("flip-btn").style.display="block";
  $("rate-btns").style.display="none";
  $("flip-hint").style.display="block";
  showRevCard();
}

// ===== REVIEW SRS =====
let revQueue=[], revIdx=0, revFlipped=false, revStart=0, revCorrect=0, revAgain=0;

function startReview(deckName){
  const d=getDue(deckName);
  const q=[...d.review,...d.new];
  if(q.length===0){showToast("✓ Plus rien à réviser !");return;}
  revQueue=shuffle(q);revIdx=0;revFlipped=false;revStart=Date.now();revCorrect=0;revAgain=0;
  $("ov-rev-title").textContent=deckName?deckName.slice(0,25)+"…":"Toute la bibliothèque";
  $("ov-review").classList.add("active");
  $("rev-session-end").style.display="none";
  $("flip-scene").style.display="block";
  $("flip-btn").style.display="block";
  $("rate-btns").style.display="none";
  $("flip-hint").style.display="block";
  showRevCard();
}
function startReviewDeck(name){startReview(name);}
function closeReview(){$("ov-review").classList.remove("active");}

function showRevCard(){
  if(revIdx>=revQueue.length){finishReview();return;}
  const c=CARDS[revQueue[revIdx]];
  const s=getCardState(revQueue[revIdx]);
  $("ov-rev-prog").textContent=(revIdx+1)+" / "+revQueue.length;
  $("rev-prog-fill").style.width=(revIdx/revQueue.length*100)+"%";
  const tp=$("flip-type");
  if(["definition","formula","method","theorem"].includes(c.type)){
    tp.style.display="inline-flex";tp.className="type-pill type-"+c.type;tp.textContent=TYPE_LABELS[c.type];
  } else tp.style.display="none";
  $("flip-recto").textContent=c.recto;
  $("flip-verso").textContent=c.verso;
  $("flip-card").classList.remove("flipped");
  $("flip-btn").style.display="block";
  $("flip-hint").style.display="block";
  $("rate-btns").style.display="none";
  revFlipped=false;
}
function flipCard(){
  if(revFlipped) return;
  $("flip-card").classList.add("flipped");
  $("flip-btn").style.display="none";
  $("flip-hint").style.display="none";
  $("rate-btns").style.display="grid";
  revFlipped=true;
  // Show intervals
  const s=getCardState(revQueue[revIdx]);
  $("int-again").textContent=intervalStr(s,1);
  $("int-hard").textContent=intervalStr(s,2);
  $("int-good").textContent=intervalStr(s,3);
  $("int-easy").textContent=intervalStr(s,4);
}
function rateCard(rating){
  const idx=revQueue[revIdx];
  const s=getCardState(idx);
  rateState(s,rating);
  if(rating===1){revQueue.push(idx);revAgain++;}
  else revCorrect++;
  revIdx++;
  updateStreak(false);
  save();
  showRevCard();
}
function finishReview(){
  maybeShowInterstitial();
  const elapsed=Math.round((Date.now()-revStart)/1000);
  $("flip-scene").style.display="none";
  $("flip-btn").style.display="none";
  $("rate-btns").style.display="none";
  $("flip-hint").style.display="none";
  updateStreak(true);
  $("rev-session-end").style.display="flex";
  $("rev-session-end").innerHTML=`
    <div class="session-emoji">🎉</div>
    <div class="session-title">Session terminée !</div>
    <div class="session-sub">Beau travail !</div>
    <div class="session-results">
      <div class="res-card"><div class="res-val" style="color:var(--green)">${revCorrect}</div><div class="res-lab">Correctes</div></div>
      <div class="res-card"><div class="res-val" style="color:var(--red)">${revAgain}</div><div class="res-lab">Encore</div></div>
      <div class="res-card"><div class="res-val">${elapsed<60?elapsed+"s":Math.round(elapsed/60)+"min"}</div><div class="res-lab">Temps</div></div>
    </div>
    <button class="btn-primary" onclick="closeReview()">Retour à l'accueil</button>
  `;
}

// ===== QCM =====
let qcmQueue=[], qcmIdx=0, qcmScore=0, qcmStart=0, qcmDeckName=null;

function startQCMMode(dn){
  qcmDeckName=dn||null;
  let pool=dn?CARDS.filter(c=>c.deck===dn):CARDS;
  if(pool.length<4){showToast("Il faut au moins 4 cartes pour le QCM");return;}
  qcmQueue=shuffle(pool).slice(0,20);
  qcmIdx=0;qcmScore=0;qcmStart=Date.now();
  $("ov-qcm-title").textContent=dn?dn.slice(0,25)+"…":"QCM — Toutes matières";
  $("ov-qcm").classList.add("active");
  $("qcm-session-end").style.display="none";
  showQCMQuestion();
}
function closeQCM(){$("ov-qcm").classList.remove("active");}

function showQCMQuestion(){
  if(qcmIdx>=qcmQueue.length){finishQCM();return;}
  const c=qcmQueue[qcmIdx];
  $("ov-qcm-prog").textContent=(qcmIdx+1)+" / "+qcmQueue.length;
  $("qcm-prog-fill").style.width=(qcmIdx/qcmQueue.length*100)+"%";
  $("qcm-meta").textContent=c.niveau+" · "+c.matiere+" · "+c.chapitre.replace(/^Ch\.\d+(\.\d+)? - /,"");
  $("qcm-question").textContent=c.recto;
  $("qcm-next").style.display="none";
  // Generate 4 choices: 1 correct + 3 distractors from same deck/matière
  const pool=(qcmDeckName?CARDS.filter(x=>x.deck===qcmDeckName):CARDS.filter(x=>x.matiere===c.matiere)).filter(x=>x!==c);
  const distractors=shuffle(pool).slice(0,3).map(x=>x.verso.split("\n")[0].slice(0,120));
  const correctAnswer=c.verso.split("\n")[0].slice(0,120);
  const choices=shuffle([correctAnswer,...distractors]);
  const labels=["A","B","C","D"];
  let html="";
  choices.forEach((ch,i)=>{
    const isCorrect=ch===correctAnswer;
    html+=`<button class="qcm-choice" onclick="answerQCM(this,${isCorrect})">
      <span class="qcm-badge">${labels[i]}</span>
      <span style="-webkit-user-select:text;user-select:text;">${esc(ch)}</span>
    </button>`;
  });
  $("qcm-choices").innerHTML=html;
}
function answerQCM(btn, isCorrect){
  // Reveal all
  document.querySelectorAll(".qcm-choice").forEach(b=>{
    b.classList.add("revealed");
    b.onclick=null;
  });
  if(isCorrect){btn.classList.add("correct");qcmScore++;}
  else{btn.classList.add("wrong");}
  // Highlight correct
  document.querySelectorAll(".qcm-choice").forEach(b=>{
    if(b!==btn && b.querySelector("span:last-child").textContent===qcmQueue[qcmIdx].verso.split("\n")[0].slice(0,120)){
      b.classList.add("correct");
    }
  });
  $("qcm-next").style.display="block";
}
function qcmNext(){qcmIdx++;showQCMQuestion();}
function finishQCM(){
  maybeShowInterstitial();
  const elapsed=Math.round((Date.now()-qcmStart)/1000);
  const pct=Math.round(qcmScore/qcmQueue.length*100);
  $("qcm-choices").innerHTML="";
  $("qcm-next").style.display="none";
  $("qcm-session-end").style.display="flex";
  $("qcm-session-end").innerHTML=`
    <div class="session-emoji">${pct>=80?"🏆":pct>=60?"😊":"💪"}</div>
    <div class="session-title">${pct>=80?"Excellent !":pct>=60?"Bien joué !":"Continue !"}</div>
    <div class="session-sub">${pct}% de réussite</div>
    <div class="session-results">
      <div class="res-card"><div class="res-val" style="color:var(--green)">${qcmScore}</div><div class="res-lab">Correctes</div></div>
      <div class="res-card"><div class="res-val" style="color:var(--red)">${qcmQueue.length-qcmScore}</div><div class="res-lab">Erreurs</div></div>
      <div class="res-card"><div class="res-val">${elapsed<60?elapsed+"s":Math.round(elapsed/60)+"min"}</div><div class="res-lab">Temps</div></div>
    </div>
    <button class="btn-primary" onclick="closeQCM()">Retour</button>
    <button class="btn-outline" style="margin-top:8px;" onclick="startQCMMode(qcmDeckName)">Rejouer</button>
  `;
}

// ===== VRAI/FAUX =====
let vfQueue=[], vfIdx=0, vfScore=0, vfStart=0, vfDeckName=null;

function startVFMode(dn){
  vfDeckName=dn||null;
  let pool=dn?CARDS.filter(c=>c.deck===dn):CARDS;
  if(pool.length<2){showToast("Il faut au moins 2 cartes");return;}
  vfQueue=shuffle(pool).slice(0,20);
  vfIdx=0;vfScore=0;vfStart=Date.now();
  $("ov-vf").classList.add("active");
  $("vf-session-end").style.display="none";
  showVFQuestion();
}
function closeVF(){$("ov-vf").classList.remove("active");}

let vfIsTrue=true;
function showVFQuestion(){
  if(vfIdx>=vfQueue.length){finishVF();return;}
  const c=vfQueue[vfIdx];
  $("ov-vf-prog").textContent=(vfIdx+1)+" / "+vfQueue.length;
  $("vf-prog-fill").style.width=(vfIdx/vfQueue.length*100)+"%";
  $("vf-meta").textContent=c.niveau+" · "+c.matiere;
  // 50% chance: show correct statement, 50% show wrong (swap recto/verso of another card)
  vfIsTrue=Math.random()>0.4;
  let statement;
  if(vfIsTrue){
    statement=c.recto+"\n\n→ "+c.verso.split("\n")[0].slice(0,100);
  } else {
    const other=shuffle(CARDS.filter(x=>x.matiere===c.matiere&&x!==c))[0];
    statement=c.recto+"\n\n→ "+(other?other.verso.split("\n")[0].slice(0,100):"Réponse incorrecte");
  }
  $("vf-statement").textContent=statement;
  $("vf-feedback").style.display="none";
  $("vf-next").style.display="none";
  document.querySelectorAll(".vf-btn").forEach(b=>{b.disabled=false;b.style.opacity="1";});
}
function answerVF(answer){
  const correct=(answer===vfIsTrue);
  if(correct) vfScore++;
  document.querySelectorAll(".vf-btn").forEach(b=>{b.disabled=true;b.style.opacity=".4";});
  const fb=$("vf-feedback");
  fb.style.display="block";
  fb.style.background=correct?"rgba(16,185,129,0.15)":"rgba(239,68,68,0.1)";
  fb.style.border="1px solid "+(correct?"var(--green)":"var(--red)");
  fb.style.color=correct?"var(--green)":"var(--red)";
  const c=vfQueue[vfIdx];
  fb.innerHTML=`<strong style="font-size:1rem;">${correct?"✓ Correct !":"✗ Incorrect"}</strong><br><span style="display:block;margin-top:6px;font-size:0.95rem;font-weight:600;line-height:1.5;color:var(--text);">Réponse : ${esc(c.verso.split("\n")[0])}</span>`;
  $("vf-next").style.display="block";
}
function vfNext(){vfIdx++;showVFQuestion();}
function finishVF(){
  maybeShowInterstitial();
  const elapsed=Math.round((Date.now()-vfStart)/1000);
  const pct=Math.round(vfScore/vfQueue.length*100);
  $("vf-session-end").style.display="flex";
  $("vf-session-end").innerHTML=`
    <div class="session-emoji">${pct>=80?"🎯":pct>=60?"😊":"💪"}</div>
    <div class="session-title">Score : ${pct}%</div>
    <div class="session-sub">${vfScore}/${vfQueue.length} bonnes réponses</div>
    <div class="session-results">
      <div class="res-card"><div class="res-val" style="color:var(--green)">${vfScore}</div><div class="res-lab">Correctes</div></div>
      <div class="res-card"><div class="res-val" style="color:var(--red)">${vfQueue.length-vfScore}</div><div class="res-lab">Erreurs</div></div>
      <div class="res-card"><div class="res-val">${elapsed<60?elapsed+"s":Math.round(elapsed/60)+"min"}</div><div class="res-lab">Temps</div></div>
    </div>
    <button class="btn-primary" onclick="closeVF()">Retour</button>
  `;
}

// ===== CHRONO MODE =====
let chronoTimer=null;
function startChronoMode(dn){
  const pool=dn?CARDS.filter(c=>c.deck===dn):CARDS;
  if(pool.length<4){showToast("Pas assez de cartes");return;}
  qcmQueue=shuffle(pool);
  qcmIdx=0;qcmScore=0;qcmDeckName=dn||null;
  $("ov-qcm-title").textContent="⏱️ Chrono 60s";
  $("ov-qcm").classList.add("active");
  $("qcm-session-end").style.display="none";
  let t=60;
  $("ov-qcm-prog").textContent=t+"s";
  $("qcm-prog-fill").style.width="100%";
  showQCMQuestion();
  if(chronoTimer) clearInterval(chronoTimer);
  chronoTimer=setInterval(()=>{
    t--;
    $("ov-qcm-prog").textContent=t+"s";
    $("qcm-prog-fill").style.width=(t/60*100)+"%";
    if(t<=0){clearInterval(chronoTimer);finishQCM();}
  },1000);
}

// ===== STATS =====
const BADGES=[
  {code:"first_review",icon:"🌱",name:"Première carte",desc:"Révise ta première carte",check:(s,h)=>Object.keys(h||{}).length>=1},
  {code:"streak3",icon:"🔥",name:"3 jours",desc:"3j de streak",check:(s)=>s>=3},
  {code:"streak7",icon:"🔥🔥",name:"7 jours",desc:"7j de streak",check:(s)=>s>=7},
  {code:"streak30",icon:"⚡",name:"30 jours",desc:"30j de streak",check:(s)=>s>=30},
  {code:"cards50",icon:"📗",name:"50 cartes",desc:"50 cartes apprises",check:(_,__,tot)=>tot>=50},
  {code:"cards200",icon:"📘",name:"200 cartes",desc:"200 cartes apprises",check:(_,__,tot)=>tot>=200},
  {code:"cards500",icon:"📕",name:"500 cartes",desc:"500 cartes apprises",check:(_,__,tot)=>tot>=500},
  {code:"cards1000",icon:"🏆",name:"1000 cartes",desc:"1000 cartes apprises",check:(_,__,tot)=>tot>=1000},
  {code:"mature10",icon:"🌟",name:"10 maîtrisées",desc:"10 cartes maîtrisées",check:(_,__,___,mat)=>mat>=10},
  {code:"mature100",icon:"💎",name:"100 maîtrisées",desc:"100 cartes maîtrisées",check:(_,__,___,mat)=>mat>=100},
  {code:"all_terminale",icon:"🎓",name:"Terminale complète",desc:"Tout le programme Terminale",check:(_,__,tot)=>tot>=498},
  {code:"all_mpsi",icon:"🎓",name:"MPSI complète",desc:"Tout le programme MPSI",check:(_,__,tot)=>tot>=455},
];

function checkBadges(){
  if(!store.badges) store.badges={};
  const s=store.streak||0;
  const h=store.dailyStats||{};
  let learned=0,mature=0;
  if(store.cards) Object.values(store.cards).forEach(c=>{if(c.reps>0)learned++;if(c.interval>=21)mature++;});
  BADGES.forEach(b=>{
    if(!store.badges[b.code]&&b.check(s,h,learned,mature)){
      store.badges[b.code]=Date.now();
      showToast("🏆 Badge débloqué : "+b.name);
      save();
    }
  });
}

function renderStats(){
  checkBadges();
  let learned=0,mature=0;
  if(store.cards) Object.values(store.cards).forEach(s=>{if(s.reps>0)learned++;if(s.interval>=21)mature++;});
  $("st-streak").textContent=store.streak||0;
  $("st-total").textContent=learned;
  $("st-mature").textContent=mature;
  $("st-sessions").textContent=store.totalSessions||0;
  // Heatmap: 15 weeks = 105 days, 7 rows, 15 cols
  const days=105;
  const now=new Date();now.setHours(0,0,0,0);
  let grid=$("heatmap-grid");
  let html="";
  for(let col=14;col>=0;col--){
    html+='<div class="heatmap-col">';
    for(let row=6;row>=0;row--){
      const dayOffset=col*7+row;
      const d=new Date(now);d.setDate(d.getDate()-dayOffset);
      const k=dayKey(d.getTime());
      const c=(store.dailyStats||{})[k]||0;
      let cls=c===0?"":c<=10?"l1":c<=30?"l2":c<=60?"l3":"l4";
      html+=`<div class="heatmap-cell ${cls}" title="${k}: ${c} cartes"></div>`;
    }
    html+="</div>";
  }
  grid.innerHTML=html;
  // Deck progress
  const decks={};
  CARDS.forEach((c,i)=>{
    if(!decks[c.deck]) decks[c.deck]={name:c.deck,total:0,learned:0,mature:0};
    decks[c.deck].total++;
    const s=getCardState(i);
    if(s.reps>0) decks[c.deck].learned++;
    if(s.interval>=21) decks[c.deck].mature++;
  });
  let ph="";
  Object.values(decks).forEach(d=>{
    const pct=Math.round(d.learned/d.total*100);
    const m=getDeckMeta(d.name);
    ph+=`<div class="progress-row">
      <div class="pr-header">
        <div class="pr-name">${m.icon} ${esc(d.name)}</div>
        <div class="pr-nums">${d.learned}/${d.total} · ${d.mature} maîtrisées</div>
      </div>
      <div class="pr-bar"><div class="pr-fill" style="width:${pct}%"></div></div>
    </div>`;
  });
  $("deck-progress-list").innerHTML=ph;
  // Points faibles par chapitre
  const chaps={};
  CARDS.forEach((c,i)=>{
    const key=c.deck+"||"+c.chapitre;
    if(!chaps[key]) chaps[key]={deck:c.deck,chap:c.chapitre,total:0,learned:0,mature:0};
    chaps[key].total++;
    const s=getCardState(i);
    if(s.reps>0) chaps[key].learned++;
    if(s.interval>=21) chaps[key].mature++;
  });
  const studied=Object.values(chaps).filter(x=>x.learned>0);
  studied.forEach(x=>x.pct=Math.round(x.mature/x.total*100));
  studied.sort((a,b)=>(a.pct-b.pct)||(b.total-a.total));
  let ch="";
  studied.slice(0,15).forEach(x=>{
    const m=getDeckMeta(x.deck);
    const name=x.chap.replace(/^Ch\.\d+(\.\d+)? - /,"");
    ch+=`<div class="progress-row">
      <div class="pr-header">
        <div class="pr-name">${m.icon} ${esc(name)}</div>
        <div class="pr-nums">${x.mature}/${x.total} maîtrisées</div>
      </div>
      <div class="pr-bar"><div class="pr-fill" style="width:${x.pct}%"></div></div>
    </div>`;
  });
  $("chapter-weak-list").innerHTML=ch||'<div style="text-align:center;color:var(--muted);padding:16px;font-size:.85rem;">Révise quelques cartes pour voir tes points faibles apparaître ici.</div>';
  // Badges
  let bh="";
  BADGES.forEach(b=>{
    const unlocked=store.badges&&store.badges[b.code];
    bh+=`<div class="badge-card ${unlocked?"unlocked":"locked"}" title="${b.desc}">
      <div class="badge-icon">${b.icon}</div>
      <div class="badge-name">${b.name}</div>
    </div>`;
  });
  $("badges-grid").innerHTML=bh;
}

// ===== PROFIL =====
function renderProfil(){
  $("set-new").value=settings.newPerDay;
  $("set-rev").value=settings.maxReviews;
  $("set-goal").value=settings.goalPerDay;
  $("set-remind").value=settings.reminderTime||"";
  $("total-cards-count").textContent=CARDS.length;
  const decks=new Set(CARDS.map(c=>c.deck));
  $("total-decks-count").textContent=decks.size;
  let learned=0;
  if(store.cards) Object.values(store.cards).forEach(s=>{if(s.reps>0)learned++;});
  $("profil-stats-line").textContent=learned+" cartes apprises · "+( store.streak||0)+"j de streak";
  const p=settings.profile||{};
  $("pf-niveau").textContent=p.niveauLabel||"Non défini";
  $("pf-exam").textContent=p.examDate?((p.examLabel||"Concours")+" · "+fmtDate(p.examDate)):"Non défini";
}
["set-new","set-rev","set-goal"].forEach(id=>{
  $(id).addEventListener("change",()=>{
    settings.newPerDay=parseInt($("set-new").value)||20;
    settings.maxReviews=parseInt($("set-rev").value)||150;
    settings.goalPerDay=parseInt($("set-goal").value)||50;
    saveSettings();showToast("✓ Sauvegardé");
  });
});
$("set-remind").addEventListener("change",()=>{
  settings.reminderTime=$("set-remind").value||"";
  saveSettings();
  scheduleReminder();
  showToast(settings.reminderTime?("⏰ Rappel à "+settings.reminderTime):"Rappel désactivé");
});
async function scheduleReminder(){
  try{
    const LN=window.Capacitor&&window.Capacitor.Plugins&&window.Capacitor.Plugins.LocalNotifications;
    if(!LN) return;
    if(LN.cancel) await LN.cancel({notifications:[{id:4242}]});
    const t=settings.reminderTime;
    if(!t) return;
    const [h,m]=t.split(":").map(Number);
    if(LN.requestPermissions) await LN.requestPermissions();
    await LN.schedule({notifications:[{
      id:4242,title:"FlashRevise",
      body:"C'est l'heure de réviser 💪 Garde ta série !",
      schedule:{on:{hour:h,minute:m},repeats:true}
    }]});
  }catch(e){}
}

function exportStats(){
  let learned=0,mature=0;
  if(store.cards) Object.values(store.cards).forEach(s=>{if(s.reps>0)learned++;if(s.interval>=21)mature++;});
  const lines=["date,streak,cartes_apprises,matures"];
  Object.entries(store.dailyStats||{}).sort().forEach(([k,v])=>lines.push(k+","+(store.streak||0)+","+learned+","+mature));
  const blob=new Blob([lines.join("\n")],{type:"text/csv"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");a.href=url;a.download="flashrevise_stats.csv";a.click();
  showToast("Export téléchargé !");
}

function resetProgress(){
  if(!confirm("Effacer toute votre progression ?")) return;
  localStorage.removeItem(STORE_KEY);
  store={};
  showToast("Progression réinitialisée");
  renderHome();
}

// ===== TOAST =====
function showToast(msg){
  const t=$("toast");t.textContent=msg;t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"),2200);
}

// ===== ONBOARDING / PROFIL SCOLAIRE =====
const NIVEAU_OPTIONS=[
  {key:"college",label:"Collège",icon:"🏫",levels:["Collège 5e","Collège 4e"]},
  {key:"seconde",label:"Seconde",icon:"📗",levels:["Seconde"]},
  {key:"premiere",label:"Première",icon:"📘",levels:["Première"]},
  {key:"terminale",label:"Terminale",icon:"📐",levels:["Terminale"]},
  {key:"mpsi",label:"Prépa MPSI",icon:"🧠",levels:["MPSI"]},
  {key:"mp",label:"Prépa MP",icon:"🚀",levels:["MP"]},
  {key:"licence",label:"Licence",icon:"📚",levels:["Licence L1"]},
  {key:"agreg",label:"Agrégation",icon:"🏆",levels:["Agrégation"]},
];
const SUBJECTS=[
  {k:"Maths",label:"Mathématiques",icon:"📐"},
  {k:"Physique-Chimie",label:"Physique-Chimie",icon:"⚗️"},
  {k:"Langues",label:"Langues",icon:"🗣️"},
];
const LEVELS=["Débutant","Moyen","Avancé"];
let onbStep=0;
const onbSel={niveau:null,subjects:{}};

function fmtDate(iso){
  if(!iso) return "";
  const d=new Date(iso+"T00:00:00");
  if(isNaN(d)) return iso;
  return d.toLocaleDateString("fr-FR",{day:"numeric",month:"short",year:"numeric"});
}
function ensureProfile(){
  settings.profile=settings.profile||{niveau:null,niveauLabel:"",levels:[],subjects:{},examDate:"",examLabel:""};
  return settings.profile;
}
function startOnboarding(){
  const p=ensureProfile();
  onbSel.niveau=p.niveau||null;
  onbSel.subjects=Object.assign({},p.subjects||{});
  renderOnbNiveau();renderOnbSubjects();
  $("onb-date").value=p.examDate||"";
  $("onb-date-label").value=p.examLabel||"";
  onbGoStep(0);
  $("ov-onboard").classList.add("active");
}
function onbGoStep(s){
  onbStep=s;
  document.querySelectorAll(".onb-step").forEach((el,i)=>el.classList.toggle("active",i===s));
  document.querySelectorAll(".onb-dot").forEach((el,i)=>el.classList.toggle("active",i<=s));
  $("onb-next").textContent=(s===2)?"Terminer ✓":"Continuer";
}
function renderOnbNiveau(){
  $("onb-niveau-grid").innerHTML=NIVEAU_OPTIONS.map(o=>
    `<div class="onb-opt ${onbSel.niveau===o.key?'selected':''}" onclick="onbPickNiveau('${o.key}')"><span class="oi">${o.icon}</span>${o.label}</div>`).join("");
}
function onbPickNiveau(k){onbSel.niveau=k;renderOnbNiveau();}
function renderOnbSubjects(){
  $("onb-subj-list").innerHTML=SUBJECTS.map(s=>{
    const cur=onbSel.subjects[s.k]||"";
    const lvls=LEVELS.map(l=>`<div class="onb-lvl ${cur===l?'selected':''}" onclick="onbPickLevel('${s.k}','${l}')">${l}</div>`).join("");
    return `<div class="onb-subj"><div class="onb-subj-head">${s.icon} ${s.label}</div><div class="onb-levels">${lvls}</div></div>`;
  }).join("");
}
function onbPickLevel(subj,l){
  if(onbSel.subjects[subj]===l) delete onbSel.subjects[subj];
  else onbSel.subjects[subj]=l;
  renderOnbSubjects();
}
function onbNext(){
  if(onbStep===0){
    if(!onbSel.niveau){showToast("Choisis ta situation 🙂");return;}
    onbGoStep(1);
  } else if(onbStep===1){
    onbGoStep(2);
  } else {
    onbFinish();
  }
}
function onbFinish(){
  const p=ensureProfile();
  const opt=NIVEAU_OPTIONS.find(o=>o.key===onbSel.niveau);
  p.niveau=onbSel.niveau;
  p.niveauLabel=opt?opt.label:"";
  p.levels=opt?opt.levels:[];
  p.subjects=Object.assign({},onbSel.subjects);
  p.examDate=$("onb-date").value||"";
  p.examLabel=($("onb-date-label").value||"").trim();
  settings.onboarded=true;
  saveSettings();
  $("ov-onboard").classList.remove("active");
  showToast("✓ Profil configuré");
  renderHome();
}
function renderExamCountdown(){
  const p=settings.profile||{};
  const greet=$("hero-greet"),el=$("hero-countdown"),sub=$("hero-sub");
  el.classList.add("small");
  el.onclick=null;sub.onclick=null;
  if(p.examDate){
    const diff=Math.ceil((new Date(p.examDate+"T00:00:00").getTime()-todayStart())/86400000);
    greet.textContent=p.examLabel||"Objectif concours";
    if(diff>0){el.textContent="J-"+diff;sub.textContent="avant "+(p.examLabel||"les concours");}
    else if(diff===0){el.textContent="Jour J";sub.textContent="Bonne chance ! 🍀";}
    else{el.textContent="✓";sub.textContent="Concours passés — continue à consolider";}
    el.style.cursor="pointer";el.onclick=startOnboarding;sub.onclick=startOnboarding;
  } else {
    greet.textContent="Bonjour 👋";
    el.textContent="🎯";
    sub.innerHTML='<span class="hero-set-link">Définir la date des concours</span>';
    el.style.cursor="pointer";el.onclick=startOnboarding;sub.onclick=startOnboarding;
  }
}

// ===== ADMOB (publicité in-app, conforme au règlement Google) =====
const ADMOB_CONFIG={
  enabled:false,     // ← INTERRUPTEUR GÉNÉRAL : aucune pub tant que c'est false. Passe à true quand tu auras des utilisateurs.
  // IDs de TEST Google — remplace par tes vrais IDs (https://apps.admob.com) puis passe useTest à false
  interstitialAndroid:'ca-app-pub-3940256099942544/1033173712',
  interstitialIos:'ca-app-pub-3940256099942544/4411468910',
  useTest:true,
  everyNsessions:2   // afficher une pub 1 session sur 2
};
let admobReady=false, admobSessions=0;
function getAdMob(){return window.Capacitor&&window.Capacitor.Plugins&&window.Capacitor.Plugins.AdMob;}
async function initAdMob(){
  try{
    if(!ADMOB_CONFIG.enabled) return; // pub désactivée globalement
    const AdMob=getAdMob();
    if(!AdMob) return;               // navigateur / pas de natif → aucune pub
    await AdMob.initialize({});
    admobReady=true;
  }catch(e){}
}
async function maybeShowInterstitial(){
  try{
    if(!ADMOB_CONFIG.enabled) return;
    const AdMob=getAdMob();
    if(!AdMob||!admobReady) return;
    admobSessions++;
    if(admobSessions % ADMOB_CONFIG.everyNsessions !== 0) return;
    const platform=(window.Capacitor.getPlatform&&window.Capacitor.getPlatform())||'android';
    const adId=platform==='ios'?ADMOB_CONFIG.interstitialIos:ADMOB_CONFIG.interstitialAndroid;
    await AdMob.prepareInterstitial({adId,isTesting:ADMOB_CONFIG.useTest});
    await AdMob.showInterstitial();
  }catch(e){}
}
initAdMob();

// ===== INIT =====
$("streak-val").textContent=store.streak||0;
checkBadges();
renderHome();
if(!settings.onboarded){ startOnboarding(); }
if(settings.reminderTime){ scheduleReminder(); }

// ===== SERVICE WORKER =====
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('sw.js').catch(()=>{});
  });
}

</script>
</body>
</html>