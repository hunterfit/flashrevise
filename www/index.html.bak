<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#6366f1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="FlashRevise">
<title>FlashRevise</title>
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" href="favicon.png" type="image/png">
<style>
:root{
  --bg:#0f172a;--bg2:#1e293b;--bg3:#334155;--bg4:#475569;
  --text:#e2e8f0;--muted:#94a3b8;--accent:#6366f1;--accent2:#8b5cf6;
  --green:#10b981;--yellow:#f59e0b;--red:#ef4444;--blue:#3b82f6;
  --border:#334155;
  --safe-top:env(safe-area-inset-top,0px);
  --safe-bot:env(safe-area-inset-bottom,0px);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{overflow-x:hidden;}
body{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,sans-serif;
  background:var(--bg);color:var(--text);line-height:1.5;min-height:100vh;
  padding-top:calc(var(--safe-top) + 56px);
  padding-bottom:calc(var(--safe-bot) + 72px);
  -webkit-user-select:none;user-select:none;
}

/* ===== HEADER ===== */
header{
  position:fixed;top:0;left:0;right:0;
  padding:calc(var(--safe-top) + 8px) 16px 8px;
  background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;z-index:200;
  backdrop-filter:blur(12px);
}
.logo{
  width:32px;height:32px;border-radius:9px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:0.75rem;font-weight:900;color:#fff;letter-spacing:-0.5px;
}
.app-name{font-size:1rem;font-weight:700;}
.header-right{margin-left:auto;display:flex;align-items:center;gap:12px;}
.streak-badge{
  display:flex;align-items:center;gap:4px;
  background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.3);
  padding:4px 10px;border-radius:20px;
  font-size:0.8rem;font-weight:700;color:#fbbf24;
}
.notif-dot{
  width:8px;height:8px;border-radius:50%;background:var(--red);
  position:absolute;top:-2px;right:-2px;
}

/* ===== TABBAR ===== */
.tabbar{
  position:fixed;bottom:0;left:0;right:0;
  background:var(--bg2);border-top:1px solid var(--border);
  display:flex;padding:6px 0 calc(6px + var(--safe-bot));z-index:200;
}
.tab{
  flex:1;background:none;border:none;color:var(--muted);
  padding:6px 4px;font-size:0.62rem;font-weight:600;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:3px;
  transition:color .2s;
}
.tab.active{color:var(--accent);}
.tab .ti{font-size:1.35rem;transition:transform .15s;}
.tab.active .ti{transform:scale(1.1);}

/* ===== PAGES ===== */
.page{display:none;animation:fadeIn .2s ease;}
.page.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
main{padding:16px;max-width:720px;margin:0 auto;}

/* ===== COMMON ===== */
.section-title{font-size:0.8rem;font-weight:700;color:var(--muted);letter-spacing:.6px;text-transform:uppercase;margin:20px 0 10px;}
.card-surface{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:16px;}
.btn-primary{
  display:block;width:100%;border:none;cursor:pointer;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:#fff;padding:15px;border-radius:12px;font-size:1rem;font-weight:700;
  transition:opacity .15s,transform .1s;
}
.btn-primary:active{transform:scale(.97);opacity:.9;}
.btn-primary:disabled{opacity:.4;cursor:default;}
.btn-outline{
  display:block;width:100%;border:1px solid var(--border);cursor:pointer;
  background:var(--bg2);color:var(--text);padding:13px;border-radius:12px;
  font-size:0.95rem;font-weight:600;
}
.chip{
  display:inline-flex;align-items:center;gap:4px;
  padding:5px 12px;border-radius:20px;font-size:0.75rem;font-weight:600;
  border:1px solid var(--border);background:var(--bg2);color:var(--muted);
  cursor:pointer;white-space:nowrap;transition:all .15s;
}
.chip.active{background:var(--accent);border-color:var(--accent);color:#fff;}
.chips-row{display:flex;gap:7px;overflow-x:auto;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
.chips-row::-webkit-scrollbar{display:none;}

/* ===== HOME PAGE ===== */
.hero-card{
  background:linear-gradient(135deg,var(--accent) 0%,var(--accent2) 100%);
  border-radius:18px;padding:24px;margin-bottom:12px;position:relative;overflow:hidden;
}
.hero-card::before{
  content:'';position:absolute;top:-30px;right:-30px;
  width:120px;height:120px;border-radius:50%;
  background:rgba(255,255,255,0.08);
}
.hero-card::after{
  content:'';position:absolute;bottom:-20px;right:40px;
  width:80px;height:80px;border-radius:50%;
  background:rgba(255,255,255,0.05);
}
.hero-label{font-size:0.8rem;font-weight:600;opacity:.85;margin-bottom:6px;}
.hero-count{font-size:3.5rem;font-weight:900;line-height:1;margin-bottom:4px;}
.hero-sub{font-size:0.85rem;opacity:.8;margin-bottom:20px;}

.quick-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px;}
.qs-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:12px;text-align:center;}
.qs-val{font-size:1.4rem;font-weight:800;color:var(--accent);}
.qs-lab{font-size:0.68rem;color:var(--muted);margin-top:2px;}

.deck-row{
  background:var(--bg2);border:1px solid var(--border);border-radius:14px;
  padding:14px 16px;display:flex;align-items:center;gap:12px;cursor:pointer;
  transition:border-color .15s,transform .1s;
}
.deck-row:active{transform:scale(.98);}
.deck-row:hover{border-color:var(--accent);}
.deck-icon{
  width:42px;height:42px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;font-size:1.3rem;
  flex-shrink:0;
}
.deck-info{flex:1;min-width:0;}
.deck-name{font-weight:700;font-size:0.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.deck-sub{font-size:0.72rem;color:var(--muted);margin-top:2px;}
.deck-progress-mini{height:3px;background:var(--bg3);border-radius:3px;margin-top:6px;overflow:hidden;}
.deck-progress-mini-fill{height:100%;background:var(--accent);border-radius:3px;transition:width .5s;}
.due-badge{
  flex-shrink:0;min-width:30px;text-align:center;
  padding:4px 8px;border-radius:10px;font-size:0.75rem;font-weight:800;
}
.due-badge.has{background:var(--accent);color:#fff;}
.due-badge.zero{background:var(--bg3);color:var(--muted);}

/* ===== DECKS PAGE ===== */
.search-bar{
  width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:11px;
  padding:10px 14px;color:var(--text);font-size:0.95rem;outline:none;
  margin-bottom:10px;
}
.search-bar:focus{border-color:var(--accent);}
.card-browse{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:14px;padding:14px 16px;cursor:pointer;transition:border-color .15s;
}
.card-browse:hover{border-color:var(--accent);}
.card-browse:active{opacity:.8;}
.card-browse.open{border-color:var(--accent);}
.card-tags{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:7px;}
.tag{background:var(--bg3);padding:2px 7px;border-radius:6px;font-size:0.65rem;color:var(--muted);font-weight:600;}
.tag.type-formula{background:rgba(99,102,241,0.15);color:#818cf8;}
.tag.type-definition{background:rgba(16,185,129,0.15);color:#34d399;}
.tag.type-method{background:rgba(245,158,11,0.15);color:#fcd34d;}
.tag.type-theorem{background:rgba(239,68,68,0.15);color:#fca5a5;}
.card-front{font-weight:600;font-size:0.95rem;line-height:1.5;}
.card-back{
  display:none;margin-top:10px;padding-top:10px;
  border-top:1px dashed var(--border);color:var(--text);
  font-size:0.92rem;line-height:1.55;white-space:pre-wrap;
  -webkit-user-select:text;user-select:text;
}
.card-browse.open .card-back{display:block;}
.results-count{font-size:0.78rem;color:var(--muted);margin-bottom:10px;}

/* ===== MODES PAGE ===== */
.mode-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px;}
.mode-card{
  background:var(--bg2);border:1px solid var(--border);border-radius:14px;
  padding:18px 14px;cursor:pointer;text-align:center;
  transition:border-color .2s,transform .1s;
}
.mode-card:active{transform:scale(.95);}
.mode-card.selected{border-color:var(--accent);background:rgba(99,102,241,0.1);}
.mode-icon{font-size:2rem;margin-bottom:8px;}
.mode-name{font-weight:700;font-size:0.9rem;}
.mode-desc{font-size:0.72rem;color:var(--muted);margin-top:4px;}

.deck-selector{margin-bottom:16px;}
.deck-sel-item{
  background:var(--bg2);border:1px solid var(--border);border-radius:10px;
  padding:12px 14px;cursor:pointer;margin-bottom:7px;
  display:flex;align-items:center;gap:10px;
}
.deck-sel-item.selected{border-color:var(--accent);}
.deck-sel-check{
  width:20px;height:20px;border-radius:50%;border:2px solid var(--border);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.deck-sel-item.selected .deck-sel-check{
  background:var(--accent);border-color:var(--accent);color:#fff;font-size:0.75rem;
}

/* ===== REVIEW OVERLAY ===== */
.overlay{
  display:none;position:fixed;inset:0;background:var(--bg);z-index:300;
  flex-direction:column;
  padding-top:var(--safe-top);
  padding-bottom:var(--safe-bot);
}
.overlay.active{display:flex;}
.ov-header{
  padding:12px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:12px;
}
.ov-close{
  background:var(--bg2);border:none;color:var(--text);
  width:34px;height:34px;border-radius:50%;font-size:1.1rem;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
}
.ov-title{font-size:0.95rem;font-weight:700;flex:1;}
.ov-prog{font-size:0.85rem;color:var(--muted);}
.progress-bar-ov{height:3px;background:var(--bg3);}
.progress-bar-ov-fill{height:100%;background:var(--accent);transition:width .3s;}
.ov-body{flex:1;overflow-y:auto;padding:16px;}

/* Flashcard flip */
.flip-scene{
  perspective:1000px;
  min-height:260px;margin-bottom:16px;cursor:pointer;
}
.flip-card{
  position:relative;width:100%;min-height:260px;
  transform-style:preserve-3d;transition:transform .45s cubic-bezier(.4,0,.2,1);
}
.flip-card.flipped{transform:rotateY(180deg);}
.flip-face{
  position:absolute;inset:0;
  background:var(--bg2);border:1px solid var(--border);border-radius:16px;
  padding:24px;display:flex;flex-direction:column;justify-content:center;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
}
.flip-face.back{transform:rotateY(180deg);border-color:rgba(16,185,129,0.45);}
.flip-face.back .flip-label{color:var(--green);}
.flip-label{font-size:0.72rem;color:var(--muted);font-weight:700;margin-bottom:12px;text-transform:uppercase;letter-spacing:.5px;}
.flip-text{font-size:1.15rem;font-weight:600;text-align:center;white-space:pre-wrap;line-height:1.6;}
.flip-text.back-text{color:var(--text);font-weight:500;font-size:1.1rem;text-align:left;line-height:1.65;}
.flip-hint{text-align:center;font-size:0.78rem;color:var(--muted);margin-bottom:14px;}

.rate-btns{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
.rate-btn{
  border:none;padding:13px 4px;border-radius:11px;font-size:0.78rem;font-weight:700;
  color:#fff;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;
  transition:opacity .1s,transform .1s;
}
.rate-btn:active{transform:scale(.94);}
.rate-btn small{font-size:0.6rem;opacity:.8;font-weight:400;}
.rate-again{background:var(--red);}
.rate-hard{background:var(--yellow);}
.rate-good{background:var(--green);}
.rate-easy{background:var(--blue);}

.flip-btn{
  width:100%;border:none;background:var(--accent);color:#fff;
  padding:16px;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;
}

/* ===== QCM OVERLAY ===== */
.qcm-question{
  background:var(--bg2);border:1px solid var(--border);border-radius:14px;
  padding:24px;margin-bottom:16px;text-align:center;
}
.qcm-q-text{font-size:1.08rem;font-weight:600;line-height:1.6;-webkit-user-select:text;user-select:text;}
.qcm-choices{display:flex;flex-direction:column;gap:10px;}
.qcm-choice{
  background:var(--bg2);border:2px solid var(--border);border-radius:12px;
  padding:15px 16px;cursor:pointer;text-align:left;font-size:1rem;font-weight:500;line-height:1.45;
  transition:border-color .15s,background .15s;display:flex;align-items:center;gap:10px;
  -webkit-user-select:text;user-select:text;
}
.qcm-choice:active{transform:scale(.98);}
.qcm-choice.correct{border-color:var(--green);background:rgba(16,185,129,0.2);color:var(--text);}
.qcm-choice.wrong{border-color:var(--red);background:rgba(239,68,68,0.18);color:var(--text);}
.qcm-choice.correct .qcm-badge{background:var(--green);color:#fff;}
.qcm-choice.wrong .qcm-badge{background:var(--red);color:#fff;}
.qcm-choice.correct::after{content:'✓';margin-left:auto;color:#34d399;font-weight:800;font-size:1.2rem;flex-shrink:0;}
.qcm-choice.wrong::after{content:'✗';margin-left:auto;color:#f87171;font-weight:800;font-size:1.2rem;flex-shrink:0;}
.qcm-choice.revealed{cursor:default;}
.qcm-badge{
  width:26px;height:26px;border-radius:50%;background:var(--bg3);
  display:flex;align-items:center;justify-content:center;
  font-size:0.75rem;font-weight:700;flex-shrink:0;
}
.qcm-next{
  width:100%;border:none;background:var(--accent);color:#fff;
  padding:15px;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;
  margin-top:12px;
}

/* ===== VRAI/FAUX OVERLAY ===== */
.vf-question{
  background:var(--bg2);border:1px solid var(--border);border-radius:14px;
  padding:24px;margin-bottom:20px;text-align:center;min-height:160px;
  display:flex;flex-direction:column;justify-content:center;
}
.vf-q-text{font-size:1.08rem;font-weight:600;line-height:1.6;-webkit-user-select:text;user-select:text;}
.vf-btns{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.vf-btn{
  padding:20px;border:none;border-radius:14px;font-size:1.1rem;font-weight:800;
  cursor:pointer;transition:opacity .15s,transform .1s;
}
.vf-btn:active{transform:scale(.95);}
.vf-true{background:var(--green);color:#fff;}
.vf-false{background:var(--red);color:#fff;}

/* ===== SESSION END ===== */
.session-end{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;text-align:center;padding:32px 16px;min-height:60vh;
}
.session-emoji{font-size:4rem;margin-bottom:16px;}
.session-title{font-size:1.5rem;font-weight:800;margin-bottom:8px;}
.session-sub{color:var(--muted);margin-bottom:24px;}
.session-results{
  display:grid;grid-template-columns:repeat(3,1fr);gap:10px;
  width:100%;margin-bottom:24px;
}
.res-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center;}
.res-val{font-size:1.4rem;font-weight:800;}
.res-lab{font-size:0.7rem;color:var(--muted);margin-top:3px;}

/* ===== STATS PAGE ===== */
.stats-row{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:16px;}
.stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px;text-align:center;}
.stat-val{font-size:1.8rem;font-weight:900;color:var(--accent);}
.stat-lab{font-size:0.72rem;color:var(--muted);margin-top:4px;}
.heatmap-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:16px;overflow-x:auto;}
.heatmap-grid{display:flex;gap:3px;min-width:280px;}
.heatmap-col{display:flex;flex-direction:column;gap:3px;}
.heatmap-cell{width:11px;height:11px;border-radius:2px;background:var(--bg3);}
.heatmap-cell.l1{background:#312e81;}
.heatmap-cell.l2{background:#4338ca;}
.heatmap-cell.l3{background:#6366f1;}
.heatmap-cell.l4{background:#a5b4fc;}

.progress-row{margin-bottom:12px;}
.pr-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;}
.pr-name{font-size:0.85rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60%;}
.pr-nums{font-size:0.72rem;color:var(--muted);}
.pr-bar{height:7px;background:var(--bg3);border-radius:4px;overflow:hidden;}
.pr-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:4px;transition:width .6s;}

/* ===== BADGES ===== */
.badges-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px;}
.badge-card{
  background:var(--bg2);border:1px solid var(--border);border-radius:12px;
  padding:12px 8px;text-align:center;
}
.badge-card.locked{opacity:.35;filter:grayscale(1);}
.badge-icon{font-size:1.6rem;margin-bottom:4px;}
.badge-name{font-size:0.6rem;font-weight:700;color:var(--muted);}
.badge-card.unlocked .badge-name{color:var(--text);}

/* ===== PROFIL PAGE ===== */
.profil-avatar{
  width:64px;height:64px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:1.5rem;font-weight:800;color:#fff;margin:0 auto 12px;
}
.setting-row{
  display:flex;align-items:center;gap:12px;
  background:var(--bg2);border:1px solid var(--border);border-radius:12px;
  padding:14px 16px;margin-bottom:8px;
}
.setting-icon{font-size:1.2rem;}
.setting-label{flex:1;font-size:0.9rem;font-weight:500;}
.setting-value{color:var(--muted);font-size:0.85rem;}
.setting-input{
  background:var(--bg3);border:none;color:var(--text);
  padding:6px 10px;border-radius:8px;width:70px;font-size:0.9rem;text-align:center;
}

/* ===== TOAST ===== */
.toast{
  position:fixed;bottom:calc(80px + var(--safe-bot));left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--bg3);color:var(--text);padding:10px 20px;border-radius:20px;
  font-size:0.85rem;font-weight:600;opacity:0;transition:all .25s;z-index:999;white-space:nowrap;
  pointer-events:none;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ===== DECK GROUPS (accueil personnalisé) ===== */
.deck-group-label{font-size:0.72rem;color:var(--muted);font-weight:700;letter-spacing:.5px;text-transform:uppercase;margin:2px 2px 8px;}

/* ===== COUNTDOWN HERO ===== */
.hero-count.small{font-size:2.6rem;}
.hero-set-link{text-decoration:underline;cursor:pointer;}

/* ===== ONBOARDING ===== */
.onb-body{flex:1;overflow-y:auto;padding:26px 20px calc(20px + var(--safe-bot));display:flex;flex-direction:column;}
.onb-progress{display:flex;gap:6px;justify-content:center;margin-bottom:24px;}
.onb-dot{width:8px;height:8px;border-radius:50%;background:var(--bg3);transition:all .2s;}
.onb-dot.active{background:var(--accent);width:22px;border-radius:4px;}
.onb-step{display:none;animation:fadeIn .25s ease;}
.onb-step.active{display:block;}
.onb-emoji{font-size:2.6rem;text-align:center;margin-bottom:10px;}
.onb-title{font-size:1.35rem;font-weight:800;text-align:center;margin-bottom:8px;}
.onb-desc{font-size:0.9rem;color:var(--muted);text-align:center;margin-bottom:24px;line-height:1.55;}
.onb-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.onb-opt{
  background:var(--bg2);border:2px solid var(--border);border-radius:14px;
  padding:16px 12px;cursor:pointer;text-align:center;font-weight:600;font-size:0.9rem;
  transition:border-color .15s,background .15s;
}
.onb-opt .oi{font-size:1.6rem;display:block;margin-bottom:6px;}
.onb-opt.selected{border-color:var(--accent);background:rgba(99,102,241,0.14);}
.onb-subj{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:10px;}
.onb-subj-head{display:flex;align-items:center;gap:10px;font-weight:700;font-size:0.95rem;margin-bottom:10px;}
.onb-levels{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;}
.onb-lvl{
  border:1px solid var(--border);background:var(--bg3);color:var(--muted);
  border-radius:9px;padding:9px 4px;font-size:0.78rem;font-weight:700;cursor:pointer;text-align:center;
  transition:all .15s;
}
.onb-lvl.selected{background:var(--accent);border-color:var(--accent);color:#fff;}
.onb-date{
  width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:12px;
  padding:14px;color:var(--text);font-size:1rem;color-scheme:dark;outline:none;
}
.onb-date:focus{border-color:var(--accent);}
.onb-footer{margin-top:auto;padding-top:22px;display:flex;gap:10px;align-items:center;}
.onb-skip{background:none;border:none;color:var(--muted);font-size:0.85rem;cursor:pointer;padding:14px 10px;white-space:nowrap;}

/* ===== OBJECTIF DU JOUR ===== */
.goal-card{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:14px 16px;margin-bottom:16px;}
.goal-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.goal-title{font-size:0.85rem;font-weight:700;}
.goal-count{font-size:0.85rem;color:var(--muted);font-weight:700;}
.goal-count.done{color:var(--green);}
.goal-bar{height:8px;background:var(--bg3);border-radius:5px;overflow:hidden;}
.goal-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--accent));border-radius:5px;transition:width .5s;}

/* ===== PASTILLE TYPE (cartes visuelles) ===== */
.type-pill{
  display:inline-flex;align-items:center;gap:5px;align-self:center;
  padding:5px 12px;border-radius:20px;font-size:0.72rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.4px;margin-bottom:14px;
  border:1px solid var(--border);background:var(--bg3);color:var(--muted);
}
.type-pill.type-formula{background:rgba(99,102,241,0.15);color:#a5b4fc;border-color:rgba(99,102,241,0.4);}
.type-pill.type-definition{background:rgba(16,185,129,0.15);color:#6ee7b7;border-color:rgba(16,185,129,0.4);}
.type-pill.type-method{background:rgba(245,158,11,0.15);color:#fcd34d;border-color:rgba(245,158,11,0.4);}
.type-pill.type-theorem{background:rgba(239,68,68,0.15);color:#fca5a5;border-color:rgba(239,68,68,0.4);}
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="logo">FR</div>
  <span class="app-name">FlashRevise</span>
  <div class="header-right">
    <div class="streak-badge">🔥 <span id="streak-val">0</span>j</div>
  </div>
</header>

<!-- ========== PAGE: ACCUEIL ========== -->
<div class="page active" id="page-home">
<main>
  <!-- Hero : compte à rebours concours -->
  <div class="hero-card">
    <div class="hero-label" id="hero-greet">Bonjour 👋</div>
    <div class="hero-count small" id="hero-countdown">🎯</div>
    <div class="hero-sub" id="hero-sub">Définir la date des concours</div>
    <button class="btn-primary" id="btn-start-all" style="background:rgba(255,255,255,0.2);border:1.5px solid rgba(255,255,255,0.4);backdrop-filter:blur(4px);">
      ⚡ Commencer la session
    </button>
  </div>

  <!-- Quick stats -->
  <div class="quick-stats">
    <div class="qs-card">
      <div class="qs-val" id="qs-total">0</div>
      <div class="qs-lab">Cartes apprises</div>
    </div>
    <div class="qs-card">
      <div class="qs-val" id="qs-mature">0</div>
      <div class="qs-lab">Maîtrisées</div>
    </div>
    <div class="qs-card">
      <div class="qs-val" id="qs-today">0</div>
      <div class="qs-lab">Vues aujourd'hui</div>
    </div>
  </div>

  <div class="goal-card">
    <div class="goal-top">
      <span class="goal-title">🎯 Objectif du jour</span>
      <span class="goal-count" id="goal-count">0 / 50</span>
    </div>
    <div class="goal-bar"><div class="goal-fill" id="goal-fill" style="width:0%"></div></div>
  </div>

  <div class="section-title">Mes decks</div>
  <div id="home-deck-list" style="display:flex;flex-direction:column;gap:8px;"></div>

  <div class="section-title" style="margin-top:24px;">Révision rapide</div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
    <button class="btn-outline" onclick="startQCMMode()">🎯 QCM</button>
    <button class="btn-outline" onclick="startVFMode()">✅ Vrai/Faux</button>
  </div>
</main>
</div>

<!-- ========== PAGE: DECKS ========== -->
<div class="page" id="page-decks">
<main>
  <input class="search-bar" id="search-input" placeholder="🔍 Rechercher une carte…" oninput="renderBrowse()">
  <div class="chips-row" id="browse-niveau-chips"></div>
  <div class="chips-row" style="margin-top:7px;" id="browse-matiere-chips"></div>
  <div class="chips-row" style="margin-top:7px;" id="browse-type-chips"></div>
  <div class="results-count" id="browse-count"></div>
  <div id="browse-list" style="display:flex;flex-direction:column;gap:8px;"></div>
</main>
</div>

<!-- ========== PAGE: MODES ========== -->
<div class="page" id="page-modes">
<main>
  <div class="section-title">Choisir un mode</div>
  <div class="mode-grid">
    <div class="mode-card selected" id="mcard-srs" onclick="selectMode('srs')">
      <div class="mode-icon">🧠</div>
      <div class="mode-name">Répétition espacée</div>
      <div class="mode-desc">Algorithme SRS adaptatif</div>
    </div>
    <div class="mode-card" id="mcard-qcm" onclick="selectMode('qcm')">
      <div class="mode-icon">🎯</div>
      <div class="mode-name">QCM</div>
      <div class="mode-desc">4 réponses proposées</div>
    </div>
    <div class="mode-card" id="mcard-vf" onclick="selectMode('vf')">
      <div class="mode-icon">✅</div>
      <div class="mode-name">Vrai / Faux</div>
      <div class="mode-desc">Statements à juger</div>
    </div>
    <div class="mode-card" id="mcard-chrono" onclick="selectMode('chrono')">
      <div class="mode-icon">⏱️</div>
      <div class="mode-name">Chrono 60s</div>
      <div class="mode-desc">Maximum en 1 minute</div>
    </div>
    <div class="mode-card" id="mcard-hard" onclick="selectMode('hard')">
      <div class="mode-icon">🔥</div>
      <div class="mode-name">Cartes difficiles</div>
      <div class="mode-desc">Ce que tu rates souvent</div>
    </div>
  </div>

  <div class="section-title">Sélectionner un deck</div>
  <div id="mode-deck-selector"></div>
  <button class="btn-primary" id="btn-launch-mode" onclick="launchSelectedMode()">▶ Lancer la session</button>
</main>
</div>

<!-- ========== PAGE: STATS ========== -->
<div class="page" id="page-stats">
<main>
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-val" id="st-streak">0</div>
      <div class="stat-lab">🔥 Streak (jours)</div>
    </div>
    <div class="stat-card">
      <div class="stat-val" id="st-total">0</div>
      <div class="stat-lab">Cartes apprises</div>
    </div>
    <div class="stat-card">
      <div class="stat-val" id="st-mature">0</div>
      <div class="stat-lab">🏆 Maîtrisées (≥21j)</div>
    </div>
    <div class="stat-card">
      <div class="stat-val" id="st-sessions">0</div>
      <div class="stat-lab">Sessions totales</div>
    </div>
  </div>

  <div class="section-title">Activité (15 semaines)</div>
  <div class="heatmap-wrap">
    <div class="heatmap-grid" id="heatmap-grid"></div>
    <div style="display:flex;align-items:center;gap:6px;margin-top:10px;font-size:0.7rem;color:var(--muted);">
      <span>Moins</span>
      <div class="heatmap-cell"></div>
      <div class="heatmap-cell l1"></div>
      <div class="heatmap-cell l2"></div>
      <div class="heatmap-cell l3"></div>
      <div class="heatmap-cell l4"></div>
      <span>Plus</span>
    </div>
  </div>

  <div class="section-title">Progression par deck</div>
  <div id="deck-progress-list"></div>

  <div class="section-title">Points faibles par chapitre</div>
  <div id="chapter-weak-list"></div>

  <div class="section-title">Badges</div>
  <div class="badges-grid" id="badges-grid"></div>
</main>
</div>

<!-- ========== PAGE: PROFIL ========== -->
<div class="page" id="page-profil">
<main>
  <div style="text-align:center;margin-bottom:20px;">
    <div class="profil-avatar">🎓</div>
    <div style="font-size:1.1rem;font-weight:700;">Mon profil</div>
    <div style="font-size:0.8rem;color:var(--muted);margin-top:2px;" id="profil-stats-line"></div>
  </div>

  <div class="section-title">Profil scolaire</div>
  <div class="setting-row" onclick="startOnboarding()" style="cursor:pointer;">
    <span class="setting-icon">🎓</span>
    <span class="setting-label">Niveau</span>
    <span class="setting-value" id="pf-niveau">Non défini</span>
  </div>
  <div class="setting-row" onclick="startOnboarding()" style="cursor:pointer;">
    <span class="setting-icon">🎯</span>
    <span class="setting-label">Concours / examen</span>
    <span class="setting-value" id="pf-exam">Non défini</span>
  </div>
  <button class="btn-outline" style="margin-bottom:8px;" onclick="startOnboarding()">🔧 Refaire la configuration</button>

  <div class="section-title">Paramètres de révision</div>
  <div class="setting-row">
    <span class="setting-icon">🆕</span>
    <span class="setting-label">Nouvelles cartes / jour</span>
    <input class="setting-input" type="number" id="set-new" min="1" max="100" value="20">
  </div>
  <div class="setting-row">
    <span class="setting-icon">🔁</span>
    <span class="setting-label">Révisions max / jour</span>
    <input class="setting-input" type="number" id="set-rev" min="10" max="500" value="150">
  </div>
  <div class="setting-row">
    <span class="setting-icon">🎯</span>
    <span class="setting-label">Objectif quotidien (cartes)</span>
    <input class="setting-input" type="number" id="set-goal" min="5" max="200" value="50">
  </div>
  <div class="setting-row">
    <span class="setting-icon">⏰</span>
    <span class="setting-label">Rappel quotidien</span>
    <input class="setting-input" type="time" id="set-remind" style="width:96px;color-scheme:dark;">
  </div>

  <div class="section-title">Informations</div>
  <div class="setting-row">
    <span class="setting-icon">📚</span>
    <span class="setting-label">Total cartes disponibles</span>
    <span class="setting-value" id="total-cards-count">0</span>
  </div>
  <div class="setting-row">
    <span class="setting-icon">📦</span>
    <span class="setting-label">Decks chargés</span>
    <span class="setting-value" id="total-decks-count">0</span>
  </div>

  <div class="section-title">Actions</div>
  <button class="btn-outline" style="margin-bottom:8px;" onclick="exportStats()">📤 Exporter mes statistiques</button>
  <button class="btn-outline" style="color:var(--red);border-color:var(--red);" onclick="resetProgress()">🗑️ Réinitialiser la progression</button>
</main>
</div>

<!-- ========== OVERLAY: RÉVISION SRS ========== -->
<div class="overlay" id="ov-review">
  <div class="ov-header">
    <button class="ov-close" onclick="closeReview()">✕</button>
    <div class="ov-title" id="ov-rev-title">Révision</div>
    <div class="ov-prog" id="ov-rev-prog">0/0</div>
  </div>
  <div class="progress-bar-ov"><div class="progress-bar-ov-fill" id="rev-prog-fill" style="width:0%"></div></div>
  <div class="ov-body">
    <div class="flip-scene" onclick="flipCard()" id="flip-scene">
      <div class="flip-card" id="flip-card">
        <div class="flip-face front" id="flip-front">
          <div class="type-pill" id="flip-type" style="display:none;"></div>
          <div class="flip-text" id="flip-recto"></div>
        </div>
        <div class="flip-face back" id="flip-back">
          <div class="flip-label">Réponse</div>
          <div class="flip-text back-text" id="flip-verso"></div>
        </div>
      </div>
    </div>
    <div class="flip-hint" id="flip-hint">Appuie pour révéler la réponse</div>
    <button class="flip-btn" id="flip-btn" onclick="flipCard()">Afficher la réponse 👁️</button>
    <div class="rate-btns" id="rate-btns" style="display:none;">
      <button class="rate-btn rate-again" onclick="rateCard(1)">😵<br>Encore<br><small id="int-again"></small></button>
      <button class="rate-btn rate-hard" onclick="rateCard(2)">😓<br>Difficile<br><small id="int-hard"></small></button>
      <button class="rate-btn rate-good" onclick="rateCard(3)">😊<br>Bien<br><small id="int-good"></small></button>
      <button class="rate-btn rate-easy" onclick="rateCard(4)">🚀<br>Facile<br><small id="int-easy"></small></button>
    </div>
    <div id="rev-session-end" class="session-end" style="display:none;"></div>
  </div>
</div>

<!-- ========== OVERLAY: QCM ========== -->
<div class="overlay" id="ov-qcm">
  <div class="ov-header">
    <button class="ov-close" onclick="closeQCM()">✕</button>
    <div class="ov-title" id="ov-qcm-title">QCM</div>
    <div class="ov-prog" id="ov-qcm-prog">0/0</div>
  </div>
  <div class="progress-bar-ov"><div class="progress-bar-ov-fill" id="qcm-prog-fill" style="width:0%"></div></div>
  <div class="ov-body">
    <div id="qcm-meta" style="font-size:0.72rem;color:var(--muted);margin-bottom:10px;"></div>
    <div class="qcm-question">
      <div class="qcm-q-text" id="qcm-question"></div>
    </div>
    <div class="qcm-choices" id="qcm-choices"></div>
    <button class="qcm-next" id="qcm-next" onclick="qcmNext()" style="display:none;">Suivant →</button>
    <div id="qcm-session-end" class="session-end" style="display:none;"></div>
  </div>
</div>

<!-- ========== OVERLAY: VRAI/FAUX ========== -->
<div class="overlay" id="ov-vf">
  <div class="ov-header">
    <button class="ov-close" onclick="closeVF()">✕</button>
    <div class="ov-title">Vrai / Faux</div>
    <div class="ov-prog" id="ov-vf-prog">0/0</div>
  </div>
  <div class="progress-bar-ov"><div class="progress-bar-ov-fill" id="vf-prog-fill" style="width:0%"></div></div>
  <div class="ov-body">
    <div id="vf-meta" style="font-size:0.72rem;color:var(--muted);margin-bottom:10px;"></div>
    <div class="vf-question">
      <div class="vf-q-text" id="vf-statement"></div>
    </div>
    <div class="vf-btns">
      <button class="vf-btn vf-true" onclick="answerVF(true)">✓ Vrai</button>
      <button class="vf-btn vf-false" onclick="answerVF(false)">✗ Faux</button>
    </div>
    <div id="vf-feedback" style="margin-top:14px;padding:14px;border-radius:12px;display:none;"></div>
    <button class="qcm-next" id="vf-next" onclick="vfNext()" style="display:none;margin-top:10px;">Suivant →</button>
    <div id="vf-session-end" class="session-end" style="display:none;"></div>
  </div>
</div>

<!-- ========== OVERLAY: ONBOARDING ========== -->
<div class="overlay" id="ov-onboard">
  <div class="onb-body">
    <div class="onb-progress">
      <div class="onb-dot active"></div>
      <div class="onb-dot"></div>
      <div class="onb-dot"></div>
    </div>

    <div class="onb-step active" id="onb-0">
      <div class="onb-emoji">🎓</div>
      <div class="onb-title">Bienvenue sur FlashRevise</div>
      <div class="onb-desc">Pour personnaliser tes révisions, où en es-tu dans tes études&nbsp;?</div>
      <div class="onb-grid" id="onb-niveau-grid"></div>
    </div>

    <div class="onb-step" id="onb-1">
      <div class="onb-emoji">📚</div>
      <div class="onb-title">Tes matières</div>
      <div class="onb-desc">Indique ton niveau ressenti — on adaptera le rythme et l'ordre des decks.</div>
      <div id="onb-subj-list"></div>
    </div>

    <div class="onb-step" id="onb-2">
      <div class="onb-emoji">🎯</div>
      <div class="onb-title">Ton objectif</div>
      <div class="onb-desc">La date de tes concours ou examens&nbsp;? On affichera un compte à rebours pour garder le cap sur le long terme.</div>
      <input type="date" class="onb-date" id="onb-date">
      <input type="text" class="onb-date" id="onb-date-label" placeholder="Nom (ex : Concours CCINP)" style="margin-top:10px;">
    </div>

    <div class="onb-footer">
      <button class="onb-skip" id="onb-skip" onclick="onbFinish()">Passer</button>
      <button class="btn-primary" id="onb-next" onclick="onbNext()" style="flex:1;">Continuer</button>
    </div>
  </div>
</div>

<!-- TABBAR -->
<div class="tabbar">
  <button class="tab active" data-page="home"><span class="ti">🏠</span>Accueil</button>
  <button class="tab" data-page="decks"><span class="ti">📚</span>Cartes</button>
  <button class="tab" data-page="modes"><span class="ti">🎮</span>Modes</button>
  <button class="tab" data-page="stats"><span class="ti">📊</span>Stats</button>
  <button class="tab" data-page="profil"><span class="ti">👤</span>Profil</button>
</div>

<div class="toast" id="toast"></div>

<script>
// ===== DATA =====
const CARDS=[{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.1 - Raisonnement par récurrence","type":"method","recto":"Les 2 étapes d'une démonstration par récurrence ?","verso":"1. INITIALISATION : prouver P(n₀) vraie (souvent n₀ = 0 ou 1).\n2. HÉRÉDITÉ : supposer P(n) vraie pour un n ≥ n₀, démontrer P(n+1) vraie.\nConclusion : P(n) vraie pour tout n ≥ n₀.","tags":"recurrence","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.1 - Raisonnement par récurrence","type":"definition","recto":"Récurrence simple ?","verso":"Démonstration par récurrence où l'hérédité est : P(n) ⇒ P(n+1).","tags":"recurrence;simple","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.1 - Raisonnement par récurrence","type":"definition","recto":"Récurrence double ?","verso":"L'hérédité utilise DEUX rangs précédents : P(n) ET P(n+1) ⇒ P(n+2).\nIl faut alors initialiser sur DEUX valeurs : P(n₀) et P(n₀+1).","tags":"recurrence;double","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.1 - Raisonnement par récurrence","type":"definition","recto":"Récurrence forte ?","verso":"L'hérédité utilise TOUS les rangs précédents : P(n₀), P(n₀+1), ..., P(n) ⇒ P(n+1).\nUtile quand le passage à n+1 dépend de plusieurs prédécesseurs.","tags":"recurrence;forte","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.1 - Raisonnement par récurrence","type":"application","recto":"Quand utiliser une récurrence forte ?","verso":"Quand on a besoin de l'hypothèse pour PLUSIEURS rangs antérieurs (par exemple, suites définies par u_(n+1) = f(u_n, u_(n-1), ...) ou propriétés de divisibilité).","tags":"recurrence;forte","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.1 - Raisonnement par récurrence","type":"law","recto":"5ᵉ axiome de Peano ?","verso":"Toute partie non vide de ℕ admet un plus petit élément.\nC'est le fondement du raisonnement par récurrence.","tags":"peano;axiome","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"definition","recto":"Cardinal d'un ensemble fini E ?","verso":"Card(E) = nombre d'éléments de E. Noté aussi |E| ou #E.","tags":"cardinal","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Cardinal d'une union (formule du crible) ?","verso":"Card(A ∪ B) = Card(A) + Card(B) − Card(A ∩ B)","tags":"crible","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Cardinal d'un produit cartésien ?","verso":"Card(A × B) = Card(A) × Card(B)\nGénéralisation : Card(A₁ × ... × Aₙ) = ∏ Card(Aᵢ).","tags":"produit-cartesien","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"definition","recto":"k-liste (ou k-uplet) d'un ensemble à n éléments ?","verso":"Suite ordonnée de k éléments avec répétitions possibles. Nombre : nᵏ.","tags":"liste","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"definition","recto":"Liste sans répétition (arrangement) ?","verso":"Suite ordonnée de k éléments distincts choisis parmi n.\nNombre : A(n,k) = n × (n−1) × ... × (n−k+1) = n! / (n−k)!","tags":"arrangement","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"definition","recto":"Permutation d'un ensemble à n éléments ?","verso":"Réarrangement de tous les éléments. Nombre : n! (factorielle de n).","tags":"permutation","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Définition de n! (factorielle) ?","verso":"n! = 1 × 2 × 3 × ... × n  pour n ≥ 1\nPar convention : 0! = 1.","tags":"factorielle","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"definition","recto":"Combinaison de k éléments parmi n ?","verso":"Choix non ordonné de k éléments parmi n. Nombre : C(n,k) = (n choose k) = n! / (k! × (n−k)!).","tags":"combinaison","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Notation française vs anglaise ?","verso":"C(n,k) = (n k) = n! / (k!(n−k)!)\nLire : « k parmi n ».\nAussi appelé coefficient binomial.","tags":"coefficient-binomial","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Symétrie des coefficients binomiaux ?","verso":"(n k) = (n n−k)\nEx. : (5 2) = (5 3) = 10.","tags":"binomial;symetrie","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Formule du triangle de Pascal ?","verso":"(n k) + (n k+1) = (n+1 k+1)\nPermet de construire le triangle de Pascal ligne par ligne.","tags":"pascal;triangle","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Formule du binôme de Newton ?","verso":"(a + b)ⁿ = Σ_(k=0)^n (n k) × aᵏ × bⁿ⁻ᵏ\nDéveloppement de (a+b) à la puissance n.","tags":"binome;newton","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"application","recto":"Cas particulier : (1+x)ⁿ ?","verso":"(1+x)ⁿ = Σ_(k=0)^n (n k) × xᵏ\n= 1 + n·x + (n(n−1)/2)·x² + ... + xⁿ","tags":"binome;application","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.2 - Dénombrement et combinatoire","type":"formula","recto":"Somme des coefficients binomiaux ?","verso":"Σ_(k=0)^n (n k) = 2ⁿ\n(Démontré par binôme avec a = b = 1.)","tags":"binomial;somme","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suite numérique ?","verso":"Application d'une partie de ℕ vers ℝ. Notée (uₙ)_(n∈ℕ) ou (uₙ).","tags":"suite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suite arithmétique ?","verso":"Suite (uₙ) telle que u_(n+1) = uₙ + r (raison r constante).\nFormule explicite : uₙ = u₀ + n·r.","tags":"arithmetique","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"formula","recto":"Somme des termes d'une suite arithmétique ?","verso":"Σ_(k=0)^n uₖ = (n+1) × (u₀ + uₙ) / 2\nDe façon générale : (nb termes) × (1er + dernier) / 2.","tags":"arithmetique;somme","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suite géométrique ?","verso":"Suite (uₙ) telle que u_(n+1) = q × uₙ (raison q).\nFormule explicite : uₙ = u₀ × qⁿ.","tags":"geometrique","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"formula","recto":"Somme d'une suite géométrique (q ≠ 1) ?","verso":"Σ_(k=0)^n qᵏ = (1 − qⁿ⁺¹) / (1 − q)\nPour une suite (uₙ = u₀·qⁿ) : Σuₖ = u₀ × (1 − qⁿ⁺¹)/(1 − q).","tags":"geometrique;somme","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suite croissante ?","verso":"Pour tout n, u_(n+1) ≥ uₙ.\nStrictement croissante si u_(n+1) > uₙ.","tags":"monotonie","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suite majorée / minorée / bornée ?","verso":"• Majorée : ∃ M, ∀n, uₙ ≤ M.\n• Minorée : ∃ m, ∀n, uₙ ≥ m.\n• Bornée : majorée ET minorée.","tags":"bornage","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Limite finie d'une suite ?","verso":"lim uₙ = ℓ ⟺ ∀ε > 0, ∃ N tq ∀n ≥ N, |uₙ − ℓ| < ε.\n(Tout intervalle ouvert contenant ℓ contient tous les uₙ à partir d'un certain rang.)","tags":"limite;finie","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Limite +∞ d'une suite ?","verso":"lim uₙ = +∞ ⟺ ∀ A > 0, ∃ N tq ∀n ≥ N, uₙ > A.","tags":"limite;infinie","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suite convergente / divergente ?","verso":"• Convergente : admet une limite FINIE.\n• Divergente : sinon (limite ±∞ ou pas de limite).","tags":"convergence","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"law","recto":"Théorème : toute suite convergente est bornée.","verso":"Si (uₙ) converge, alors (uₙ) est bornée. Réciproque FAUSSE (ex. (−1)ⁿ est bornée mais ne converge pas).","tags":"theoreme;bornage","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"law","recto":"Théorème de la limite monotone ?","verso":"Toute suite croissante MAJORÉE converge.\nToute suite décroissante MINORÉE converge.","tags":"monotonie;convergence","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"law","recto":"Théorème des gendarmes (suites) ?","verso":"Si vₙ ≤ uₙ ≤ wₙ à partir d'un certain rang, et lim vₙ = lim wₙ = ℓ,\nalors lim uₙ = ℓ.","tags":"gendarmes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"application","recto":"Limite d'une suite géométrique qⁿ ?","verso":"• |q| < 1 : lim qⁿ = 0\n• q = 1 : lim qⁿ = 1\n• q > 1 : lim qⁿ = +∞\n• q ≤ −1 : pas de limite (oscille).","tags":"geometrique;limite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"definition","recto":"Suites adjacentes ?","verso":"Deux suites (uₙ) et (vₙ) telles que :\n• uₙ croissante, vₙ décroissante\n• ∀n, uₙ ≤ vₙ\n• lim(vₙ − uₙ) = 0\n→ Elles convergent vers la même limite.","tags":"adjacentes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.1.3 - Suites — propriétés et limites","type":"law","recto":"Théorème des suites adjacentes ?","verso":"Deux suites adjacentes convergent et ont la même limite.","tags":"adjacentes;theoreme","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"definition","recto":"Limite d'une fonction en +∞ ?","verso":"lim_(x→+∞) f(x) = ℓ ⟺ ∀ε > 0, ∃A, ∀x > A, |f(x) − ℓ| < ε.","tags":"limite;infini","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"definition","recto":"Asymptote horizontale ?","verso":"Si lim_(x→+∞) f(x) = ℓ (ou en −∞), la droite d'équation y = ℓ est asymptote horizontale à C_f.","tags":"asymptote;horizontale","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"definition","recto":"Asymptote verticale ?","verso":"Si lim_(x→a) f(x) = ±∞, la droite x = a est asymptote verticale à C_f.","tags":"asymptote;verticale","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"definition","recto":"Asymptote oblique ?","verso":"Si f(x) − (ax + b) → 0 quand x → ±∞, alors y = ax + b est asymptote oblique à C_f.","tags":"asymptote;oblique","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"formula","recto":"Limite d'une somme ?","verso":"Si lim f = ℓ et lim g = ℓ', alors lim(f+g) = ℓ + ℓ'.\nSAUF cas indéterminé : (+∞) + (−∞).","tags":"limite;somme","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"formula","recto":"Limite d'un produit ?","verso":"lim(f·g) = ℓ × ℓ'.\nSAUF cas indéterminé : 0 × ∞.","tags":"limite;produit","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"formula","recto":"Limite d'un quotient ?","verso":"lim(f/g) = ℓ/ℓ' si ℓ' ≠ 0.\nCas indéterminés : 0/0 et ∞/∞.","tags":"limite;quotient","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"application","recto":"Les 4 formes indéterminées (FI) ?","verso":"1. ∞ − ∞\n2. 0 × ∞\n3. 0/0\n4. ∞/∞\nIl faut TOUJOURS lever l'indétermination (factoriser, multiplier par le conjugué, etc.).","tags":"forme-indeterminee","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"application","recto":"Croissances comparées en +∞ ?","verso":"Pour α > 0 :\n• lim_(x→+∞) eˣ / xᵃ = +∞\n• lim_(x→+∞) (ln x) / xᵃ = 0\n→ « L'exponentielle l'emporte sur les puissances, qui l'emportent sur le logarithme. »","tags":"croissance-comparee","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"law","recto":"Théorème des gendarmes (fonctions) ?","verso":"Si g(x) ≤ f(x) ≤ h(x) sur un voisinage de a, et lim_(x→a) g = lim_(x→a) h = ℓ, alors lim_(x→a) f = ℓ.","tags":"gendarmes;fonction","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.1 - Limites de fonctions","type":"law","recto":"Théorème de comparaison des limites ?","verso":"Si f(x) ≥ g(x) au voisinage de a, et lim g = +∞, alors lim f = +∞.","tags":"comparaison;limites","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.2 - Continuité","type":"definition","recto":"Continuité en un point a ?","verso":"f est continue en a ⟺ lim_(x→a) f(x) = f(a).\nIl faut donc : f définie en a, limite existante en a, et égalité avec f(a).","tags":"continuite;point","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.2 - Continuité","type":"definition","recto":"Continuité sur un intervalle I ?","verso":"f est continue sur I si elle est continue en tout point de I.","tags":"continuite;intervalle","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.2 - Continuité","type":"application","recto":"Continuité des fonctions usuelles ?","verso":"Polynômes, exponentielle, logarithme, sinus, cosinus, racine carrée (sur [0,+∞[), valeur absolue : continues sur leur ensemble de définition.","tags":"continuite;usuelles","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.2 - Continuité","type":"law","recto":"Théorème des Valeurs Intermédiaires (TVI) ?","verso":"Si f continue sur [a,b] et k compris entre f(a) et f(b),\nalors ∃ c ∈ [a,b] tel que f(c) = k.","tags":"tvi","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.2 - Continuité","type":"law","recto":"Corollaire du TVI (fonction strictement monotone) ?","verso":"Si f continue ET strictement monotone sur [a,b], alors pour tout k ∈ [f(a), f(b)],\nl'équation f(x) = k admet UNE UNIQUE solution dans [a,b].","tags":"tvi;corollaire","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.2 - Continuité","type":"application","recto":"Application typique du TVI ?","verso":"Prouver l'existence (et parfois unicité) d'une solution d'une équation f(x) = k, sans la calculer.","tags":"tvi;application","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"definition","recto":"Nombre dérivé en a ?","verso":"f'(a) = lim_(h→0) (f(a+h) − f(a)) / h\nC'est la pente de la tangente à C_f au point d'abscisse a.","tags":"derivee;nombre","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"formula","recto":"Équation de la tangente en a ?","verso":"y = f'(a) × (x − a) + f(a)","tags":"tangente;equation","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"formula","recto":"Dérivées usuelles ?","verso":"• (xⁿ)' = n·xⁿ⁻¹\n• (1/x)' = −1/x²\n• (√x)' = 1/(2√x)\n• (eˣ)' = eˣ\n• (ln x)' = 1/x\n• (sin x)' = cos x\n• (cos x)' = −sin x","tags":"derivee;usuelles","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"formula","recto":"Dérivée d'un produit ?","verso":"(uv)' = u'v + uv'","tags":"derivee;produit","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"formula","recto":"Dérivée d'un quotient ?","verso":"(u/v)' = (u'v − uv') / v²  (avec v ≠ 0)","tags":"derivee;quotient","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"formula","recto":"Dérivée d'une composée ?","verso":"(f∘g)'(x) = f'(g(x)) × g'(x)\nEx. : (e^(u(x)))' = u'(x) × e^(u(x))\n(ln(u(x)))' = u'(x) / u(x)","tags":"derivee;composee","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"formula","recto":"Dérivée seconde f'' ?","verso":"f'' = (f')'  (dérivée de la dérivée)\nUtilisée pour la convexité.","tags":"derivee;seconde","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"law","recto":"Théorème : lien dérivée-monotonie ?","verso":"Sur un intervalle I :\n• f' > 0 ⇒ f strictement croissante\n• f' < 0 ⇒ f strictement décroissante\n• f' = 0 ⇒ f constante.","tags":"derivee;variation","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"definition","recto":"Convexité d'une fonction ?","verso":"f convexe sur I ⟺ pour tous x, y de I, et tout t ∈ [0,1] :\nf(tx + (1−t)y) ≤ t·f(x) + (1−t)·f(y).\nGraphiquement : la courbe est en-dessous de ses cordes.","tags":"convexite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"law","recto":"Caractérisation de la convexité par f'' ?","verso":"Sur un intervalle I :\n• f'' ≥ 0 ⟺ f convexe\n• f'' ≤ 0 ⟺ f concave","tags":"convexite;f''","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"definition","recto":"Point d'inflexion ?","verso":"Point où la fonction change de convexité (passe de convexe à concave ou inversement). En ce point, f'' s'annule en changeant de signe.","tags":"inflexion","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.3 - Dérivation","type":"law","recto":"Théorème des accroissements finis (TAF) ?","verso":"f continue sur [a,b], dérivable sur ]a,b[ : ∃ c ∈ ]a,b[ tel que\nf(b) − f(a) = (b − a) × f'(c).","tags":"taf","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"definition","recto":"Logarithme népérien ln ?","verso":"Fonction inverse de l'exponentielle :\nln : ]0, +∞[ → ℝ\nx ↦ ln(x) tel que e^(ln x) = x.\nln(1) = 0 et ln(e) = 1.","tags":"ln;definition","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"formula","recto":"Propriétés algébriques du ln ?","verso":"• ln(a·b) = ln(a) + ln(b)\n• ln(a/b) = ln(a) − ln(b)\n• ln(aⁿ) = n × ln(a)\n• ln(1/a) = −ln(a)\n• ln(√a) = ½ × ln(a)","tags":"ln;proprietes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"formula","recto":"Dérivée et primitive de ln ?","verso":"(ln x)' = 1/x  sur ]0, +∞[\nUne primitive de 1/x sur ]0,+∞[ est ln x.","tags":"ln;derivee","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"formula","recto":"Limites du ln à connaître ?","verso":"• lim_(x→0⁺) ln(x) = −∞\n• lim_(x→+∞) ln(x) = +∞\n• lim_(x→+∞) ln(x)/x = 0\n• lim_(x→0⁺) x·ln(x) = 0\n• lim_(x→0) ln(1+x)/x = 1","tags":"ln;limites","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"application","recto":"Résoudre eˣ = k (avec k > 0) ?","verso":"x = ln(k).\nPour k ≤ 0 : pas de solution.","tags":"equation;exponentielle","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"application","recto":"Résoudre ln(x) = k ?","verso":"x = eᵏ. Solution unique car ln est bijective de ]0,+∞[ vers ℝ.","tags":"equation;ln","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.5 - Logarithme népérien","type":"formula","recto":"Logarithme de base a ?","verso":"log_a(x) = ln(x) / ln(a)  pour a > 0, a ≠ 1.\nlog₁₀ = log (logarithme décimal).","tags":"log-base","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.6 - Exponentielle (rappels & approfondissement)","type":"definition","recto":"Fonction exponentielle ?","verso":"Unique fonction f définie sur ℝ telle que f' = f et f(0) = 1.\nNotée exp ou e^x. Image dans ]0, +∞[.","tags":"exp;definition","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.6 - Exponentielle (rappels & approfondissement)","type":"formula","recto":"Propriétés de l'exponentielle ?","verso":"• e^(a+b) = eᵃ × eᵇ\n• e^(a-b) = eᵃ / eᵇ\n• (eᵃ)ⁿ = e^(na)\n• e^(-a) = 1/eᵃ\n• e⁰ = 1, e¹ = e ≈ 2,718","tags":"exp;proprietes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.6 - Exponentielle (rappels & approfondissement)","type":"formula","recto":"Dérivée et primitive de e^x ?","verso":"(eˣ)' = eˣ.\nUne primitive de eˣ est eˣ.\nPlus généralement : (e^(u(x)))' = u'(x) · e^(u(x)).","tags":"exp;derivee","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.2.6 - Exponentielle (rappels & approfondissement)","type":"formula","recto":"Limites de l'exponentielle ?","verso":"• lim_(x→+∞) eˣ = +∞\n• lim_(x→−∞) eˣ = 0\n• lim_(x→+∞) eˣ/x = +∞\n• lim_(x→−∞) x·eˣ = 0\n• lim_(x→0) (eˣ−1)/x = 1","tags":"exp;limites","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.1 - Primitives","type":"definition","recto":"Primitive d'une fonction f ?","verso":"Fonction F dérivable telle que F'(x) = f(x) sur un intervalle I.\nDeux primitives diffèrent d'une constante : F(x) + k.","tags":"primitive;definition","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.1 - Primitives","type":"law","recto":"Théorème : existence des primitives ?","verso":"Toute fonction CONTINUE sur un intervalle admet des primitives sur cet intervalle.","tags":"primitive;existence","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.1 - Primitives","type":"formula","recto":"Primitives usuelles ?","verso":"• xⁿ → x^(n+1)/(n+1)  (n ≠ −1)\n• 1/x → ln|x|\n• eˣ → eˣ\n• 1/√x → 2√x\n• cos x → sin x\n• sin x → −cos x\n• 1/(1+x²) → arctan x","tags":"primitive;usuelles","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.1 - Primitives","type":"formula","recto":"Primitives par composition ?","verso":"• u' · uⁿ → u^(n+1)/(n+1)\n• u'/u → ln|u|\n• u' · eᵘ → eᵘ\n• u'/√u → 2√u\n• u' · cos(u) → sin(u)","tags":"primitive;composee","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.1 - Primitives","type":"application","recto":"Trouver une primitive : méthode ?","verso":"1. Identifier la forme (somme, produit, composée)\n2. Reconnaître u' à un facteur multiplicatif près\n3. Appliquer la formule correspondante\n4. Vérifier en dérivant.","tags":"primitive;methode","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.2 - Équations différentielles","type":"definition","recto":"Équation différentielle ?","verso":"Équation reliant une fonction y et ses dérivées (y', y'', ...). Résoudre = trouver toutes les fonctions y solutions.","tags":"ed;definition","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.2 - Équations différentielles","type":"law","recto":"Solutions de y' = a·y ?","verso":"Toutes les solutions sur ℝ sont :\ny(x) = C × e^(ax)  où C ∈ ℝ.\nSi y(x₀) = y₀ : solution unique avec C déterminé.","tags":"ed;y'=ay","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.2 - Équations différentielles","type":"law","recto":"Solutions de y' = a·y + b ?","verso":"y(x) = C × e^(ax) − b/a  où C ∈ ℝ.\nSolution particulière constante : y_p = −b/a.\nSolution générale = solution homogène + sol. particulière.","tags":"ed;y'=ay+b","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.2 - Équations différentielles","type":"method","recto":"Méthode de résolution y' = ay + f(x) ?","verso":"1. Solution générale de y' = ay : y_h = C·e^(ax)\n2. Trouver une solution particulière y_p\n3. Solution générale : y = y_h + y_p\n4. Si condition initiale, déterminer C.","tags":"ed;methode","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.2 - Équations différentielles","type":"application","recto":"Application physique des ED ?","verso":"Désintégration radioactive : N' = −λN → N(t) = N₀·e^(−λt)\nCharge d'un condensateur : RC·u' + u = E\nRefroidissement (Newton) : T' = −k(T − T_ext)","tags":"ed;applications","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"definition","recto":"Intégrale d'une fonction continue positive ?","verso":"Pour f ≥ 0 continue sur [a,b], ∫ₐᵇ f(x) dx = aire (en unités d'aire) entre la courbe, l'axe Ox et les droites x=a, x=b.","tags":"integrale;aire","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"definition","recto":"Intégrale (cas général) ?","verso":"Si F est une primitive de f sur [a,b] (f continue) :\n∫ₐᵇ f(x) dx = F(b) − F(a) = [F(x)]ₐᵇ.","tags":"integrale;primitive","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"formula","recto":"Linéarité de l'intégrale ?","verso":"∫(λf + μg) = λ∫f + μ∫g\nL'intégrale est LINÉAIRE.","tags":"integrale;linearite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"formula","recto":"Relation de Chasles ?","verso":"∫ₐᵇ f + ∫_b^c f = ∫ₐ^c f","tags":"integrale;chasles","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"formula","recto":"Inversion des bornes ?","verso":"∫ₐᵇ f(x) dx = − ∫_b^a f(x) dx","tags":"integrale;bornes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"formula","recto":"Positivité de l'intégrale ?","verso":"Si f ≥ 0 sur [a,b] avec a ≤ b : ∫ₐᵇ f ≥ 0.\nSi f ≤ g sur [a,b] : ∫ₐᵇ f ≤ ∫ₐᵇ g.","tags":"integrale;positivite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"formula","recto":"Valeur moyenne d'une fonction ?","verso":"μ = (1/(b−a)) × ∫ₐᵇ f(x) dx\nMoyenne intégrale de f sur [a,b].","tags":"integrale;moyenne","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"formula","recto":"Intégration par parties (IPP) ?","verso":"∫ₐᵇ u'(x)·v(x) dx = [u(x)·v(x)]ₐᵇ − ∫ₐᵇ u(x)·v'(x) dx","tags":"ipp","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"application","recto":"Quand utiliser l'IPP ?","verso":"Pour intégrer un produit où l'un des facteurs se simplifie en dérivant (ex. polynôme × eˣ, polynôme × ln, x·sin x).","tags":"ipp;application","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"application","recto":"Calcul d'aire entre 2 courbes ?","verso":"Si f ≥ g sur [a,b] : Aire = ∫ₐᵇ (f(x) − g(x)) dx.","tags":"integrale;aire-courbes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.3.3 - Intégrale","type":"application","recto":"Volume d'un solide de révolution ?","verso":"V = ∫ₐᵇ π × [f(x)]² dx (autour de Ox).\n(Hors programme strict mais classique.)","tags":"integrale;volume","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"definition","recto":"Vecteurs colinéaires ?","verso":"Deux vecteurs ⃗u, ⃗v sont colinéaires s'il existe k ∈ ℝ tel que ⃗v = k·⃗u.\n⃗0 est colinéaire à tout vecteur.","tags":"colinearite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"definition","recto":"Vecteurs coplanaires ?","verso":"Trois vecteurs sont coplanaires s'ils peuvent être placés dans un même plan.\n⃗w est combinaison linéaire de ⃗u, ⃗v : ⃗w = a⃗u + b⃗v.","tags":"coplanaires","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"definition","recto":"Base de l'espace ?","verso":"Triplet (⃗i, ⃗j, ⃗k) de vecteurs non coplanaires.\nTout vecteur s'écrit de manière unique : ⃗u = x⃗i + y⃗j + z⃗k.","tags":"base","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"definition","recto":"Repère orthonormé ?","verso":"Repère (O, ⃗i, ⃗j, ⃗k) où les 3 vecteurs sont orthogonaux deux à deux et de norme 1.","tags":"repere","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"formula","recto":"Coordonnées d'un vecteur ⃗AB ?","verso":"Si A(xₐ, yₐ, zₐ) et B(x_B, y_B, z_B) :\n⃗AB = (x_B − xₐ, y_B − yₐ, z_B − zₐ)","tags":"vecteur;coordonnees","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"formula","recto":"Distance entre deux points ?","verso":"AB = √((x_B − xₐ)² + (y_B − yₐ)² + (z_B − zₐ)²)","tags":"distance","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"formula","recto":"Représentation paramétrique d'une droite ?","verso":"(D) passant par A(xₐ, yₐ, zₐ) et de vecteur directeur ⃗u(a, b, c) :\nx = xₐ + t·a\ny = yₐ + t·b\nz = zₐ + t·c   (t ∈ ℝ)","tags":"droite;parametrique","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"formula","recto":"Équation cartésienne d'un plan ?","verso":"ax + by + cz + d = 0\n(a, b, c) sont les coordonnées d'un VECTEUR NORMAL au plan.","tags":"plan;cartesienne","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"application","recto":"Vérifier qu'un point appartient à un plan ?","verso":"Substituer ses coordonnées dans l'équation cartésienne. Si l'égalité est vraie, le point appartient au plan.","tags":"plan;appartenance","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.1 - Vecteurs, droites et plans dans l'espace","type":"application","recto":"Positions relatives de 2 droites dans l'espace ?","verso":"1. Confondues\n2. Strictement parallèles\n3. Sécantes (intersection = 1 point)\n4. Non coplanaires (gauches).","tags":"droites;positions","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"definition","recto":"Produit scalaire ⃗u · ⃗v ?","verso":"⃗u · ⃗v = ‖⃗u‖ × ‖⃗v‖ × cos(⃗u, ⃗v)","tags":"produit-scalaire;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"formula","recto":"Expression analytique en repère orthonormé ?","verso":"Si ⃗u(x, y, z) et ⃗v(x', y', z') :\n⃗u · ⃗v = x·x' + y·y' + z·z'","tags":"produit-scalaire;coord","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"formula","recto":"Norme d'un vecteur via produit scalaire ?","verso":"‖⃗u‖² = ⃗u · ⃗u\n‖⃗u‖ = √(x² + y² + z²)","tags":"norme","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"formula","recto":"Carré scalaire — identités remarquables ?","verso":"• ‖⃗u + ⃗v‖² = ‖⃗u‖² + 2·⃗u·⃗v + ‖⃗v‖²\n• ‖⃗u − ⃗v‖² = ‖⃗u‖² − 2·⃗u·⃗v + ‖⃗v‖²","tags":"norme;identites","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"application","recto":"Critère d'orthogonalité ?","verso":"⃗u ⊥ ⃗v ⟺ ⃗u · ⃗v = 0\n(deux vecteurs non nuls sont orthogonaux ssi leur produit scalaire est nul).","tags":"orthogonalite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"formula","recto":"Cosinus de l'angle entre 2 vecteurs ?","verso":"cos(⃗u, ⃗v) = (⃗u · ⃗v) / (‖⃗u‖ × ‖⃗v‖)","tags":"angle","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"formula","recto":"Distance d'un point à un plan ?","verso":"Distance de M(x₀, y₀, z₀) au plan d'équation ax + by + cz + d = 0 :\nd(M, P) = |a·x₀ + b·y₀ + c·z₀ + d| / √(a² + b² + c²)","tags":"distance;point-plan","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"application","recto":"Équation d'un plan passant par A et de vecteur normal ⃗n(a, b, c) ?","verso":"a(x − xₐ) + b(y − yₐ) + c(z − zₐ) = 0\nÀ développer : ax + by + cz + d = 0 avec d = −(a·xₐ + b·yₐ + c·zₐ).","tags":"plan;normale","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.4.2 - Produit scalaire dans l'espace","type":"application","recto":"Position relative de 2 plans ?","verso":"Comparer leurs vecteurs normaux ⃗n et ⃗n' :\n• colinéaires + 1 point commun → confondus\n• colinéaires sans point commun → parallèles\n• non colinéaires → sécants (intersection = droite).","tags":"plans;position","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"definition","recto":"Variable aléatoire (VA) ?","verso":"Application X : Ω → ℝ qui associe à chaque issue de l'expérience un nombre réel.","tags":"va;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"definition","recto":"Loi de probabilité d'une VA discrète ?","verso":"Liste des couples (xᵢ, P(X = xᵢ)) avec Σ P(X = xᵢ) = 1.","tags":"va;loi","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"formula","recto":"Espérance E(X) d'une VA discrète ?","verso":"E(X) = Σ xᵢ × P(X = xᵢ)\nC'est la « valeur moyenne » de X.","tags":"esperance","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"formula","recto":"Linéarité de l'espérance ?","verso":"E(aX + b) = a·E(X) + b\nE(X + Y) = E(X) + E(Y)  (toujours, même si X, Y non indépendantes).","tags":"esperance;linearite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"formula","recto":"Variance V(X) d'une VA discrète ?","verso":"V(X) = E((X − E(X))²) = E(X²) − E(X)²\nMesure la dispersion autour de E(X).","tags":"variance","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"formula","recto":"Écart-type σ(X) ?","verso":"σ(X) = √V(X)\nUnité de X, mesure la dispersion.","tags":"ecart-type","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"formula","recto":"Variance d'une transformation affine ?","verso":"V(aX + b) = a² × V(X)\nLa constante b ne change pas la variance.","tags":"variance;transformation","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.1 - Variables aléatoires (rappels)","type":"formula","recto":"Si X et Y INDÉPENDANTES ?","verso":"V(X + Y) = V(X) + V(Y)\nE(X·Y) = E(X) × E(Y)\n(Linéarité E toujours, V seulement si indépendance.)","tags":"independance;moments","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"definition","recto":"Épreuve de Bernoulli ?","verso":"Expérience aléatoire à 2 issues : succès (probabilité p) ou échec (probabilité 1−p = q).","tags":"bernoulli;epreuve","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"definition","recto":"Schéma de Bernoulli ?","verso":"Répétition de n épreuves de Bernoulli identiques et INDÉPENDANTES.\nVA X = nombre de succès parmi les n épreuves.","tags":"bernoulli;schema","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"definition","recto":"Loi binomiale B(n, p) ?","verso":"X suit B(n, p) si X = nb de succès dans un schéma de Bernoulli (n, p).\nX prend les valeurs 0, 1, ..., n.","tags":"binomiale;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"formula","recto":"P(X = k) pour X ~ B(n, p) ?","verso":"P(X = k) = (n k) × pᵏ × (1−p)^(n−k)\npour k = 0, 1, ..., n.","tags":"binomiale;formule","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"formula","recto":"Espérance et variance d'une loi binomiale ?","verso":"Si X ~ B(n, p) :\n• E(X) = n × p\n• V(X) = n × p × (1−p)\n• σ(X) = √(n·p·(1−p))","tags":"binomiale;moments","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"application","recto":"Conditions d'utilisation de la loi binomiale ?","verso":"1. Nombre fixe d'épreuves n\n2. 2 issues seulement (succès/échec)\n3. Probabilité p constante\n4. Épreuves INDÉPENDANTES.","tags":"binomiale;conditions","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"application","recto":"Calculer P(X ≤ k) pour X ~ B(n, p) ?","verso":"Avec la calculatrice : binomFRép(n, p, k) ou binomCDF(n, p, k).\nÀ la main : Σ_(i=0)^k (n i) pⁱ (1−p)^(n−i).","tags":"binomiale;cumulative","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.2 - Loi binomiale","type":"definition","recto":"Intervalle de fluctuation ?","verso":"Intervalle [a, b] dans lequel X (loi binomiale) tombe avec une probabilité ≥ 0,95.\nUtile pour la prise de décision.","tags":"fluctuation","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.3 - Loi des grands nombres","type":"law","recto":"Inégalité de Bienaymé-Tchebychev ?","verso":"Pour toute VA X ayant une espérance μ et un écart-type σ :\nP(|X − μ| ≥ a) ≤ V(X) / a²\n(pour a > 0).","tags":"bienayme-tchebychev","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.3 - Loi des grands nombres","type":"law","recto":"Inégalité de concentration (Tchebychev) ?","verso":"Pour Mₙ = (X₁ + ... + Xₙ)/n moyenne empirique :\nP(|Mₙ − μ| ≥ a) ≤ V(X) / (n × a²)\nPlus n est grand, plus Mₙ se concentre autour de μ.","tags":"concentration","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.3 - Loi des grands nombres","type":"law","recto":"Loi (faible) des grands nombres ?","verso":"lim_(n→+∞) P(|Mₙ − μ| ≥ ε) = 0  pour tout ε > 0.\nLa moyenne empirique converge vers l'espérance théorique.","tags":"lgn","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Spécialité","chapitre":"Ch.8.3 - Loi des grands nombres","type":"application","recto":"Conséquence pratique de la LGN ?","verso":"Plus on répète une expérience, plus la fréquence observée se rapproche de la probabilité théorique. Justifie l'estimation statistique.","tags":"lgn;application","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"definition","recto":"Nombre complexe ?","verso":"Nombre de la forme z = a + ib  où a, b ∈ ℝ et i² = −1.\n• a = Re(z) (partie réelle)\n• b = Im(z) (partie imaginaire)","tags":"complexe;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"definition","recto":"Conjugué d'un complexe ?","verso":"Si z = a + ib, alors z̄ = a − ib.\nProp. : z + z̄ = 2 Re(z), z − z̄ = 2i·Im(z), z·z̄ = a² + b² ≥ 0.","tags":"conjugue","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"formula","recto":"Module |z| ?","verso":"|z| = √(a² + b²) = √(z·z̄)\nDistance de M (image de z) à l'origine dans le plan complexe.","tags":"module","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"formula","recto":"Propriétés du module ?","verso":"• |z·z'| = |z| × |z'|\n• |z/z'| = |z|/|z'|\n• |zⁿ| = |z|ⁿ\n• |z̄| = |z|","tags":"module;proprietes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"formula","recto":"Forme trigonométrique ?","verso":"z = |z| × (cos θ + i·sin θ)\nθ = arg(z) (argument), défini modulo 2π.","tags":"trigonometrique","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"formula","recto":"Forme exponentielle ?","verso":"z = r × e^(iθ)  avec r = |z|, θ = arg(z).\n(Définition d'Euler : e^(iθ) = cos θ + i sin θ.)","tags":"exponentielle;complexe","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"formula","recto":"Formule de De Moivre ?","verso":"(cos θ + i sin θ)ⁿ = cos(nθ) + i sin(nθ)\nÉquivalent : (e^(iθ))ⁿ = e^(inθ).","tags":"de-moivre","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.1 - Nombres complexes — algèbre","type":"formula","recto":"Formules d'Euler ?","verso":"cos θ = (e^(iθ) + e^(−iθ)) / 2\nsin θ = (e^(iθ) − e^(−iθ)) / (2i)","tags":"euler;formules","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.4 - Polynômes complexes","type":"formula","recto":"Discriminant d'un polynôme du 2ⁿᵈ degré ?","verso":"Δ = b² − 4ac\n• Δ > 0 : 2 racines réelles\n• Δ = 0 : 1 racine double\n• Δ < 0 : 2 racines complexes conjuguées : (−b ± i√|Δ|)/(2a).","tags":"discriminant","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.4 - Polynômes complexes","type":"law","recto":"Théorème fondamental de l'algèbre ?","verso":"Tout polynôme de degré n ≥ 1 à coefficients complexes admet exactement n racines dans ℂ (comptées avec multiplicité).","tags":"fondamental-algebre","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.5.4 - Polynômes complexes","type":"definition","recto":"Racine n-ième de l'unité ?","verso":"Solutions de zⁿ = 1 dans ℂ. Au nombre de n : zₖ = e^(2ikπ/n) pour k = 0, 1, ..., n−1.","tags":"racine-unite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.1 - Divisibilité dans ℤ","type":"definition","recto":"Divisibilité dans ℤ ?","verso":"a divise b (noté a | b) s'il existe k ∈ ℤ tel que b = a·k.\n(a est diviseur de b, b est multiple de a.)","tags":"divisibilite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.1 - Divisibilité dans ℤ","type":"law","recto":"Division euclidienne ?","verso":"Pour tout (a, b) ∈ ℤ × ℕ* :\n∃! (q, r) tels que a = b·q + r avec 0 ≤ r < b.\n• q : quotient\n• r : reste","tags":"division-euclidienne","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.2 - Congruences modulo n","type":"definition","recto":"Congruence modulo n ?","verso":"a ≡ b (mod n) ⟺ n | (a − b)\nÉquivalent : a et b ont même reste dans la division par n.","tags":"congruence;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.2 - Congruences modulo n","type":"formula","recto":"Propriétés des congruences ?","verso":"Si a ≡ b (mod n) et c ≡ d (mod n) :\n• a + c ≡ b + d (mod n)\n• a × c ≡ b × d (mod n)\n• aᵏ ≡ bᵏ (mod n)","tags":"congruence;proprietes","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.3 - PGCD, Bézout, Gauss","type":"definition","recto":"PGCD de a et b ?","verso":"Plus Grand Commun Diviseur. Noté pgcd(a,b) ou a∧b.\nCaractérisation : c'est le plus grand entier qui divise à la fois a et b.","tags":"pgcd","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.3 - PGCD, Bézout, Gauss","type":"method","recto":"Algorithme d'Euclide ?","verso":"Pour calculer pgcd(a, b) avec a ≥ b > 0 :\n• Faire division euclidienne : a = b·q + r\n• Si r = 0 : pgcd = b\n• Sinon : pgcd(a, b) = pgcd(b, r). Itérer.","tags":"euclide","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.3 - PGCD, Bézout, Gauss","type":"law","recto":"Théorème de Bézout ?","verso":"pgcd(a, b) = d ⟺ ∃ u, v ∈ ℤ tels que a·u + b·v = d.\nCas particulier (a, b premiers entre eux) : ∃ u, v tq a·u + b·v = 1.","tags":"bezout","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.3 - PGCD, Bézout, Gauss","type":"definition","recto":"Premiers entre eux ?","verso":"a et b sont premiers entre eux ⟺ pgcd(a, b) = 1.","tags":"premiers-entre-eux","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.3 - PGCD, Bézout, Gauss","type":"law","recto":"Théorème de Gauss ?","verso":"Si a | b·c et pgcd(a, b) = 1, alors a | c.\nIndispensable en arithmétique modulaire.","tags":"gauss","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.5 - Nombres premiers","type":"definition","recto":"Nombre premier ?","verso":"Entier n ≥ 2 dont les seuls diviseurs positifs sont 1 et n.\nEx. : 2, 3, 5, 7, 11, 13, ...","tags":"premier","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.5 - Nombres premiers","type":"law","recto":"Théorème fondamental de l'arithmétique ?","verso":"Tout entier n ≥ 2 s'écrit de manière UNIQUE (à l'ordre près) comme produit de nombres premiers : n = p₁^α₁ × ... × pₖ^αₖ.","tags":"decomposition","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.6.5 - Nombres premiers","type":"law","recto":"Petit théorème de Fermat ?","verso":"Si p premier et a ∈ ℤ avec pgcd(a, p) = 1 :\na^(p−1) ≡ 1 (mod p).\nForme alternative : aᵖ ≡ a (mod p) pour tout a.","tags":"fermat;petit","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.1 - Matrices","type":"definition","recto":"Matrice n × p ?","verso":"Tableau rectangulaire à n lignes et p colonnes.\nÉlément à la ligne i, colonne j : a_(ij).","tags":"matrice;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.1 - Matrices","type":"formula","recto":"Produit de deux matrices ?","verso":"(A × B)_(ij) = Σ_(k=1)^p a_(ik) × b_(kj)\nA est n×p, B est p×q : produit possible, résultat n×q.\nLe produit n'est PAS commutatif.","tags":"produit-matriciel","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.1 - Matrices","type":"definition","recto":"Matrice identité I_n ?","verso":"Matrice carrée n×n avec 1 sur la diagonale, 0 ailleurs.\nElement neutre : A × I = I × A = A.","tags":"identite","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.1 - Matrices","type":"definition","recto":"Matrice inversible ?","verso":"Matrice carrée A inversible ⟺ ∃ B telle que A × B = B × A = I.\nB = A⁻¹.\nUne matrice est inversible ⟺ son déterminant est non nul.","tags":"inversible","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"definition","recto":"Graphe ?","verso":"Couple G = (S, A) où S est un ensemble de sommets et A un ensemble d'arêtes (paires de sommets).","tags":"graphe;def","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"definition","recto":"Graphe orienté / non orienté ?","verso":"• Non orienté : arêtes (paires non ordonnées)\n• Orienté : arcs (paires ordonnées, flèches).","tags":"graphe;types","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"definition","recto":"Degré d'un sommet ?","verso":"Nombre d'arêtes incidentes à ce sommet (graphe non orienté).\nDans un graphe orienté : degré entrant + degré sortant.","tags":"degre","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"definition","recto":"Matrice d'adjacence ?","verso":"Matrice M où M_(ij) = nombre d'arêtes (ou arcs) du sommet i au sommet j.\nSymétrique pour un graphe non orienté.","tags":"adjacence","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"application","recto":"Puissances de la matrice d'adjacence ?","verso":"(Mᵏ)_(ij) = nombre de chemins de longueur k allant du sommet i au sommet j.","tags":"matrice;chemins","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"definition","recto":"Chaîne de Markov ?","verso":"Suite d'états où la probabilité de transition d'un état à l'autre ne dépend QUE de l'état actuel (pas du passé).\nReprésentée par une matrice stochastique.","tags":"markov","niveau":"Terminale","matiere":"Maths"},{"deck":"Maths Terminale Expertes (bonus)","chapitre":"Ch.7.2 - Graphes","type":"definition","recto":"État stable d'une chaîne de Markov ?","verso":"Distribution π telle que π × M = π. Si elle existe et est unique, la chaîne y converge à long terme.","tags":"markov;stable","niveau":"Terminale","matiere":"Maths"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Formule reliant le nombre d'entités N(X), la quantité de matière n(X) et N_A ?","verso":"N(X) = n(X) × N_A\n• N(X) : nombre d'entités (sans unité)\n• n(X) : quantité de matière (mol)\n• N_A : constante d'Avogadro ≈ 6,02 × 10²³ mol⁻¹","tags":"avogadro;mole","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Quantité de matière à partir de la masse ?","verso":"n(X) = m(X) / M(X)\n• n : quantité de matière (mol)\n• m : masse (g)\n• M : masse molaire (g·mol⁻¹)","tags":"mole;masse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Quantité de matière d'un gaz à partir du volume ?","verso":"n(X) = V(X) / V_m\n• V_m : volume molaire (L·mol⁻¹), indépendant du gaz\n• Dans les CNTP : V_m ≈ 22,4 L·mol⁻¹","tags":"gaz;volume-molaire","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Masse molaire d'une molécule A_a B_b ?","verso":"M(A_a B_b) = a × M(A) + b × M(B)\nSomme pondérée des masses molaires atomiques.","tags":"masse-molaire","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Pourcentage massique P_m d'une espèce X ?","verso":"P_m(X) = m(X) / m_tot\nFraction de la masse totale occupée par X (entre 0 et 1, souvent en %).","tags":"concentration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Pourcentage volumique P_v ?","verso":"P_v(X) = V(X) / V_tot\nFraction du volume occupée par X (entre 0 et 1).","tags":"concentration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Définition de la masse volumique ρ ?","verso":"ρ(X) = m(X) / V(X)\nUnités usuelles : g·L⁻¹, g·mL⁻¹, kg·L⁻¹.","tags":"masse-volumique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Densité d(X) en fonction de la masse volumique ?","verso":"d(X) = ρ(X) / ρ(eau)\nGrandeur sans unité.","tags":"densite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Solution saturée ?","verso":"Solution dans laquelle le soluté introduit n'est pas totalement dissous.","tags":"solution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Concentration en masse t(X) ?","verso":"t(X) = m(X) / V_sol  (g·L⁻¹)\nLien avec C : t(X) = C(X) × M(X)","tags":"concentration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Concentration en quantité de matière C(X) ?","verso":"C(X) = n(X) / V_sol   (mol·L⁻¹)","tags":"concentration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Titre massique W(X) ?","verso":"W(X) = m(X) / m_solution\nMasse de soluté dissous / masse totale de solution. Sans unité, souvent en %.","tags":"concentration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"method","recto":"Protocole de dissolution (5 étapes) ?","verso":"1. Peser m(X) g de soluté (balance, spatule, verre de montre)\n2. Introduire dans la fiole jaugée via entonnoir\n3. Remplir aux 2/3 avec eau distillée\n4. Homogénéiser\n5. Compléter au trait de jauge, puis homogénéiser.","tags":"protocole;dissolution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"method","recto":"Protocole de dilution ?","verso":"1. Prélever V_mère mL de solution mère à la pipette jaugée\n2. Verser dans une fiole jaugée de V_fille mL\n3. Remplir aux 2/3, homogénéiser\n4. Compléter au trait de jauge, homogénéiser.","tags":"protocole;dilution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"formula","recto":"Facteur de dilution F ?","verso":"F = C_mère / C_fille = V_fille / V_mère\nF est toujours > 1.","tags":"dilution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Oxydant ?","verso":"Espèce chimique capable de capter un ou plusieurs électrons.","tags":"redox","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Réducteur ?","verso":"Espèce chimique capable de céder un ou plusieurs électrons.","tags":"redox","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Couple oxydant/réducteur ?","verso":"Deux espèces conjuguées Ox et Red reliées par une demi-équation rédox : Ox + n e⁻ ⇌ Red.","tags":"redox;couple","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"method","recto":"4 étapes pour équilibrer une demi-équation rédox ?","verso":"1. Équilibrer tous les éléments sauf O et H\n2. Équilibrer O en ajoutant H₂O\n3. Équilibrer H en ajoutant H⁺\n4. Équilibrer les charges en ajoutant des e⁻ côté oxydant.","tags":"redox;methode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Avancement d'une réaction (x) ?","verso":"Grandeur (en mol) qui caractérise l'évolution d'une transformation. Initial x=0, augmente jusqu'à x_max ou x_f.","tags":"avancement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A0 - Bases de chimie","type":"definition","recto":"Réactif limitant ?","verso":"Réactif totalement consommé en premier ; il fixe la valeur de l'avancement maximal x_max.","tags":"avancement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Acide selon Brönsted-Lowry ?","verso":"Espèce chimique susceptible de céder un ion hydrogène H⁺ (proton).\nAH → A⁻ + H⁺","tags":"acide-base;bronsted","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Base selon Brönsted-Lowry ?","verso":"Espèce chimique susceptible de capter un ion hydrogène H⁺.\nNécessite un doublet non liant.\nB + H⁺ → BH⁺","tags":"acide-base;bronsted","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Polyacide / polybase ?","verso":"Polyacide : peut céder plusieurs H⁺ (ex. H₂SO₄, H₃PO₄).\nPolybase : peut capter plusieurs H⁺ (ex. CO₃²⁻, PO₄³⁻).","tags":"acide-base","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Ampholyte (espèce amphotère) ?","verso":"Espèce qui peut se comporter comme un acide OU comme une base.\nExemple : l'eau (H₂O / HO⁻ et H₃O⁺ / H₂O).","tags":"acide-base;amphotere","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Couples de l'eau (à connaître) ?","verso":"• H₃O⁺ / H₂O  : H₂O + H⁺ → H₃O⁺ (ion oxonium)\n• H₂O / HO⁻  : H₂O → HO⁻ + H⁺ (ion hydroxyde)","tags":"acide-base;eau","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"formula","recto":"Définition du pH ?","verso":"pH = −log([H₃O⁺] / C°)  avec C° = 1 mol·L⁻¹\nGrandeur sans unité.\n→ [H₃O⁺] = C° × 10^(−pH)","tags":"pH","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"application","recto":"Limite d'utilisation de la formule du pH ?","verso":"Valable uniquement pour [H₃O⁺] < 10⁻² mol·L⁻¹.","tags":"pH;limite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"application","recto":"Plus le pH est petit, plus...","verso":"...la concentration en ions oxonium [H₃O⁺] est élevée (solution acide).","tags":"pH","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"method","recto":"Mesure du pH : papier pH vs pH-mètre ?","verso":"• Papier pH : rapide mais approximatif (entier)\n• pH-mètre : précis (1 décimale), nécessite étalonnage à pH=4 et pH=7, agitation.","tags":"pH;mesure","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"formula","recto":"Taux d'avancement final τ_f ?","verso":"τ_f = x_f / x_max\nSans unité, entre 0 et 1 (souvent en %).\n• τ_f < 1 : transformation NON totale\n• τ_f = 1 : transformation totale","tags":"avancement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Acide fort dans l'eau ?","verso":"Acide dont la transformation avec l'eau est TOTALE (τ_f = 1).\nEx. : HCl, HNO₃.","tags":"acide-base;force","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Acide faible dans l'eau ?","verso":"Acide dont la transformation avec l'eau est NON totale (τ_f < 1).\nEx. : acide éthanoïque CH₃COOH.","tags":"acide-base;force","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Autoprotolyse de l'eau ?","verso":"Transformation acido-basique non totale entre deux molécules d'eau :\n2 H₂O ⇌ H₃O⁺ + HO⁻","tags":"autoprotolyse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Couple acide carboxylique ?","verso":"RCOOH (acide) / RCOO⁻ (ion carboxylate, base).\nL'H acide est porté par le groupe carboxyle.","tags":"acide-base;organique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A1 - Transformations acido-basiques et pH","type":"definition","recto":"Couple amine ?","verso":"R₁R₂R₃NH⁺ (ion ammonium, acide) / R₁R₂R₃N (amine, base).","tags":"acide-base;amine","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"formula","recto":"pH d'une solution d'acide fort de concentration C ?","verso":"pH = −log(C / C°)\n[H₃O⁺]_f = C","tags":"pH;acide-fort","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"formula","recto":"pH d'une solution de base forte de concentration C ?","verso":"pH = pKe + log(C / C°)\n[HO⁻]_f = C","tags":"pH;base-forte","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"definition","recto":"Produit ionique de l'eau Ke ?","verso":"Ke = [H₃O⁺] × [HO⁻] / C°² ≈ 10⁻¹⁴ à 25°C.\npKe = −log(Ke) = 14.","tags":"pH;Ke","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"formula","recto":"Constante d'acidité K_A ?","verso":"K_A = [A⁻]_eq × [H₃O⁺]_eq / ([AH]_eq × C°)\npK_A = −log(K_A)","tags":"Ka;equilibre","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"formula","recto":"Relation d'Henderson ?","verso":"pH = pK_A + log([A⁻]_eq / [AH]_eq)\nLien direct entre pH et le rapport base/acide.","tags":"Ka;henderson","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Comparaison de la force des acides ?","verso":"Plus un acide est fort dans l'eau :\n• plus son pK_A est FAIBLE\n• plus son K_A est ÉLEVÉ\n• plus sa base conjuguée est faible.","tags":"Ka;force","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Échelle des pK_A bornée par les couples de l'eau ?","verso":"• Acide le + fort dans l'eau : H₃O⁺  (pK_A = 0)\n• Base la + forte : HO⁻      (pK_A = 14)","tags":"Ka","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Diagramme de prédominance : si pH > pK_A ?","verso":"[A⁻] > [AH] : la base A⁻ prédomine.","tags":"diagramme;predominance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Diagramme de prédominance : si pH < pK_A ?","verso":"[AH] > [A⁻] : l'acide AH prédomine.","tags":"diagramme;predominance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Diagramme de prédominance : si pH = pK_A ?","verso":"[AH] = [A⁻] : les deux espèces sont en concentrations égales.","tags":"diagramme;predominance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"formula","recto":"Pourcentage de la forme acide P(AH) ?","verso":"P(AH) = 1 / (1 + 10^(pH − pK_A))","tags":"diagramme;distribution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"formula","recto":"Pourcentage de la forme basique P(A⁻) ?","verso":"P(A⁻) = 10^(pH − pK_A) / (1 + 10^(pH − pK_A))","tags":"diagramme;distribution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"definition","recto":"Acide α-aminé ?","verso":"Molécule possédant deux groupes caractéristiques (carboxyle −COOH et amine −NH₂) portés par le même carbone α.","tags":"acide-amine","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"definition","recto":"Amphion (zwitterion) ?","verso":"Forme dipolaire d'un acide α-aminé en solution aqueuse : ⁺H₃N−CHR−COO⁻.\nL'amphion est un ampholyte (2 pK_A).","tags":"acide-amine;amphion","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"definition","recto":"Indicateur coloré acido-basique ?","verso":"Couple IndH/Ind⁻ dont les espèces conjuguées ont des couleurs différentes. Change de couleur selon le pH.","tags":"indicateur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"definition","recto":"Zone de virage d'un indicateur coloré ?","verso":"Intervalle de pH compris entre pK_A − 1 et pK_A + 1 où la couleur change (teinte sensible).","tags":"indicateur;virage","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Choix d'un indicateur pour un dosage ?","verso":"Sa zone de virage doit contenir le pH à l'équivalence.","tags":"indicateur;dosage","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"definition","recto":"Solution tampon ?","verso":"Solution dont le pH varie peu par ajout modéré d'acide/base ou par dilution. Mélange d'un acide faible + sa base conjuguée à pH ≈ pK_A.","tags":"tampon","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"Exemple de tampon physiologique ?","verso":"Le sang humain : couple H₂CO₃ / HCO₃⁻ maintient le pH entre 7,35 et 7,45.","tags":"tampon;sang","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A2 - Acide-base et applications","type":"application","recto":"À la demi-équivalence d'un titrage acide faible/base forte ?","verso":"[AH] = [A⁻], donc pH = pK_A.","tags":"titrage;demi-equivalence","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"definition","recto":"Absorbance A ?","verso":"Grandeur sans unité caractérisant l'aptitude d'une espèce colorée à absorber une radiation lumineuse de longueur d'onde donnée. Mesurée au spectrophotomètre. Grandeur ADDITIVE.","tags":"absorbance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"formula","recto":"Loi de Beer-Lambert ?","verso":"A = ε_λ × ℓ × C(X)\n• A : absorbance (sans unité)\n• ε_λ : coefficient d'absorption molaire (L·mol⁻¹·cm⁻¹)\n• ℓ : épaisseur de la cuve (cm)\n• C(X) : concentration (mol·L⁻¹)","tags":"beer-lambert","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"application","recto":"Conditions de validité de la loi de Beer-Lambert ?","verso":"• Lumière monochromatique\n• Solution diluée\n• Solution non fluorescente, non diffusante.","tags":"beer-lambert;limite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"method","recto":"Détermination d'une concentration inconnue par étalonnage ?","verso":"1. Préparer plusieurs solutions étalons de concentrations connues\n2. Mesurer leur absorbance à λ_max\n3. Tracer la droite A = f(C)\n4. Mesurer A_x de la solution inconnue → en déduire C_x.","tags":"beer-lambert;methode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"definition","recto":"Spectroscopie UV-visible ?","verso":"Mesure de l'absorbance en fonction de la longueur d'onde dans le domaine 200–800 nm. Permet d'identifier des espèces et déterminer des concentrations.","tags":"uv-visible","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"definition","recto":"Spectroscopie IR ?","verso":"Spectroscopie infrarouge. Mesure la transmittance T en fonction du nombre d'onde σ (cm⁻¹). Identifie les groupes caractéristiques par leurs bandes d'absorption.","tags":"ir","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"application","recto":"Bandes IR caractéristiques à connaître ?","verso":"• O−H alcool (large) : 3200–3600 cm⁻¹\n• O−H acide carboxylique (très large) : 2500–3300 cm⁻¹\n• N−H amine : 3300–3500 cm⁻¹\n• C=O : 1650–1740 cm⁻¹\n• C−H : 2800–3100 cm⁻¹","tags":"ir;bandes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"definition","recto":"Spectroscopie RMN ?","verso":"Résonance Magnétique Nucléaire du proton (¹H). Donne la structure d'une molécule organique via le déplacement chimique δ (ppm), la multiplicité et la courbe d'intégration.","tags":"rmn","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"definition","recto":"Déplacement chimique δ en RMN ?","verso":"Position d'un signal sur le spectre RMN, exprimée en ppm. Dépend de l'environnement chimique du proton.","tags":"rmn;deplacement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"application","recto":"Règle des (n+1) en RMN ?","verso":"Un proton ayant n protons voisins équivalents donne un signal divisé en (n+1) pics (multiplicité).","tags":"rmn;multiplicite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"application","recto":"Courbe d'intégration en RMN ?","verso":"La hauteur des paliers est proportionnelle au nombre de protons équivalents responsables de chaque signal.","tags":"rmn;integration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"definition","recto":"Conductance G ?","verso":"Aptitude d'une portion de solution à conduire le courant. G = 1/R, en siemens (S).","tags":"conductance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"formula","recto":"Conductivité σ d'une solution ?","verso":"σ = Σ λ_i × [X_i]\n• σ : conductivité (S·m⁻¹)\n• λ_i : conductivité molaire ionique (S·m²·mol⁻¹)\n• [X_i] : concentration en ions (mol·m⁻³)","tags":"conductivite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A3 - Méthodes physiques d'analyse","type":"formula","recto":"Lien G − σ avec une cellule de constante k ?","verso":"G = σ × k  où k = S/L (S = surface, L = distance entre électrodes).","tags":"conductance;cellule","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"definition","recto":"Dosage par titrage ?","verso":"Méthode pour déterminer la quantité (ou concentration) d'une espèce à doser en la faisant réagir totalement avec une solution titrante de concentration connue.","tags":"titrage","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"definition","recto":"Réaction support de titrage ?","verso":"Réaction qui doit être : TOTALE, RAPIDE et UNIQUE.","tags":"titrage;support","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"definition","recto":"Équivalence d'un titrage ?","verso":"État du système chimique où les réactifs ont été introduits dans les proportions stœchiométriques de la réaction support.","tags":"titrage;equivalence","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"application","recto":"À l'équivalence (réaction 1:1) ?","verso":"n_titré = n_titrant_versé\nC_titré × V_titré = C_titrant × V_E","tags":"titrage;equivalence","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"method","recto":"Méthodes pour repérer l'équivalence ?","verso":"• Colorimétrique : changement de couleur (indicateur ou réactif)\n• pH-métrique : saut de pH\n• Conductimétrique : rupture de pente.","tags":"titrage;methode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"definition","recto":"Titrage colorimétrique ?","verso":"Repérage de l'équivalence par changement de couleur (soit l'un des réactifs/produits change de couleur, soit on ajoute un indicateur coloré).","tags":"titrage;colorimetrie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A4 - Dosage par titrage","type":"application","recto":"Verrerie pour un titrage précis ?","verso":"• Burette graduée pour le titrant\n• Pipette jaugée pour le titré\n• Bécher + barreau aimanté + agitateur magnétique.","tags":"titrage;verrerie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A5 - Dosage par titrage pH-métrique","type":"definition","recto":"Titrage pH-métrique ?","verso":"Titrage avec suivi du pH au pH-mètre en fonction du volume de titrant versé. L'équivalence correspond au saut de pH.","tags":"pH-metrie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A5 - Dosage par titrage pH-métrique","type":"method","recto":"Méthode des tangentes parallèles ?","verso":"1. Tracer deux tangentes parallèles à la courbe pH = f(V) de part et d'autre du saut\n2. Tracer la parallèle équidistante\n3. L'intersection avec la courbe donne V_E.","tags":"pH-metrie;tangentes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A5 - Dosage par titrage pH-métrique","type":"method","recto":"Méthode de la dérivée ?","verso":"Tracer dpH/dV en fonction de V. L'extremum (pic) correspond au volume équivalent V_E.","tags":"pH-metrie;derivee","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A5 - Dosage par titrage pH-métrique","type":"application","recto":"Allure d'un titrage acide fort par base forte ?","verso":"pH_initial bas (~1), saut net autour de pH = 7 à l'équivalence, pH final élevé (~13).","tags":"pH-metrie;courbe","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A5 - Dosage par titrage pH-métrique","type":"application","recto":"Allure d'un titrage acide faible par base forte ?","verso":"pH_initial > 1, saut autour de pH > 7, à la demi-équivalence pH = pK_A.","tags":"pH-metrie;courbe","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A6 - Dosage par titrage conductimétrique","type":"definition","recto":"Titrage conductimétrique ?","verso":"Titrage avec suivi de la conductivité σ (ou conductance G) en fonction du volume versé. L'équivalence correspond à une rupture de pente.","tags":"conductimetrie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A6 - Dosage par titrage conductimétrique","type":"application","recto":"Pourquoi diluer la solution avant titrage conductimétrique ?","verso":"Pour que la dilution due à l'ajout du titrant soit négligeable et que les variations de σ ne dépendent que des changements de quantité d'ions.","tags":"conductimetrie;dilution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A6 - Dosage par titrage conductimétrique","type":"application","recto":"Dans un titrage conductimétrique, on s'intéresse aux pentes : pourquoi ?","verso":"Avant et après l'équivalence, σ varie linéairement avec V. La rupture de pente repère V_E.","tags":"conductimetrie;pente","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A6 - Dosage par titrage conductimétrique","type":"application","recto":"Conductivités molaires ioniques utiles à connaître ?","verso":"λ(H₃O⁺) ≈ 35 mS·m²·mol⁻¹ (très grande)\nλ(HO⁻) ≈ 19,9 mS·m²·mol⁻¹ (grande)\nλ(Na⁺) ≈ 5,0\nλ(Cl⁻) ≈ 7,6","tags":"conductimetrie;valeurs","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"definition","recto":"Cinétique chimique ?","verso":"Étude de la vitesse des transformations chimiques.","tags":"cinetique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"definition","recto":"Transformation rapide / lente ?","verso":"• Rapide : durée < quelques secondes (ex. réactions acide-base)\n• Lente : durée mesurable (ex. oxydation)\n• Infiniment lente : pas d'évolution observable.","tags":"cinetique;duree","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"definition","recto":"Facteur cinétique ?","verso":"Paramètre influant sur la vitesse d'une réaction sans modifier l'état final : concentration des réactifs, température, surface de contact, solvant, lumière.","tags":"cinetique;facteur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"application","recto":"Effet de la température sur la vitesse ?","verso":"Augmenter la température augmente la vitesse (en moyenne ×2 pour +10 °C). Diminuer la température ralentit (utile pour conserver, faire un trempage = quench).","tags":"cinetique;temperature","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"application","recto":"Effet de la concentration ?","verso":"Augmenter la concentration des réactifs augmente la vitesse.","tags":"cinetique;concentration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"definition","recto":"Catalyseur ?","verso":"Espèce qui accélère une réaction sans apparaître dans l'équation bilan. Il est régénéré à la fin et ne modifie pas l'état final.","tags":"cinetique;catalyseur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A7 - Cinétique chimique : aspect qualitatif","type":"definition","recto":"Catalyse homogène / hétérogène / enzymatique ?","verso":"• Homogène : catalyseur dans la même phase que les réactifs\n• Hétérogène : phases différentes (ex. Pt solide / gaz)\n• Enzymatique : par des enzymes (très spécifiques).","tags":"cinetique;catalyseur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A8 - Cinétique chimique : aspect quantitatif","type":"formula","recto":"Vitesse volumique d'apparition d'un produit P ?","verso":"v(P) = (1/V) × dn(P)/dt = d[P]/dt   (mol·L⁻¹·s⁻¹)","tags":"vitesse;produit","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A8 - Cinétique chimique : aspect quantitatif","type":"formula","recto":"Vitesse volumique de disparition d'un réactif R ?","verso":"v(R) = −(1/V) × dn(R)/dt = −d[R]/dt   (mol·L⁻¹·s⁻¹)","tags":"vitesse;reactif","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A8 - Cinétique chimique : aspect quantitatif","type":"formula","recto":"Vitesse volumique de réaction ?","verso":"Pour aA + bB → cC + dD :\nv = (1/V) × dx/dt = −(1/a) × d[A]/dt = (1/c) × d[C]/dt","tags":"vitesse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A8 - Cinétique chimique : aspect quantitatif","type":"definition","recto":"Temps de demi-réaction t₁/₂ ?","verso":"Durée nécessaire pour que l'avancement atteigne la moitié de sa valeur finale : x(t₁/₂) = x_f / 2.","tags":"demi-reaction","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A8 - Cinétique chimique : aspect quantitatif","type":"application","recto":"Détermination de t₁/₂ graphiquement ?","verso":"Lire sur la courbe x = f(t) ou [R] = f(t) la date à laquelle x = x_f / 2 (ou [R] a diminué de moitié).","tags":"demi-reaction;graphique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A8 - Cinétique chimique : aspect quantitatif","type":"application","recto":"Méthode pour suivre une cinétique en TP ?","verso":"• Spectrophotométrie : suivre l'absorbance d'une espèce colorée\n• Conductimétrie : suivre σ\n• Dosage par prélèvement : titrer à différentes dates (avec quench).","tags":"cinetique;suivi","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A9 - Loi de vitesse d'ordre 1","type":"definition","recto":"Réaction d'ordre 1 par rapport à un réactif R ?","verso":"Réaction dont la vitesse est proportionnelle à [R] : v = k × [R].\nk : constante de vitesse (s⁻¹ pour ordre 1).","tags":"ordre-1","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A9 - Loi de vitesse d'ordre 1","type":"formula","recto":"Équation différentielle d'ordre 1 ?","verso":"d[R]/dt = −k × [R]\nLa solution est : [R](t) = [R]₀ × exp(−k t)","tags":"ordre-1;solution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A9 - Loi de vitesse d'ordre 1","type":"formula","recto":"Temps de demi-réaction pour une cinétique d'ordre 1 ?","verso":"t₁/₂ = ln(2) / k\nIndépendant de la concentration initiale (caractéristique de l'ordre 1).","tags":"ordre-1;demi-reaction","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A9 - Loi de vitesse d'ordre 1","type":"application","recto":"Comment vérifier qu'une réaction est d'ordre 1 ?","verso":"Tracer ln([R]) en fonction de t : si la courbe est une droite de pente −k, alors ordre 1.","tags":"ordre-1;verification","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A9 - Loi de vitesse d'ordre 1","type":"application","recto":"Allure de [R] = f(t) pour une réaction d'ordre 1 ?","verso":"Décroissance exponentielle vers 0.","tags":"ordre-1;allure","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Notation d'un noyau ?","verso":"ᴬ_Z X\n• A : nombre de masse (= protons + neutrons)\n• Z : numéro atomique (= nombre de protons)\n• N = A − Z : nombre de neutrons.","tags":"noyau;notation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Isotopes ?","verso":"Noyaux ayant le même Z mais des A différents (mêmes protons, neutrons différents).\nEx. ¹²C, ¹³C, ¹⁴C.","tags":"isotopes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Radioactivité ?","verso":"Phénomène par lequel un noyau instable se transforme spontanément en un autre noyau, en émettant un rayonnement (α, β, γ).","tags":"radioactivite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Radioactivité α ?","verso":"Émission d'un noyau d'hélium ⁴₂He.\nÉquation : ᴬ_Z X → ᴬ⁻⁴_(Z−2) Y + ⁴₂He","tags":"alpha","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Radioactivité β⁻ ?","verso":"Un neutron se transforme en proton, émission d'un électron ⁰₋₁e.\nᴬ_Z X → ᴬ_(Z+1) Y + ⁰₋₁e","tags":"beta-moins","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Radioactivité β⁺ ?","verso":"Un proton se transforme en neutron, émission d'un positon ⁰₊₁e.\nᴬ_Z X → ᴬ_(Z−1) Y + ⁰₊₁e","tags":"beta-plus","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Rayonnement γ ?","verso":"Émission d'un photon de très haute énergie (rayon γ) par un noyau dans un état excité qui se désexcite.","tags":"gamma","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"application","recto":"Lois de conservation de Soddy ?","verso":"Lors d'une désintégration radioactive : conservation du nombre de masse A et du nombre de charge Z.","tags":"soddy","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"formula","recto":"Énergie de masse d'un noyau ?","verso":"E = m × c²\n• E : énergie (J)\n• m : masse (kg)\n• c ≈ 3,00 × 10⁸ m·s⁻¹","tags":"einstein;e=mc2","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Défaut de masse Δm ?","verso":"Δm = Z × m_p + N × m_n − m_noyau\nLa masse du noyau est inférieure à la somme des masses de ses nucléons. Δm > 0.","tags":"defaut-masse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"formula","recto":"Énergie de liaison d'un noyau ?","verso":"E_l = Δm × c²\nÉnergie qu'il faudrait fournir pour dissocier le noyau en ses nucléons.","tags":"energie-liaison","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"application","recto":"Énergie de liaison par nucléon E_l/A ?","verso":"Indicateur de stabilité du noyau. Plus E_l/A est grande, plus le noyau est stable. Maximum vers A ≈ 56 (fer).","tags":"stabilite-noyau","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Fission nucléaire ?","verso":"Un noyau lourd absorbe un neutron et se scinde en deux noyaux plus légers + neutrons + énergie.\nEx. : ²³⁵U + n → ¹⁴⁴Ba + ⁸⁹Kr + 3 n.","tags":"fission","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A10 - Noyaux et radioactivité","type":"definition","recto":"Fusion nucléaire ?","verso":"Deux noyaux légers fusionnent en un noyau plus lourd + énergie.\nEx. : ²H + ³H → ⁴He + n. (Réaction du Soleil.)","tags":"fusion","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"definition","recto":"Activité d'un échantillon radioactif ?","verso":"A(t) = nombre de désintégrations par seconde, en becquerels (Bq).\nA(t) = λ × N(t)","tags":"activite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"definition","recto":"Constante radioactive λ ?","verso":"Probabilité par unité de temps qu'un noyau se désintègre. Caractéristique de chaque isotope. Unité : s⁻¹.","tags":"lambda","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"formula","recto":"Loi de décroissance radioactive ?","verso":"N(t) = N₀ × exp(−λ t)\n• N(t) : nombre de noyaux à l'instant t\n• N₀ : nombre initial\n• λ : constante radioactive (s⁻¹)","tags":"decroissance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"formula","recto":"Demi-vie t₁/₂ ?","verso":"t₁/₂ = ln(2) / λ\nDurée au bout de laquelle la moitié des noyaux s'est désintégrée. Indépendante de N₀.","tags":"demi-vie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"application","recto":"Après n demi-vies, combien reste-t-il de noyaux ?","verso":"N = N₀ / 2ⁿ","tags":"demi-vie;application","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"application","recto":"Datation au carbone 14 ?","verso":"Compare le rapport ¹⁴C/¹²C d'un échantillon ancien à celui actuel. Demi-vie ¹⁴C ≈ 5730 ans. Permet de dater jusqu'à ~50 000 ans.","tags":"datation;c14","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A11 - Décroissance radioactive","type":"application","recto":"Risques sanitaires des rayonnements ?","verso":"α : peu pénétrant (peau l'arrête) mais très ionisant si ingéré.\nβ : pénétration moyenne (arrêté par aluminium).\nγ : très pénétrant (plomb, béton).","tags":"rayonnements;sante","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A12 - Équilibre chimique","type":"definition","recto":"État d'équilibre chimique ?","verso":"État dans lequel les concentrations des espèces n'évoluent plus, mais où les réactions directe et inverse continuent à des vitesses égales.","tags":"equilibre","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A12 - Équilibre chimique","type":"formula","recto":"Quotient de réaction Q_r ?","verso":"Pour aA + bB ⇌ cC + dD :\nQ_r = ([C]^c × [D]^d) / ([A]^a × [B]^b)\nDivisé par C° à la puissance appropriée pour être sans unité.","tags":"quotient","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A12 - Équilibre chimique","type":"definition","recto":"Constante d'équilibre K ?","verso":"Valeur de Q_r à l'équilibre : K = Q_r,eq.\nDépend uniquement de la température.","tags":"constante-equilibre","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A12 - Équilibre chimique","type":"application","recto":"Critère d'évolution spontanée ?","verso":"• Si Q_r < K : évolution dans le sens direct (formation de produits)\n• Si Q_r > K : évolution dans le sens inverse\n• Si Q_r = K : équilibre, pas d'évolution.","tags":"critere-evolution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A12 - Équilibre chimique","type":"application","recto":"Plus K est grand...","verso":"...plus la réaction est avancée à l'équilibre (les produits sont favorisés). K très grand ⇒ réaction quasi totale.","tags":"K;avancement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A12 - Équilibre chimique","type":"application","recto":"Effet de la température sur K ?","verso":"K ne dépend que de T. Une réaction exothermique voit K diminuer si T augmente (Le Chatelier).","tags":"K;temperature","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"definition","recto":"Pile électrochimique ?","verso":"Dispositif transformant l'énergie chimique en énergie électrique grâce à une réaction d'oxydoréduction spontanée.","tags":"pile","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"definition","recto":"Anode d'une pile ?","verso":"Électrode où se produit l'OXYDATION (Red → Ox + n e⁻). C'est le pôle (−).","tags":"anode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"definition","recto":"Cathode d'une pile ?","verso":"Électrode où se produit la RÉDUCTION (Ox + n e⁻ → Red). C'est le pôle (+).","tags":"cathode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"application","recto":"Sens du courant et des électrons dans une pile ?","verso":"• Électrons dans le circuit extérieur : anode → cathode (du − vers le +)\n• Courant électrique conventionnel : sens inverse (du + vers le −).","tags":"pile;sens","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"definition","recto":"Pont salin ?","verso":"Élément (gel ou tube) reliant les deux demi-piles. Permet la circulation des ions et assure l'électroneutralité.","tags":"pont-salin","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"formula","recto":"Quantité d'électricité Q débitée ?","verso":"Q = I × Δt   (en coulombs C)\n• I : intensité (A)\n• Δt : durée (s)","tags":"quantite-electricite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"formula","recto":"Quantité de matière d'électrons échangés ?","verso":"n(e⁻) = Q / (N_A × e) = I × Δt / F\nF = Faraday ≈ 96 500 C·mol⁻¹","tags":"faraday","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"definition","recto":"Capacité d'une pile (Q_max) ?","verso":"Quantité d'électricité maximale qu'elle peut fournir avant épuisement du réactif limitant. En A·h ou C.","tags":"capacite-pile","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A13 - Pile électrochimique","type":"application","recto":"Comment savoir quelle électrode est l'anode ?","verso":"Comparer les pK ou consulter la classification électrochimique : le réducteur le plus fort est oxydé (anode).","tags":"anode;identification","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"definition","recto":"Électrolyse ?","verso":"Transformation chimique non spontanée provoquée par le passage forcé d'un courant électrique imposé par un générateur.","tags":"electrolyse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"application","recto":"Sens d'évolution dans une électrolyse ?","verso":"Sens INVERSE de l'évolution spontanée. Q_r tend à s'éloigner de K.","tags":"electrolyse;sens","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"definition","recto":"Anode dans une électrolyse ?","verso":"Électrode reliée au pôle (+) du générateur. Siège de l'OXYDATION.","tags":"electrolyse;anode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"definition","recto":"Cathode dans une électrolyse ?","verso":"Électrode reliée au pôle (−) du générateur. Siège de la RÉDUCTION.","tags":"electrolyse;cathode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"application","recto":"Loi de Faraday (quantité de matière formée) ?","verso":"n = I × Δt / (z × F)\n• z : nombre d'électrons échangés\n• F = 96 500 C·mol⁻¹","tags":"faraday;loi","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"application","recto":"Applications industrielles de l'électrolyse ?","verso":"Production d'aluminium (Hall-Héroult), de chlore et soude, raffinage du cuivre, électroplacage, charge des accumulateurs.","tags":"electrolyse;applications","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A14 - Transformation chimique forcée et électrolyse","type":"definition","recto":"Accumulateur ?","verso":"Pile rechargeable. En décharge : pile (spontanée). En charge : électrolyse (forcée).","tags":"accumulateur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Squelette carboné ?","verso":"Enchaînement des atomes de carbone d'une molécule organique.","tags":"squelette-carbone","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Groupes caractéristiques principaux ?","verso":"• Alcool : −OH\n• Aldéhyde : −CHO\n• Cétone : C=O\n• Acide carboxylique : −COOH\n• Ester : −COO−\n• Amine : −NH₂\n• Amide : −CONH₂\n• Halogène : −X (F, Cl, Br, I)","tags":"groupes-fonctionnels","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Stéréoisomères ?","verso":"Isomères de configuration ayant la même formule semi-développée mais des arrangements 3D différents.","tags":"stereoisomerie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Énantiomères ?","verso":"Stéréoisomères images l'un de l'autre dans un miroir, non superposables. Possèdent un carbone asymétrique (C* avec 4 substituants différents).","tags":"enantiomeres","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Diastéréoisomères ?","verso":"Stéréoisomères qui ne sont pas énantiomères. Ex. : isomères Z/E, isomères ayant plusieurs C*.","tags":"diastereoisomeres","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Isomérie Z/E (cis/trans) ?","verso":"Diastéréoisomérie autour d'une double liaison C=C. Z = mêmes substituants prioritaires du même côté, E = opposés.","tags":"z-e","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Carbone asymétrique ?","verso":"Atome de carbone lié à 4 substituants tous différents. Noté C*.","tags":"carbone-asymetrique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Mélange racémique ?","verso":"Mélange équimolaire des deux énantiomères d'une molécule chirale. Pouvoir rotatoire nul.","tags":"racemique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"application","recto":"Polarité d'une liaison ?","verso":"Déterminée par la différence d'électronégativité entre les deux atomes. Si Δχ > 0,4, la liaison est polarisée.","tags":"polarite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Site donneur d'électrons ?","verso":"Atome ou groupe possédant un doublet non liant ou une charge négative, capable de céder un doublet (nucléophile).","tags":"donneur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Site accepteur d'électrons ?","verso":"Atome avec une charge partielle (δ+) ou une lacune électronique, capable de capter un doublet (électrophile).","tags":"accepteur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A15 - Structures des molécules organiques","type":"definition","recto":"Mécanisme réactionnel ?","verso":"Description détaillée des étapes (formation/rupture de liaisons) d'une réaction. Représentée par des flèches courbes pour le mouvement des électrons.","tags":"mecanisme","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"definition","recto":"Synthèse chimique ?","verso":"Préparation d'une espèce chimique à partir d'autres espèces, par réaction chimique.","tags":"synthese","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"formula","recto":"Rendement d'une synthèse ?","verso":"η = m_obtenue / m_théorique = n_obtenue / n_théorique\nGrandeur sans unité, entre 0 et 1, souvent en %.","tags":"rendement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"method","recto":"Étapes d'une synthèse organique ?","verso":"1. Transformation : mise en contact des réactifs (chauffage à reflux souvent)\n2. Isolement : extraction, filtration\n3. Purification : recristallisation, distillation, lavage\n4. Identification : CCM, point de fusion, IR, RMN.","tags":"synthese;etapes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"definition","recto":"Chauffage à reflux ?","verso":"Technique consistant à chauffer une solution dont les vapeurs sont condensées par un réfrigérant. Permet d'accélérer la réaction sans perte de matière.","tags":"reflux","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"definition","recto":"Recristallisation ?","verso":"Purification d'un solide en le dissolvant à chaud dans un solvant adapté, puis en le faisant cristalliser à froid. Les impuretés restent en solution.","tags":"recristallisation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"definition","recto":"Distillation fractionnée ?","verso":"Séparation de deux liquides miscibles ayant des températures d'ébullition différentes. Le plus volatil distille en premier.","tags":"distillation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"definition","recto":"CCM (chromatographie sur couche mince) ?","verso":"Technique d'identification : un échantillon migre sur une plaque grâce à un éluant. Comparaison du R_f avec un témoin.","tags":"ccm","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A16 - Synthèses chimiques","type":"formula","recto":"Rapport frontal R_f en CCM ?","verso":"R_f = h_dépôt / h_front\nValeur entre 0 et 1 caractéristique d'une espèce dans un éluant donné.","tags":"ccm;rf","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A17 - Stratégie de synthèses","type":"definition","recto":"Synthèse multi-étapes ?","verso":"Synthèse impliquant plusieurs transformations successives pour obtenir le produit cible.","tags":"multi-etapes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A17 - Stratégie de synthèses","type":"application","recto":"Comment maximiser le rendement global d'une synthèse multi-étapes ?","verso":"Minimiser le nombre d'étapes et maximiser le rendement de chacune. Le rendement global est le PRODUIT des rendements (η_global = η₁ × η₂ × ...).","tags":"rendement-global","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A17 - Stratégie de synthèses","type":"definition","recto":"Protection de groupe fonctionnel ?","verso":"Transformation temporaire d'un groupe réactif en un groupe inerte pour qu'il ne réagisse pas pendant l'étape suivante. Déprotection à la fin.","tags":"protection","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A17 - Stratégie de synthèses","type":"definition","recto":"Réaction sélective ?","verso":"Réaction qui privilégie un produit parmi plusieurs possibles : régiosélective (position) ou stéréosélective (3D).","tags":"selectivite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A17 - Stratégie de synthèses","type":"definition","recto":"Chimie verte (12 principes) ?","verso":"Approche durable visant à : réduire les déchets, économiser les atomes, utiliser des réactifs et solvants peu toxiques, favoriser la catalyse, être économe en énergie.","tags":"chimie-verte","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A17 - Stratégie de synthèses","type":"formula","recto":"Économie d'atomes ?","verso":"EA = M(produit utile) / Σ M(réactifs)\nEntre 0 et 1, à maximiser.","tags":"economie-atomes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Réaction chimique au niveau microscopique ?","verso":"Rupture et formation de liaisons covalentes par déplacement de doublets d'électrons.","tags":"microscopique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Représentation par flèches courbes ?","verso":"Une flèche courbe représente le mouvement d'un DOUBLET d'électrons : du donneur vers l'accepteur.","tags":"fleches-courbes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Réaction de substitution ?","verso":"Un groupe d'une molécule est remplacé par un autre.\nEx. : R−X + Nu⁻ → R−Nu + X⁻","tags":"substitution","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Réaction d'addition ?","verso":"Deux molécules s'unissent en une seule, rupture d'une liaison multiple.\nEx. : H₂C=CH₂ + H₂ → CH₃−CH₃","tags":"addition","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Réaction d'élimination ?","verso":"Création d'une liaison multiple par perte de groupes.\nEx. : déshydratation d'un alcool : R−CH(OH)−CH₃ → R−CH=CH₂ + H₂O","tags":"elimination","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Site nucléophile ?","verso":"Site donneur d'électrons (riche en e⁻, charge négative ou doublet non liant).","tags":"nucleophile","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème A — Constitution et transformation de la matière","chapitre":"A18 - Modélisation microscopique d'une transformation chimique","type":"definition","recto":"Site électrophile ?","verso":"Site accepteur d'électrons (pauvre en e⁻, charge positive ou lacune).","tags":"electrophile","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"definition","recto":"Repère cartésien ?","verso":"Repère orthonormé (O, ⃗i, ⃗j, ⃗k) où chaque vecteur a une norme de 1 et où les axes sont perpendiculaires.","tags":"repere","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"formula","recto":"Vecteur position ⃗OM(t) ?","verso":"⃗OM(t) = x(t)·⃗i + y(t)·⃗j + z(t)·⃗k\nCoordonnées : (x, y, z) à l'instant t.","tags":"position","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"formula","recto":"Vecteur vitesse ⃗v(t) ?","verso":"⃗v(t) = d⃗OM/dt\nCoordonnées : (dx/dt, dy/dt, dz/dt) = (v_x, v_y, v_z).\nUnité : m·s⁻¹.","tags":"vitesse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"formula","recto":"Vecteur accélération ⃗a(t) ?","verso":"⃗a(t) = d⃗v/dt = d²⃗OM/dt²\nCoordonnées : (a_x, a_y, a_z). Unité : m·s⁻².","tags":"acceleration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"formula","recto":"Norme du vecteur vitesse ?","verso":"‖⃗v‖ = √(v_x² + v_y² + v_z²)","tags":"vitesse;norme","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"application","recto":"Mouvement uniforme ?","verso":"Norme du vecteur vitesse constante : ‖⃗v‖ = cste.","tags":"mouvement;uniforme","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"application","recto":"Mouvement rectiligne uniforme ?","verso":"Trajectoire = droite, ‖⃗v‖ = cste, ⃗a = ⃗0.","tags":"MRU","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B1 - Cinématique dans le repère cartésien","type":"application","recto":"Mouvement rectiligne uniformément varié ?","verso":"Trajectoire = droite, ⃗a = cste, ⃗v varie linéairement.","tags":"MRUV","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B2 - Mouvements rectilignes","type":"formula","recto":"Loi horaire de la position en MRU ?","verso":"x(t) = v₀ × t + x₀","tags":"MRU;loi","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B2 - Mouvements rectilignes","type":"formula","recto":"Loi horaire en MRUV (mouvement uniformément accéléré) ?","verso":"x(t) = ½·a·t² + v₀·t + x₀\nv(t) = a·t + v₀","tags":"MRUV;loi","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B2 - Mouvements rectilignes","type":"application","recto":"Reconnaître un mouvement à partir de v(t) ?","verso":"• v constante → MRU\n• v fonction affine de t → MRUV\n• v variable autrement → mouvement varié.","tags":"reconnaissance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B2 - Mouvements rectilignes","type":"formula","recto":"Lien entre v² et la position en MRUV ?","verso":"v² − v₀² = 2·a·(x − x₀)\n(Formule sans le temps, utile en mécanique.)","tags":"MRUV;sans-temps","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B3 - Cinématique dans le repère de Frenet","type":"definition","recto":"Repère de Frenet ?","verso":"Repère mobile attaché au point M en mouvement, formé de :\n• ⃗τ : tangent à la trajectoire, orienté dans le sens du mouvement\n• ⃗n : normal, orienté vers le centre de courbure.","tags":"frenet","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B3 - Cinématique dans le repère de Frenet","type":"formula","recto":"Vecteur vitesse en repère de Frenet ?","verso":"⃗v = v · ⃗τ\nLe vecteur vitesse est toujours TANGENT à la trajectoire.","tags":"frenet;vitesse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B3 - Cinématique dans le repère de Frenet","type":"formula","recto":"Vecteur accélération en repère de Frenet ?","verso":"⃗a = (dv/dt) · ⃗τ + (v²/R) · ⃗n\n• a_t = dv/dt : accélération tangentielle\n• a_n = v²/R : accélération normale (R : rayon de courbure).","tags":"frenet;acceleration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B3 - Cinématique dans le repère de Frenet","type":"application","recto":"Mouvement circulaire uniforme ?","verso":"v = cste, donc a_t = 0. ⃗a est purement normale : ⃗a = (v²/R)·⃗n. Toujours dirigée vers le centre.","tags":"circulaire;uniforme","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B3 - Cinématique dans le repère de Frenet","type":"formula","recto":"Période T d'un mouvement circulaire uniforme ?","verso":"T = 2πR / v\nFréquence f = 1/T (Hz).","tags":"circulaire;periode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B3 - Cinématique dans le repère de Frenet","type":"application","recto":"Cas où ⃗a et ⃗v sont colinéaires ?","verso":"Mouvement RECTILIGNE (la trajectoire est une droite).","tags":"rectiligne;criteres","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"definition","recto":"Force ?","verso":"Modélise l'action de l'extérieur sur le système. Vecteur ⃗F ayant : point d'application, direction, sens, valeur (en newtons N).","tags":"force","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"formula","recto":"Poids d'un corps ?","verso":"⃗P = m·⃗g\n• m : masse (kg)\n• ⃗g : champ de pesanteur (m·s⁻²), vertical vers le bas.\n• ‖⃗P‖ = m·g, en newtons.","tags":"poids","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"formula","recto":"Poussée d'Archimède ?","verso":"⃗P_A = −ρ_fluide · V_immergé · ⃗g\nVerticale, dirigée vers le HAUT.","tags":"archimede","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"formula","recto":"Force de frottement fluide ?","verso":"⃗f = −α·⃗v\nColinéaire et de SENS CONTRAIRE au vecteur vitesse.","tags":"frottement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"law","recto":"Première loi de Newton (principe d'inertie) ?","verso":"Si Σ⃗F = ⃗0 dans un référentiel galiléen, alors :\n• le système est immobile, OU\n• il a un mouvement rectiligne uniforme.\nRéciproque vraie.","tags":"newton;1","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"law","recto":"Deuxième loi de Newton (PFD) ?","verso":"Dans un référentiel galiléen :\nΣ⃗F = m·⃗a(t)\n⃗F et ⃗a sont colinéaires et de même sens.","tags":"newton;2","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"law","recto":"Troisième loi de Newton (actions réciproques) ?","verso":"Quand A et B interagissent : ⃗F_(A/B) = −⃗F_(B/A)\nMême norme, sens opposés, mêmes droites d'action.","tags":"newton;3","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"definition","recto":"Référentiel galiléen ?","verso":"Référentiel dans lequel le principe d'inertie s'applique. Ex. : référentiel de Copernic, géocentrique et terrestre (sur des durées limitées).","tags":"galileen","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B4 - Forces et lois de Newton","type":"definition","recto":"Centre de masse G ?","verso":"Point unique du système où s'applique le principe d'inertie. Pour un solide homogène : centre géométrique.","tags":"centre-de-masse","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"definition","recto":"Champ de pesanteur uniforme ?","verso":"Région où ⃗g est considéré comme constant (même direction, sens, norme). Approximation valable au voisinage de la Terre sur une zone réduite.","tags":"pesanteur;uniforme","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"definition","recto":"Chute libre ?","verso":"Mouvement d'un système soumis UNIQUEMENT à son poids (poussée d'Archimède et frottements négligés).","tags":"chute-libre","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"formula","recto":"Accélération en chute libre ?","verso":"⃗a = ⃗g  (vecteur constant, g ≈ 9,81 m·s⁻²)\nIndépendant de la masse.","tags":"chute-libre;a","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"formula","recto":"Loi horaire d'une chute verticale sans vitesse initiale (vers le bas) ?","verso":"v(t) = g·t\nz(t) = ½·g·t² (depuis la position initiale, axe vers le bas)","tags":"chute-verticale","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"formula","recto":"Lois horaires d'un tir parabolique (axe x horizontal, z vertical haut) ?","verso":"a_x = 0, a_z = −g\nv_x(t) = v₀·cos(α), v_z(t) = −g·t + v₀·sin(α)\nx(t) = v₀·cos(α)·t\nz(t) = −½·g·t² + v₀·sin(α)·t + z₀","tags":"tir-parabolique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"formula","recto":"Équation de la trajectoire d'un tir parabolique ?","verso":"z(x) = −g·x² / (2·v₀²·cos²(α)) + tan(α)·x + z₀\nC'est une PARABOLE.","tags":"tir;trajectoire","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"application","recto":"Portée maximale d'un tir parabolique ?","verso":"Atteinte pour α = 45°. P = v₀² / g (sur sol horizontal).","tags":"tir;portee","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B5 - Mouvement dans le champ de pesanteur uniforme","type":"application","recto":"Hauteur maximale d'un tir parabolique ?","verso":"h_max = (v₀·sin(α))² / (2g)","tags":"tir;hauteur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"definition","recto":"Champ électrique uniforme ?","verso":"Champ ⃗E où direction, sens et norme sont constants. Cas type : entre deux plaques planes parallèles chargées (condensateur plan).","tags":"champ-electrique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"formula","recto":"Norme de ⃗E entre deux plaques ?","verso":"E = U / d\n• U : tension entre les plaques (V)\n• d : distance (m)\n• ⃗E dirigée de la plaque (+) vers la plaque (−).","tags":"champ-E;plaques","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"formula","recto":"Force électrique sur une particule chargée ?","verso":"⃗F = q·⃗E\n• q > 0 : ⃗F même sens que ⃗E\n• q < 0 : ⃗F sens opposé.","tags":"force-electrique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"formula","recto":"Accélération d'une particule de charge q dans ⃗E ?","verso":"⃗a = (q/m)·⃗E\nIndépendante du temps si ⃗E est uniforme.","tags":"particule;acceleration","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"application","recto":"Mouvement parabolique d'une particule chargée ?","verso":"Si la particule entre avec une vitesse perpendiculaire à ⃗E uniforme : trajectoire parabolique (analogue à un tir parabolique).","tags":"particule;parabole","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"formula","recto":"Théorème de l'énergie cinétique appliqué ?","verso":"ΔE_c = W(⃗F) = q·U\n• U : tension entre les positions initiale et finale.","tags":"energie-cinetique;electrique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B6 - Mouvement dans le champ électrique uniforme","type":"application","recto":"Accélération entre 2 plaques séparées par une tension U_AB ?","verso":"Pour un proton (q = e) accéléré : E_c = e·U_AB\n→ v = √(2·e·U_AB / m_p)","tags":"accelerateur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"law","recto":"Loi de gravitation universelle (Newton) ?","verso":"F = G·m_A·m_B / d²\n• G ≈ 6,67 × 10⁻¹¹ N·m²·kg⁻²\nForce attractive entre 2 corps de masses m_A, m_B distants de d.","tags":"gravitation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"formula","recto":"Champ de gravitation créé par un astre de masse M ?","verso":"⃗g(M) = −G·M / r² · ⃗u\nDirigé vers le centre de l'astre. r : distance au centre.","tags":"champ-gravitation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"application","recto":"Mouvement circulaire uniforme d'un satellite ?","verso":"Application de la 2ᵉ loi de Newton + accélération normale :\nv = √(G·M / r)\nT² = 4π²·r³ / (G·M)  (3ᵉ loi de Kepler)","tags":"satellite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"law","recto":"Première loi de Kepler (loi des orbites) ?","verso":"Les planètes décrivent des ELLIPSES dont le Soleil est l'un des foyers.","tags":"kepler;1","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"law","recto":"Deuxième loi de Kepler (loi des aires) ?","verso":"Le segment Soleil-planète balaie des aires égales pendant des durées égales (vitesse aréolaire constante).","tags":"kepler;2","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"law","recto":"Troisième loi de Kepler ?","verso":"T² / a³ = 4π² / (G·M_Soleil) = constante\n• T : période\n• a : demi-grand axe.","tags":"kepler;3","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"definition","recto":"Satellite géostationnaire ?","verso":"Satellite restant à la verticale du même point de l'équateur. Période = 23 h 56 min, altitude ≈ 36 000 km.","tags":"geostationnaire","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B7 - Mouvement dans le champ de gravitation","type":"formula","recto":"Vitesse de libération ?","verso":"v_lib = √(2·G·M / R)\nVitesse minimale pour quitter l'attraction d'un astre. Sur Terre : ≈ 11,2 km·s⁻¹.","tags":"vitesse-liberation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"definition","recto":"Fluide incompressible ?","verso":"Fluide dont la masse volumique ρ est constante. Liquides souvent incompressibles, gaz seulement si v << c_son.","tags":"fluide;incompressible","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"definition","recto":"Écoulement stationnaire ?","verso":"Écoulement où la vitesse en chaque point ne dépend pas du temps (mais peut varier d'un point à l'autre).","tags":"stationnaire","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"definition","recto":"Débit volumique D_V ?","verso":"D_V = V / Δt = S × v   (m³·s⁻¹)\n• S : section\n• v : vitesse moyenne","tags":"debit","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"formula","recto":"Conservation du débit (équation de continuité) ?","verso":"Pour un fluide incompressible : S₁·v₁ = S₂·v₂\nOù la section diminue, la vitesse augmente.","tags":"continuite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"law","recto":"Théorème de Bernoulli ?","verso":"Pour un fluide parfait incompressible en écoulement stationnaire :\np + ½·ρ·v² + ρ·g·z = constante (le long d'une ligne de courant)","tags":"bernoulli","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"application","recto":"Effet Venturi ?","verso":"Quand un fluide passe par un rétrécissement, sa vitesse augmente et sa pression diminue (conséquence de Bernoulli).","tags":"venturi","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème B — Mouvements et interactions","chapitre":"B8 - Dynamique des fluides","type":"application","recto":"Loi de Pascal ?","verso":"Toute variation de pression appliquée à un fluide incompressible se transmet intégralement en tout point. (Principe des presses hydrauliques.)","tags":"pascal","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"definition","recto":"Onde mécanique ?","verso":"Propagation d'une perturbation dans un milieu matériel SANS transport de matière, mais avec transport d'énergie.","tags":"onde-mecanique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"definition","recto":"Onde sonore ?","verso":"Onde mécanique LONGITUDINALE (la perturbation est parallèle à la direction de propagation) qui se propage dans un fluide ou un solide.","tags":"son","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"application","recto":"Le son se propage-t-il dans le vide ?","verso":"NON. Une onde sonore nécessite un milieu matériel.","tags":"son;vide","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"formula","recto":"Période T d'une onde ?","verso":"T = 1/f   (s)\n• f : fréquence (Hz)","tags":"periode","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"formula","recto":"Longueur d'onde λ ?","verso":"λ = v × T = v/f\n• v : célérité de l'onde (m·s⁻¹)\n• λ : distance parcourue pendant une période (m)","tags":"longueur-onde","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"application","recto":"Célérité du son dans l'air ?","verso":"v ≈ 340 m·s⁻¹ (à 20°C, dépend de T).","tags":"son;celerite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"application","recto":"Domaines de fréquences sonores ?","verso":"• Infrasons : f < 20 Hz\n• Audibles : 20 Hz < f < 20 kHz\n• Ultrasons : f > 20 kHz","tags":"son;domaines","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"formula","recto":"Niveau d'intensité sonore L ?","verso":"L = 10·log(I/I₀)   en décibels (dB)\n• I : intensité sonore (W·m⁻²)\n• I₀ = 10⁻¹² W·m⁻² (seuil d'audibilité)","tags":"decibel","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"application","recto":"Doublement de l'intensité sonore I ?","verso":"L augmente de 10·log(2) ≈ 3 dB.","tags":"decibel;doublement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C1 - Les ondes sonores","type":"application","recto":"Doublement du nombre de sources identiques ?","verso":"L augmente de 3 dB (intensités s'additionnent).","tags":"decibel;sources","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C2 - Effet Doppler","type":"definition","recto":"Effet Doppler ?","verso":"Modification de la fréquence perçue d'une onde lorsque l'émetteur et le récepteur sont en mouvement relatif.","tags":"doppler","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C2 - Effet Doppler","type":"formula","recto":"Décalage Doppler (source en mouvement, vitesse v_s, célérité c) ?","verso":"f_perçue = f_émise × c / (c − v_s)  si la source se rapproche\nf_perçue = f_émise × c / (c + v_s)  si la source s'éloigne","tags":"doppler;formule","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C2 - Effet Doppler","type":"application","recto":"Effet Doppler : conséquences pratiques ?","verso":"• Sirène d'ambulance : son plus aigu en approche, plus grave après\n• Mesure de vitesse (radar, échographie Doppler)\n• Astronomie : red-shift / blue-shift des galaxies","tags":"doppler;applications","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C2 - Effet Doppler","type":"application","recto":"Décalage Doppler en ondes électromagnétiques (lumière) ?","verso":"• Source qui s'éloigne : lumière décalée vers le ROUGE (red-shift), z = (λ' − λ)/λ\n• Source qui s'approche : décalage vers le BLEU.","tags":"doppler;lumiere","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C2 - Effet Doppler","type":"application","recto":"Loi de Hubble ?","verso":"v = H₀ × d : les galaxies lointaines s'éloignent à une vitesse proportionnelle à leur distance (preuve de l'expansion de l'Univers).","tags":"hubble","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C3 - La diffraction","type":"definition","recto":"Diffraction ?","verso":"Phénomène d'étalement spatial d'une onde rencontrant un obstacle ou une ouverture de dimension comparable à sa longueur d'onde.","tags":"diffraction","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C3 - La diffraction","type":"application","recto":"Quand observe-t-on la diffraction ?","verso":"Quand la dimension de l'ouverture/obstacle a est de l'ordre de λ : a ≲ quelques λ.\nSi a >> λ : peu de diffraction (propagation rectiligne).","tags":"diffraction;condition","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C3 - La diffraction","type":"formula","recto":"Demi-angle de diffraction θ par une fente de largeur a ?","verso":"sin(θ) ≈ θ = λ/a\n(en radians, pour des petits angles)","tags":"diffraction;angle","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C3 - La diffraction","type":"formula","recto":"Largeur de la tache centrale L à la distance D ?","verso":"L = 2·λ·D / a\n• L : largeur de la tache de diffraction\n• D : distance fente-écran\n• a : largeur de la fente","tags":"diffraction;tache","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C3 - La diffraction","type":"application","recto":"Diffraction et nature de la lumière ?","verso":"La diffraction prouve la nature ONDULATOIRE de la lumière.","tags":"diffraction;preuve","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C4 - Les interférences","type":"definition","recto":"Interférences ?","verso":"Phénomène de superposition de deux ondes cohérentes (même fréquence, déphasage constant) donnant lieu à des zones d'amplification ou d'extinction.","tags":"interferences","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C4 - Les interférences","type":"definition","recto":"Différence de marche δ ?","verso":"Différence des chemins optiques parcourus par deux ondes provenant de deux sources cohérentes vers un point M.\nδ = d₂ − d₁","tags":"delta;marche","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C4 - Les interférences","type":"application","recto":"Condition d'interférence constructive ?","verso":"δ = k·λ avec k entier (Z).\nLes deux ondes sont en phase, amplitudes s'additionnent → MAXIMUM lumineux.","tags":"interference;constructive","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C4 - Les interférences","type":"application","recto":"Condition d'interférence destructive ?","verso":"δ = (k + ½)·λ avec k entier.\nLes ondes sont en opposition de phase → MINIMUM (extinction).","tags":"interference;destructive","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C4 - Les interférences","type":"formula","recto":"Interfrange i (fentes d'Young) ?","verso":"i = λ·D / b\n• λ : longueur d'onde\n• D : distance fentes-écran\n• b : distance entre les 2 fentes","tags":"young;interfrange","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C4 - Les interférences","type":"application","recto":"Sources cohérentes ?","verso":"Deux sources émettant exactement à la même fréquence avec un déphasage constant. En pratique, on dédouble une source unique (fentes d'Young, miroirs de Fresnel).","tags":"coherence","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"law","recto":"Lois de Snell-Descartes (réflexion) ?","verso":"1. Le rayon réfléchi est dans le plan d'incidence.\n2. L'angle de réflexion = angle d'incidence : i₁' = i₁.","tags":"snell;reflexion","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"law","recto":"Lois de Snell-Descartes (réfraction) ?","verso":"1. Le rayon réfracté est dans le plan d'incidence, de l'autre côté de la normale.\n2. n₁·sin(i₁) = n₂·sin(i₂)","tags":"snell;refraction","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"formula","recto":"Indice de réfraction n d'un milieu ?","verso":"n = c / v\n• c : célérité de la lumière dans le vide\n• v : célérité dans le milieu\n• n ≥ 1 (n_vide = 1, n_eau ≈ 1,33, n_verre ≈ 1,5)","tags":"indice","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"definition","recto":"Réflexion totale ?","verso":"Quand n₁ > n₂ et i₁ > i_lim avec sin(i_lim) = n₂/n₁, le rayon est entièrement réfléchi (pas de réfraction). Application : fibre optique.","tags":"reflexion-totale","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"definition","recto":"Lentille convergente ?","verso":"Lentille mince qui fait converger un faisceau parallèle vers un foyer image F'. Distance focale f' > 0.","tags":"lentille","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"formula","recto":"Relation de conjugaison (Descartes) ?","verso":"1/OA' − 1/OA = 1/f'\n• OA : distance objet (algébrique)\n• OA' : distance image\n• f' : distance focale image","tags":"conjugaison","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C5 - Généralités d'optique géométrique","type":"formula","recto":"Grandissement γ d'une lentille ?","verso":"γ = A'B' / AB = OA' / OA\n• |γ| > 1 : agrandit\n• γ > 0 : image droite\n• γ < 0 : image renversée","tags":"grandissement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C6 - Un instrument d'optique : la lunette astronomique","type":"definition","recto":"Lunette astronomique ?","verso":"Instrument afocal composé de deux lentilles convergentes : un OBJECTIF (grande f') et un OCULAIRE (petite f').","tags":"lunette","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C6 - Un instrument d'optique : la lunette astronomique","type":"application","recto":"Système afocal ?","verso":"Système où l'objet et l'image sont à l'INFINI. Le foyer image de l'objectif coïncide avec le foyer objet de l'oculaire.","tags":"afocal","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C6 - Un instrument d'optique : la lunette astronomique","type":"formula","recto":"Grossissement G d'une lunette astronomique ?","verso":"G = α' / α = f'_objectif / f'_oculaire\n• α : angle sous lequel l'objet est vu à l'œil nu\n• α' : angle sous lequel l'image est vue à travers l'instrument","tags":"grossissement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C6 - Un instrument d'optique : la lunette astronomique","type":"application","recto":"Pour augmenter G d'une lunette ?","verso":"Augmenter la focale de l'objectif OU diminuer celle de l'oculaire.","tags":"grossissement;applications","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"definition","recto":"Photon ?","verso":"Particule de lumière. Quantum d'énergie électromagnétique. Pas de masse, se propage à la vitesse c.","tags":"photon","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"formula","recto":"Énergie d'un photon ?","verso":"E = h·ν = h·c/λ\n• h ≈ 6,63 × 10⁻³⁴ J·s (constante de Planck)\n• ν : fréquence\n• λ : longueur d'onde","tags":"photon;energie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"application","recto":"Conversion eV ↔ J ?","verso":"1 eV = 1,602 × 10⁻¹⁹ J\nUtilisée en physique des particules, atomistique.","tags":"ev;conversion","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"definition","recto":"Effet photoélectrique ?","verso":"Émission d'électrons par un métal éclairé par une lumière de fréquence ν supérieure à un seuil ν₀. Découvert par Hertz, expliqué par Einstein (1905).","tags":"photoelectrique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"formula","recto":"Travail d'extraction W₀ et énergie cinétique ?","verso":"E_c(électron) = h·ν − W₀  (si h·ν ≥ W₀, sinon pas d'émission)\nW₀ : énergie minimale pour extraire un électron du métal.","tags":"photoelectrique;energie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"application","recto":"Dualité onde-particule ?","verso":"La lumière a une double nature : ondulatoire (interférences, diffraction) et corpusculaire (effet photoélectrique). Vrai aussi pour la matière (de Broglie).","tags":"dualite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C7 - La lumière, un flux de photons","type":"definition","recto":"Niveaux d'énergie d'un atome ?","verso":"Un atome ne peut occuper que des niveaux d'énergie discrets E_n. L'absorption/émission de photons se fait par transitions : E_photon = |E_n − E_m|.","tags":"niveaux-energie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"definition","recto":"Intensité d'un courant ?","verso":"Débit de charges électriques : I = dq/dt   (A = C·s⁻¹).","tags":"intensite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"definition","recto":"Tension U entre deux points ?","verso":"Différence de potentiel U_AB = V_A − V_B   (V).","tags":"tension","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"law","recto":"Loi des nœuds ?","verso":"Σ I_entrant = Σ I_sortant. Conservation de la charge.","tags":"noeuds","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"law","recto":"Loi des mailles ?","verso":"Σ U = 0 sur une maille fermée (en respectant les sens).","tags":"mailles","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"law","recto":"Loi d'Ohm (résistor) ?","verso":"U = R·I\n• U : tension (V)\n• R : résistance (Ω)\n• I : intensité (A)","tags":"ohm","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"formula","recto":"Puissance électrique reçue par un dipôle ?","verso":"P = U·I   (W)\nPour un résistor : P = R·I² = U²/R (effet Joule).","tags":"puissance","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C8 - Notions d'électrocinétique","type":"formula","recto":"Énergie électrique reçue ?","verso":"E = P·Δt = U·I·Δt   (J)","tags":"energie-electrique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"definition","recto":"Condensateur ?","verso":"Composant constitué de deux armatures conductrices séparées par un isolant. Stocke des charges électriques.","tags":"condensateur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"formula","recto":"Charge Q d'un condensateur ?","verso":"Q = C·U\n• C : capacité (F = C·V⁻¹)\n• U : tension à ses bornes (V)","tags":"condensateur;charge","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"formula","recto":"Lien intensité-tension pour un condensateur ?","verso":"i(t) = C × du/dt","tags":"condensateur;i","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"formula","recto":"Équation différentielle de la charge d'un condensateur (RC) ?","verso":"RC × du/dt + u = E\nSolution : u(t) = E·(1 − e^(−t/τ))","tags":"rc;charge","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"formula","recto":"Constante de temps τ d'un circuit RC ?","verso":"τ = R·C   (s)\n• R : résistance (Ω)\n• C : capacité (F)","tags":"rc;tau","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"application","recto":"Régime permanent d'un condensateur ?","verso":"u_C = E (tension finale)\ni = 0 (le condensateur ne laisse plus passer de courant).","tags":"rc;regime-permanent","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"application","recto":"Au bout de combien de τ le régime permanent est atteint ?","verso":"Pratiquement après 5τ (à 99% de la valeur finale).","tags":"rc;5tau","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"formula","recto":"Énergie stockée par un condensateur ?","verso":"E_C = ½·C·U² = Q²/(2C)   (J)","tags":"condensateur;energie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème C — Ondes et signaux","chapitre":"C9 - Circuit RC série","type":"formula","recto":"Décharge d'un condensateur dans une résistance ?","verso":"u(t) = U₀·e^(−t/τ)\nDécroissance exponentielle vers 0.","tags":"rc;decharge","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D1 - Gaz parfait","type":"definition","recto":"Gaz parfait ?","verso":"Modèle idéal d'un gaz : molécules ponctuelles, sans interactions entre elles (sauf chocs élastiques). Bonne approximation pour les gaz à basse pression et haute température.","tags":"gaz-parfait","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D1 - Gaz parfait","type":"law","recto":"Équation d'état du gaz parfait ?","verso":"P·V = n·R·T\n• P : pression (Pa)\n• V : volume (m³)\n• n : quantité de matière (mol)\n• R = 8,314 J·K⁻¹·mol⁻¹\n• T : température (K)","tags":"gaz-parfait;equation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D1 - Gaz parfait","type":"application","recto":"Conversion °C ↔ K ?","verso":"T(K) = θ(°C) + 273,15","tags":"temperature","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D1 - Gaz parfait","type":"application","recto":"Conditions normales (CNTP) ?","verso":"T = 273,15 K (0°C), P = 1,013 × 10⁵ Pa\nV_m ≈ 22,4 L·mol⁻¹","tags":"cntp","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D1 - Gaz parfait","type":"application","recto":"Loi de Boyle-Mariotte (T constante) ?","verso":"P × V = constante. Si T fixée, P et V sont inversement proportionnels.","tags":"boyle-mariotte","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D1 - Gaz parfait","type":"application","recto":"Loi de Gay-Lussac (V constant) ?","verso":"P / T = constante. À volume fixé, pression et température sont proportionnelles.","tags":"gay-lussac","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"definition","recto":"Énergie interne U d'un système ?","verso":"Somme des énergies cinétiques d'agitation thermique et des énergies potentielles d'interaction des particules. Grandeur extensive (J).","tags":"energie-interne","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"formula","recto":"Variation d'énergie interne d'un solide/liquide incompressible ?","verso":"ΔU = m·c·ΔT\n• c : capacité thermique massique (J·kg⁻¹·K⁻¹)\n• Pour l'eau : c ≈ 4185 J·kg⁻¹·K⁻¹","tags":"energie-interne;solide","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"law","recto":"Premier principe de la thermodynamique ?","verso":"ΔU = W + Q\n• W : travail des forces non conservatives (J)\n• Q : transfert thermique reçu (J)\nÉnergie ne se crée ni ne se perd, elle se transforme.","tags":"premier-principe","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"definition","recto":"Convention thermodynamique des signes ?","verso":"Tout ce qui est REÇU par le système est COMPTÉ POSITIVEMENT (W>0, Q>0).\nTout ce qui est CÉDÉ est compté négativement.","tags":"convention-signes","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"definition","recto":"Système isolé ?","verso":"Système n'échangeant ni matière ni énergie avec l'extérieur. ΔU = 0.","tags":"isole","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"definition","recto":"Transformation adiabatique ?","verso":"Transformation sans transfert thermique : Q = 0. Donc ΔU = W.","tags":"adiabatique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"definition","recto":"Transformation isotherme ?","verso":"Transformation à température constante. Pour un gaz parfait : ΔU = 0 (U ne dépend que de T).","tags":"isotherme","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D2 - Énergie interne et premier principe de la thermodynamique","type":"definition","recto":"Capacité thermique massique c ?","verso":"Énergie nécessaire pour augmenter de 1 K la température de 1 kg de matière. Caractéristique du matériau.","tags":"capacite-thermique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"definition","recto":"Trois modes de transfert thermique ?","verso":"1. Conduction : sans déplacement de matière (solides ++)\n2. Convection : par déplacement de fluide (gaz, liquides)\n3. Rayonnement : par ondes électromagnétiques (sans support).","tags":"modes-transfert","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"formula","recto":"Flux thermique Φ ?","verso":"Φ = Q/Δt   (W)\nÉnergie thermique transférée par unité de temps.","tags":"flux","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"formula","recto":"Résistance thermique R_th ?","verso":"Φ = (T_chaud − T_froid) / R_th\n→ R_th = ΔT / Φ   (K·W⁻¹)\nAnalogue électrique de R = U/I.","tags":"resistance-thermique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"formula","recto":"Résistance thermique d'un mur d'épaisseur e ?","verso":"R_th = e / (λ·S)\n• λ : conductivité thermique (W·m⁻¹·K⁻¹)\n• S : surface\n• Plus λ est faible, mieux le matériau ISOLE.","tags":"rth;mur","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"application","recto":"Résistances thermiques en série ?","verso":"R_éq = R₁ + R₂ + ...\n(Comme les résistances électriques en série.)","tags":"rth;serie","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"application","recto":"Résistances thermiques en parallèle ?","verso":"1/R_éq = 1/R₁ + 1/R₂ + ...","tags":"rth;parallele","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D3 - Transferts, flux et résistance thermique","type":"application","recto":"Bons isolants vs bons conducteurs thermiques ?","verso":"• Isolants : laine de verre, polystyrène (λ faible)\n• Conducteurs : métaux (cuivre, aluminium, fer ; λ élevé).","tags":"conductivite-thermique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D4 - Loi phénoménologique de Newton","type":"law","recto":"Loi de Newton (refroidissement) ?","verso":"Φ = h·S·(T_corps − T_ext)\n• h : coefficient de transfert thermique (W·m⁻²·K⁻¹)\n• S : surface\nFlux proportionnel à l'écart de température.","tags":"newton-thermique","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D4 - Loi phénoménologique de Newton","type":"formula","recto":"Équation différentielle du refroidissement ?","verso":"m·c × dT/dt = −h·S·(T − T_ext)\nSolution : T(t) = T_ext + (T₀ − T_ext)·e^(−t/τ)\navec τ = m·c / (h·S)","tags":"newton;equation","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D4 - Loi phénoménologique de Newton","type":"application","recto":"Allure de T(t) lors du refroidissement ?","verso":"Décroissance EXPONENTIELLE vers T_ext.\nAprès 5τ : pratiquement à T_ext.","tags":"newton;allure","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D4 - Loi phénoménologique de Newton","type":"application","recto":"Domaines de validité de la loi de Newton ?","verso":"Valable pour de petits écarts de température (typiquement |ΔT| < 30°C).","tags":"newton;limite","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D5 - Bilan thermique du système Terre-atmosphère","type":"law","recto":"Loi de Stefan-Boltzmann ?","verso":"Φ_émis = σ·T⁴·S\n• σ ≈ 5,67 × 10⁻⁸ W·m⁻²·K⁻⁴\n• T : température en K (corps noir).","tags":"stefan-boltzmann","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D5 - Bilan thermique du système Terre-atmosphère","type":"formula","recto":"Puissance solaire reçue par la Terre ?","verso":"P_reçue = (1 − a) × P_solaire × π·R_T²\n• a : albédo (≈ 0,3 pour la Terre)\n• P_solaire ≈ 1361 W·m⁻²","tags":"albedo;solaire","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D5 - Bilan thermique du système Terre-atmosphère","type":"definition","recto":"Albédo ?","verso":"Fraction de l'énergie lumineuse incidente réfléchie par une surface (0 < a < 1).\n• Neige fraîche : a ≈ 0,9\n• Forêt : a ≈ 0,15\n• Océans : a ≈ 0,06","tags":"albedo","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D5 - Bilan thermique du système Terre-atmosphère","type":"application","recto":"Effet de serre ?","verso":"L'atmosphère (CO₂, H₂O, CH₄, ...) absorbe une partie du rayonnement IR émis par la Terre et le réémet en partie vers le sol → réchauffement de la surface.\nSans effet de serre : T moyenne ≈ −18 °C. Avec : ≈ +15 °C.","tags":"effet-serre","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D5 - Bilan thermique du système Terre-atmosphère","type":"application","recto":"Bilan radiatif d'équilibre ?","verso":"À l'équilibre : P_absorbée = P_émise\n→ T_eq = ((1 − a)·P_solaire / (4·σ))^(1/4)\nSans atmosphère : T_eq ≈ 255 K (−18 °C).","tags":"bilan-radiatif","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"Thème D — Énergie : conversions et transferts","chapitre":"D5 - Bilan thermique du système Terre-atmosphère","type":"application","recto":"Causes du dérèglement climatique ?","verso":"Augmentation de la concentration des gaz à effet de serre (CO₂ +50% depuis 1850, CH₄, N₂O) → renforcement de l'effet de serre → réchauffement global.","tags":"rechauffement","niveau":"Terminale","matiere":"Physique-Chimie"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Ensemble ?","verso":"Collection d'éléments. Notation : E = {x₁, x₂, ...}.\n• ∅ : ensemble vide.\n• Cardinal : Card(E) ou |E|.","tags":"ensemble;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Inclusion ?","verso":"A ⊂ B ⟺ ∀x ∈ A, x ∈ B.\nA = B ⟺ A ⊂ B et B ⊂ A (double inclusion).","tags":"inclusion","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"formula","recto":"Opérations ensemblistes ?","verso":"• A ∪ B = {x | x ∈ A ou x ∈ B}\n• A ∩ B = {x | x ∈ A et x ∈ B}\n• A \ B = {x ∈ A | x ∉ B}\n• A^c = E \ A (complémentaire dans E)","tags":"operations;ensembles","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"law","recto":"Lois de De Morgan ?","verso":"(A ∪ B)^c = A^c ∩ B^c\n(A ∩ B)^c = A^c ∪ B^c","tags":"de-morgan","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"formula","recto":"Cardinal d'une union (formule du crible) ?","verso":"|A ∪ B| = |A| + |B| − |A ∩ B|\n|A ∪ B ∪ C| = |A|+|B|+|C| − |A∩B|−|A∩C|−|B∩C| + |A∩B∩C|","tags":"crible","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Produit cartésien A × B ?","verso":"{(a, b) | a ∈ A, b ∈ B}\n|A × B| = |A| × |B| (cas fini).","tags":"produit-cartesien","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Ensemble des parties P(E) ?","verso":"P(E) = {A | A ⊂ E}.\nSi |E| = n, alors |P(E)| = 2ⁿ.","tags":"parties","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Relation d'ordre ?","verso":"Relation R sur E :\n• Réflexive : ∀x, xRx\n• Antisymétrique : xRy et yRx ⇒ x = y\n• Transitive : xRy et yRz ⇒ xRz","tags":"ordre","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Ordre total / partiel ?","verso":"Total : ∀x,y ∈ E, x ≤ y ou y ≤ x.\nPartiel : sinon (ex. inclusion sur P(E)).","tags":"ordre;total","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Majorant / Minorant ?","verso":"M majorant de A ⟺ ∀a ∈ A, a ≤ M.\nm minorant de A ⟺ ∀a ∈ A, m ≤ a.","tags":"majorant;minorant","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Borne supérieure sup(A) ?","verso":"Plus petit majorant de A (s'il existe). Si max(A) existe, sup(A) = max(A).","tags":"sup","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.1 - Ensembles","type":"definition","recto":"Maximum ?","verso":"M = max(A) ⟺ M est un majorant de A ET M ∈ A.\nN'existe pas toujours.","tags":"max","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Application f : E → F ?","verso":"Correspondance qui à tout x ∈ E associe un UNIQUE f(x) ∈ F. E : ensemble de départ. F : ensemble d'arrivée.","tags":"application;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Image directe f(A) ?","verso":"f(A) = {f(x) | x ∈ A} ⊂ F.\nC'est l'image de la partie A par f.","tags":"image-directe","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Image réciproque f⁻¹(B) ?","verso":"f⁻¹(B) = {x ∈ E | f(x) ∈ B} ⊂ E.\nNotation TROMPEUSE : f⁻¹ existe même si f n'est pas bijective.","tags":"image-reciproque","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"formula","recto":"Composition de deux applications ?","verso":"(g ∘ f)(x) = g(f(x)).\nNon commutative en général. Associative : h ∘ (g ∘ f) = (h ∘ g) ∘ f.","tags":"composition","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Injection ?","verso":"f injective ⟺ ∀x, x' ∈ E : f(x) = f(x') ⇒ x = x'.\nÉquivalent : tout y ∈ F a au plus UN antécédent.","tags":"injection","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Surjection ?","verso":"f surjective ⟺ ∀y ∈ F, ∃x ∈ E, f(x) = y.\nf(E) = F.","tags":"surjection","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Bijection ?","verso":"f bijective ⟺ injective ET surjective.\nÉquivalent : tout y ∈ F a EXACTEMENT UN antécédent.","tags":"bijection","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"definition","recto":"Bijection réciproque f⁻¹ ?","verso":"Si f : E → F bijective, f⁻¹ : F → E est définie par f⁻¹(y) = unique x tel que f(x) = y.\n• f ∘ f⁻¹ = id_F\n• f⁻¹ ∘ f = id_E","tags":"reciproque","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.2 - Applications","type":"law","recto":"Composition de bijections ?","verso":"Si f et g bijectives composables : g ∘ f bijective, et (g ∘ f)⁻¹ = f⁻¹ ∘ g⁻¹.","tags":"bijection;composition","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.3 - Principe de récurrence","type":"law","recto":"Axiomes de Peano (essentiels) ?","verso":"• 0 ∈ ℕ\n• ∀n ∈ ℕ, succ(n) ∈ ℕ\n• 0 n'est successeur d'aucun entier\n• succ injectif\n• Toute partie de ℕ contenant 0 et stable par succ est ℕ.","tags":"peano","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.3 - Principe de récurrence","type":"method","recto":"Récurrence simple ?","verso":"Pour montrer P(n) vraie ∀n ≥ n₀ :\n1. Initialisation : P(n₀) vraie.\n2. Hérédité : P(n) ⇒ P(n+1).","tags":"recurrence;simple","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.3 - Principe de récurrence","type":"method","recto":"Récurrence forte ?","verso":"Pour montrer P(n) :\n1. P(n₀) vraie.\n2. Pour tout n, [P(n₀) ∧ ... ∧ P(n)] ⇒ P(n+1).\nUtile quand P(n+1) dépend de plusieurs rangs antérieurs.","tags":"recurrence;forte","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.3 - Principe de récurrence","type":"method","recto":"Récurrence finie ?","verso":"Pour P(k) ∀k ∈ ⟦n₀, n₁⟧ :\n1. P(n₀) vraie.\n2. Pour n₀ ≤ k < n₁ : P(k) ⇒ P(k+1).","tags":"recurrence;finie","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.3 - Principe de récurrence","type":"method","recto":"Récurrence double ?","verso":"1. P(n₀) et P(n₀+1) vraies.\n2. P(n) ∧ P(n+1) ⇒ P(n+2).\nUsage typique : suites récurrentes d'ordre 2 (Fibonacci).","tags":"recurrence;double","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"definition","recto":"Ensemble fini ?","verso":"E fini ⟺ ∃n ∈ ℕ et bijection ⟦1, n⟧ → E.\nn = Card(E), unique.","tags":"fini","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"law","recto":"Image et bijection en cardinal fini ?","verso":"Si E, F finis et f : E → F :\n• f injective ⟹ |E| ≤ |F|\n• f surjective ⟹ |E| ≥ |F|\n• f bijective ⟺ |E| = |F| (avec injection ou surjection).","tags":"cardinal;application","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"law","recto":"Principe des tiroirs (Dirichlet) ?","verso":"Si f : E → F avec |E| > |F| (E, F finis), alors f n'est PAS injective.\n→ ∃ x ≠ x', f(x) = f(x').","tags":"tiroirs","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"formula","recto":"Nombre d'applications de E vers F ?","verso":"|F^E| = |F|^|E|\n(une application = choix de f(x) pour chaque x).","tags":"applications;nombre","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"formula","recto":"Nombre de bijections d'un ensemble à n éléments ?","verso":"n! (factorielle de n).","tags":"permutations","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"formula","recto":"Nombre d'injections de ⟦1,p⟧ dans un ensemble à n éléments ?","verso":"A_n^p = n × (n−1) × ... × (n−p+1) = n! / (n−p)!\n(arrangements).","tags":"arrangements","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"formula","recto":"Nombre de combinaisons C(n,p) ?","verso":"(n p) = n! / (p! × (n−p)!) si 0 ≤ p ≤ n, sinon 0.\nNombre de parties à p éléments d'un ensemble à n éléments.","tags":"combinaisons","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"formula","recto":"Symétrie et triangle de Pascal ?","verso":"(n p) = (n n−p)\n(n+1 p+1) = (n p) + (n p+1) (formule de Pascal)","tags":"pascal","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.4 - Ensembles finis et combinatoire","type":"formula","recto":"Binôme de Newton ?","verso":"(a+b)ⁿ = Σ_(k=0)^n (n k) aᵏ b^(n−k)\n(valable dans tout anneau commutatif).","tags":"binome","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"definition","recto":"Divisibilité dans ℤ ?","verso":"a | b ⟺ ∃k ∈ ℤ, b = a×k.\nProp. : 1 et a divisent toujours a. 0 est divisé par tous.","tags":"divisibilite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"law","recto":"Division euclidienne ?","verso":"∀(a,b) ∈ ℤ × ℕ*, ∃! (q,r) tq a = bq + r avec 0 ≤ r < b.","tags":"division-euclidienne","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"definition","recto":"PGCD ?","verso":"pgcd(a,b) = plus grand entier divisant à la fois a et b. Existe si (a,b) ≠ (0,0).","tags":"pgcd","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"definition","recto":"PPCM ?","verso":"ppcm(a,b) = plus petit entier strictement positif multiple à la fois de a et de b.","tags":"ppcm","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"formula","recto":"Lien PGCD-PPCM ?","verso":"pgcd(a,b) × ppcm(a,b) = |a × b|","tags":"pgcd-ppcm","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"method","recto":"Algorithme d'Euclide ?","verso":"pgcd(a, b) = pgcd(b, r) où a = bq + r.\nOn itère jusqu'à r = 0 ; le dernier reste non nul est le PGCD.","tags":"euclide","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"definition","recto":"Premiers entre eux ?","verso":"a ∧ b = pgcd(a,b) = 1.\n→ Aucun diviseur commun > 1.","tags":"premiers-entre-eux","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"law","recto":"Théorème de Bézout ?","verso":"pgcd(a,b) = d ⟺ ∃(u,v) ∈ ℤ², au + bv = d ET d divise a et b.\nCas particulier (a∧b=1) : ∃(u,v), au + bv = 1.","tags":"bezout","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"law","recto":"Théorème de Gauss ?","verso":"Si a | bc et a ∧ b = 1, alors a | c.","tags":"gauss","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"law","recto":"Lemme d'Euclide ?","verso":"Si p premier et p | ab, alors p | a ou p | b.","tags":"euclide;lemme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"definition","recto":"Nombre premier ?","verso":"p ≥ 2 dont les seuls diviseurs positifs sont 1 et p.","tags":"premier","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"law","recto":"Théorème fondamental de l'arithmétique ?","verso":"Tout entier n ≥ 2 s'écrit de manière unique (à l'ordre près) comme produit de nombres premiers : n = p₁^α₁ × ... × pₖ^αₖ.","tags":"decomposition","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"law","recto":"Infinité des nombres premiers (Euclide) ?","verso":"Il existe une infinité de nombres premiers.\nDémonstration : par l'absurde, si p₁,...,pₙ étaient tous, alors p₁×...×pₙ + 1 contredirait.","tags":"premiers;infinite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.5 - Arithmétique dans ℤ","type":"formula","recto":"Valuation p-adique ?","verso":"v_p(n) = exposant de p dans la décomposition de n.\nProp. : v_p(ab) = v_p(a) + v_p(b), v_p(a+b) ≥ min(v_p(a), v_p(b)).","tags":"valuation","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"definition","recto":"Borne supérieure dans ℝ ?","verso":"sup(A) = plus petit majorant de A.\nCaract. : M = sup(A) ⟺ ∀ε>0, ∃a ∈ A, M − ε < a ≤ M.","tags":"sup;reel","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"law","recto":"Théorème de la borne supérieure ?","verso":"Toute partie non vide majorée de ℝ admet une borne supérieure dans ℝ.\nC'est UNE PROPRIÉTÉ FONDAMENTALE de ℝ (qu'ℚ ne possède pas).","tags":"borne-sup","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"law","recto":"Caractérisation séquentielle de sup ?","verso":"M = sup(A) ⟺ M majore A et ∃ (xₙ) suite d'éléments de A telle que xₙ → M.","tags":"sup;sequentielle","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"definition","recto":"Partie entière ⌊x⌋ ?","verso":"⌊x⌋ = unique entier n tel que n ≤ x < n+1.\nProp. : x − 1 < ⌊x⌋ ≤ x.","tags":"partie-entiere","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"definition","recto":"Intervalle de ℝ ?","verso":"Partie I de ℝ telle que ∀x, y ∈ I, [x, y] ⊂ I.\n9 types : ∅, {a}, [a,b], ]a,b], etc., ℝ.","tags":"intervalle","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"law","recto":"Densité de ℚ dans ℝ ?","verso":"Entre deux réels distincts, il existe (au moins) un rationnel.\nÉquivalent : tout réel est limite d'une suite de rationnels.","tags":"densite;Q","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"law","recto":"Densité des irrationnels ?","verso":"Entre deux réels distincts, il existe (au moins) un irrationnel.","tags":"densite;irr","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.6 - Le corps des réels","type":"definition","recto":"Droite numérique achevée ℝ̄ ?","verso":"ℝ̄ = ℝ ∪ {−∞, +∞}.\nOrdre prolongé : −∞ < x < +∞ ∀x ∈ ℝ.\nOpérations partiellement définies (∞ − ∞ : indéterminé).","tags":"R-achevee","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"definition","recto":"ℂ ?","verso":"Corps engendré par ℝ et un élément i tel que i² = −1.\nz = a + ib, a, b ∈ ℝ.\nRe(z) = a, Im(z) = b.","tags":"complexe;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Conjugaison ?","verso":"z = a + ib ⇒ z̄ = a − ib.\n• z + z̄ = 2 Re(z), z − z̄ = 2i Im(z)\n• z·z̄ = |z|² ≥ 0\n• Conjugaison est un automorphisme : z+w = z̄+w̄, zw = z̄w̄.","tags":"conjugaison","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Module |z| ?","verso":"|z| = √(a² + b²) = √(zz̄).\n• |zw| = |z||w|, |z+w| ≤ |z|+|w| (inégalité triangulaire).\n• |z| = 0 ⟺ z = 0.","tags":"module","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Argument ?","verso":"arg(z) ∈ ℝ tel que z = |z|·(cos θ + i sin θ).\nDéfini modulo 2π. arg(0) non défini.","tags":"argument","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Forme exponentielle (Euler) ?","verso":"e^(iθ) = cos θ + i sin θ.\nz = |z|·e^(iθ) (forme polaire).","tags":"euler;forme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Formule de De Moivre ?","verso":"(cos θ + i sin θ)ⁿ = cos(nθ) + i sin(nθ)\nÉquiv. : (e^(iθ))ⁿ = e^(inθ).","tags":"de-moivre","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Formules d'Euler ?","verso":"cos θ = (e^(iθ) + e^(−iθ))/2\nsin θ = (e^(iθ) − e^(−iθ))/(2i)","tags":"euler;formules","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Argument d'un produit / quotient ?","verso":"arg(z·w) = arg(z) + arg(w) [2π]\narg(z/w) = arg(z) − arg(w) [2π]\narg(z̄) = −arg(z) [2π]","tags":"argument;proprietes","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Racines n-ièmes de l'unité ?","verso":"Solutions de zⁿ = 1 : zₖ = e^(2ikπ/n), k = 0, 1, ..., n−1.\nElles forment un sous-groupe cyclique de ℂ* d'ordre n. Notation 𝕌ₙ.","tags":"racines-unite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Racines n-ièmes d'un complexe a = re^(iα) ?","verso":"Solutions de zⁿ = a : zₖ = r^(1/n) · e^(i(α+2kπ)/n), k = 0, ..., n−1.\nIl y en a exactement n.","tags":"racines-n-ieme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"formula","recto":"Équation du 2nd degré dans ℂ : az² + bz + c = 0 ?","verso":"Δ = b² − 4ac.\nRacines : z = (−b ± δ)/(2a) où δ² = Δ.\nPas de cas Δ < 0 : on extrait toujours une racine carrée complexe.","tags":"second-degre;C","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.7 - Les nombres complexes","type":"method","recto":"Racines carrées d'un complexe a + ib ?","verso":"Z = x + iy avec Z² = a + ib :\n• x² − y² = a\n• 2xy = b\n• x² + y² = √(a²+b²)\nRésolution : x² = (a + √(a²+b²))/2, y² = (−a + √(a²+b²))/2, signe de xy = signe de b.","tags":"racine-carree;C","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Loi de composition interne (LCI) ?","verso":"Application * : E × E → E.\nNotation infixe : x * y.","tags":"lci","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Groupe (G, *) ?","verso":"Ensemble G avec LCI * tels que :\n1. Associativité : (a*b)*c = a*(b*c)\n2. Élément neutre e : a*e = e*a = a\n3. Tout élément a a un symétrique a' : a*a' = a'*a = e.","tags":"groupe","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Groupe abélien (commutatif) ?","verso":"Groupe où * est commutative : a * b = b * a ∀a,b.","tags":"groupe;abelien","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Sous-groupe ?","verso":"H ⊂ G non vide, stable par * et par symétrique.\nCaract. : ∀x, y ∈ H, x * y⁻¹ ∈ H.","tags":"sous-groupe","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Morphisme de groupes ?","verso":"f : (G, *) → (G', ⊥) tel que f(x * y) = f(x) ⊥ f(y) ∀x, y.\nProp. : f(eG) = eG', f(x⁻¹) = f(x)⁻¹.","tags":"morphisme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Noyau et image d'un morphisme ?","verso":"Ker(f) = {x ∈ G | f(x) = eG'} (sous-groupe de G).\nIm(f) = f(G) (sous-groupe de G').\nf injective ⟺ Ker(f) = {eG}.","tags":"noyau;image","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Anneau (A, +, ×) ?","verso":"(A, +) groupe abélien.\n× associative, distributive sur +.\nÉlément neutre 1 pour ×.","tags":"anneau","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Anneau commutatif ?","verso":"Anneau où × est commutative.","tags":"anneau;commutatif","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Anneau intègre ?","verso":"Anneau commutatif (≠ {0}) sans diviseur de zéro :\nab = 0 ⇒ a = 0 ou b = 0.","tags":"anneau;integre","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"definition","recto":"Corps (𝕂, +, ×) ?","verso":"Anneau commutatif (≠ {0}) où tout élément non nul est inversible pour ×.\nEx. : ℚ, ℝ, ℂ, ℤ/pℤ pour p premier.","tags":"corps","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.12 - Groupes, anneaux, corps","type":"formula","recto":"Identités remarquables (anneau commutatif) ?","verso":"(a+b)ⁿ = Σ (n k) aᵏ b^(n−k)  (binôme)\naⁿ − bⁿ = (a − b)(a^(n−1) + a^(n−2)b + ... + b^(n−1))\na² − b² = (a−b)(a+b)\na³ ± b³ = (a ± b)(a² ∓ ab + b²)","tags":"identites","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"definition","recto":"Polynôme P ∈ 𝕂[X] ?","verso":"Suite (a₀, a₁, a₂, ...) presque nulle (nulle à partir d'un rang).\nÉcriture : P = a₀ + a₁X + a₂X² + ...","tags":"polynome;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"definition","recto":"Degré deg(P) ?","verso":"Plus grand indice n tel que aₙ ≠ 0.\ndeg(0) = −∞ par convention.","tags":"degre","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"formula","recto":"Degré d'une somme / produit ?","verso":"deg(P + Q) ≤ max(deg P, deg Q)\ndeg(PQ) = deg P + deg Q (dans un anneau intègre).","tags":"degre;operations","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"definition","recto":"Coefficient dominant ?","verso":"Coefficient de X^(deg P). Polynôme unitaire : coefficient dominant = 1.","tags":"dominant","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"law","recto":"Division euclidienne dans 𝕂[X] ?","verso":"∀(A, B) ∈ 𝕂[X] × 𝕂[X]*, ∃! (Q, R) tq A = BQ + R avec deg R < deg B.","tags":"polynome;division","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"formula","recto":"Composition / dérivée ?","verso":"(P + Q)' = P' + Q'\n(PQ)' = P'Q + PQ'\n(P^n)' = n × P' × P^(n-1)\n(P ∘ Q)' = Q' × (P' ∘ Q)","tags":"polynome;derivee","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.24 - Polynômes à une indéterminée","type":"formula","recto":"Formule de Taylor pour polynôme ?","verso":"P(X) = Σ_(k=0)^n (P^(k)(a) / k!) × (X − a)^k.\nValable pour tout polynôme et tout a (somme finie).","tags":"taylor;poly","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.25 - Arithmétique des polynômes","type":"definition","recto":"Divisibilité dans 𝕂[X] ?","verso":"B | A ⟺ ∃Q, A = BQ.\nDeux polynômes A, B sont associés ⟺ ∃ λ ∈ 𝕂*, A = λB.","tags":"div;poly","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.25 - Arithmétique des polynômes","type":"definition","recto":"PGCD de polynômes ?","verso":"Polynôme UNITAIRE de degré maximum divisant à la fois A et B.\nUnique (modulo unitaire).","tags":"pgcd;poly","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.25 - Arithmétique des polynômes","type":"law","recto":"Théorème de Bézout (polynômes) ?","verso":"PGCD(A, B) = D ⟺ ∃ U, V ∈ 𝕂[X], AU + BV = D.\nA ∧ B = 1 ⟺ ∃ U, V, AU + BV = 1.","tags":"bezout;poly","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.25 - Arithmétique des polynômes","type":"law","recto":"Théorème de Gauss (polynômes) ?","verso":"Si A | BC et A ∧ B = 1, alors A | C.","tags":"gauss;poly","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.25 - Arithmétique des polynômes","type":"definition","recto":"Polynôme irréductible ?","verso":"Polynôme P ∈ 𝕂[X] non constant qui n'a pour diviseurs que les constantes et ses associés.","tags":"irreductible","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.25 - Arithmétique des polynômes","type":"application","recto":"Polynômes irréductibles dans ℝ[X] et ℂ[X] ?","verso":"• ℂ[X] : irréductibles = polynômes de degré 1 (théorème de d'Alembert-Gauss).\n• ℝ[X] : irréductibles = polynômes de degré 1 OU degré 2 à Δ < 0.","tags":"irreductible;R;C","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.26 - Racines d'un polynôme","type":"definition","recto":"Racine d'un polynôme ?","verso":"α est racine de P ⟺ P(α) = 0.\nÉquiv. : (X − α) | P.","tags":"racine","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.26 - Racines d'un polynôme","type":"definition","recto":"Multiplicité d'une racine ?","verso":"α est racine d'ordre k ⟺ (X − α)^k | P et (X − α)^(k+1) ∤ P.\nÉquiv. : P(α) = P'(α) = ... = P^(k−1)(α) = 0 et P^(k)(α) ≠ 0.","tags":"multiplicite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.26 - Racines d'un polynôme","type":"law","recto":"Théorème de d'Alembert-Gauss ?","verso":"Tout polynôme non constant de ℂ[X] admet au moins une racine dans ℂ.\nConséquence : tout P de degré n ≥ 1 a exactement n racines comptées avec multiplicité.","tags":"d-alembert","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.26 - Racines d'un polynôme","type":"formula","recto":"Relations coefficients-racines ?","verso":"Pour P = X² + bX + c de racines α, β :\nα + β = −b, α × β = c.\nGénéralisation par les fonctions symétriques élémentaires (relations de Viète).","tags":"viete","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.26 - Racines d'un polynôme","type":"application","recto":"Racines conjuguées dans ℝ[X] ?","verso":"Si P ∈ ℝ[X] et z ∈ ℂ \ ℝ est racine, alors z̄ aussi (avec même multiplicité).","tags":"racines-conjuguees","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.27-28 - Fractions rationnelles","type":"definition","recto":"Fraction rationnelle ?","verso":"Élément de 𝕂(X) = corps des fractions de 𝕂[X].\nF = P/Q avec P, Q ∈ 𝕂[X], Q ≠ 0.","tags":"fraction","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.27-28 - Fractions rationnelles","type":"definition","recto":"Pôle d'une fraction ?","verso":"Racine de Q (après simplification du PGCD avec P).\nMultiplicité du pôle = multiplicité de cette racine dans Q.","tags":"pole","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.27-28 - Fractions rationnelles","type":"law","recto":"Décomposition en éléments simples sur ℂ ?","verso":"Toute fraction P/Q ∈ ℂ(X) avec deg P < deg Q se décompose en éléments simples :\nF = Σ c_(i,k) / (X − α_i)^k\noù α_i sont les pôles avec multiplicités.","tags":"des;C","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.27-28 - Fractions rationnelles","type":"law","recto":"Décomposition sur ℝ ?","verso":"Sur ℝ : éléments simples de 1ʳᵉ espèce a/(X−α)^k et de 2ⁿᵈᵉ espèce (aX+b)/(X²+pX+q)^k où X²+pX+q irréductible.","tags":"des;R","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre fondamentale","chapitre":"Ch.27-28 - Fractions rationnelles","type":"method","recto":"Calcul d'un coefficient (multiplication-évaluation) ?","verso":"Pour récupérer le coefficient de 1/(X−α) dans F = P/Q :\nMultiplier F par (X − α), simplifier, évaluer en α.\nDonne directement le coefficient (pôle simple).","tags":"des;methode","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.13 - Systèmes linéaires","type":"definition","recto":"Système linéaire ?","verso":"Système de m équations à n inconnues : Σ a_(ij)·xⱼ = bᵢ pour i = 1, ..., m.\nForme matricielle : AX = B, A ∈ M_(m,n)(𝕂), X ∈ 𝕂ⁿ, B ∈ 𝕂ᵐ.","tags":"systeme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.13 - Systèmes linéaires","type":"definition","recto":"Système homogène ?","verso":"B = 0. Toujours compatible (X = 0 est solution).","tags":"homogene","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.13 - Systèmes linéaires","type":"method","recto":"Méthode du pivot de Gauss ?","verso":"Échelonner la matrice par opérations élémentaires sur les lignes :\n• Lᵢ ← λLᵢ (λ ≠ 0)\n• Lᵢ ← Lᵢ + λLⱼ\n• Lᵢ ↔ Lⱼ\n→ matrice échelonnée → résolution par remontée.","tags":"gauss;pivot","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.13 - Systèmes linéaires","type":"definition","recto":"Système échelonné réduit ?","verso":"Forme dans laquelle chaque ligne non nulle a un pivot (1 dans la colonne pivot, 0 ailleurs dans la même colonne).","tags":"echelonne;reduit","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.13 - Systèmes linéaires","type":"application","recto":"Rang d'un système ?","verso":"Nombre de pivots dans la matrice échelonnée.\nrg(A) = nb pivots = nb équations utiles.","tags":"rang","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.13 - Systèmes linéaires","type":"law","recto":"Théorème de Rouché-Fontené ?","verso":"AX = B compatible ⟺ rg(A) = rg([A|B]).\nDimension de l'ensemble des solutions = n − rg(A) (si compatible).","tags":"rouche","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Espace vectoriel sur 𝕂 (𝕂-ev) ?","verso":"(E, +, ·) tel que :\n• (E, +) groupe abélien\n• λ·(x + y) = λ·x + λ·y\n• (λ + μ)·x = λ·x + μ·x\n• (λμ)·x = λ·(μ·x)\n• 1·x = x","tags":"ev","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"application","recto":"Exemples standard d'ev ?","verso":"𝕂ⁿ, 𝕂[X], M_(n,p)(𝕂), F(I, 𝕂), C^k(I, ℝ), suites, séries...","tags":"ev;exemples","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Sous-espace vectoriel (sev) ?","verso":"F ⊂ E non vide, stable par + et par produit scalaire.\nCaract. : 0 ∈ F et ∀x,y ∈ F, ∀λ ∈ 𝕂, λx + y ∈ F.","tags":"sev","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"law","recto":"Intersection de sev ?","verso":"Toute intersection de sev est un sev.\nAttention : la RÉUNION n'est PAS un sev en général.","tags":"sev;intersection","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Combinaison linéaire ?","verso":"v = Σ λᵢ vᵢ avec λᵢ ∈ 𝕂.","tags":"combinaison","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Sous-espace engendré Vect(A) ?","verso":"Plus petit sev contenant A.\n= ensemble des combinaisons linéaires d'éléments de A.","tags":"vect","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Somme de sev F + G ?","verso":"{x + y | x ∈ F, y ∈ G}. C'est un sev.","tags":"somme;sev","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Somme directe F ⊕ G ?","verso":"F + G en somme directe ⟺ F ∩ G = {0}.\nÉquiv. : tout x ∈ F + G se décompose de manière UNIQUE en x = x_F + x_G.","tags":"somme-directe","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.14 - Espaces vectoriels","type":"definition","recto":"Sev supplémentaires ?","verso":"F et G supplémentaires dans E ⟺ E = F ⊕ G.\n→ tout x ∈ E se décompose de façon unique en x_F + x_G.","tags":"supplementaires","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"definition","recto":"Famille libre ?","verso":"(v₁, ..., vₙ) libre ⟺ Σ λᵢvᵢ = 0 ⇒ tous λᵢ = 0.\nAucun vecteur n'est combinaison linéaire des autres.","tags":"libre","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"definition","recto":"Famille génératrice ?","verso":"(v₁, ..., vₙ) génératrice de E ⟺ Vect(v₁,...,vₙ) = E.\nTout x ∈ E s'écrit x = Σλᵢvᵢ.","tags":"generatrice","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"definition","recto":"Base ?","verso":"Famille à la fois libre ET génératrice.\nÉquiv. : tout x s'écrit de manière UNIQUE comme combinaison linéaire des éléments de la base.","tags":"base","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"definition","recto":"Dimension ?","verso":"Si E admet une base finie, dim(E) = nb d'éléments d'une base (toutes les bases ont même cardinal).\nE = {0} : dim 0.","tags":"dimension","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"law","recto":"Théorème de la base incomplète ?","verso":"Toute famille libre peut être complétée en une base.\nToute famille génératrice contient une base.","tags":"base-incomplete","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"formula","recto":"Dimensions de référence ?","verso":"• dim(𝕂ⁿ) = n\n• dim(𝕂_n[X]) = n+1\n• dim(M_(n,p)(𝕂)) = np\n• dim(ℂ comme ℝ-ev) = 2","tags":"dim;exemples","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"law","recto":"Caractérisation par la dimension ?","verso":"Si dim E = n :\n• Toute famille libre de n vecteurs est une base.\n• Toute famille génératrice de n vecteurs est une base.","tags":"base;caracterisation","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.15 - Familles de vecteurs","type":"law","recto":"Formule de Grassmann ?","verso":"dim(F + G) = dim F + dim G − dim(F ∩ G)","tags":"grassmann","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Application linéaire f : E → F ?","verso":"f(x + y) = f(x) + f(y) ET f(λx) = λf(x).\nÉquiv. : f(λx + μy) = λf(x) + μf(y) ∀ λ,μ,x,y.","tags":"lineaire;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Endomorphisme / Automorphisme ?","verso":"Endo : f : E → E linéaire.\nAuto : endo bijectif.\nIso : application linéaire bijective.","tags":"endo;iso","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Noyau et image ?","verso":"Ker(f) = {x ∈ E | f(x) = 0} (sev de E).\nIm(f) = {f(x) | x ∈ E} = f(E) (sev de F).\nf injective ⟺ Ker(f) = {0}.","tags":"ker;im","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Rang d'une application linéaire ?","verso":"rg(f) = dim Im(f).","tags":"rang;app","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"law","recto":"Théorème du rang ?","verso":"Si E de dim finie, f : E → F linéaire :\ndim E = dim Ker(f) + rg(f)\nIndispensable.","tags":"rang;theoreme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"application","recto":"Caract. d'isomorphisme en dim finie ?","verso":"Si dim E = dim F finie :\nf injective ⟺ f surjective ⟺ f bijective.","tags":"iso;caracterisation","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Espace L(E, F) ?","verso":"Ensemble des applications linéaires de E vers F. C'est un 𝕂-ev.\ndim L(E, F) = dim E × dim F (en dim finie).","tags":"L-EF","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Algèbre L(E) ?","verso":"Endomorphismes de E. Anneau pour la composition. Algèbre.\nÉléments inversibles = automorphismes : GL(E).","tags":"L-E","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Projecteur ?","verso":"Endomorphisme p tel que p² = p.\nE = Ker(p) ⊕ Im(p).\np est projecteur sur Im(p) parallèlement à Ker(p).","tags":"projecteur","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"definition","recto":"Symétrie (involution) ?","verso":"Endomorphisme s tel que s² = id.\nE = Ker(s − id) ⊕ Ker(s + id).\nReliée au projecteur p par s = 2p − id.","tags":"symetrie","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.16-17 - Applications linéaires","type":"formula","recto":"Hyperplan ?","verso":"Sev H de E de dim n−1 (codimension 1).\nNoyau d'une forme linéaire non nulle.","tags":"hyperplan","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Matrice m × n ?","verso":"Tableau A = (a_(ij)) à m lignes et n colonnes, a_(ij) ∈ 𝕂.\nM_(m,n)(𝕂) est un 𝕂-ev de dimension mn.","tags":"matrice","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"formula","recto":"Produit matriciel A × B ?","verso":"(AB)_(ij) = Σ_(k=1)^p a_(ik)·b_(kj)\nA ∈ M_(m,p), B ∈ M_(p,n), AB ∈ M_(m,n).\nNON commutatif. Associatif.","tags":"produit-mat","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Matrice identité I_n ?","verso":"Diagonale de 1 (taille n×n). Élément neutre du produit.","tags":"identite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Transposée ?","verso":"ᵗA défini par (ᵗA)_(ij) = a_(ji).\n• ᵗ(AB) = ᵗB · ᵗA (produit transposé)\n• ᵗ(A + B) = ᵗA + ᵗB","tags":"transposee","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Matrice inversible ?","verso":"A ∈ M_n(𝕂) inversible ⟺ ∃ B, AB = BA = I_n.\nB = A⁻¹. GL_n(𝕂) = ensemble des inversibles.","tags":"inversible","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"application","recto":"Caractérisations de l'inversibilité ?","verso":"A inversible ⟺ rg(A) = n ⟺ det(A) ≠ 0 ⟺ Ker(A) = {0} ⟺ colonnes/lignes libres.","tags":"inversible;caract","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"formula","recto":"Inverse d'un produit ?","verso":"(AB)⁻¹ = B⁻¹A⁻¹\n(ᵗA)⁻¹ = ᵗ(A⁻¹)","tags":"inversion;produit","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Matrice d'une application linéaire ?","verso":"Mat_𝓑,𝓒(f) : colonnes = coordonnées des f(eⱼ) dans la base 𝓒.\nf(x) en colonnes : Mat(f) · X = Y.","tags":"matrice;app","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"formula","recto":"Changement de base ?","verso":"X = P · X' (P matrice de passage 𝓑 → 𝓑').\nMat_𝓑'(f) = P⁻¹ · Mat_𝓑(f) · P.","tags":"changement-base","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Matrices semblables ?","verso":"A et B semblables ⟺ ∃P inversible, B = P⁻¹AP.\nReprésentent le même endomorphisme dans des bases différentes.","tags":"semblables","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.18 - Calcul matriciel","type":"definition","recto":"Trace ?","verso":"tr(A) = Σ a_(ii) (somme des éléments diagonaux).\n• tr(A + B) = tr A + tr B\n• tr(AB) = tr(BA)\n• tr invariante par changement de base.","tags":"trace","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"definition","recto":"Déterminant d'ordre 2 ?","verso":"det(a b // c d) = ad − bc","tags":"det;2","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"definition","recto":"Déterminant d'ordre 3 (Sarrus) ?","verso":"det(M) = aei + bfg + cdh − ceg − afh − bdi  (matrice 3×3 (a b c // d e f // g h i)).","tags":"det;3;sarrus","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"formula","recto":"Développement par ligne/colonne ?","verso":"det(A) = Σⱼ (−1)^(i+j) · a_(ij) · M_(ij)\noù M_(ij) est le mineur (déterminant de A privée de la i-ème ligne et j-ème colonne).","tags":"developpement","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"law","recto":"Propriétés du déterminant ?","verso":"• det(AB) = det(A) · det(B)\n• det(ᵗA) = det(A)\n• det(λA) = λⁿ det(A) (A ∈ Mₙ)\n• det(A⁻¹) = 1/det(A)\n• det invariant par opérations Lᵢ ← Lᵢ + λLⱼ.","tags":"det;proprietes","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"application","recto":"Critère d'inversibilité ?","verso":"A inversible ⟺ det(A) ≠ 0.","tags":"det;inversibilite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"formula","recto":"Formule de Cramer ?","verso":"Pour AX = B avec A inversible : xᵢ = det(Aᵢ) / det(A) où Aᵢ est obtenue en remplaçant la i-ème colonne de A par B.","tags":"cramer","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.19 - Déterminant","type":"formula","recto":"Comatrice et inverse ?","verso":"Com(A) = matrice des cofacteurs (−1)^(i+j) M_(ij).\nA · ᵗCom(A) = det(A) · I.\n→ A⁻¹ = (1/det A) · ᵗCom(A).","tags":"comatrice","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"definition","recto":"Produit scalaire sur ℝ-ev ?","verso":"Forme bilinéaire SYMÉTRIQUE, DÉFINIE POSITIVE :\n• (x|y) = (y|x)\n• (·|·) bilinéaire\n• (x|x) ≥ 0 et (x|x) = 0 ⟺ x = 0.","tags":"produit-scalaire;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"formula","recto":"Norme euclidienne ?","verso":"‖x‖ = √(x|x).\nProp. : ‖λx‖ = |λ|·‖x‖, ‖x+y‖ ≤ ‖x‖+‖y‖ (triangulaire).","tags":"norme;euclidienne","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"law","recto":"Inégalité de Cauchy-Schwarz ?","verso":"|(x|y)| ≤ ‖x‖ × ‖y‖\nÉgalité ⟺ x et y colinéaires.","tags":"cauchy-schwarz","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"definition","recto":"Orthogonalité ?","verso":"x ⊥ y ⟺ (x|y) = 0.\nFamille orthogonale : vecteurs deux à deux orthogonaux.\nFamille orthonormée : orthogonale + tous unitaires.","tags":"orthogonal","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"law","recto":"Théorème de Pythagore ?","verso":"x ⊥ y ⟺ ‖x + y‖² = ‖x‖² + ‖y‖².","tags":"pythagore","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"method","recto":"Procédé de Gram-Schmidt ?","verso":"Transformer (vᵢ) libre en (eᵢ) orthonormée :\ne₁ = v₁ / ‖v₁‖\nuₖ = vₖ − Σᵢ<ₖ (vₖ|eᵢ)·eᵢ\neₖ = uₖ / ‖uₖ‖","tags":"gram-schmidt","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"definition","recto":"Sev orthogonal F⊥ ?","verso":"F⊥ = {x ∈ E | ∀y ∈ F, (x|y) = 0}.\nE = F ⊕ F⊥ (en dim finie).","tags":"orthogonal;sev","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"definition","recto":"Projection orthogonale sur F ?","verso":"p_F(x) = projection de x sur F parallèlement à F⊥.\nEn base orthonormée (e₁,...,eₚ) de F : p_F(x) = Σ (x|eᵢ)·eᵢ.","tags":"projection-ortho","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.20 - Espaces euclidiens","type":"formula","recto":"Distance d'un point à un sev ?","verso":"d(x, F) = ‖x − p_F(x)‖ = inf_(y ∈ F) ‖x − y‖.","tags":"distance;sev","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.21 - Groupe orthogonal","type":"definition","recto":"Endomorphisme orthogonal ?","verso":"f ∈ L(E) tel que ∀x, ‖f(x)‖ = ‖x‖.\nÉquiv. : (f(x)|f(y)) = (x|y) (conserve le produit scalaire).","tags":"ortho;endo","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.21 - Groupe orthogonal","type":"definition","recto":"Matrice orthogonale ?","verso":"M ∈ Mₙ(ℝ) telle que ᵗM·M = I_n.\nÉquiv. : ᵗM = M⁻¹.\nÉquiv. : colonnes (et lignes) forment une BON.","tags":"matrice-orthogonale","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.21 - Groupe orthogonal","type":"law","recto":"Groupe orthogonal Oₙ(ℝ) ?","verso":"Ensemble des matrices orthogonales : sous-groupe de GLₙ(ℝ).\ndet(M) = ±1 si M orthogonale.\nSO_n(ℝ) = matrices orthogonales avec det = 1 (rotations).","tags":"On","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.21 - Groupe orthogonal","type":"application","recto":"Rotations en dim 2 ?","verso":"R_θ = (cos θ, −sin θ // sin θ, cos θ) ∈ SO₂(ℝ).\nR_θ · R_φ = R_(θ+φ).","tags":"rotation;2D","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Algèbre linéaire","chapitre":"Ch.21 - Groupe orthogonal","type":"application","recto":"Symétries en dim 2 ?","verso":"Réflexion d'axe d'angle θ/2 :\nS_θ = (cos θ, sin θ // sin θ, −cos θ).\ndet = −1, S² = id.","tags":"reflexion;2D","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.8 - Géométrie plane","type":"formula","recto":"Identification 𝒫 ↔ ℂ ?","verso":"M(x, y) ↔ z = x + iy (affixe).\n• Vecteur ⃗AB ↔ z_B − z_A\n• Distance AB = |z_B − z_A|\n• Angle (⃗AB, ⃗AC) = arg((z_C − z_A)/(z_B − z_A)) [2π]","tags":"affixe","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.8 - Géométrie plane","type":"formula","recto":"Équation cartésienne d'une droite ?","verso":"ax + by + c = 0\nVecteur normal : (a, b). Vecteur directeur : (−b, a).","tags":"droite;cartesienne","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.8 - Géométrie plane","type":"formula","recto":"Équation paramétrique d'une droite ?","verso":"(x, y) = (x₀ + ta, y₀ + tb), t ∈ ℝ.\n(a, b) directeur, (x₀, y₀) point.","tags":"droite;parametrique","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.8 - Géométrie plane","type":"formula","recto":"Distance d'un point à une droite ?","verso":"Distance de M(x₀, y₀) à ax + by + c = 0 :\nd = |ax₀ + by₀ + c| / √(a² + b²)","tags":"distance;droite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.8 - Géométrie plane","type":"formula","recto":"Équation d'un cercle ?","verso":"(x − a)² + (y − b)² = r²\nCentre (a, b), rayon r > 0.","tags":"cercle","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.8 - Géométrie plane","type":"formula","recto":"Cercle par son équation générale ?","verso":"x² + y² + αx + βy + γ = 0\n→ centre (−α/2, −β/2), rayon √((α² + β²)/4 − γ) si > 0.","tags":"cercle;general","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.9 - Coniques","type":"definition","recto":"Conique ?","verso":"Lieu géométrique défini par : MF/MD = e (excentricité), où F foyer, D directrice.\n• e = 0 : cercle\n• 0 < e < 1 : ellipse\n• e = 1 : parabole\n• e > 1 : hyperbole","tags":"conique;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.9 - Coniques","type":"formula","recto":"Ellipse — équation réduite ?","verso":"x²/a² + y²/b² = 1 (a > b > 0).\nFoyers : F(±c, 0), c² = a² − b². e = c/a.","tags":"ellipse","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.9 - Coniques","type":"formula","recto":"Hyperbole — équation réduite ?","verso":"x²/a² − y²/b² = 1.\nFoyers : (±c, 0), c² = a² + b². e = c/a > 1.\nAsymptotes : y = ±(b/a)x.","tags":"hyperbole","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.9 - Coniques","type":"formula","recto":"Parabole — équation réduite ?","verso":"y² = 2px\nFoyer F(p/2, 0). Directrice x = −p/2. e = 1.","tags":"parabole","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Plan par équation cartésienne ?","verso":"ax + by + cz + d = 0\n(a, b, c) = vecteur NORMAL au plan.","tags":"plan;cartesien","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Distance d'un point à un plan ?","verso":"d(M, P) = |ax₀ + by₀ + cz₀ + d| / √(a² + b² + c²)","tags":"distance;plan","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Équation paramétrique d'un plan ?","verso":"M = A + s·⃗u + t·⃗v, (s, t) ∈ ℝ².\n⃗u, ⃗v non colinéaires, vecteurs directeurs.","tags":"plan;parametrique","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Équation d'une droite par point + directeur ?","verso":"(x, y, z) = (x₀ + ta, y₀ + tb, z₀ + tc), t ∈ ℝ.\nDroite ⊂ ℝ³ caractérisable par 2 équations cartésiennes (intersection de 2 plans).","tags":"droite;3D","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Sphère ?","verso":"(x−a)² + (y−b)² + (z−c)² = r²\nCentre (a,b,c), rayon r.","tags":"sphere","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Produit vectoriel ?","verso":"⃗u ∧ ⃗v = (u₂v₃ − u₃v₂, u₃v₁ − u₁v₃, u₁v₂ − u₂v₁)\n• ⃗u ∧ ⃗v = ⃗0 ⟺ ⃗u, ⃗v colinéaires\n• ⃗u ∧ ⃗v ⊥ à ⃗u et ⃗v\n• ‖⃗u ∧ ⃗v‖ = ‖⃗u‖·‖⃗v‖·|sin(⃗u, ⃗v)|","tags":"produit-vectoriel","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Géométrie","chapitre":"Ch.11 - Géométrie dans l'espace","type":"formula","recto":"Produit mixte ?","verso":"[⃗u, ⃗v, ⃗w] = (⃗u ∧ ⃗v) · ⃗w = det(⃗u, ⃗v, ⃗w)\nVolume du parallélépipède construit sur ⃗u, ⃗v, ⃗w.","tags":"produit-mixte","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.29 - Logarithme, exponentielle, puissance","type":"definition","recto":"ln (logarithme népérien) ?","verso":"Unique primitive sur ]0,+∞[ de x ↦ 1/x s'annulant en 1.\nln : ]0,+∞[ → ℝ, bijective, strictement croissante.","tags":"ln","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.29 - Logarithme, exponentielle, puissance","type":"formula","recto":"Propriétés du ln ?","verso":"ln(ab) = ln a + ln b\nln(a/b) = ln a − ln b\nln(aⁿ) = n·ln a\nln(1) = 0, ln(e) = 1\nLimites : ln(0⁺) = −∞, ln(+∞) = +∞","tags":"ln;proprietes","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.29 - Logarithme, exponentielle, puissance","type":"definition","recto":"exp ?","verso":"Bijection réciproque de ln. exp : ℝ → ]0,+∞[, exp(x) = eˣ.\n(exp)' = exp.\nexp(0) = 1, exp(1) = e ≈ 2,7183.","tags":"exp","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.29 - Logarithme, exponentielle, puissance","type":"formula","recto":"Croissances comparées ?","verso":"Pour α > 0, β > 0 :\n• lim_(x→+∞) eˣ/xᵃ = +∞\n• lim_(x→+∞) (ln x)^β / xᵃ = 0\n• lim_(x→0⁺) xᵃ × (ln x)^β = 0\n« exp ≫ puissance ≫ ln »","tags":"croissances-comparees","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.29 - Logarithme, exponentielle, puissance","type":"formula","recto":"Puissance xᵃ avec a ∈ ℝ ?","verso":"Pour x > 0 : xᵃ = e^(a·ln x).\nDérivée : (xᵃ)' = a·xᵃ⁻¹.","tags":"puissance","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.30 - Trigonométrie","type":"formula","recto":"Valeurs remarquables ?","verso":"θ : 0, π/6, π/4, π/3, π/2\nsin: 0, 1/2, √2/2, √3/2, 1\ncos: 1, √3/2, √2/2, 1/2, 0\ntan: 0, √3/3, 1, √3, indef","tags":"trigo;valeurs","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.30 - Trigonométrie","type":"formula","recto":"Identités fondamentales ?","verso":"cos²θ + sin²θ = 1\n1 + tan²θ = 1/cos²θ\ntan(θ) = sin(θ)/cos(θ)","tags":"trigo;identites","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.30 - Trigonométrie","type":"formula","recto":"Formules d'addition ?","verso":"cos(a±b) = cos a cos b ∓ sin a sin b\nsin(a±b) = sin a cos b ± cos a sin b\ntan(a±b) = (tan a ± tan b)/(1 ∓ tan a tan b)","tags":"addition","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.30 - Trigonométrie","type":"formula","recto":"Formules de duplication ?","verso":"cos(2a) = cos²a − sin²a = 2cos²a − 1 = 1 − 2sin²a\nsin(2a) = 2 sin a cos a\ntan(2a) = 2 tan a / (1 − tan²a)","tags":"duplication","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.30 - Trigonométrie","type":"formula","recto":"Formules de linéarisation ?","verso":"cos²a = (1 + cos 2a)/2\nsin²a = (1 − cos 2a)/2\nsin a · cos b = (1/2)[sin(a+b) + sin(a−b)]","tags":"linearisation","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.30 - Trigonométrie","type":"formula","recto":"Fonctions trigonométriques inverses ?","verso":"arcsin : [−1,1] → [−π/2, π/2], dérivée 1/√(1−x²).\narccos : [−1,1] → [0, π], dérivée −1/√(1−x²).\narctan : ℝ → ]−π/2, π/2[, dérivée 1/(1+x²).","tags":"trigo-inverses","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.31 - Fonctions hyperboliques","type":"formula","recto":"ch, sh, th ?","verso":"ch(x) = (eˣ + e⁻ˣ)/2  (cosinus hyp.)\nsh(x) = (eˣ − e⁻ˣ)/2  (sinus hyp.)\nth(x) = sh(x)/ch(x)","tags":"hyperbolique;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.31 - Fonctions hyperboliques","type":"formula","recto":"Identité fondamentale hyp. ?","verso":"ch²x − sh²x = 1\n(Diff. avec trigo : signe −).","tags":"hyp;identite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.31 - Fonctions hyperboliques","type":"formula","recto":"Dérivées hyperboliques ?","verso":"ch'(x) = sh(x)\nsh'(x) = ch(x)\nth'(x) = 1 − th²(x) = 1/ch²(x)","tags":"hyp;derivees","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.31 - Fonctions hyperboliques","type":"formula","recto":"Fonctions hyperboliques inverses (argch, argsh, argth) ?","verso":"argch(x) = ln(x + √(x²−1))  pour x ≥ 1\nargsh(x) = ln(x + √(x²+1))  pour x ∈ ℝ\nargth(x) = ½·ln((1+x)/(1−x))  pour |x| < 1","tags":"hyp;inverses","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"definition","recto":"Suite convergente ?","verso":"uₙ → ℓ ⟺ ∀ε>0, ∃N, ∀n ≥ N, |uₙ − ℓ| < ε.\nUnicité de la limite.","tags":"suite;convergence","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"definition","recto":"Suite divergente ?","verso":"Suite non convergente.\nDeux cas : limite ±∞ (divergente vers ±∞) ou pas de limite.","tags":"suite;divergence","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"law","recto":"Théorème : convergente ⇒ bornée.","verso":"Toute suite convergente est bornée.\nRéciproque FAUSSE : (−1)ⁿ bornée mais divergente.","tags":"suite;borne","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"law","recto":"Théorème de la limite monotone ?","verso":"Suite croissante majorée → converge vers sup.\nSuite décroissante minorée → converge vers inf.\nSi non bornée : tend vers ±∞.","tags":"suite;monotone","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"law","recto":"Théorème des gendarmes ?","verso":"Si vₙ ≤ uₙ ≤ wₙ et vₙ, wₙ → ℓ, alors uₙ → ℓ.","tags":"gendarmes;suite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"law","recto":"Théorème de la suite extraite ?","verso":"(uₙ) → ℓ ⟹ toute sous-suite (u_(φ(n))) → ℓ.\nContraposée utile pour montrer la divergence.","tags":"extraite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"law","recto":"Théorème de Bolzano-Weierstrass ?","verso":"De toute suite réelle BORNÉE, on peut extraire une sous-suite CONVERGENTE.","tags":"bolzano-weierstrass","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"definition","recto":"Suite de Cauchy ?","verso":"(uₙ) Cauchy ⟺ ∀ε>0, ∃N, ∀p,q ≥ N, |u_p − u_q| < ε.\nDans ℝ : Cauchy ⟺ convergente (ℝ est complet).","tags":"cauchy;suite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"definition","recto":"Suites adjacentes ?","verso":"(uₙ) ↗, (vₙ) ↘, vₙ − uₙ → 0.\n→ Convergent vers la même limite.\nuₙ ≤ ℓ ≤ vₙ.","tags":"adjacentes","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"formula","recto":"Suite arithmétique ?","verso":"u_(n+1) = uₙ + r ⟹ uₙ = u₀ + nr.\nΣ_(k=0)^n uₖ = (n+1)(u₀ + uₙ)/2.","tags":"arithmetique","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"formula","recto":"Suite géométrique ?","verso":"u_(n+1) = q·uₙ ⟹ uₙ = u₀·qⁿ.\nΣ_(k=0)^n qᵏ = (1−q^(n+1))/(1−q) (q ≠ 1).","tags":"geometrique","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.32 - Suites numériques","type":"formula","recto":"Suite récurrente linéaire d'ordre 2 ?","verso":"u_(n+2) = a·u_(n+1) + b·uₙ.\nÉquation caractéristique : x² = ax + b → racines r₁, r₂.\n• r₁ ≠ r₂ : uₙ = αr₁ⁿ + βr₂ⁿ\n• r₁ = r₂ = r : uₙ = (α + βn)·rⁿ","tags":"recurrence;ordre-2","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.33-34 - Limite d'une fonction","type":"definition","recto":"Limite finie en a ∈ ℝ ?","verso":"lim_(x→a) f(x) = ℓ ⟺ ∀ε>0, ∃η>0, ∀x ∈ Df, |x−a| < η ⇒ |f(x)−ℓ| < ε.","tags":"limite;a-fini","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.33-34 - Limite d'une fonction","type":"definition","recto":"Limite +∞ en +∞ ?","verso":"lim_(x→+∞) f(x) = +∞ ⟺ ∀A, ∃B, ∀x > B, f(x) > A.","tags":"limite;infini","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.33-34 - Limite d'une fonction","type":"law","recto":"Caractérisation séquentielle ?","verso":"lim_(x→a) f(x) = ℓ ⟺ ∀ (xₙ) → a, f(xₙ) → ℓ.\nUtile pour prouver la non-existence d'une limite.","tags":"limite;sequentielle","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.33-34 - Limite d'une fonction","type":"law","recto":"Opérations sur les limites ?","verso":"lim(f+g), lim(fg), lim(f/g) se calculent par les règles usuelles.\nFI : ∞ − ∞, 0×∞, 0/0, ∞/∞, 0⁰, ∞⁰, 1^∞.","tags":"limite;operations","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.33-34 - Limite d'une fonction","type":"law","recto":"Composition des limites ?","verso":"Si lim_(x→a) f(x) = b et lim_(y→b) g(y) = ℓ, alors lim_(x→a) (g∘f)(x) = ℓ.","tags":"limite;composition","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.33-34 - Limite d'une fonction","type":"law","recto":"Encadrement / gendarmes (fonction) ?","verso":"g(x) ≤ f(x) ≤ h(x) au voisinage de a, lim g = lim h = ℓ ⟹ lim f = ℓ.","tags":"gendarmes;fonction","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"definition","recto":"Continuité en a ?","verso":"f continue en a ⟺ lim_(x→a) f(x) = f(a).","tags":"continuite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"definition","recto":"Continuité sur un intervalle ?","verso":"f continue sur I si continue en tout point.\nNotation : f ∈ C⁰(I, ℝ).","tags":"continuite;I","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"law","recto":"Théorème des Valeurs Intermédiaires (TVI) ?","verso":"f continue sur [a,b], k entre f(a) et f(b) ⟹ ∃ c ∈ [a,b], f(c) = k.","tags":"tvi","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"law","recto":"Image continue d'un segment ?","verso":"L'image continue d'un segment [a,b] est un segment [m, M].\n→ f atteint son min et son max.","tags":"segment;image","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"law","recto":"Théorème de bijection ?","verso":"f continue STRICTEMENT MONOTONE sur [a,b] ⟹ bijection [a,b] → [f(a), f(b)] (ou inverse).\nf⁻¹ est continue, strictement monotone, de même sens.","tags":"bijection;continuite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"definition","recto":"Continuité uniforme ?","verso":"f uniformément continue sur I ⟺ ∀ε, ∃η, ∀x,y ∈ I, |x−y|<η ⇒ |f(x)−f(y)|<ε.\nLe η ne dépend PAS de x.","tags":"uniforme","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"law","recto":"Théorème de Heine ?","verso":"Toute fonction continue sur un segment est uniformément continue.","tags":"heine","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35 - Continuité","type":"definition","recto":"Fonction lipschitzienne ?","verso":"∃ k ≥ 0, ∀x,y, |f(x) − f(y)| ≤ k·|x − y|.\nLipschitzienne ⟹ uniformément continue ⟹ continue.","tags":"lipschitz","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"definition","recto":"Dérivabilité en a ?","verso":"f dérivable en a ⟺ lim_(x→a) (f(x) − f(a))/(x − a) existe et est finie. Cette limite est f'(a).","tags":"derivee;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"law","recto":"Dérivable ⟹ continu.","verso":"Si f dérivable en a, alors f continue en a.\nRéciproque FAUSSE : x ↦ |x| continue mais non dérivable en 0.","tags":"derivee;continuite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"formula","recto":"Dérivées des fonctions usuelles ?","verso":"(xⁿ)' = n·xⁿ⁻¹\n(eˣ)' = eˣ\n(ln x)' = 1/x\n(sin x)' = cos x, (cos x)' = −sin x\n(tan x)' = 1/cos²x = 1+tan²x","tags":"derivees;usuelles","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"formula","recto":"Règles de dérivation ?","verso":"(u+v)' = u'+v'\n(uv)' = u'v + uv'\n(u/v)' = (u'v − uv')/v²\n(g∘f)' = f' × (g'∘f)","tags":"derivees;regles","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"formula","recto":"Dérivée de la réciproque ?","verso":"(f⁻¹)'(y) = 1 / f'(f⁻¹(y))  (si f'(f⁻¹(y)) ≠ 0).","tags":"derivee;reciproque","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"law","recto":"Théorème de Rolle ?","verso":"f continue sur [a,b], dérivable sur ]a,b[, f(a)=f(b) ⟹ ∃ c ∈ ]a,b[, f'(c) = 0.","tags":"rolle","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"law","recto":"Théorème des accroissements finis (TAF) ?","verso":"f continue [a,b], dérivable ]a,b[ ⟹ ∃ c ∈ ]a,b[, f(b) − f(a) = (b−a)·f'(c).","tags":"taf","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"law","recto":"Inégalité des accroissements finis (IAF) ?","verso":"Si |f'| ≤ M sur [a,b], alors |f(b) − f(a)| ≤ M·|b − a|.","tags":"iaf","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"law","recto":"Lien dérivée-monotonie ?","verso":"f' > 0 sur I (sauf points isolés) ⟹ f strictement croissante.\nf' = 0 sur intervalle ⟺ f constante.","tags":"derivee;monotonie","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.35-36 - Dérivabilité","type":"law","recto":"Théorème de la limite de la dérivée ?","verso":"Si f continue en a, dérivable sur V \ {a}, et lim f'(x) = ℓ, alors f dérivable en a et f'(a) = ℓ.","tags":"derivee;limite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.37 - Convexité","type":"definition","recto":"Fonction convexe ?","verso":"f : I → ℝ convexe ⟺ ∀x,y ∈ I, ∀t ∈ [0,1] :\nf(tx + (1−t)y) ≤ t·f(x) + (1−t)·f(y).\nGraphiquement : courbe SOUS les cordes.","tags":"convexite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.37 - Convexité","type":"definition","recto":"Concave ?","verso":"f concave ⟺ −f convexe ⟺ inégalité inversée.\nGraphiquement : courbe AU-DESSUS des cordes.","tags":"concavite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.37 - Convexité","type":"law","recto":"Caractérisation par f' (si dérivable) ?","verso":"f dérivable convexe ⟺ f' croissante ⟺ courbe au-dessus de toute tangente.","tags":"convexite;derivee","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.37 - Convexité","type":"law","recto":"Caractérisation par f'' ?","verso":"f deux fois dérivable :\n• f'' ≥ 0 ⟺ f convexe\n• f'' ≤ 0 ⟺ f concave\n• f'' s'annule en changeant de signe ⟹ point d'inflexion.","tags":"convexite;derivee-seconde","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.37 - Convexité","type":"law","recto":"Inégalité de convexité (Jensen) ?","verso":"Si f convexe et λᵢ ≥ 0 avec Σλᵢ = 1 :\nf(Σ λᵢxᵢ) ≤ Σ λᵢ·f(xᵢ).\nGénéralise l'inégalité standard à n points.","tags":"jensen","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"definition","recto":"Subdivision d'un segment ?","verso":"Famille a = x₀ < x₁ < ... < xₙ = b. Pas : max |x_(k+1) − xₖ|.","tags":"subdivision","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"definition","recto":"Fonction en escalier ?","verso":"Fonction constante par morceaux sur une subdivision.\nIntégrale = Σ ck × (x_(k+1) − xₖ).","tags":"escalier","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"definition","recto":"Intégrale de Riemann ?","verso":"f bornée sur [a,b] est Riemann-intégrable ⟺ son intégrale supérieure = intégrale inférieure (encadrement par fcts en escalier).\nNotation : ∫ₐᵇ f.","tags":"riemann","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"law","recto":"Critère d'intégrabilité ?","verso":"f continue par morceaux sur [a,b] ⟹ f est Riemann-intégrable.\nF monotone aussi.","tags":"riemann;criteres","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"formula","recto":"Linéarité ?","verso":"∫(λf + μg) = λ∫f + μ∫g","tags":"integrale;linearite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"formula","recto":"Relation de Chasles ?","verso":"∫ₐᵇ f + ∫_b^c f = ∫_a^c f.\n∫_b^a f = −∫_a^b f.","tags":"chasles","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"formula","recto":"Positivité, monotonie ?","verso":"f ≥ 0 ⟹ ∫f ≥ 0.\nf ≤ g ⟹ ∫f ≤ ∫g.\n|∫f| ≤ ∫|f|.","tags":"positivite","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"law","recto":"Inégalité de Cauchy-Schwarz (intégrale) ?","verso":"(∫ f·g)² ≤ (∫ f²) × (∫ g²)","tags":"cauchy-schwarz;integrale","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"law","recto":"Théorème de la moyenne ?","verso":"f continue sur [a,b] ⟹ ∃ c ∈ [a,b], ∫ₐᵇ f = (b−a)·f(c).","tags":"moyenne","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"law","recto":"Théorème fondamental de l'analyse (1) ?","verso":"f continue sur I, a ∈ I. F(x) = ∫_a^x f(t) dt est dérivable, F'(x) = f(x).\n→ F primitive de f s'annulant en a.","tags":"fondamental","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"law","recto":"Théorème fondamental (2) ?","verso":"Si F primitive de f sur [a,b] :\n∫_a^b f(t) dt = F(b) − F(a) = [F(t)]_a^b.","tags":"fondamental;2","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"formula","recto":"Intégration par parties (IPP) ?","verso":"∫_a^b u'·v = [uv]_a^b − ∫_a^b u·v'","tags":"ipp","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.39 - Intégrale de Riemann","type":"formula","recto":"Changement de variable ?","verso":"∫_(φ(a))^(φ(b)) f(t) dt = ∫_a^b f(φ(u))·φ'(u) du.\n(φ : C¹, bijective si nécessaire.)","tags":"changement-variable","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.40 - Développements limités","type":"definition","recto":"DL_n(a) (développement limité) ?","verso":"f admet un DL à l'ordre n en a ⟺ ∃ polynôme P de degré ≤ n tel que :\nf(x) = P(x − a) + o((x − a)ⁿ) au voisinage de a.","tags":"dl;def","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.40 - Développements limités","type":"law","recto":"Formule de Taylor-Young ?","verso":"f de classe Cⁿ en a :\nf(x) = Σ_(k=0)^n (f^(k)(a) / k!) × (x − a)^k + o((x − a)ⁿ)","tags":"taylor-young","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.40 - Développements limités","type":"formula","recto":"DL usuels en 0 (ordre n) ?","verso":"eˣ = 1 + x + x²/2! + ... + xⁿ/n! + o(xⁿ)\nln(1+x) = x − x²/2 + x³/3 − ... + (−1)^(n−1)·xⁿ/n + o(xⁿ)\n(1+x)^α = 1 + αx + α(α−1)/2 x² + ... + o(xⁿ)\ncos x = 1 − x²/2 + x⁴/24 + o(x⁴)\nsin x = x − x³/6 + x⁵/120 + o(x⁵)","tags":"dl;usuels","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.40 - Développements limités","type":"formula","recto":"DL de tan x à l'ordre 5 ?","verso":"tan x = x + x³/3 + 2x⁵/15 + o(x⁵)","tags":"tan;dl","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.40 - Développements limités","type":"formula","recto":"Opérations sur les DL ?","verso":"Somme : addition des polynômes.\nProduit : tronquer au bon ordre.\nComposition : substituer en respectant l'ordre.\nDérivée/primitive : dériver/intégrer le polynôme (attention aux constantes).","tags":"dl;operations","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.40 - Développements limités","type":"application","recto":"Utilité des DL ?","verso":"• Calculs de limites (formes indéterminées)\n• Étude locale d'une courbe\n• Tangente, asymptote oblique, position relative\n• Approximations numériques","tags":"dl;application","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.41-42 - Primitives et calcul","type":"formula","recto":"Primitives usuelles ?","verso":"• xⁿ → x^(n+1)/(n+1)  (n ≠ −1)\n• 1/x → ln|x|\n• eˣ → eˣ\n• sin x → −cos x, cos x → sin x\n• 1/cos²x → tan x\n• 1/(1+x²) → arctan x\n• 1/√(1−x²) → arcsin x","tags":"primitive;usuelles","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.41-42 - Primitives et calcul","type":"formula","recto":"Primitives par u' ?","verso":"u'·u^n → u^(n+1)/(n+1)\nu'/u → ln|u|\nu'·eᵘ → eᵘ\nu'·cos u → sin u\nu'/√u → 2√u","tags":"primitive;u","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.41-42 - Primitives et calcul","type":"method","recto":"Intégration de fractions rationnelles ?","verso":"1. Décomposer en éléments simples\n2. Primitiver chaque morceau :\n• a/(x−α) → a·ln|x−α|\n• a/(x−α)^k → a/((1−k)(x−α)^(k−1))  (k ≥ 2)\n• (αx+β)/(x²+px+q) : compléter le carré, primitiver via arctan + ln.","tags":"rationnelles;integration","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.41-42 - Primitives et calcul","type":"method","recto":"Règles de Bioche (intégrales trigonométriques) ?","verso":"f(x)dx invariante par :\n• x ↔ −x : poser u = cos x\n• x ↔ π − x : poser u = sin x\n• x ↔ π + x : poser u = tan x\nSinon : t = tan(x/2), dx = 2dt/(1+t²), cos x = (1−t²)/(1+t²), sin x = 2t/(1+t²).","tags":"bioche","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI — Analyse","chapitre":"Ch.41-42 - Primitives et calcul","type":"method","recto":"Intégrales abéliennes ∫ R(x, √(ax²+bx+c)) dx ?","verso":"Compléter le carré :\n• ax² + bx + c = a((x+b/2a)² ± k²)\nSelon le signe : poser x + b/2a = (k/√a) sh(t) ou (k/√a) ch(t) ou (k/√a) sin(t).","tags":"abeliennes","niveau":"MPSI","matiere":"Maths"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"definition","recto":"Approximation des régimes quasi-stationnaires (ARQS) ?","verso":"On suppose que la durée de propagation des signaux ≪ période. Le courant a la même valeur en tout point d'un fil à un instant donné. Validité : tailles ≪ λ = c/f.","tags":"arqs","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"definition","recto":"Intensité du courant I ?","verso":"Débit de charges traversant une section orientée :\nI = dq/dt   (A = C·s⁻¹)\nLe sens conventionnel est celui des charges POSITIVES.","tags":"courant","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"formula","recto":"Densité de courant ⃗j ?","verso":"⃗j = ρ_m · ⃗v = n·q·⃗v   (A·m⁻²)\n• n : densité de porteurs\n• q : charge d'un porteur\n• I = ∫∫ ⃗j · d⃗S à travers la section.","tags":"densite-courant","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"definition","recto":"Tension u_AB ?","verso":"u_AB = V_A − V_B   (V).\nDifférence de potentiel entre A et B. Conventionnellement orientée du + vers le −.","tags":"tension","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"law","recto":"Loi des nœuds (Kirchhoff) ?","verso":"Σ I_entrant = Σ I_sortant à un nœud.\nConservation de la charge en ARQS.","tags":"noeuds","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"law","recto":"Loi des mailles (Kirchhoff) ?","verso":"Σ U = 0 sur une maille fermée (en respectant l'orientation).\nConséquence de la conservation de l'énergie (champ conservatif en ARQS).","tags":"mailles","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"definition","recto":"Dipôle ?","verso":"Composant à 2 bornes. Caractérisé par sa relation u(i).\n• Récepteur : convention récepteur (u et i de même sens entrant)\n• Générateur : convention générateur (sens opposés)","tags":"dipole","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.1 - Lois générales de l'électrocinétique","type":"formula","recto":"Puissance reçue par un dipôle ?","verso":"P = u · i   (W)\n• Convention récepteur : P > 0 si reçue.\n• P > 0 : dipôle reçoit (récepteur effectif)\n• P < 0 : dipôle fournit.","tags":"puissance","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"law","recto":"Loi d'Ohm (résistor) ?","verso":"u = R · i   (convention récepteur)\nR : résistance (Ω). Dipôle linéaire passif.","tags":"ohm","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Puissance dissipée par effet Joule ?","verso":"P = R·i² = u²/R = u·i\nÉnergie dissipée en chaleur. Toujours ≥ 0.","tags":"joule","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Bobine d'inductance L ?","verso":"u = L · di/dt   (convention récepteur)\nL : inductance (H = V·s·A⁻¹).\nÉnergie magnétique stockée : E_L = ½·L·i².","tags":"bobine","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Condensateur de capacité C ?","verso":"i = C · du/dt   (convention récepteur)\nq = C·u (charge accumulée).\nC : capacité (F = C·V⁻¹).\nÉnergie : E_C = ½·C·u² = q²/(2C).","tags":"condensateur","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Associations de résistors ?","verso":"• Série : R_eq = R₁ + R₂ + ...\n• Parallèle : 1/R_eq = 1/R₁ + 1/R₂ + ...\nDeux en parallèle : R_eq = R₁·R₂/(R₁+R₂).","tags":"resistors;association","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Associations de condensateurs ?","verso":"• Série : 1/C_eq = 1/C₁ + 1/C₂ + ... (INVERSÉ de R)\n• Parallèle : C_eq = C₁ + C₂ + ...","tags":"condensateurs;association","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Associations d'inductances ?","verso":"• Série : L_eq = L₁ + L₂ + ...\n• Parallèle : 1/L_eq = 1/L₁ + 1/L₂ + ...\n(Comme R.)","tags":"bobines;association","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"definition","recto":"Source de tension idéale ?","verso":"u = E quelle que soit i. Caractéristique : verticale.\nSchéma : cercle avec barre.","tags":"source-tension","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"definition","recto":"Source de courant idéale ?","verso":"i = I₀ quelle que soit u. Caractéristique : horizontale.","tags":"source-courant","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"definition","recto":"Modèle de Thévenin ?","verso":"Source de tension E en série avec résistance R.\nTension à vide : E. Courant de court-circuit : E/R.","tags":"thevenin","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"definition","recto":"Modèle de Norton ?","verso":"Source de courant I₀ en parallèle avec R.\nÉquivalence : E = R·I₀ (modèle Thévenin équivalent).","tags":"norton","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Diviseur de tension ?","verso":"Pour deux résistors en série soumis à u_total :\nu_R₁ = u_total · R₁/(R₁+R₂)","tags":"diviseur-tension","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.2 - Circuits linéaires en ARQS","type":"formula","recto":"Diviseur de courant ?","verso":"Pour deux résistors en parallèle parcourus par i_total :\ni_R₁ = i_total · R₂/(R₁+R₂)\n(ATTENTION : R₂ au numérateur, pas R₁.)","tags":"diviseur-courant","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"definition","recto":"Circuit du 1er ordre ?","verso":"Comporte UNE bobine OU UN condensateur (avec résistance).\nRégi par une équation différentielle linéaire d'ordre 1.","tags":"ordre-1","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"formula","recto":"Constante de temps τ d'un RC ?","verso":"τ = R·C   (s)\nLe condensateur est chargé à 63 % après t = τ et à ~99 % après 5τ.","tags":"rc;tau","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"formula","recto":"Constante de temps τ d'un RL ?","verso":"τ = L/R   (s)","tags":"rl;tau","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"formula","recto":"Charge d'un condensateur (RC, échelon E) ?","verso":"u_C(t) = E·(1 − e^(−t/τ))\ni(t) = (E/R)·e^(−t/τ)","tags":"rc;charge","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"formula","recto":"Décharge d'un condensateur (RC) ?","verso":"u_C(t) = U₀·e^(−t/τ)\ni(t) = −(U₀/R)·e^(−t/τ)\nDécroissance exponentielle vers 0.","tags":"rc;decharge","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"law","recto":"Continuité de u_C et de i_L ?","verso":"• u_C continue (pas de saut), car q = C·u_C ne peut pas varier instantanément.\n• i_L continue (pas de saut), car le flux dans une bobine ne peut pas varier instantanément.","tags":"continuite","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"definition","recto":"Circuit du 2ème ordre (RLC série) ?","verso":"Équation différentielle : LC·d²u/dt² + RC·du/dt + u = E.\nForme normalisée : d²u/dt² + 2ξω₀·du/dt + ω₀²·u = ω₀²·E.","tags":"rlc;ordre-2","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"formula","recto":"Pulsation propre ω₀ et amortissement ξ ?","verso":"ω₀ = 1/√(LC)   (rad·s⁻¹)\nξ = (R/2)·√(C/L) = R/(2L·ω₀)\nFacteur de qualité : Q = 1/(2ξ).","tags":"rlc;parametres","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"application","recto":"Régimes du 2ème ordre selon ξ ?","verso":"• ξ > 1 : apériodique (sur-amorti)\n• ξ = 1 : critique (le plus rapide sans oscillation)\n• ξ < 1 : pseudo-périodique (oscillations amorties)","tags":"rlc;regimes","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.3 - Régimes transitoires (échelon de tension)","type":"formula","recto":"Pulsation des pseudo-oscillations (ξ < 1) ?","verso":"ω = ω₀ · √(1 − ξ²)\nPseudo-période T = 2π/ω.","tags":"pseudo-periode","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"definition","recto":"Notation complexe d'un signal sinusoïdal ?","verso":"Pour u(t) = U_m·cos(ωt + φ) :\nU = U_m·e^(jφ) (amplitude complexe)\nu(t) = Re(U·e^(jωt)).","tags":"complexe","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"formula","recto":"Impédances complexes ?","verso":"• Résistor : Z_R = R\n• Bobine : Z_L = jLω\n• Condensateur : Z_C = 1/(jCω) = −j/(Cω)","tags":"impedance","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"formula","recto":"Loi d'Ohm en complexe ?","verso":"U = Z · I\nMême associations que les résistances : série Z_eq = ΣZᵢ, parallèle 1/Z_eq = Σ 1/Zᵢ.","tags":"ohm;complexe","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"application","recto":"RLC série en régime sinusoïdal ?","verso":"Z = R + j(Lω − 1/(Cω))\n|Z| minimal pour ω = ω₀ = 1/√(LC) : c'est la RÉSONANCE en intensité.","tags":"rlc;sinusoidal","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"formula","recto":"Pulsation de résonance d'intensité ?","verso":"ω_r = ω₀ = 1/√(LC)\nÀ cette pulsation : Z = R, |I| = U/R (max).","tags":"resonance;intensite","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"definition","recto":"Facteur de qualité Q ?","verso":"Q = (1/R)·√(L/C) = L·ω₀/R = 1/(R·C·ω₀)\nIndique la sélectivité de la résonance. Plus Q grand, plus la résonance est étroite.","tags":"facteur-qualite","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.15-16 - Régime sinusoïdal forcé — RLC","type":"formula","recto":"Bande passante à −3 dB ?","verso":"Δω = ω₀/Q\nLargeur entre les deux pulsations où |I| = I_max/√2.","tags":"bande-passante","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.17 - Puissance en régime sinusoïdal","type":"definition","recto":"Puissance instantanée ?","verso":"p(t) = u(t)·i(t)","tags":"puissance;instantanee","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.17 - Puissance en régime sinusoïdal","type":"formula","recto":"Puissance moyenne (active) ?","verso":"P_moy = (U_m·I_m/2)·cos(φ) = U_eff·I_eff·cos(φ)\noù φ = arg(U) − arg(I) (déphasage tension/courant).","tags":"puissance;active","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.17 - Puissance en régime sinusoïdal","type":"definition","recto":"Valeurs efficaces ?","verso":"U_eff = U_m/√2, I_eff = I_m/√2 (pour signaux sinusoïdaux).\nGénéralement : grandeur eff. = √(<grandeur²>).","tags":"efficace","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.17 - Puissance en régime sinusoïdal","type":"definition","recto":"Facteur de puissance ?","verso":"k = cos(φ)\nMesure l'efficacité du transfert d'énergie. Idéal : k=1 (charge purement résistive).","tags":"facteur-puissance","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.17 - Puissance en régime sinusoïdal","type":"formula","recto":"Puissances complexe / réactive ?","verso":"S = U·I*/2 = P + jQ\n• P = puissance active (moyenne)\n• Q = puissance réactive (oscille entre source et charge)\n• |S| = puissance apparente.","tags":"puissance;complexe","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"definition","recto":"Fonction de transfert H(jω) ?","verso":"H(jω) = U_sortie / U_entrée (en complexe).\n• Module |H| : gain.\n• Argument arg(H) : déphasage.","tags":"transfert","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"formula","recto":"Gain en décibels ?","verso":"G_dB = 20·log₁₀(|H|)\n• |H| = 1 → 0 dB\n• |H| = 1/√2 → −3 dB\n• |H| = 1/10 → −20 dB","tags":"gain;db","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"definition","recto":"Filtre passe-bas du 1er ordre ?","verso":"H(jω) = 1/(1 + j(ω/ω_c)) où ω_c = 1/(RC).\nRC série, sortie aux bornes de C.\nPente asymptote : −20 dB/décade au-dessus de ω_c.","tags":"passe-bas","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"definition","recto":"Filtre passe-haut du 1er ordre ?","verso":"H(jω) = j(ω/ω_c)/(1 + j(ω/ω_c))\nRC série, sortie aux bornes de R. Coupe les BF.","tags":"passe-haut","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"definition","recto":"Filtre passe-bande (RLC) ?","verso":"Lié à la résonance : passe la bande autour de ω₀, coupe BF et HF.\nLargeur Δω = ω₀/Q.","tags":"passe-bande","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"definition","recto":"Filtre coupe-bande (réjecteur) ?","verso":"Coupe une bande étroite autour de ω₀, laisse passer le reste. Antenne RLC série en parallèle d'un autre branchement.","tags":"coupe-bande","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électrocinétique","chapitre":"Ch.18 - Filtres linéaires","type":"formula","recto":"Diagramme de Bode (asymptotes 1er ordre) ?","verso":"Passe-bas :\n• ω ≪ ω_c : G ≈ 0 dB, φ ≈ 0\n• ω ≫ ω_c : G ≈ −20·log(ω/ω_c) dB, φ ≈ −π/2\n• ω = ω_c : G = −3 dB, φ = −π/4.","tags":"bode","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"definition","recto":"Référentiel ?","verso":"Solide de référence + horloge. Permet de repérer la position d'un point au cours du temps.","tags":"referentiel","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"definition","recto":"Trajectoire ?","verso":"Ensemble des positions successives du point M dans un référentiel donné.\nDépend du référentiel.","tags":"trajectoire","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"formula","recto":"Coordonnées cartésiennes ?","verso":"M(x, y, z), ⃗OM = x⃗i + y⃗j + z⃗k\n⃗v = ẋ⃗i + ẏ⃗j + ż⃗k\n⃗a = ẍ⃗i + ÿ⃗j + z̈⃗k","tags":"cartesien","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"formula","recto":"Coordonnées cylindriques (polaires en 2D) ?","verso":"M(r, θ, z) avec ⃗OM = r·⃗e_r + z·⃗e_z\n⃗v = ṙ·⃗e_r + r·θ̇·⃗e_θ + ż·⃗e_z\n⃗a = (r̈ − r·θ̇²)·⃗e_r + (r·θ̈ + 2·ṙ·θ̇)·⃗e_θ + z̈·⃗e_z","tags":"cylindriques","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"formula","recto":"Coordonnées sphériques ?","verso":"M(r, θ, φ) où r = OM, θ angle avec axe z, φ angle azimutal.\nx = r·sin θ·cos φ, y = r·sin θ·sin φ, z = r·cos θ.","tags":"spheriques","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"formula","recto":"Repère de Frenet ?","verso":"⃗v = v·⃗τ\n⃗a = (dv/dt)·⃗τ + (v²/R)·⃗n\nR : rayon de courbure local.","tags":"frenet","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.4 - Cinématique du point","type":"application","recto":"Mouvement circulaire uniforme ?","verso":"v = R·ω = cste, ⃗a normale au mouvement\n‖⃗a‖ = v²/R = R·ω²\n(Toujours dirigée vers le centre.)","tags":"circulaire-uniforme","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"definition","recto":"Quantité de mouvement (impulsion) ?","verso":"⃗p = m·⃗v   (kg·m·s⁻¹)\nGrandeur conservée pour un système isolé.","tags":"p","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"law","recto":"Première loi (principe d'inertie) ?","verso":"Dans un référentiel galiléen, si Σ⃗F = ⃗0, alors ⃗v = cste.\nIl existe des référentiels (galiléens) où cela vaut.","tags":"newton-1","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"law","recto":"Deuxième loi (PFD) ?","verso":"Dans un référentiel galiléen :\nΣ⃗F = m·⃗a = d⃗p/dt\n(à masse constante)","tags":"newton-2","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"law","recto":"Troisième loi (action-réaction) ?","verso":"⃗F_(A→B) = −⃗F_(B→A)\nLes forces sont opposées, mêmes droites d'action, même intensité.","tags":"newton-3","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"definition","recto":"Référentiel galiléen ?","verso":"Référentiel où le principe d'inertie s'applique.\nApproximations : héliocentrique (Copernic), géocentrique, terrestre (durées courtes).","tags":"galileen","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"formula","recto":"Forces classiques ?","verso":"• Poids : ⃗P = m·⃗g\n• Tension d'un fil : T·⃗u (le long du fil)\n• Réaction normale : ⃗N (perp. au support)\n• Frottement solide : ⃗f (parallèle au support)\n• Frottement fluide : ⃗f = −α·⃗v (linéaire) ou −β·v·⃗v (quadratique)\n• Rappel d'un ressort : ⃗F = −k·(ℓ − ℓ₀)·⃗u","tags":"forces","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.5 - Lois de Newton","type":"application","recto":"Loi de Coulomb (frottement solide) ?","verso":"• Statique : f ≤ μ_s·N\n• Glissement : f = μ_d·N (μ_d ≤ μ_s)\nμ : coefficients de frottement.","tags":"coulomb;frottement","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"formula","recto":"Travail d'une force ?","verso":"δW = ⃗F · d⃗r\nW_(A→B) = ∫_A^B ⃗F · d⃗r   (J)","tags":"travail","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"formula","recto":"Puissance d'une force ?","verso":"P = ⃗F · ⃗v   (W)\nP = δW/dt.","tags":"puissance;force","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"definition","recto":"Énergie cinétique ?","verso":"E_c = ½·m·v²   (J)","tags":"ec","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"law","recto":"Théorème de l'énergie cinétique ?","verso":"ΔE_c = Σ W(⃗F)\nLa variation d'énergie cinétique = somme des travaux des forces appliquées.","tags":"tec","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"definition","recto":"Force conservative ?","verso":"Force dont le travail ne dépend pas du chemin.\nÉquivalent : circulation nulle sur tout chemin fermé.\nÉquivalent : dérive d'une énergie potentielle ⃗F = −grad(E_p).","tags":"conservative","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"formula","recto":"Énergies potentielles usuelles ?","verso":"• Pesanteur : E_p = m·g·z (axe vertical vers haut)\n• Ressort : E_p = ½·k·(ℓ − ℓ₀)²\n• Gravitationnelle : E_p = −G·m₁·m₂/r\n• Coulombienne : E_p = q₁·q₂/(4πε₀·r)","tags":"ep","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"definition","recto":"Énergie mécanique ?","verso":"E_m = E_c + E_p   (J)","tags":"em","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"law","recto":"Théorème de l'énergie mécanique ?","verso":"ΔE_m = Σ W(⃗F_(non conservatives))\nSi toutes les forces sont conservatives : E_m = cste.","tags":"tem","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"application","recto":"Conservation de l'énergie mécanique ?","verso":"Cas typique : pendule sans frottement, projectile sans résistance de l'air.\nEn présence de frottements : E_m diminue (dissipation).","tags":"conservation","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"definition","recto":"Position d'équilibre ?","verso":"x_eq tel que dE_p/dx (x_eq) = 0.\n• Stable si d²E_p/dx² > 0 (minimum local de E_p)\n• Instable si d²E_p/dx² < 0 (maximum)\n• Indifférent si d²E_p/dx² = 0.","tags":"equilibre","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.6 - Énergie mécanique","type":"application","recto":"Portrait de phase ?","verso":"Trajectoire dans le plan (x, ẋ).\nPour un système conservatif : courbes d'énergie E_m = cste.\nEntourent les points stables, repoussées par les instables.","tags":"portrait-phase","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"definition","recto":"Oscillateur harmonique ?","verso":"Système régi par : ẍ + ω₀²·x = 0\nSolution : x(t) = A·cos(ω₀t + φ).\nω₀ : pulsation propre. Période T = 2π/ω₀.","tags":"oscillateur","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"formula","recto":"Pulsation d'un ressort ?","verso":"ω₀ = √(k/m)\nPour un pendule simple : ω₀ = √(g/ℓ) (petites oscillations).","tags":"pulsation;ressort","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"formula","recto":"Énergie d'un oscillateur harmonique ?","verso":"E_m = ½·k·A² = ½·m·v_max² = cste\nRépartition : E_c et E_p oscillent en quadrature à 2·ω₀.","tags":"oscillateur;energie","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"definition","recto":"Oscillateur amorti ?","verso":"ẍ + 2λ·ẋ + ω₀²·x = 0  (frottement fluide linéaire)\nFacteur d'amortissement : ξ = λ/ω₀.","tags":"oscillateur;amorti","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"application","recto":"Régimes de l'oscillateur amorti ?","verso":"• ξ > 1 : apériodique (deux exponentielles décroissantes)\n• ξ = 1 : critique (le plus rapide, sans oscillation)\n• ξ < 1 : pseudo-périodique (oscillations amorties à ω = ω₀·√(1−ξ²))","tags":"oscillateur;regimes","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"definition","recto":"Décrément logarithmique ?","verso":"δ = ln(x_n / x_(n+1))\nMesure de l'amortissement entre deux maxima successifs. δ = 2π·ξ/√(1−ξ²) ≈ 2π·ξ pour ξ petit.","tags":"decrement","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"definition","recto":"Oscillateur entretenu (forcé) ?","verso":"ẍ + 2λ·ẋ + ω₀²·x = (F₀/m)·cos(ωt)\nRégime établi : x(t) = X·cos(ωt − φ).","tags":"force","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.7;24 - Oscillateurs harmoniques et amortis","type":"application","recto":"Résonance d'amplitude (oscillateur forcé) ?","verso":"Maximum de X(ω) à ω_r = ω₀·√(1−2ξ²) si ξ < 1/√2.\nSi ξ ≥ 1/√2 : pas de résonance.","tags":"resonance;amplitude","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.25 - Moment cinétique","type":"definition","recto":"Moment cinétique en un point O ?","verso":"⃗L_O = ⃗OM ∧ m·⃗v\nUnité : kg·m²·s⁻¹.","tags":"moment-cinetique","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.25 - Moment cinétique","type":"definition","recto":"Moment d'une force en O ?","verso":"⃗M_O(⃗F) = ⃗OM ∧ ⃗F","tags":"moment-force","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.25 - Moment cinétique","type":"law","recto":"Théorème du moment cinétique en O fixe (galiléen) ?","verso":"d⃗L_O/dt = Σ ⃗M_O(⃗F)\nGénéralise la 2ème loi de Newton à l'aspect rotationnel.","tags":"tmc","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.25 - Moment cinétique","type":"application","recto":"Conservation du moment cinétique ?","verso":"Si ⃗M_O totale = ⃗0 (cas d'une force centrale en O) : ⃗L_O = cste.\n→ Mouvement plan (perp. à L) + loi des aires.","tags":"conservation;L","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.26-27 - Changement de référentiel","type":"formula","recto":"Composition des vitesses ?","verso":"⃗v_(M/R) = ⃗v_(M/R') + ⃗v_e\noù ⃗v_e = vitesse d'entraînement = ⃗v_(O'/R) + ⃗Ω·∧·⃗O'M","tags":"composition;vitesse","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.26-27 - Changement de référentiel","type":"formula","recto":"Composition des accélérations ?","verso":"⃗a_(M/R) = ⃗a_(M/R') + ⃗a_e + ⃗a_c\n⃗a_e : accélération d'entraînement.\n⃗a_c = 2·⃗Ω∧⃗v_(M/R') : accélération de Coriolis.","tags":"composition;acceleration","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.26-27 - Changement de référentiel","type":"definition","recto":"Référentiel non galiléen ?","verso":"Référentiel en mouvement accéléré ou en rotation par rapport à un galiléen.\nPour appliquer Newton, on doit ajouter des forces d'inertie.","tags":"non-galileen","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.26-27 - Changement de référentiel","type":"formula","recto":"Forces d'inertie ?","verso":"• Force d'inertie d'entraînement : ⃗f_(ie) = −m·⃗a_e\n• Force de Coriolis : ⃗f_(ic) = −m·⃗a_c = −2m·⃗Ω∧⃗v_(M/R')","tags":"forces-inertie","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.26-27 - Changement de référentiel","type":"application","recto":"Effet Coriolis sur Terre ?","verso":"Devie les masses d'air vers la droite dans l'hémisphère Nord, vers la gauche dans le Sud.\nResponsable du sens de rotation des cyclones, des courants océaniques.","tags":"coriolis","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"definition","recto":"Force centrale ?","verso":"Force dirigée vers (ou contre) un point fixe O, de norme dépendant uniquement de la distance r.\n⃗F = f(r)·⃗e_r","tags":"force-centrale","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"law","recto":"Conséquences d'une force centrale ?","verso":"1. Conservation du moment cinétique ⃗L_O.\n2. Mouvement PLAN.\n3. Loi des aires : (1/2)·r²·θ̇ = cste = C/2 (constante des aires).","tags":"force-centrale;consequences","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"definition","recto":"Énergie potentielle effective ?","verso":"U_eff(r) = E_p(r) + L²/(2m·r²)\nLe terme L²/(2mr²) s'appelle barrière centrifuge.\nL'étude graphique de U_eff donne les caractéristiques du mouvement.","tags":"potentiel-effectif","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"law","recto":"Loi de gravitation universelle ?","verso":"F = G·m₁·m₂/r²\nG = 6,67×10⁻¹¹ N·m²·kg⁻²\nForce attractive, dirigée selon la droite des centres.","tags":"gravitation","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"law","recto":"Lois de Kepler ?","verso":"1. Orbites elliptiques, Soleil au foyer.\n2. Loi des aires : aires égales en temps égaux.\n3. T²/a³ = 4π²/(G·M)  (3ème loi).","tags":"kepler","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"formula","recto":"Vitesse pour orbite circulaire de rayon r ?","verso":"v = √(G·M/r)\nT = 2π·√(r³/(G·M))   (3ème loi de Kepler).","tags":"orbite-circulaire","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"formula","recto":"Énergie totale d'une orbite elliptique ?","verso":"E = −G·M·m/(2·a)\noù a = demi-grand axe.\n• E < 0 : orbite liée (ellipse, cercle)\n• E = 0 : parabole (vitesse de libération)\n• E > 0 : hyperbole.","tags":"energie-orbite","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"formula","recto":"Vitesse de libération ?","verso":"v_lib = √(2·G·M/R)\n≈ 11,2 km·s⁻¹ à la surface de la Terre.","tags":"vitesse-liberation","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Mécanique","chapitre":"Ch.31 - Force centrale et mouvement képlérien","type":"definition","recto":"Satellite géostationnaire ?","verso":"T = 23h56min, altitude ≈ 36 000 km, plan équatorial, sens prograde.\nReste à la verticale du même point sur l'équateur.","tags":"geostationnaire","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.8-9 - Bases et lois de l'optique géométrique","type":"definition","recto":"Approximation de l'optique géométrique ?","verso":"Valable quand λ ≪ dimensions. La lumière se propage selon des rayons rectilignes dans un milieu homogène.","tags":"approx;OG","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.8-9 - Bases et lois de l'optique géométrique","type":"definition","recto":"Indice de réfraction n ?","verso":"n = c/v\n• c : célérité dans le vide (3·10⁸ m/s)\n• v : célérité dans le milieu\n• n ≥ 1 : air ≈ 1, eau ≈ 1,33, verre ≈ 1,5","tags":"indice","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.8-9 - Bases et lois de l'optique géométrique","type":"law","recto":"Loi de Snell-Descartes (réflexion) ?","verso":"1. Le rayon réfléchi est dans le plan d'incidence.\n2. i_réfléchi = i_incident (mesurés par rapport à la normale).","tags":"snell;reflexion","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.8-9 - Bases et lois de l'optique géométrique","type":"law","recto":"Loi de Snell-Descartes (réfraction) ?","verso":"1. Rayon réfracté dans le plan d'incidence (de l'autre côté de la normale).\n2. n₁·sin(i₁) = n₂·sin(i₂)","tags":"snell;refraction","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.8-9 - Bases et lois de l'optique géométrique","type":"definition","recto":"Réflexion totale ?","verso":"Quand n₁ > n₂ et i₁ > i_lim avec sin(i_lim) = n₂/n₁, le rayon est entièrement réfléchi.\nApplication : fibre optique.","tags":"reflexion-totale","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.8-9 - Bases et lois de l'optique géométrique","type":"definition","recto":"Principe de Fermat ?","verso":"Le rayon emprunte le chemin qui minimise (ou stationnarise) le temps de parcours, donc le chemin optique L = ∫n·ds.","tags":"fermat","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.10 - Stigmatisme, dioptres, miroirs","type":"definition","recto":"Stigmatisme rigoureux ?","verso":"Tous les rayons issus d'un point objet A passent par un même point image A'.\nRare en pratique ; la plupart des systèmes ne sont stigmatiques qu'au sens approché.","tags":"stigmatisme","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.10 - Stigmatisme, dioptres, miroirs","type":"definition","recto":"Conditions de Gauss (stigmatisme approché) ?","verso":"• Rayons paraxiaux (proches de l'axe optique)\n• Faibles inclinaisons par rapport à l'axe\n→ Stigmatisme approché valable pour la plupart des systèmes optiques.","tags":"gauss","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.10 - Stigmatisme, dioptres, miroirs","type":"formula","recto":"Miroir sphérique - relation de conjugaison (centre C) ?","verso":"1/CA' + 1/CA = 2/CS\nOrigine au centre. R = SC = rayon de courbure.","tags":"miroir;conjugaison","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.10 - Stigmatisme, dioptres, miroirs","type":"formula","recto":"Miroir plan ?","verso":"Image symétrique de l'objet par rapport au plan du miroir.\nVirtuelle, droite, même taille.","tags":"miroir-plan","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.10 - Stigmatisme, dioptres, miroirs","type":"formula","recto":"Dioptre plan ?","verso":"n₁·HA = n₂·HA'\nA' image de A à travers le dioptre. H : projection.","tags":"dioptre-plan","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"definition","recto":"Lentille convergente ?","verso":"Bord plus mince que centre. f' > 0. Fait converger les rayons parallèles vers le foyer image F'.","tags":"lentille;convergente","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"definition","recto":"Lentille divergente ?","verso":"Bord plus épais que centre. f' < 0. Fait diverger les rayons (foyer image virtuel).","tags":"lentille;divergente","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"formula","recto":"Vergence V ?","verso":"V = 1/f'   (en dioptries δ ; f' en mètres)\n• Convergente : V > 0\n• Divergente : V < 0","tags":"vergence","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"formula","recto":"Relation de conjugaison (origine au centre O) ?","verso":"1/OA' − 1/OA = 1/f'\n(formule de Descartes)","tags":"conjugaison;Descartes","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"formula","recto":"Grandissement γ ?","verso":"γ = A'B'/AB = OA'/OA\n• |γ| > 1 : grandit\n• γ > 0 : image droite\n• γ < 0 : image renversée","tags":"grandissement","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"formula","recto":"Relation de Newton (origines aux foyers) ?","verso":"FA · F'A' = −f'²\n(F, F' foyers objet et image)","tags":"newton;optique","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"application","recto":"3 rayons à connaître pour la construction ?","verso":"1. Rayon parallèle à l'axe → passe par F'.\n2. Rayon par O → non dévié.\n3. Rayon par F → ressort parallèle à l'axe.","tags":"construction","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"formula","recto":"Association de 2 lentilles minces accolées ?","verso":"V = V₁ + V₂\n1/f' = 1/f'₁ + 1/f'₂","tags":"lentilles;accolees","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Optique géométrique","chapitre":"Ch.11 - Lentilles minces","type":"application","recto":"Conditions d'image réelle (lentille convergente) ?","verso":"OA < −f' (objet AVANT le foyer objet F).\nSi −f' < OA < 0 : image virtuelle, droite, agrandie (loupe).","tags":"image;reelle","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.33 - Généralités","type":"definition","recto":"Système thermodynamique ?","verso":"Portion de matière étudiée. Délimitée par une frontière. Peut être :\n• Isolé : ni matière ni énergie échangées\n• Fermé : énergie oui, matière non\n• Ouvert : les deux","tags":"systeme","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.33 - Généralités","type":"definition","recto":"Variables d'état ?","verso":"Grandeurs caractérisant le système :\n• Extensives (proportionnelles à la quantité) : V, n, U, S, m\n• Intensives (indépendantes) : P, T, ρ, μ","tags":"variables-etat","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.33 - Généralités","type":"definition","recto":"État d'équilibre thermodynamique ?","verso":"État où aucune variable d'état n'évolue : équilibre thermique (T uniforme), mécanique (P uniforme), chimique (pas de réaction).","tags":"equilibre-td","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.33 - Généralités","type":"definition","recto":"Transformation quasi-statique / réversible ?","verso":"• Quasi-statique : suite d'états d'équilibre (lente).\n• Réversible : quasi-statique ET sans dissipation (sans frottement, irréversibilité).\nIdéalisations.","tags":"transformation","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.34 - Statique des fluides","type":"law","recto":"Équation de la statique des fluides ?","verso":"dP/dz = −ρ·g  (axe z vertical vers le haut)\nLa pression diminue avec l'altitude.","tags":"statique-fluides","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.34 - Statique des fluides","type":"formula","recto":"Pression dans un liquide incompressible ?","verso":"P(z) = P₀ + ρ·g·(z₀ − z)\n→ P augmente avec la profondeur.\nThéorème de Pascal : variation de pression transmise intégralement.","tags":"liquide;pression","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.34 - Statique des fluides","type":"formula","recto":"Atmosphère isotherme (modèle simple) ?","verso":"P(z) = P₀·exp(−z/H)\nH = R·T/(M·g) (hauteur d'échelle ≈ 8 km dans l'air à 20°C).","tags":"atmosphere","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.34 - Statique des fluides","type":"law","recto":"Théorème d'Archimède ?","verso":"Tout corps plongé dans un fluide subit une poussée verticale dirigée vers le haut, égale au poids du fluide déplacé :\n⃗F_A = −ρ_fluide·V_immergé·⃗g","tags":"archimede","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.35 - Gaz parfait — interprétation","type":"law","recto":"Équation d'état du gaz parfait ?","verso":"P·V = n·R·T\nR = 8,314 J·K⁻¹·mol⁻¹\nT en kelvins (T(K) = θ(°C) + 273,15).","tags":"gaz-parfait","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.35 - Gaz parfait — interprétation","type":"formula","recto":"Forme moléculaire ?","verso":"P·V = N·k_B·T\nk_B = 1,38·10⁻²³ J·K⁻¹ (constante de Boltzmann).\nN = nombre de molécules. R = N_A·k_B.","tags":"gaz-parfait;mole","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.35 - Gaz parfait — interprétation","type":"definition","recto":"Énergie interne d'un GP ?","verso":"U = U(T) seulement (théorème de Joule).\n• GP monoatomique : U = (3/2)·n·R·T\n• GP diatomique (T usuelles) : U = (5/2)·n·R·T","tags":"U;gp","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.35 - Gaz parfait — interprétation","type":"formula","recto":"Vitesse quadratique moyenne ?","verso":"<v²> = 3·k_B·T/m\nv_q = √(3·R·T/M)\nÀ T = 300 K dans l'air : ≈ 500 m·s⁻¹.","tags":"vitesse-quadratique","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.35 - Gaz parfait — interprétation","type":"formula","recto":"Loi de Mariotte / Charles / Gay-Lussac ?","verso":"• Mariotte (T cste) : P·V = cste\n• Charles (P cste) : V/T = cste\n• Gay-Lussac (V cste) : P/T = cste","tags":"lois-empiriques","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"law","recto":"Premier principe (système fermé) ?","verso":"ΔU = W + Q\n• W : travail des forces extérieures\n• Q : transfert thermique\nGrandeurs algébriques : reçues > 0, cédées < 0.","tags":"premier-principe","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"formula","recto":"Travail des forces de pression ?","verso":"δW = −P_ext·dV\nW = −∫ P_ext·dV\nSigne −  : compression (dV<0) → W>0 (reçu).","tags":"travail;pression","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"definition","recto":"Transformation isotherme (T cste) ?","verso":"Pour un GP : U ne varie pas → ΔU = 0 → Q = −W.\nW = −n·R·T·ln(V_f/V_i).","tags":"isotherme","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"definition","recto":"Transformation isobare (P cste) ?","verso":"W = −P·ΔV.\nQ = ΔH (enthalpie) : voir ci-dessous.","tags":"isobare","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"definition","recto":"Transformation isochore (V cste) ?","verso":"W = 0 (pas de variation de volume).\nQ_V = ΔU.","tags":"isochore","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"definition","recto":"Transformation adiabatique ?","verso":"Q = 0 (pas d'échange de chaleur).\n→ ΔU = W.","tags":"adiabatique","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"formula","recto":"Lois de Laplace (adiabatique réversible d'un GP) ?","verso":"P·V^γ = cste\nT·V^(γ−1) = cste\nP^(1−γ)·T^γ = cste\nγ = C_P/C_V (5/3 monoatomique, 7/5 diatomique).","tags":"laplace","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"definition","recto":"Enthalpie H ?","verso":"H = U + P·V\nÀ P cste : Q_P = ΔH.\nGP : H = H(T), avec dH = C_P·dT.","tags":"enthalpie","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.36-37 - Premier principe","type":"formula","recto":"Capacités thermiques ?","verso":"C_V = (∂U/∂T)_V (à V cste)\nC_P = (∂H/∂T)_P (à P cste)\nGP : C_P − C_V = n·R (relation de Mayer).","tags":"capacites","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.38 - Deuxième principe","type":"law","recto":"Deuxième principe ?","verso":"Il existe une fonction d'état S (entropie) extensive telle que pour toute transformation :\nΔS = S_e + S_c\n• S_e = ∫ δQ/T_(frontière) : entropie d'échange\n• S_c ≥ 0 : entropie créée (= 0 si réversible).","tags":"deuxieme-principe","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.38 - Deuxième principe","type":"application","recto":"Conséquence : sens d'évolution ?","verso":"Pour un système ISOLÉ : ΔS ≥ 0.\nL'entropie d'un système isolé ne peut que croître.\nÉquilibre = maximum d'entropie.","tags":"evolution;ds","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.38 - Deuxième principe","type":"formula","recto":"Variation d'entropie d'un GP ?","verso":"ΔS = n·C_V·ln(T_f/T_i) + n·R·ln(V_f/V_i)\nÉquivalent : ΔS = n·C_P·ln(T_f/T_i) − n·R·ln(P_f/P_i).","tags":"entropie;gp","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.38 - Deuxième principe","type":"formula","recto":"Entropie d'un solide / liquide incompressible ?","verso":"ΔS = m·c·ln(T_f/T_i)\n(c : capacité thermique massique)","tags":"entropie;solide","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.38 - Deuxième principe","type":"definition","recto":"Identités thermodynamiques ?","verso":"dU = T·dS − P·dV\ndH = T·dS + V·dP\n(formes différentielles fondamentales).","tags":"identites-td","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"definition","recto":"Diagramme PT d'un corps pur ?","verso":"Trois phases (solide, liquide, gaz) séparées par 3 courbes :\n• Sublimation, fusion, vaporisation\nPoint triple (3 phases) et point critique (au-delà : fluide supercritique).","tags":"diagramme-pt","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"formula","recto":"Pression de vapeur saturante ?","verso":"Pour un corps pur en équilibre liquide-vapeur à T donnée : P_sat(T).\nClapeyron : dP_sat/dT = L_v / (T·ΔV).","tags":"pression-saturante","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"definition","recto":"Titre vapeur x ?","verso":"x = m_v / (m_v + m_l) ∈ [0, 1]\nProportion de vapeur dans un mélange liquide-vapeur.\nThéorème des moments : x = AM/AB sur le diagramme.","tags":"titre-vapeur","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"definition","recto":"Cycle d'une machine thermique ?","verso":"Suite de transformations ramenant le système à son état initial. ΔU = 0 sur le cycle.\nW + Q = 0.","tags":"cycle","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"law","recto":"Théorème de Carnot ?","verso":"Une machine ditherme (entre source chaude T_c et froide T_f) a un rendement ≤ celui d'une machine RÉVERSIBLE :\nη_max = 1 − T_f/T_c","tags":"carnot","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"formula","recto":"Rendement d'un moteur ditherme ?","verso":"η = W_fourni / Q_chaud = 1 − Q_f/Q_c\n0 ≤ η ≤ 1 − T_f/T_c (Carnot).","tags":"rendement;moteur","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"formula","recto":"Efficacité d'une pompe à chaleur ?","verso":"e_PAC = Q_chaud/W_reçu\nMax = T_c/(T_c − T_f) (toujours > 1).","tags":"pompe-chaleur","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Thermodynamique","chapitre":"Ch.40-41 - Corps purs et machines thermiques","type":"formula","recto":"Efficacité d'un réfrigérateur ?","verso":"e_frigo = Q_froid/W_reçu\nMax = T_f/(T_c − T_f).","tags":"frigo","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"law","recto":"Loi de Coulomb ?","verso":"⃗F_(2/1) = (1/(4πε₀))·(q₁·q₂/r²)·⃗u_(2→1)\n• ε₀ ≈ 8,85·10⁻¹² F/m\n• 1/(4πε₀) ≈ 9·10⁹ N·m²·C⁻²\nForce attractive si charges opposées, répulsive sinon.","tags":"coulomb","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"definition","recto":"Champ électrostatique ⃗E ?","verso":"Créé par une distribution de charges : ⃗F = q·⃗E sur une charge test q.\nUnité : V·m⁻¹.","tags":"champ-E","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"formula","recto":"Champ d'une charge ponctuelle ?","verso":"⃗E(M) = (1/(4πε₀))·(q/r²)·⃗u\noù ⃗u : vecteur unitaire de Q vers M.","tags":"E;ponctuelle","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"formula","recto":"Champ d'une distribution continue ?","verso":"⃗E(M) = (1/(4πε₀))·∫ (dq/r²)·⃗u\ndq peut être ρ·dV (volumique), σ·dS (surfacique), λ·dℓ (linéique).","tags":"E;distribution","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"definition","recto":"Potentiel électrostatique V ?","verso":"Pour une charge ponctuelle : V = q/(4πε₀·r) + cste\n⃗E = −grad(V).\nV s'exprime en volts. Défini à une constante près.","tags":"potentiel","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"formula","recto":"Lien E-V ?","verso":"⃗E = −grad(V) = −(∂V/∂x, ∂V/∂y, ∂V/∂z)\nUnités : V/m = N/C.","tags":"E;V","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.42-43 - Champ électrostatique","type":"formula","recto":"Circulation et travail ?","verso":"Travail de ⃗F = q·⃗E pour déplacer q de A à B :\nW = q·(V_A − V_B) = −q·∫_A^B ⃗E·d⃗ℓ","tags":"circulation;V","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.44 - Propriétés du champ E","type":"law","recto":"Théorème de Gauss ?","verso":"Flux de ⃗E à travers une surface fermée :\n∯ ⃗E·d⃗S = Q_int/ε₀\nQ_int : charge totale intérieure à la surface.\nValable sous toutes hypothèses (statiques ou non en réalité).","tags":"gauss;E","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.44 - Propriétés du champ E","type":"law","recto":"Conservation de la circulation (statique) ?","verso":"∮ ⃗E·d⃗ℓ = 0 sur tout chemin fermé.\nÉquivalent à ⃗E = −grad(V).","tags":"circulation","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.44 - Propriétés du champ E","type":"application","recto":"Symétries en électrostatique ?","verso":"• Plan de symétrie de la distribution : ⃗E ⊂ ce plan.\n• Plan d'antisymétrie : ⃗E ⊥ à ce plan.\nAident à déterminer la direction de ⃗E avant calcul.","tags":"symetries","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.44 - Propriétés du champ E","type":"application","recto":"Invariances ?","verso":"• Translation selon un axe : ⃗E indépendant de cette coordonnée.\n• Rotation : ⃗E indépendant de l'angle.\nDéterminent les variables dont ⃗E dépend.","tags":"invariances","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.45 - Champs et potentiels usuels","type":"formula","recto":"Fil infini de charge λ ?","verso":"E(r) = λ/(2πε₀·r)  (radial)\nV(r) = −(λ/(2πε₀))·ln(r) + cste","tags":"fil","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.45 - Champs et potentiels usuels","type":"formula","recto":"Plan infini chargé σ ?","verso":"E = σ/(2ε₀)  (perpendiculaire au plan, des deux côtés)\nChamp UNIFORME en module mais discontinu de signe.","tags":"plan","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.45 - Champs et potentiels usuels","type":"formula","recto":"Sphère uniformément chargée (Q, R) ?","verso":"Pour r > R (extérieur) : ⃗E = (1/(4πε₀))·Q/r²·⃗u (comme charge ponctuelle).\nPour r < R (intérieur, volumique) : E = (Q·r)/(4πε₀·R³)·⃗u.\nCas surfacique (r < R) : E = 0.","tags":"sphere","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.45 - Champs et potentiels usuels","type":"formula","recto":"Condensateur plan ?","verso":"Entre les plaques : E = σ/ε₀ = U/d (uniforme).\nCapacité : C = ε₀·S/d.","tags":"condensateur-plan","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.45 - Champs et potentiels usuels","type":"formula","recto":"Énergie d'un condensateur ?","verso":"E = (1/2)·C·U² = Q²/(2C) = (1/2)·Q·U","tags":"energie;condensateur","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.46 - Dipôle électrostatique","type":"definition","recto":"Dipôle électrostatique ?","verso":"Ensemble de 2 charges +q et −q séparées par une distance a (petite).\nMoment dipolaire : ⃗p = q·⃗a (de − vers +).\nUnité : C·m.","tags":"dipole;def","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.46 - Dipôle électrostatique","type":"formula","recto":"Potentiel d'un dipôle (à grande distance r ≫ a) ?","verso":"V(M) = (1/(4πε₀))·(⃗p·⃗u)/r² = (p·cos θ)/(4πε₀·r²)\noù θ : angle entre ⃗p et ⃗OM.","tags":"dipole;V","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.46 - Dipôle électrostatique","type":"formula","recto":"Champ d'un dipôle (loin, en sphériques) ?","verso":"E_r = (2p·cos θ)/(4πε₀·r³)\nE_θ = (p·sin θ)/(4πε₀·r³)","tags":"dipole;E","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.46 - Dipôle électrostatique","type":"formula","recto":"Action sur un dipôle dans un champ ?","verso":"• Force : ⃗F = (⃗p·grad)⃗E (nulle si ⃗E uniforme)\n• Moment : ⃗Γ = ⃗p∧⃗E (tend à aligner ⃗p sur ⃗E)\n• Énergie : U = −⃗p·⃗E (minimale quand alignés).","tags":"dipole;actions","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.47-48 - Magnétostatique — Biot-Savart","type":"definition","recto":"Champ magnétique ⃗B ?","verso":"Créé par les courants électriques. Unité : tesla (T).\nDétecté par la force de Lorentz sur une charge : ⃗F = q·⃗v∧⃗B.","tags":"B","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.47-48 - Magnétostatique — Biot-Savart","type":"law","recto":"Loi de Biot et Savart ?","verso":"d⃗B = (μ₀/(4π))·(I·d⃗ℓ ∧ ⃗u)/r²\nμ₀ = 4π·10⁻⁷ H/m (perméabilité du vide).","tags":"biot-savart","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.47-48 - Magnétostatique — Biot-Savart","type":"formula","recto":"Champ d'un fil rectiligne infini ?","verso":"B = μ₀·I/(2π·r)\nLignes de champ : cercles concentriques au fil.\nSens : règle de la main droite.","tags":"fil-droit","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.47-48 - Magnétostatique — Biot-Savart","type":"formula","recto":"Champ au centre d'une spire circulaire ?","verso":"B = μ₀·I/(2R)\nSur l'axe à distance z : B(z) = μ₀·I·R²/(2·(R²+z²)^(3/2))","tags":"spire","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.47-48 - Magnétostatique — Biot-Savart","type":"formula","recto":"Champ dans un solénoïde infini ?","verso":"B = μ₀·n·I  (à l'intérieur, uniforme)\nB = 0 à l'extérieur (solénoïde infini idéal).\nn : nombre de spires par unité de longueur.","tags":"solenoide","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.49 - Propriétés du champ B","type":"law","recto":"Conservation du flux magnétique ?","verso":"∯ ⃗B·d⃗S = 0 sur toute surface FERMÉE.\nLes lignes de champ se referment sur elles-mêmes (pas de monopôle magnétique).","tags":"flux;B","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.49 - Propriétés du champ B","type":"law","recto":"Théorème d'Ampère ?","verso":"∮ ⃗B·d⃗ℓ = μ₀·I_enlacé\nValable en magnétostatique. I_enlacé : courant traversant un contour orienté.","tags":"ampere","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.49 - Propriétés du champ B","type":"application","recto":"Symétries pour ⃗B ?","verso":"• Plan de symétrie de la distribution de courants : ⃗B PERPENDICULAIRE à ce plan.\n• Plan d'antisymétrie : ⃗B DANS ce plan.\nATTENTION : symétries opposées par rapport à ⃗E.","tags":"symetries;B","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.53 - Particule chargée dans champ EM","type":"formula","recto":"Force de Lorentz ?","verso":"⃗F = q·(⃗E + ⃗v∧⃗B)\nForce électrostatique + magnétique.","tags":"lorentz","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.53 - Particule chargée dans champ EM","type":"application","recto":"Mouvement dans ⃗E uniforme ?","verso":"⃗F = q·⃗E constante → mouvement uniformément accéléré.\nThéorème de l'énergie cinétique : ΔE_c = q·U_AB.","tags":"particule;E","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.53 - Particule chargée dans champ EM","type":"application","recto":"Mouvement dans ⃗B uniforme (sans E) ?","verso":"Le travail de ⃗F est nul (⃗F⊥⃗v) → v = cste.\nTrajectoire CIRCULAIRE de rayon R = m·v/(|q|·B).\nPulsation cyclotron : ω_c = |q|·B/m.","tags":"cyclotron","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.53 - Particule chargée dans champ EM","type":"application","recto":"Mouvement hélicoïdal ?","verso":"Si ⃗v₀ a une composante ‖⃗B et une composante ⊥⃗B : trajectoire hélicoïdale.\nProjection sur plan ⊥⃗B : cercle. Sur ⃗B : MRU.","tags":"helicoidal","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MPSI Physique — Électromagnétisme","chapitre":"Ch.53 - Particule chargée dans champ EM","type":"formula","recto":"Travail de la force magnétique ?","verso":"Toujours NUL : ⃗F⊥⃗v → δW = 0.\n→ B ne fait PAS varier l'énergie cinétique.","tags":"B;travail-nul","niveau":"MPSI","matiere":"Physique-Chimie"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"definition","recto":"Ensembles équipotents ?","verso":"E et F équipotents ⟺ ∃ bijection E → F.\nNotation : |E| = |F|.\nC'est la généralisation de l'égalité des cardinaux.","tags":"equipotent","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"definition","recto":"Ensemble dénombrable ?","verso":"E dénombrable ⟺ |E| = |ℕ|, c.à.d. ∃ bijection E → ℕ.\nÉquivalent : E peut être énuméré en suite.","tags":"denombrable","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"definition","recto":"Ensemble au plus dénombrable ?","verso":"E fini OU dénombrable.\nCaractérisation : ∃ injection E → ℕ.\nÉquivalent : ∃ surjection ℕ → E (si E ≠ ∅).","tags":"au-plus-denombrable","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"law","recto":"Toute partie d'un ensemble dénombrable...","verso":"...est au plus dénombrable.","tags":"denombrable;partie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"law","recto":"Union dénombrable d'ensembles dénombrables ?","verso":"Si (Aₙ)_(n∈ℕ) est une famille dénombrable d'ensembles au plus dénombrables, alors ∪ Aₙ est au plus dénombrable.","tags":"denombrable;union","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"law","recto":"Produit fini d'ensembles dénombrables ?","verso":"Si A₁, ..., Aₙ dénombrables, alors A₁ × ... × Aₙ est dénombrable.\nGénéralisation : ℤ, ℚ sont dénombrables.","tags":"denombrable;produit","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"law","recto":"ℝ est-il dénombrable ?","verso":"NON. ℝ n'est PAS dénombrable (théorème de Cantor, par diagonalisation).\nDonc tout intervalle non trivial de ℝ est non dénombrable.","tags":"R;non-denombrable","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"law","recto":"Théorème de Cantor ?","verso":"Pour tout ensemble E : |E| < |𝒫(E)|.\nIl n'existe pas de surjection E → 𝒫(E).\nDonc une infinité de cardinaux infinis distincts.","tags":"cantor","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"definition","recto":"Hypothèse du continu (HP) ?","verso":"Il n'existe pas de cardinal strictement compris entre |ℕ| et |ℝ|.\nIndépendante de ZFC (Gödel + Cohen).","tags":"continu","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.1 - Cardinaux et dénombrabilité","type":"definition","recto":"Axiome du choix (HP) ?","verso":"Pour toute famille (Aᵢ)_(i ∈ I) d'ensembles non vides, il existe une fonction de choix f : I → ∪ Aᵢ avec f(i) ∈ Aᵢ.\nÉquivalent au lemme de Zorn.","tags":"choix","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"definition","recto":"Norme sur un 𝕂-ev E ?","verso":"Application N : E → ℝ vérifiant :\n• Séparation : N(x) = 0 ⟺ x = 0\n• Homogénéité : N(λx) = |λ|·N(x)\n• Inégalité triangulaire : N(x+y) ≤ N(x) + N(y).","tags":"norme","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"definition","recto":"Espace vectoriel normé (evn) ?","verso":"Couple (E, ‖·‖) où E est un 𝕂-ev et ‖·‖ une norme sur E.","tags":"evn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"formula","recto":"Inégalité triangulaire inverse ?","verso":"|‖x‖ − ‖y‖| ≤ ‖x − y‖","tags":"triangulaire-inverse","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"definition","recto":"Distance associée à une norme ?","verso":"d(x, y) = ‖x − y‖.\nDistance ≥ 0, symétrique, séparante, et vérifie l'inégalité triangulaire.","tags":"distance","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"formula","recto":"Normes usuelles sur 𝕂ⁿ ?","verso":"Pour x = (x₁, ..., xₙ) :\n‖x‖₁ = Σ|xᵢ|\n‖x‖₂ = √(Σ|xᵢ|²) (euclidienne)\n‖x‖∞ = max|xᵢ|","tags":"normes;Kn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"formula","recto":"Normes usuelles sur C([a,b]) ?","verso":"‖f‖₁ = ∫|f|\n‖f‖₂ = √(∫|f|²)\n‖f‖∞ = sup|f| (norme infinie)","tags":"normes;C(I)","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"formula","recto":"Normes sur 𝕂[X] ?","verso":"Pour P = Σ aₖ Xᵏ :\n‖P‖₁ = Σ|aₖ|, ‖P‖∞ = max|aₖ|, ‖P‖₂ = √(Σ|aₖ|²).\nAttention : non équivalentes (dim infinie).","tags":"normes;polynome","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"formula","recto":"Norme matricielle subordonnée ?","verso":"‖A‖_op = sup_(‖x‖=1) ‖Ax‖.\nPropriétés : ‖A·x‖ ≤ ‖A‖_op · ‖x‖, ‖AB‖_op ≤ ‖A‖_op · ‖B‖_op.","tags":"norme;matricielle","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.I - Normes sur un ev","type":"definition","recto":"Boule ouverte / fermée ?","verso":"B(a, r) = {x : ‖x − a‖ < r}\nB̄(a, r) = {x : ‖x − a‖ ≤ r}\nSphère : S(a, r) = {x : ‖x − a‖ = r}.","tags":"boule","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Ouvert d'un evn ?","verso":"U ⊂ E ouvert ⟺ ∀x ∈ U, ∃ r > 0, B(x, r) ⊂ U.\n∅ et E sont ouverts. Boule ouverte est ouverte.","tags":"ouvert","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Fermé ?","verso":"F fermé ⟺ E \ F est ouvert.\nÉquivalent : toute suite (xₙ) de F qui converge dans E a sa limite dans F.","tags":"ferme","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"law","recto":"Stabilité des ouverts / fermés ?","verso":"• Réunion QUELCONQUE d'ouverts : ouvert.\n• Intersection FINIE d'ouverts : ouverte.\n• Intersection quelconque de fermés : fermée.\n• Réunion FINIE de fermés : fermée.","tags":"stabilite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Voisinage ?","verso":"V est un voisinage de a ⟺ ∃ ouvert U avec a ∈ U ⊂ V.\nÉquiv. : ∃ r > 0, B(a, r) ⊂ V.","tags":"voisinage","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Intérieur Int(A) ou Å ?","verso":"Plus grand ouvert inclus dans A.\nÉquiv. : Å = {a : A est voisinage de a}.","tags":"interieur","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Adhérence Ā ?","verso":"Plus petit fermé contenant A.\nÉquiv. : Ā = {a : ∃ (xₙ) ⊂ A, xₙ → a}.","tags":"adherence","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Frontière ∂A ?","verso":"∂A = Ā \ Å = adhérence de A privée de son intérieur.\nLes points du « bord ».","tags":"frontiere","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.II - Topologie d'un evn","type":"definition","recto":"Partie dense ?","verso":"A dense dans E ⟺ Ā = E ⟺ ∀x ∈ E, ∀ε > 0, B(x, ε) ∩ A ≠ ∅.\nEx. : ℚ dense dans ℝ.","tags":"dense","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.III - Comparaison de normes","type":"definition","recto":"Domination ?","verso":"N₁ dominée par N₂ (N₁ ≼ N₂) ⟺ ∃ k > 0, ∀x, N₁(x) ≤ k·N₂(x).","tags":"domination","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.III - Comparaison de normes","type":"definition","recto":"Normes équivalentes ?","verso":"N₁ et N₂ équivalentes ⟺ se dominent mutuellement :\n∃ α, β > 0, ∀x, α·N₁(x) ≤ N₂(x) ≤ β·N₁(x).","tags":"normes-equivalentes","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.III - Comparaison de normes","type":"law","recto":"Toutes les normes sur un ev de dim FINIE...","verso":"...sont équivalentes !\n→ Topologie unique en dim finie.\n→ Convergence ne dépend pas de la norme.","tags":"dim-finie;normes","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.III - Comparaison de normes","type":"application","recto":"Conséquence pratique en dim finie ?","verso":"Pour étudier la convergence : on peut choisir LA norme la plus pratique (souvent ‖·‖∞).","tags":"dim-finie;application","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"definition","recto":"Suite convergente dans un evn ?","verso":"(uₙ) → ℓ ⟺ ‖uₙ − ℓ‖ → 0.\nÉquiv. : ∀ε > 0, ∃ N, ∀n ≥ N, ‖uₙ − ℓ‖ < ε.","tags":"convergence;evn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"law","recto":"Caractérisation des fermés par les suites ?","verso":"F fermé ⟺ pour toute suite (xₙ) ⊂ F convergente, lim xₙ ∈ F.","tags":"ferme;suites","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"law","recto":"Caractérisation séquentielle de l'adhérence ?","verso":"x ∈ Ā ⟺ ∃ (xₙ) ⊂ A avec xₙ → x.","tags":"adherence;suites","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"law","recto":"Convergence dans un evn de dim finie ?","verso":"Soit (e₁, ..., eₚ) une base de E. xₙ = Σ x_(n,k) eₖ.\nxₙ → ℓ = Σ ℓₖ eₖ ⟺ ∀k, x_(n,k) → ℓₖ.\nConvergence COMPOSANTE PAR COMPOSANTE.","tags":"convergence;dim-finie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"definition","recto":"Suite de Cauchy ?","verso":"(uₙ) Cauchy ⟺ ∀ε > 0, ∃ N, ∀p, q ≥ N, ‖u_p − u_q‖ < ε.","tags":"cauchy","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"law","recto":"Convergente ⟹ Cauchy.","verso":"Toute suite convergente est de Cauchy.\nLa réciproque est vraie dans un espace COMPLET (Banach).","tags":"cauchy;convergente","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.IV - Convergence dans un evn","type":"definition","recto":"Espace de Banach ?","verso":"Evn dans lequel toute suite de Cauchy converge.\nEx. : 𝕂ⁿ, C([a,b]) avec ‖·‖∞.","tags":"banach","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"definition","recto":"Limite d'une fonction (evn) ?","verso":"f : E → F, a ∈ Ē, ℓ ∈ F :\nlim_(x→a) f(x) = ℓ ⟺ ∀ε > 0, ∃ η > 0, ∀x ∈ Df, ‖x−a‖_E < η ⇒ ‖f(x)−ℓ‖_F < ε.","tags":"limite;evn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"law","recto":"Caractérisation séquentielle ?","verso":"lim_(x→a) f(x) = ℓ ⟺ ∀(xₙ) → a (dans Df), f(xₙ) → ℓ.","tags":"limite;sequentielle","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"definition","recto":"Continuité en un point ?","verso":"f continue en a ⟺ lim_(x→a) f(x) = f(a).","tags":"continuite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"law","recto":"Caractérisation de la continuité globale ?","verso":"f continue sur E ⟺ ∀ ouvert V de F, f⁻¹(V) ouvert de E.\n⟺ ∀ fermé W de F, f⁻¹(W) fermé de E.","tags":"continuite;ouverts","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"law","recto":"Théorèmes opératoires ?","verso":"Somme, produit, quotient (avec dénominateur ≠ 0) et composée de continues sont continues.","tags":"continuite;operations","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"law","recto":"Continuité des applications linéaires en dim finie ?","verso":"Toute application linéaire entre EVN de dim FINIE est continue.\nEn dim infinie : ce n'est pas toujours le cas.","tags":"lineaire;continuite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"law","recto":"Caractérisation de la continuité d'une application linéaire ?","verso":"u : E → F linéaire continue ⟺ ∃ k > 0, ∀x, ‖u(x)‖_F ≤ k·‖x‖_E.\nNorme triple : ‖u‖ = sup_(‖x‖=1) ‖u(x)‖.","tags":"lineaire;k-lipschitz","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.3.V - Limites et continuité","type":"definition","recto":"Fonction lipschitzienne ?","verso":"∃ k ≥ 0, ∀x, y, ‖f(x) − f(y)‖ ≤ k·‖x − y‖.\nLipschitz ⟹ uniformément continue ⟹ continue.","tags":"lipschitz","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"definition","recto":"Partie compacte ?","verso":"K compacte ⟺ de toute suite de K, on peut extraire une sous-suite convergeant DANS K.\n(Définition séquentielle, valable en evn.)","tags":"compact","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"law","recto":"Caractérisation des compacts en dim finie ?","verso":"En dim FINIE : K compact ⟺ K fermé ET borné (Bolzano-Weierstrass).","tags":"compact;dim-finie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"law","recto":"Image continue d'un compact ?","verso":"f continue, K compact ⟹ f(K) compact.\nEn particulier : continue sur compact à valeurs réelles ⟹ atteint son max et son min.","tags":"compact;image","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"law","recto":"Théorème de Heine ?","verso":"Toute fonction continue sur un compact est UNIFORMÉMENT continue.","tags":"heine","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"definition","recto":"Partie connexe par arcs ?","verso":"A connexe par arcs ⟺ ∀ x, y ∈ A, ∃ chemin continu γ : [0,1] → A avec γ(0)=x, γ(1)=y.","tags":"connexe-arcs","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"law","recto":"Image continue d'un connexe par arcs ?","verso":"Si A connexe par arcs et f continue, alors f(A) connexe par arcs.","tags":"connexe;image","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"law","recto":"TVI généralisé ?","verso":"Si A connexe par arcs et f : A → ℝ continue, alors f(A) est un INTERVALLE de ℝ.","tags":"tvi;generalise","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"definition","recto":"Espace complet ?","verso":"Toute suite de Cauchy converge.\nDim finie : tout EVN est complet.\nC([a,b], ‖·‖∞) est complet.","tags":"complet","niveau":"MP","matiere":"Maths"},{"deck":"MP — Topologie & EVN","chapitre":"Ch.11 - Compléments de topologie","type":"law","recto":"Théorème du point fixe de Banach ?","verso":"Soit (E, d) complet, f : E → E contractante (k-lipschitz, k < 1).\nAlors f admet un UNIQUE point fixe ℓ, et toute suite uₙ₊₁ = f(uₙ) converge vers ℓ.","tags":"banach;point-fixe","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"definition","recto":"Série Σ uₙ ?","verso":"Suite des sommes partielles Sₙ = Σ_(k=0)^n uₖ.\nΣuₙ converge ⟺ (Sₙ) converge. Sa somme est lim Sₙ.","tags":"serie;def","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Critère de Cauchy pour les séries ?","verso":"Σuₙ converge ⟺ ∀ε > 0, ∃ N, ∀p ≥ q ≥ N, |Σ_(k=q)^p uₖ| < ε.","tags":"cauchy;serie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Condition nécessaire de convergence ?","verso":"Σuₙ converge ⟹ uₙ → 0.\nLa réciproque est FAUSSE (ex. série harmonique).","tags":"serie;cn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Série à termes positifs (TCSTP) ?","verso":"Une série à termes positifs converge ⟺ la suite des sommes partielles est MAJORÉE.","tags":"tcstp","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Critère de comparaison ?","verso":"0 ≤ uₙ ≤ vₙ. Si Σvₙ converge, alors Σuₙ converge.\nSi Σuₙ diverge, alors Σvₙ diverge.","tags":"comparaison;serie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Critère d'équivalence ?","verso":"uₙ ~ vₙ avec uₙ, vₙ ≥ 0 (à partir d'un rang) ⟹ Σuₙ et Σvₙ ont même nature.","tags":"equivalence;serie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Série de Riemann ?","verso":"Σ 1/nᵃ converge ⟺ a > 1.\nGénéralisation : Σ 1/(n·(ln n)^b) converge ⟺ b > 1 (a = 1).","tags":"riemann;serie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Série géométrique ?","verso":"Σ qⁿ converge ⟺ |q| < 1.\nSomme : Σ qⁿ = 1/(1−q).","tags":"geometrique","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I - Séries numériques (rappels et compléments)","type":"law","recto":"Comparaison série-intégrale ?","verso":"Soit f continue, positive, décroissante sur [N, +∞[.\nLa série Σ f(n) et l'intégrale ∫_N^(+∞) f(t) dt sont de même nature.","tags":"serie-integrale","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I.4 - Séries semi-convergentes","type":"definition","recto":"Série absolument convergente ?","verso":"Σuₙ absolument convergente ⟺ Σ|uₙ| converge.","tags":"absolu;convergente","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I.4 - Séries semi-convergentes","type":"law","recto":"Absolument convergente ⟹ convergente.","verso":"Vrai dans tout espace de Banach (en particulier ℝ, ℂ, ℝⁿ).\nLa réciproque est FAUSSE.","tags":"absolu;cv","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I.4 - Séries semi-convergentes","type":"definition","recto":"Série semi-convergente ?","verso":"Σuₙ converge mais Σ|uₙ| diverge.\nEx. : série harmonique alternée.","tags":"semi-convergente","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I.4 - Séries semi-convergentes","type":"law","recto":"Critère spécial des séries alternées (CSSA) ?","verso":"Si (aₙ) ≥ 0, décroissante, aₙ → 0, alors Σ(−1)ⁿ aₙ converge.\nReste : |Rₙ| ≤ a_(n+1).","tags":"cssa","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.2.I.4 - Séries semi-convergentes","type":"law","recto":"Théorème de réarrangement (Riemann) ?","verso":"Une série semi-convergente peut être réarrangée pour converger vers TOUT réel (ou ±∞).\nUne série absolument convergente garde sa somme par tout réarrangement.","tags":"rearrangement","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.I - Convergences de suites de fonctions","type":"definition","recto":"Convergence simple (CVS) ?","verso":"fₙ → f simplement sur A ⟺ ∀ x ∈ A, fₙ(x) → f(x).","tags":"cvs","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.I - Convergences de suites de fonctions","type":"definition","recto":"Convergence uniforme (CVU) ?","verso":"fₙ → f uniformément sur A ⟺ sup_(x ∈ A) |fₙ(x) − f(x)| → 0.\nÉquiv. : ‖fₙ − f‖∞ → 0.","tags":"cvu","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.I - Convergences de suites de fonctions","type":"law","recto":"CVU ⟹ CVS.","verso":"Si fₙ → f uniformément, alors fₙ → f simplement.\nLa réciproque est FAUSSE.","tags":"cvu;cvs","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.I - Convergences de suites de fonctions","type":"definition","recto":"Convergence uniforme locale ?","verso":"fₙ → f uniformément sur tout compact (ou tout segment) inclus dans A.\nPlus faible que CVU globale, suffisante pour beaucoup de propriétés.","tags":"cvu;locale","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.II - Régularité des limites de suites","type":"law","recto":"Continuité d'une limite uniforme ?","verso":"Si chaque fₙ est continue sur A et fₙ → f UNIFORMÉMENT sur A,\nalors f est CONTINUE sur A.","tags":"cvu;continuite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.II - Régularité des limites de suites","type":"law","recto":"Théorème de la double limite ?","verso":"Sous CVU, lim_(x→a) lim_(n→∞) fₙ(x) = lim_(n→∞) lim_(x→a) fₙ(x).","tags":"double-limite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.II - Régularité des limites de suites","type":"law","recto":"Interversion limite-intégrale (CVU) ?","verso":"fₙ continues sur [a,b], fₙ → f UNIFORMÉMENT.\nAlors ∫_a^b fₙ → ∫_a^b f. Permutation lim - intégrale.","tags":"interversion;integrale","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.II - Régularité des limites de suites","type":"law","recto":"Dérivabilité d'une limite ?","verso":"Si :\n• fₙ ∈ C¹ sur [a,b]\n• fₙ → f simplement\n• fₙ' → g UNIFORMÉMENT\nAlors f ∈ C¹ et f' = g.","tags":"limite;derivabilite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.III - Séries de fonctions","type":"definition","recto":"Convergence simple/uniforme d'une série de fonctions ?","verso":"Σ uₙ converge simplement (resp. uniformément) sur A ⟺ la suite des sommes partielles SN(x) = Σ_(n=0)^N uₙ(x) converge simplement (resp. uniformément).","tags":"serie-fct;cvs;cvu","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.III - Séries de fonctions","type":"definition","recto":"Convergence normale ?","verso":"Σ uₙ converge normalement sur A ⟺ ∃ aₙ ≥ 0 avec |uₙ(x)| ≤ aₙ ∀x ∈ A et Σ aₙ converge.\nÉquiv. : Σ ‖uₙ‖∞ < +∞.","tags":"cvn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.III - Séries de fonctions","type":"law","recto":"Hiérarchie des convergences (séries) ?","verso":"CV normale ⟹ CV uniforme ⟹ CV absolue ET CV simple.\nLes implications réciproques sont fausses.","tags":"cv;hierarchie","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.4.III - Séries de fonctions","type":"application","recto":"Stratégie pour étudier une série de fonctions ?","verso":"1. Trouver l'ensemble de CVS\n2. Vérifier la CV normale (le plus simple) sur des sous-ensembles\n3. Sinon CVU directement, puis appliquer théorèmes de continuité, dérivation, intégration.","tags":"serie-fct;methode","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"definition","recto":"Intégrale impropre ?","verso":"∫_a^b f(t) dt avec f non bornée près d'une borne, ou b = +∞ (ou a = −∞).\nDéfinie comme limite : ∫_a^X f → ?, X → b.","tags":"impropre;def","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"definition","recto":"Intégrale convergente ?","verso":"∫_a^(+∞) f converge ⟺ lim_(X→+∞) ∫_a^X f existe et est finie.\nIdem aux autres bornes.","tags":"impropre;cv","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"law","recto":"Critère de comparaison ?","verso":"0 ≤ f ≤ g sur [a, +∞[. Si ∫g converge, ∫f converge.\nSi ∫f diverge, ∫g diverge.","tags":"comparaison;impropre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"law","recto":"Critère d'équivalence ?","verso":"f ~ g (au voisinage d'une borne), f, g ≥ 0 ⟹ ∫f et ∫g de même nature.","tags":"equivalence;impropre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"law","recto":"Intégrale de Riemann (en +∞) ?","verso":"∫_1^(+∞) dt/t^a converge ⟺ a > 1.","tags":"riemann;infini","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"law","recto":"Intégrale de Riemann (en 0) ?","verso":"∫_0^1 dt/t^a converge ⟺ a < 1.","tags":"riemann;zero","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"definition","recto":"Intégrale absolument convergente ?","verso":"∫f absolument convergente ⟺ ∫|f| converge.\nAbsolument convergente ⟹ convergente.","tags":"abs-cv;impropre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.I - Intégrales généralisées (impropres)","type":"law","recto":"Critère d'Abel pour intégrales impropres ?","verso":"Si φ ≥ 0 décroissante, → 0 en +∞, et ∫f bornée (sommes partielles), alors ∫ φ·f converge.","tags":"abel","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.II - Théorèmes d'intégration sous le signe","type":"law","recto":"Théorème de convergence dominée (TCD) ?","verso":"Si :\n• fₙ → f simplement sur I\n• fₙ continues par morceaux\n• ∃ φ ≥ 0 intégrable sur I tq |fₙ| ≤ φ ∀n\nAlors ∫_I fₙ → ∫_I f.\n(Hypothèse de DOMINATION par fonction intégrable indép. de n).","tags":"tcd","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.II - Théorèmes d'intégration sous le signe","type":"law","recto":"Théorème d'intégration terme à terme (séries) ?","verso":"Si :\n• uₙ continues par morceaux, intégrables\n• Σ uₙ converge simplement vers s\n• Σ ∫ |uₙ| converge\nAlors s est intégrable et ∫ s = Σ ∫ uₙ.","tags":"iteration","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.II - Théorèmes d'intégration sous le signe","type":"law","recto":"Continuité d'une intégrale à paramètre ?","verso":"f(x, t) continue en x, dominée par φ(t) intégrable indép. de x.\nAlors x ↦ ∫_I f(x,t) dt est continue.","tags":"integrale-parametre;continuite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.5.II - Théorèmes d'intégration sous le signe","type":"law","recto":"Dérivation d'une intégrale à paramètre (Leibniz) ?","verso":"Si f de classe C¹ en x, ∂f/∂x continue et dominée par φ intégrable :\n(d/dx) ∫_I f(x,t) dt = ∫_I (∂f/∂x)(x,t) dt.","tags":"leibniz","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"definition","recto":"Série entière Σ aₙ zⁿ ?","verso":"Série de fonctions de la forme Σ aₙ zⁿ avec aₙ ∈ ℂ et z ∈ ℂ (ou ℝ).","tags":"serie-entiere","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"definition","recto":"Rayon de convergence R ?","verso":"R = sup{r ≥ 0 | (aₙ rⁿ) bornée}.\nR ∈ [0, +∞]. La série :\n• converge absolument si |z| < R\n• diverge si |z| > R\n• cas |z| = R : à étudier au cas par cas.","tags":"rayon-cv","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"law","recto":"Lemme d'Abel ?","verso":"Si (aₙ z₀ⁿ) bornée, alors la série converge absolument pour tout |z| < |z₀|.","tags":"abel;serie-entiere","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"formula","recto":"Calcul de R via aₙ ?","verso":"Règle de d'Alembert : R = lim |aₙ|/|aₙ₊₁| (si la limite existe).\nRègle de Cauchy : 1/R = lim sup |aₙ|^(1/n) (formule de Hadamard).","tags":"rayon;calcul","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"law","recto":"Convergence sur le disque ouvert ?","verso":"Σ aₙ zⁿ converge NORMALEMENT sur tout disque fermé D̄(0, r) avec r < R.\nDonc CVU et somme continue sur D(0, R).","tags":"disque-ouvert","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"law","recto":"Dérivation et intégration terme à terme ?","verso":"Soit f(x) = Σ aₙ xⁿ de rayon R sur ]−R, R[ :\n• f est C^∞ sur ]−R, R[\n• f'(x) = Σ n·aₙ x^(n−1) (même R)\n• Primitive : Σ aₙ x^(n+1)/(n+1) (même R)","tags":"derivation;serie-entiere","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"formula","recto":"Formules de Taylor et coefficients ?","verso":"Si f(x) = Σ aₙ xⁿ sur ]−R, R[, alors aₙ = f^(n)(0) / n!.\nDéveloppement en série entière unique.","tags":"taylor;serie-entiere","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"formula","recto":"Séries entières usuelles (rayon ∞) ?","verso":"eˣ = Σ xⁿ/n!\ncos x = Σ (−1)ⁿ x^(2n)/(2n)!\nsin x = Σ (−1)ⁿ x^(2n+1)/(2n+1)!\nch x = Σ x^(2n)/(2n)!\nsh x = Σ x^(2n+1)/(2n+1)!","tags":"se;usuelles;R-infini","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"formula","recto":"Séries entières (rayon 1) ?","verso":"1/(1−x) = Σ xⁿ (|x| < 1)\nln(1+x) = Σ (−1)^(n−1) xⁿ/n (|x| < 1)\narctan x = Σ (−1)ⁿ x^(2n+1)/(2n+1) (|x| < 1)\n(1+x)^α = Σ (α n) xⁿ (|x| < 1)","tags":"se;usuelles;R-1","niveau":"MP","matiere":"Maths"},{"deck":"MP — Analyse","chapitre":"Ch.8 - Séries entières","type":"application","recto":"Critère pratique de DSE en 0 ?","verso":"f développable en série entière en 0 ⟺ ∃ r > 0 tq Rₙ(x) = f(x) − Tₙ(x) → 0 sur ]−r, r[.","tags":"dse","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"definition","recto":"Somme directe ?","verso":"F₁ ⊕ ... ⊕ Fₚ ⟺ tout x ∈ F₁ + ... + Fₚ s'écrit de manière UNIQUE x = x₁ + ... + xₚ avec xᵢ ∈ Fᵢ.","tags":"somme-directe","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"law","recto":"Caractérisation par bases ?","verso":"F = ⊕ Fᵢ ⟺ la concaténation des bases des Fᵢ donne une base de F.","tags":"somme-directe;base","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"definition","recto":"Polynôme d'endomorphisme ?","verso":"Pour P = Σ aₖ Xᵏ et u ∈ L(E) : P(u) = Σ aₖ uᵏ ∈ L(E).\n(uᵏ = u ∘ u ∘ ... composé k fois.)","tags":"polynome;endo","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"formula","recto":"Calcul matriciel des polynômes ?","verso":"Si A diagonale = diag(λᵢ), alors P(A) = diag(P(λᵢ)).\nSi A trigonalisable : (P(A))ᵢᵢ = P(λᵢ) sur la diagonale.","tags":"polynome;matrice","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"definition","recto":"Polynôme annulateur ?","verso":"P annule u (ou A) ⟺ P(u) = 0.\nL'ensemble des polynômes annulateurs est un IDÉAL de 𝕂[X].","tags":"annulateur","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"definition","recto":"Polynôme minimal ?","verso":"Générateur unitaire de l'idéal des polynômes annulateurs.\nNoté μ_u ou π_u. Divise tout polynôme annulateur.","tags":"minimal","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.6 - Compléments d'algèbre linéaire","type":"law","recto":"Lemme de décomposition des noyaux ?","verso":"Si P et Q sont premiers entre eux, alors :\nKer((PQ)(u)) = Ker(P(u)) ⊕ Ker(Q(u)).\nGénéralisation à n facteurs deux à deux premiers entre eux.","tags":"decomposition-noyaux","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Valeur propre ?","verso":"λ ∈ 𝕂 valeur propre de u ⟺ ∃ x ≠ 0, u(x) = λx.\nÉquiv. : Ker(u − λ·id) ≠ {0}.\nÉquiv. : det(u − λ·id) = 0.","tags":"valeur-propre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Vecteur propre ?","verso":"x ≠ 0 tel que u(x) = λx pour un certain λ ∈ 𝕂.","tags":"vecteur-propre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Sous-espace propre E_λ ?","verso":"E_λ = Ker(u − λ·id) = {x ∈ E | u(x) = λx}.\nDim E_λ ≥ 1 si λ valeur propre.","tags":"sous-espace-propre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Polynôme caractéristique χ_u ?","verso":"χ_u(X) = det(X·id − u).\nχ_A(X) = det(X·I − A).\nDeg(χ_u) = dim E. Coefficient dominant 1.","tags":"polynome-caracteristique","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"formula","recto":"Coefficients de χ_u ?","verso":"χ_u(X) = Xⁿ − tr(u)·X^(n−1) + ... + (−1)ⁿ det(u).\n• Coeff de Xⁿ⁻¹ = −tr(u)\n• Terme constant = (−1)ⁿ det(u)","tags":"chi;coeffs","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"law","recto":"Théorème de Cayley-Hamilton ?","verso":"Tout endomorphisme annule son polynôme caractéristique : χ_u(u) = 0.\nDonc μ_u | χ_u.","tags":"cayley-hamilton","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Multiplicité algébrique / géométrique ?","verso":"Algébrique : multiplicité de λ dans χ_u (m_a(λ)).\nGéométrique : dim E_λ (m_g(λ)).\nToujours : 1 ≤ m_g(λ) ≤ m_a(λ).","tags":"multiplicite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Endomorphisme diagonalisable ?","verso":"u diagonalisable ⟺ ∃ base de E formée de vecteurs propres de u.\nÉquiv. : E = ⊕ E_λ (somme directe des sous-espaces propres).","tags":"diagonalisable","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"law","recto":"Caractérisation diagonalisable (multiplicités) ?","verso":"u diagonalisable ⟺ ∀λ valeur propre, m_g(λ) = m_a(λ) ET χ_u scindé.","tags":"diagonalisable;caract","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"law","recto":"Caractérisation diagonalisable (polynôme annulateur) ?","verso":"u diagonalisable ⟺ μ_u est SCINDÉ à racines SIMPLES.\nÉquiv. : ∃ P scindé à racines simples annulant u.","tags":"diagonalisable;polynome","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"application","recto":"Polynôme scindé à racines simples le plus simple ?","verso":"Si Aᵏ = I (matrice d'ordre fini), alors μ_A | (Xᵏ − 1) qui est scindé à racines simples sur ℂ → A diagonalisable sur ℂ.","tags":"diag;application","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Endomorphisme trigonalisable ?","verso":"u trigonalisable ⟺ ∃ base de E où la matrice de u est triangulaire supérieure.\n⟺ χ_u est SCINDÉ.","tags":"trigonalisable","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"law","recto":"Trigonalisable sur ℂ ?","verso":"Sur ℂ, tout endomorphisme est TRIGONALISABLE (d'Alembert-Gauss).\nSur ℝ, ce n'est pas toujours le cas.","tags":"trigonalisable;C","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.7 - Réduction des endomorphismes","type":"definition","recto":"Sous-espaces caractéristiques (HP en MP) ?","verso":"F_λ = Ker((u − λ·id)^(m_a(λ))).\nE = ⊕ F_λ (décomposition de Dunford).","tags":"caracteristique","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"definition","recto":"Adjoint d'un endo. ?","verso":"Soit u ∈ L(E) (E euclidien). L'adjoint u* est l'unique endo. tel que :\n(u(x) | y) = (x | u*(y))  ∀x,y.\nMatrice : Mat(u*) = ᵗMat(u) en BON.","tags":"adjoint","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"definition","recto":"Endomorphisme symétrique ?","verso":"u = u*. Matrice symétrique en BON : ᵗA = A.","tags":"symetrique","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"law","recto":"Théorème spectral (réel) ?","verso":"Tout endomorphisme symétrique d'un espace euclidien est DIAGONALISABLE en BASE ORTHONORMÉE.\nMatricielement : si A symétrique réelle, ∃ P orthogonale, P⁻¹AP = ᵗPAP diagonale.","tags":"spectral","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"definition","recto":"Endomorphisme orthogonal ?","verso":"u tel que u* ∘ u = id.\nÉquiv. : ‖u(x)‖ = ‖x‖ ∀x (préserve la norme).\nÉquiv. : matrice ᵗA·A = I (matrice orthogonale).","tags":"orthogonal","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"definition","recto":"Groupe orthogonal O(E) ?","verso":"{u ∈ L(E) | u orthogonal}. Sous-groupe de GL(E).\ndet(u) = ±1.\nSO(E) : sous-groupe des u avec det = 1 (rotations).","tags":"O-E","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"law","recto":"Réduction des endo. orthogonaux ?","verso":"Tout endo. orthogonal admet une matrice par blocs en BON : blocs diagonaux ±1 et blocs 2×2 de rotation R_θ.","tags":"orthogonal;reduction","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.12 - Endomorphismes d'un espace euclidien","type":"definition","recto":"Endomorphisme positif / défini positif ?","verso":"u symétrique :\n• Positif : (u(x) | x) ≥ 0 ∀x.\n• Défini positif : (u(x) | x) > 0 ∀x ≠ 0.\nÉquiv. : valeurs propres ≥ 0 (resp. > 0).","tags":"positif","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"definition","recto":"Idéal d'un anneau (commutatif) ?","verso":"I ⊂ A non vide tel que :\n• ∀x, y ∈ I, x − y ∈ I (sous-groupe additif)\n• ∀x ∈ I, ∀a ∈ A, ax ∈ I (absorbant).","tags":"ideal","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"definition","recto":"Idéal principal ?","verso":"Idéal engendré par un seul élément : (a) = a·A.\n𝕂[X] et ℤ sont principaux : tous leurs idéaux sont principaux.","tags":"principal","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"definition","recto":"Anneau intègre ?","verso":"Anneau commutatif (≠ {0}) sans diviseur de zéro :\nab = 0 ⟹ a = 0 ou b = 0.","tags":"integre","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"definition","recto":"Corps ?","verso":"Anneau commutatif (≠ {0}) où tout élément non nul est inversible.\nEx. : ℚ, ℝ, ℂ, ℤ/pℤ pour p premier.","tags":"corps","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"law","recto":"Théorème chinois (anneaux) ?","verso":"Si I, J idéaux comaximaux (I + J = A), alors A/(I ∩ J) ≅ A/I × A/J.\nCas ℤ : si m ∧ n = 1, ℤ/mnℤ ≅ ℤ/mℤ × ℤ/nℤ.","tags":"chinois","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"definition","recto":"Indicateur d'Euler φ(n) ?","verso":"φ(n) = nb d'entiers k ∈ ⟦1, n⟧ premiers avec n.\nφ(p) = p−1, φ(p^k) = p^k − p^(k−1) (p premier).","tags":"euler;phi","niveau":"MP","matiere":"Maths"},{"deck":"MP — Algèbre","chapitre":"Ch.13 - Structures algébriques (compléments)","type":"law","recto":"Théorème d'Euler ?","verso":"Si a ∧ n = 1 : a^φ(n) ≡ 1 (mod n).\nGénéralise petit Fermat (n = p premier).","tags":"euler;theoreme","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"definition","recto":"Tribu (σ-algèbre) ?","verso":"𝒯 ⊂ 𝒫(Ω) tq :\n• Ω ∈ 𝒯\n• stable par complémentaire\n• stable par union DÉNOMBRABLE.\n(Ω, 𝒯) : espace probabilisable.","tags":"tribu","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"definition","recto":"Probabilité ?","verso":"P : 𝒯 → [0, 1] tq :\n• P(Ω) = 1\n• σ-additivité : pour Aₙ disjoints, P(⊔ Aₙ) = Σ P(Aₙ).","tags":"probabilite;def","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"law","recto":"Propriétés élémentaires ?","verso":"• P(∅) = 0\n• P(A^c) = 1 − P(A)\n• A ⊂ B ⟹ P(A) ≤ P(B)\n• P(A ∪ B) = P(A) + P(B) − P(A ∩ B)","tags":"proba;proprietes","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"law","recto":"Continuité monotone ?","verso":"Si Aₙ ↗ A : P(Aₙ) → P(A).\nSi Aₙ ↘ A : P(Aₙ) → P(A).\n(Conséquence de la σ-additivité.)","tags":"continuite-mono","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"definition","recto":"Probabilité conditionnelle ?","verso":"Pour P(B) > 0 :\nP(A | B) = P(A ∩ B) / P(B).\nDéfinit une probabilité sur (Ω, 𝒯).","tags":"conditionnelle","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"law","recto":"Formule des probabilités composées ?","verso":"P(A₁ ∩ ... ∩ Aₙ) = P(A₁)·P(A₂|A₁)·...·P(Aₙ|A₁∩...∩A_(n−1))\n(quand P(A₁∩...∩A_(n−1)) > 0).","tags":"composees","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"law","recto":"Formule des probabilités totales ?","verso":"Si (Bₙ) système complet d'événements (disjoints, P(Bₙ) > 0, ∪Bₙ = Ω) :\nP(A) = Σ P(A | Bₙ) · P(Bₙ).","tags":"totales","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"law","recto":"Formule de Bayes ?","verso":"P(B | A) = P(A | B) · P(B) / P(A)\nVersion étendue : si (Bₙ) système complet :\nP(B_k | A) = P(A|B_k)·P(B_k) / Σ P(A|Bₙ)·P(Bₙ).","tags":"bayes","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"definition","recto":"Indépendance d'événements ?","verso":"A, B indép. ⟺ P(A ∩ B) = P(A) · P(B).\nPlusieurs : indép. mutuels ⟺ ∀ I, P(∩_{i∈I} Aᵢ) = ∏_{i∈I} P(Aᵢ).","tags":"independance","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.9 - Espaces probabilisés","type":"law","recto":"Lemme de Borel-Cantelli ?","verso":"Soit lim sup Aₙ = ∩_N ∪_(n≥N) Aₙ.\nSi Σ P(Aₙ) < +∞ : P(lim sup Aₙ) = 0.\nSi (Aₙ) indép. et Σ P(Aₙ) = +∞ : P(lim sup) = 1.","tags":"borel-cantelli","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"definition","recto":"Variable aléatoire discrète ?","verso":"Application X : Ω → 𝕂 telle que X(Ω) est fini ou dénombrable, et {X = x} ∈ 𝒯 pour tout x.","tags":"vad","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"definition","recto":"Loi d'une VAD ?","verso":"Donnée par P(X = x) pour x ∈ X(Ω). Vérifie Σ P(X = x) = 1.","tags":"loi;vad","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Espérance E(X) ?","verso":"E(X) = Σ_(x ∈ X(Ω)) x · P(X = x), à condition de convergence ABSOLUE.\nLinéaire : E(aX + bY) = aE(X) + bE(Y).","tags":"esperance","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Théorème de transfert ?","verso":"E(g(X)) = Σ g(x) · P(X = x) (sous convergence absolue).","tags":"transfert","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Variance ?","verso":"V(X) = E((X − E(X))²) = E(X²) − E(X)².\nV(aX + b) = a²·V(X). σ(X) = √V(X).","tags":"variance","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"law","recto":"Cauchy-Schwarz pour variances ?","verso":"|Cov(X, Y)| ≤ σ(X) · σ(Y).\nÉgalité ⟺ X, Y liées par relation affine.","tags":"cauchy-schwarz;cov","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"definition","recto":"Covariance ?","verso":"Cov(X, Y) = E((X − E(X))(Y − E(Y))) = E(XY) − E(X)·E(Y).\nProp. : Cov bilinéaire, symétrique.","tags":"covariance","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"law","recto":"Variance d'une somme ?","verso":"V(X + Y) = V(X) + V(Y) + 2·Cov(X, Y).\nSi X, Y indép. : Cov = 0 ⟹ V(X+Y) = V(X) + V(Y).","tags":"variance;somme","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"definition","recto":"Indépendance de VAD ?","verso":"X et Y indépendantes ⟺ ∀ x, y : P(X=x, Y=y) = P(X=x)·P(Y=y).\nÉquiv. : événements (X∈A) et (Y∈B) toujours indép.","tags":"vad;independance","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"law","recto":"Indépendance ⟹ E(XY) = E(X)·E(Y).","verso":"Pour X, Y indépendantes admettant une espérance.\nLa réciproque est FAUSSE.","tags":"independance;multiplicativite","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Lois usuelles : Bernoulli B(p) ?","verso":"X(Ω) = {0, 1}\nP(X=1) = p, P(X=0) = 1−p\nE(X) = p, V(X) = p(1−p).","tags":"bernoulli","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Loi binomiale B(n, p) ?","verso":"P(X=k) = (n k) pᵏ (1−p)^(n−k), k ∈ ⟦0, n⟧\nE(X) = np, V(X) = np(1−p).","tags":"binomiale","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Loi géométrique 𝒢(p) ?","verso":"X(Ω) = ℕ*. P(X=k) = (1−p)^(k−1) · p\nE(X) = 1/p, V(X) = (1−p)/p².\n(Rang du premier succès.)","tags":"geometrique","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"formula","recto":"Loi de Poisson 𝒫(λ) ?","verso":"X(Ω) = ℕ. P(X=k) = e^(−λ) · λᵏ/k!\nE(X) = V(X) = λ.\n(Approche la binomiale quand n→∞ et np→λ.)","tags":"poisson","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"definition","recto":"Fonction génératrice G_X ?","verso":"G_X(t) = E(t^X) = Σ P(X=k) tᵏ.\nProp. :\n• G_X(1) = 1\n• E(X) = G_X'(1)\n• V(X) = G_X''(1) + G_X'(1) − G_X'(1)²","tags":"fct-generatrice","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"law","recto":"Loi faible des grands nombres ?","verso":"Soit (Xₙ) iid d'espérance μ et variance finie. Mₙ = (X₁+...+Xₙ)/n.\nAlors P(|Mₙ − μ| ≥ ε) → 0 pour tout ε > 0.\n(Démontré via Bienaymé-Tchebychev.)","tags":"lgn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.10 - Variables aléatoires discrètes","type":"law","recto":"Inégalités de concentration ?","verso":"• Markov : P(|X| ≥ a) ≤ E(|X|)/a\n• Bienaymé-Tchebychev : P(|X − E(X)| ≥ a) ≤ V(X)/a².","tags":"concentration","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Dérivée partielle ?","verso":"∂f/∂xᵢ (a) = limite de [f(a + t·eᵢ) − f(a)]/t quand t → 0.\nC'est la dérivée selon la i-ème direction.","tags":"derivee-partielle","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Fonction de classe C^k ?","verso":"f : U ⊂ ℝⁿ → ℝᵖ est C^k sur U si toutes ses dérivées partielles d'ordre ≤ k existent et sont continues.","tags":"classe-Ck","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Différentielle df_a ?","verso":"f différentiable en a ⟺ ∃ application linéaire L = df_a tq :\nf(a + h) = f(a) + L(h) + o(‖h‖).\nL est unique : c'est la différentielle.","tags":"differentielle","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Gradient (cas réel) ?","verso":"∇f(a) = (∂f/∂x₁(a), ..., ∂f/∂xₙ(a)).\nDifférentielle : df_a(h) = (∇f(a) | h).","tags":"gradient","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Matrice jacobienne ?","verso":"Pour f : ℝⁿ → ℝᵖ : J_f(a) = (∂fᵢ/∂xⱼ)_(i,j) ∈ M_(p,n)(ℝ).\nC'est la matrice de df_a.","tags":"jacobienne","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"law","recto":"Théorème de Schwarz ?","verso":"Si f de classe C² au voisinage de a :\n∂²f/∂xᵢ∂xⱼ (a) = ∂²f/∂xⱼ∂xᵢ (a).\nLa hessienne est symétrique.","tags":"schwarz","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Hessienne ?","verso":"H_f(a) = (∂²f/∂xᵢ∂xⱼ (a))_(i,j).\nMatrice carrée symétrique (en C²).\nC'est la matrice de la forme bilinéaire de la 2ⁿᵈᵉ différentielle.","tags":"hessienne","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"law","recto":"Formule de Taylor à l'ordre 2 ?","verso":"f(a + h) = f(a) + (∇f(a) | h) + ½·(H_f(a)·h | h) + o(‖h‖²).","tags":"taylor;ordre-2","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Point critique ?","verso":"Point a où ∇f(a) = 0 (toutes les dérivées partielles s'annulent).\nNécessaire pour un extremum local.","tags":"critique","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"law","recto":"Conditions d'extremum local (C²) ?","verso":"Au point critique a :\n• H_f(a) définie POSITIVE ⟹ minimum local strict.\n• H_f(a) définie NÉGATIVE ⟹ maximum local strict.\n• H_f(a) avec valeurs propres de signes opposés ⟹ POINT-COL (selle).","tags":"extremum;hessienne","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"law","recto":"Théorème des fonctions implicites (HP MP, hors progr.) ?","verso":"Si f : U × V → ℝᵖ est C¹, f(a,b) = 0, et ∂f/∂y(a,b) inversible,\nalors localement il existe une fonction φ tq f(x, φ(x)) = 0.","tags":"fonctions-implicites","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"definition","recto":"Fonction convexe sur ouvert convexe ?","verso":"f : U → ℝ convexe ⟺ ∀ x, y ∈ U, ∀ t ∈ [0,1] : f(tx + (1−t)y) ≤ t·f(x) + (1−t)·f(y).","tags":"convexite;Rn","niveau":"MP","matiere":"Maths"},{"deck":"MP — Probabilités & Calcul diff.","chapitre":"Ch.14 - Calcul différentiel et optimisation","type":"law","recto":"Caractérisation par la hessienne ?","verso":"f de classe C² convexe ⟺ H_f(x) positive ∀x ∈ U.\nStrictement convexe : H_f définie positive.","tags":"convexite;hessienne","niveau":"MP","matiere":"Maths"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"formula","recto":"Gradient en cartésiennes ?","verso":"grad(f) = ∇f = (∂f/∂x, ∂f/∂y, ∂f/∂z)\nVecteur. Indique la direction de plus forte croissance de f.","tags":"gradient","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"formula","recto":"Divergence en cartésiennes ?","verso":"div(⃗A) = ∂A_x/∂x + ∂A_y/∂y + ∂A_z/∂z\nScalaire. Mesure le « flux sortant » par unité de volume.","tags":"divergence","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"formula","recto":"Rotationnel en cartésiennes ?","verso":"rot(⃗A) = ∇∧⃗A\nrot(⃗A)_x = ∂A_z/∂y − ∂A_y/∂z\nVecteur. Mesure la « circulation » locale.","tags":"rotationnel","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"formula","recto":"Laplacien d'un scalaire ?","verso":"Δf = ∂²f/∂x² + ∂²f/∂y² + ∂²f/∂z² = div(grad f)","tags":"laplacien","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"law","recto":"Théorème d'Ostrogradsky (flux-divergence) ?","verso":"∯_(S fermée) ⃗A·d⃗S = ∭_V div(⃗A)·dV\nLe flux sortant à travers une surface fermée = intégrale de la divergence sur le volume.","tags":"ostrogradsky","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"law","recto":"Théorème de Stokes ?","verso":"∮_(C fermé) ⃗A·d⃗ℓ = ∬_S rot(⃗A)·d⃗S\nLa circulation sur un contour = flux du rotationnel à travers une surface s'appuyant sur ce contour.","tags":"stokes","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.1 - Analyse vectorielle","type":"formula","recto":"Identités utiles ?","verso":"rot(grad f) = ⃗0\ndiv(rot ⃗A) = 0\nrot(rot ⃗A) = grad(div ⃗A) − Δ⃗A","tags":"identites;vectorielles","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.2 - Analyse de Fourier","type":"definition","recto":"Série de Fourier (signal périodique de période T) ?","verso":"f(t) = a₀ + Σ_(n=1) [aₙ·cos(nωt) + bₙ·sin(nωt)]\noù ω = 2π/T.\naₙ, bₙ : coefficients de Fourier.","tags":"fourier;serie","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.2 - Analyse de Fourier","type":"formula","recto":"Coefficients de Fourier ?","verso":"a₀ = (1/T)·∫_0^T f(t)·dt\naₙ = (2/T)·∫_0^T f(t)·cos(nωt)·dt\nbₙ = (2/T)·∫_0^T f(t)·sin(nωt)·dt","tags":"fourier;coefficients","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.2 - Analyse de Fourier","type":"definition","recto":"Spectre d'un signal ?","verso":"Représentation des amplitudes (et phases) en fonction de la fréquence.\n• Signal périodique : spectre DISCRET (raies aux harmoniques nf₀)\n• Signal non périodique : spectre CONTINU (transformée de Fourier).","tags":"spectre","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Outils mathématiques","chapitre":"Ch.2 - Analyse de Fourier","type":"formula","recto":"Théorème de Parseval ?","verso":"<f²> = a₀² + (1/2)·Σ(aₙ² + bₙ²)\nLa moyenne quadratique = somme des carrés des coefficients (énergie répartie sur les harmoniques).","tags":"parseval","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"law","recto":"Équation de Maxwell-Gauss ?","verso":"div(⃗E) = ρ/ε₀\nLien local entre ⃗E et la densité volumique de charges ρ.\n→ Théorème de Gauss intégral.","tags":"maxwell-gauss","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"law","recto":"Équation de Maxwell-flux (thomson) ?","verso":"div(⃗B) = 0\nPas de monopôle magnétique. Conservation du flux magnétique.","tags":"maxwell-flux","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"law","recto":"Équation de Maxwell-Faraday ?","verso":"rot(⃗E) = −∂⃗B/∂t\nUn champ ⃗B variable engendre un champ ⃗E à circulation non nulle (induction).","tags":"maxwell-faraday","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"law","recto":"Équation de Maxwell-Ampère ?","verso":"rot(⃗B) = μ₀·⃗j + μ₀·ε₀·∂⃗E/∂t\nLe second terme μ₀ε₀·∂⃗E/∂t (courant de déplacement) est l'apport de Maxwell.\nμ₀ε₀ = 1/c².","tags":"maxwell-ampere","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"formula","recto":"Équation de conservation de la charge ?","verso":"∂ρ/∂t + div(⃗j) = 0\nObtenue en prenant la divergence de Maxwell-Ampère.","tags":"conservation;charge","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"definition","recto":"Courant de déplacement ?","verso":"⃗j_D = ε₀·∂⃗E/∂t\nNon associé à un mouvement de charges, mais à la variation temporelle du champ électrique.\nIndispensable à la cohérence des équations de Maxwell.","tags":"courant-deplacement","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"formula","recto":"Potentiels (⃗A, V) ?","verso":"div ⃗B = 0 ⟹ ∃ ⃗A tq ⃗B = rot(⃗A)\nrot ⃗E = −∂⃗B/∂t ⟹ ⃗E = −grad(V) − ∂⃗A/∂t.","tags":"potentiels","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.I - Équations locales — Maxwell","type":"definition","recto":"Jauge de Lorenz ?","verso":"div ⃗A + (1/c²)·∂V/∂t = 0\nSimplifie les équations en ondes : ΔV − (1/c²)·∂²V/∂t² = −ρ/ε₀ (avec contrepartie pour ⃗A).","tags":"jauge-lorenz","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.II - Énergie électromagnétique","type":"formula","recto":"Densité volumique d'énergie EM ?","verso":"u_em = (1/2)·ε₀·E² + B²/(2μ₀)\n• 1ʳᵉ partie : énergie électrique\n• 2ⁿᵈᵉ partie : énergie magnétique","tags":"energie-em","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.II - Énergie électromagnétique","type":"formula","recto":"Vecteur de Poynting ?","verso":"⃗Π = ⃗E ∧ ⃗B / μ₀\nDirection et flux de l'énergie électromagnétique. Unité : W·m⁻².","tags":"poynting","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.24.II - Énergie électromagnétique","type":"law","recto":"Bilan local d'énergie EM (théorème de Poynting) ?","verso":"∂u_em/∂t + div(⃗Π) = −⃗j·⃗E\n−⃗j·⃗E : puissance fournie par le champ aux porteurs (effet Joule).","tags":"poynting;bilan","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"law","recto":"Loi de Faraday ?","verso":"e = −dΦ/dt\nLa f.é.m. d'induction dans un circuit fermé = opposé de la dérivée du flux magnétique à travers ce circuit.","tags":"faraday","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"law","recto":"Loi de Lenz ?","verso":"Le sens du courant induit s'oppose à la cause qui lui donne naissance (variation de flux).\nQualitative ; le signe « − » dans Faraday la traduit quantitativement.","tags":"lenz","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"definition","recto":"F.é.m. d'induction ?","verso":"e = ∮ (⃗E + ⃗v∧⃗B)·d⃗ℓ\nDécomposition :\n• Cas Neumann : circuit fixe, ⃗B variable → e = −∂Φ/∂t (induction de champ)\n• Cas Lorentz : circuit mobile, ⃗B fixe → e = ∮(⃗v∧⃗B)·d⃗ℓ (induction de motion)","tags":"fem","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"definition","recto":"Inductance propre L ?","verso":"Φ_propre = L·i\nCoefficient propre au circuit, en henrys (H).\nÉnergie magnétique stockée : E_m = (1/2)·L·i².","tags":"inductance","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"definition","recto":"Inductance mutuelle M ?","verso":"Φ_(1→2) = M·i₁\nCoefficient entre 2 circuits couplés.\nM₁₂ = M₂₁ (symétrie).\n|M| ≤ √(L₁·L₂) (couplage maximal).","tags":"mutuelle","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"application","recto":"Phénomène d'autoinduction ?","verso":"Variation de i dans un circuit → variation de Φ propre → f.é.m. d'autoinduction e_a = −L·di/dt.\nC'est ce qui rend l'inductance « inerte » à la variation de courant.","tags":"autoinduction","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"application","recto":"Lois de Kirchhoff avec induction ?","verso":"Sur une maille incluant une bobine d'inductance L :\nΣ tensions = L·di/dt (terme inductif).\nGénéralisation à L_eq pour mutuelle : couplage transformateur.","tags":"induction;kirchhoff","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"definition","recto":"Force de Laplace ?","verso":"Force exercée sur un élément de circuit parcouru par i dans un champ ⃗B :\nd⃗F = i·d⃗ℓ ∧ ⃗B\nIntégrée : ⃗F = i·∫ d⃗ℓ ∧ ⃗B.","tags":"laplace","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"application","recto":"Couplage électromécanique ?","verso":"Conversion entre énergie électrique et mécanique :\nP_(reçue par champ) = e·i\nP_(fournie au mécanique) = ⃗F·⃗v\nLois fondamentales conservées : P_em + P_mec = 0 (cas idéal).","tags":"couplage","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.25 - Induction électromagnétique","type":"application","recto":"Freinage par induction ?","verso":"Conducteur mobile dans ⃗B → courants induits (Foucault) → forces qui s'opposent au mouvement.\nApplication : freins à courants de Foucault des poids lourds, train.","tags":"foucault;freinage","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.26 - Dipôle magnétique","type":"definition","recto":"Moment magnétique d'une boucle ?","verso":"⃗m = I·⃗S\nI : intensité dans la boucle, ⃗S : surface orientée par règle main droite.\nUnité : A·m².","tags":"moment-mag","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.26 - Dipôle magnétique","type":"formula","recto":"Champ d'un dipôle magnétique (à grande distance) ?","verso":"Analogue au dipôle électrostatique avec :\nB_r = (μ₀/(4π))·(2m·cos θ)/r³\nB_θ = (μ₀/(4π))·(m·sin θ)/r³","tags":"dipole-mag;champ","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Électromagnétisme","chapitre":"Ch.26 - Dipôle magnétique","type":"formula","recto":"Action d'un champ ⃗B externe sur un dipôle ?","verso":"• Force : ⃗F = grad(⃗m·⃗B) (nulle si ⃗B uniforme)\n• Couple : ⃗Γ = ⃗m∧⃗B (aligne ⃗m sur ⃗B)\n• Énergie : E_p = −⃗m·⃗B (minimum à alignement).","tags":"dipole-mag;actions","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.27 - Généralités sur les ondes","type":"definition","recto":"Onde plane progressive harmonique ?","verso":"ψ(x, t) = A·cos(ωt − kx + φ)\n• ω : pulsation (rad·s⁻¹)\n• k : nombre d'onde (m⁻¹)\n• v_φ = ω/k : vitesse de phase.","tags":"onde;plane","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.27 - Généralités sur les ondes","type":"formula","recto":"Relation longueur d'onde / fréquence ?","verso":"λ = v·T = v/f = 2π/k\nT : période, f : fréquence, k = 2π/λ.","tags":"longueur-onde","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.27 - Généralités sur les ondes","type":"definition","recto":"Équation de d'Alembert ?","verso":"Δψ − (1/c²)·∂²ψ/∂t² = 0\nÉquation des ondes en milieu non dispersif. Solutions : f(x − ct) + g(x + ct).","tags":"alembert","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.27 - Généralités sur les ondes","type":"definition","recto":"Vitesse de phase / vitesse de groupe ?","verso":"v_φ = ω/k : vitesse de propagation des plans de phase.\nv_g = dω/dk : vitesse de propagation de l'enveloppe d'un paquet d'ondes.\nMilieu non dispersif : v_φ = v_g.","tags":"vitesse-phase;groupe","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.27 - Généralités sur les ondes","type":"definition","recto":"Milieu dispersif ?","verso":"v_φ dépend de la fréquence (k = k(ω) non linéaire).\nDifférentes fréquences se propagent à des vitesses différentes → étalement d'un paquet.","tags":"dispersion","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.27 - Généralités sur les ondes","type":"formula","recto":"Relation de dispersion ?","verso":"Lien k = k(ω) caractéristique d'un milieu.\nNon dispersif : k = ω/c (linéaire). Plasma : k² = (ω² − ω_p²)/c².","tags":"relation-dispersion","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"law","recto":"Équations d'onde du vide (à partir de Maxwell) ?","verso":"Δ⃗E − (1/c²)·∂²⃗E/∂t² = 0\nIdem pour ⃗B.\nObtenu en prenant rot de Maxwell-Faraday + Maxwell-Ampère (avec ρ = 0, ⃗j = 0).","tags":"onde-em;equation","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"formula","recto":"Vitesse de la lumière ?","verso":"c = 1/√(ε₀·μ₀) ≈ 3·10⁸ m/s\nApparaît naturellement dans Maxwell.","tags":"c","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"definition","recto":"OPPM (onde plane progressive monochromatique) ?","verso":"⃗E = ⃗E₀·cos(ωt − ⃗k·⃗r + φ)\nStructure : ⃗E ⊥ ⃗k, ⃗B ⊥ ⃗k, ⃗B = (1/c)·⃗u_k ∧ ⃗E.\n⃗E, ⃗B, ⃗k forment un trièdre direct.","tags":"oppm","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"formula","recto":"Module B vs E pour OPPM ?","verso":"B = E/c\n(beaucoup plus petit en module : E en V/m, B en T).","tags":"oppm;b-e","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"formula","recto":"Vecteur de Poynting d'une OPPM ?","verso":"⃗Π = (E²/μ₀c)·⃗u_k\nDirigé selon ⃗k, transporte l'énergie.\nMoyenne temporelle : <⃗Π> = (E₀²/(2μ₀c))·⃗u_k.","tags":"oppm;poynting","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"formula","recto":"Densité moyenne d'énergie ?","verso":"<u_em> = (1/2)·ε₀·E₀²·(1/2) = ε₀·E_eff²\nIntensité I = c·<u_em>.","tags":"oppm;energie","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"definition","recto":"Polarisation rectiligne ?","verso":"⃗E garde une direction fixe au cours du temps. Plan de polarisation = (⃗E, ⃗k).","tags":"polarisation;rectiligne","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.28 - Ondes EM dans le vide","type":"definition","recto":"Polarisation circulaire / elliptique ?","verso":"Circulaire : ⃗E décrit un cercle (déphasage de π/2 entre composantes).\nElliptique : ellipse (déphasage quelconque).","tags":"polarisation;circulaire","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.29 - Ondes EM dans les milieux","type":"definition","recto":"Milieu LHI (linéaire, homogène, isotrope) ?","verso":"Modèle où les relations entre ⃗D, ⃗E et ⃗H, ⃗B sont linéaires :\n⃗D = ε·⃗E, ⃗B = μ·⃗H\nε : permittivité, μ : perméabilité.","tags":"lhi","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.29 - Ondes EM dans les milieux","type":"formula","recto":"Relation de dispersion dans un plasma peu dense ?","verso":"k² = (ω² − ω_p²)/c²\nω_p = √(n·e²/(m·ε₀)) : pulsation plasma.\nSi ω < ω_p : k imaginaire → onde évanescente.","tags":"plasma;dispersion","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.29 - Ondes EM dans les milieux","type":"application","recto":"Conducteur parfait — réflexion totale ?","verso":"Pour ω < ω_p (cas du métal aux fréquences optiques), une onde EM est réfléchie totalement → caractère réfléchissant des métaux.","tags":"metal;reflexion","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.29 - Ondes EM dans les milieux","type":"definition","recto":"Effet de peau (skin) ?","verso":"Dans un conducteur réel à fréquence f, les courants se concentrent dans une couche d'épaisseur δ = √(2/(μ·σ·ω)).\nPlus f grand, plus δ petit.","tags":"skin","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.29 - Ondes EM dans les milieux","type":"application","recto":"Réflexion / transmission à une interface ?","verso":"Coefficients de Fresnel donnent r = (n₁−n₂)/(n₁+n₂), t = 2n₁/(n₁+n₂) (incidence normale).\nÉquivalent en termes d'amplitude.","tags":"fresnel","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.30 - Rayonnement dipolaire","type":"definition","recto":"Dipôle oscillant ?","verso":"⃗p(t) = p₀·cos(ωt)·⃗u\nReproduit en première approximation l'émission d'une charge oscillante (antenne, molécule, atome excité).","tags":"dipole-oscillant","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.30 - Rayonnement dipolaire","type":"formula","recto":"Champ rayonné en zone lointaine ?","verso":"Loin (r ≫ λ) : champs ∝ 1/r (et non 1/r² ou 1/r³).\n• Ce sont des ondes sphériques transverses.\n• L'énergie rayonnée se propage à l'infini.","tags":"rayonnement;zone-lointaine","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.30 - Rayonnement dipolaire","type":"formula","recto":"Puissance rayonnée totale ?","verso":"P = (μ₀·p₀²·ω⁴)/(12π·c)\nProportionnelle à ω⁴ (formule de Larmor) : justifie le bleu du ciel (diffusion Rayleigh).","tags":"larmor","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Ondes","chapitre":"Ch.30 - Rayonnement dipolaire","type":"application","recto":"Diffusion Rayleigh — pourquoi le ciel est bleu ?","verso":"Diffusion par les molécules de l'atmosphère : intensité ∝ ω⁴ ∝ 1/λ⁴.\nLe bleu (λ courte) est diffusé bien plus que le rouge → ciel bleu, soleils rouges au coucher.","tags":"rayleigh","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.41 - Interférences lumineuses","type":"definition","recto":"Cohérence (temporelle, spatiale) ?","verso":"Cohérence TEMPORELLE : les phases sont corrélées sur un temps τ_c (longueur de cohérence ℓ_c = c·τ_c).\nCohérence SPATIALE : les ondes en différents points de la source ont des phases corrélées.","tags":"coherence","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.41 - Interférences lumineuses","type":"definition","recto":"Différence de marche δ ?","verso":"δ = (SM)₂ − (SM)₁ : différence des chemins optiques.\nDéphasage : Δφ = 2π·δ/λ.","tags":"delta;marche","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.41 - Interférences lumineuses","type":"application","recto":"Conditions d'interférences ?","verso":"Maximum (constructive) : δ = m·λ (m entier)\nMinimum (destructive) : δ = (m + 1/2)·λ","tags":"interferences;conditions","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.41 - Interférences lumineuses","type":"formula","recto":"Intensité résultante (deux ondes cohérentes I₁, I₂) ?","verso":"I = I₁ + I₂ + 2√(I₁·I₂)·cos(Δφ)\nSi I₁ = I₂ = I₀ : I = 2I₀·(1 + cos Δφ) = 4I₀·cos²(Δφ/2).","tags":"interferences;intensite","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.41 - Interférences lumineuses","type":"definition","recto":"Visibilité (contraste) ?","verso":"V = (I_max − I_min)/(I_max + I_min)\n• Sources de même intensité, parfaitement cohérentes : V = 1\n• Cohérence partielle : V < 1.","tags":"visibilite","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.41 - Interférences lumineuses","type":"formula","recto":"Interfrange (fentes d'Young) ?","verso":"i = λ·D/a\n• λ : longueur d'onde\n• D : distance fentes-écran\n• a : distance entre les 2 fentes.","tags":"young;interfrange","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.42 - Interférences par lames minces","type":"definition","recto":"Anneaux d'égale inclinaison (Haidinger) ?","verso":"Lame d'épaisseur uniforme. Anneaux concentriques visibles à l'infini, dépendent de l'angle d'incidence.\nObservés sur les bulles de savon, films d'huile.","tags":"haidinger","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.42 - Interférences par lames minces","type":"definition","recto":"Franges d'égale épaisseur (Fizeau) ?","verso":"Lame d'épaisseur variable (coin d'air). Franges suivent les lignes d'égale épaisseur.\nUtilisée pour mesurer les défauts de planéité.","tags":"fizeau","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.42 - Interférences par lames minces","type":"formula","recto":"Différence de marche pour lame d'épaisseur e en incidence quasi-normale ?","verso":"δ = 2·n·e·cos(r) + λ/2 (si réflexion sur milieu plus réfringent)\nLe λ/2 vient du déphasage de π à la réflexion.","tags":"lame;delta","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.43 - Interféromètre de Michelson","type":"definition","recto":"Interféromètre de Michelson ?","verso":"Lame séparatrice + 2 miroirs orthogonaux + lame compensatrice.\nDeux configurations principales : LAME D'AIR (anneaux) et COIN D'AIR (franges rectilignes).","tags":"michelson","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.43 - Interféromètre de Michelson","type":"application","recto":"Configuration en lame d'air ?","verso":"Miroirs strictement parallèles. Différence de marche δ = 2·e·cos(i).\nObserve des anneaux à l'infini (égale inclinaison).","tags":"michelson;lame-air","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.43 - Interféromètre de Michelson","type":"application","recto":"Configuration en coin d'air ?","verso":"Miroirs faisant un angle α faible. δ ≈ 2·α·x (x : position).\nObserve des franges rectilignes parallèles à l'arête, écartées de i = λ/(2α).","tags":"michelson;coin-air","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.43 - Interféromètre de Michelson","type":"application","recto":"Réglage du contact optique ?","verso":"Les deux miroirs sont à la même distance de la séparatrice (e = 0).\nFrange centrale très large à la teinte plate. Servir de référence.","tags":"contact-optique","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.44 - Diffraction","type":"law","recto":"Principe de Huygens-Fresnel ?","verso":"Chaque point d'un front d'onde se comporte comme une source secondaire. L'onde en un point est la somme cohérente de toutes ces sources.","tags":"huygens-fresnel","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.44 - Diffraction","type":"formula","recto":"Diffraction de Fraunhofer (à l'infini) — fente largeur a ?","verso":"I(θ) ∝ sinc²(π·a·sin(θ)/λ)\nMinimum d'ordre 1 : sin(θ) = λ/a.\nLargeur angulaire de la tache centrale : 2λ/a.","tags":"fraunhofer;fente","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.44 - Diffraction","type":"application","recto":"Diffraction d'une ouverture circulaire ?","verso":"Tâche d'Airy : sin(θ_1) ≈ 1,22·λ/D (D : diamètre de l'ouverture).\nLimite la résolution des instruments d'optique (critère de Rayleigh).","tags":"airy","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.44 - Diffraction","type":"law","recto":"Critère de Rayleigh ?","verso":"Deux points sont juste séparés si le maximum de l'image de l'un coïncide avec le 1er minimum de l'autre.\nCela définit la résolution angulaire d'un instrument.","tags":"rayleigh;resolution","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.44 - Diffraction","type":"definition","recto":"Pouvoir de résolution d'un instrument ?","verso":"Inverse du plus petit angle/longueur d'onde résolvable.\nLimité par la diffraction (à ouverture donnée) et les aberrations.","tags":"pouvoir-resolution","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.45 - Réseaux plans","type":"definition","recto":"Réseau de diffraction ?","verso":"Système périodique de N fentes ou traits espacés de a (pas du réseau).\nJoue le rôle d'un « peigne » d'interférences cohérentes.","tags":"reseau","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.45 - Réseaux plans","type":"formula","recto":"Formule des réseaux ?","verso":"a·(sin(θ_p) − sin(θ_i)) = p·λ\np : ordre (entier).\nDifférents ordres pour différentes longueurs d'onde → spectroscopie.","tags":"reseaux;formule","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Optique ondulatoire","chapitre":"Ch.45 - Réseaux plans","type":"application","recto":"Pouvoir de résolution d'un réseau ?","verso":"R = λ/Δλ = N·p\nN : nombre de traits éclairés. Augmente avec N et l'ordre p.","tags":"reseau;resolution","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.47 - Théorie cinétique du gaz parfait","type":"formula","recto":"Pression cinétique ?","verso":"P = (1/3)·n·m·<v²>\noù n : nombre de molécules par unité de volume.\nÉquivalent : P = n·k_B·T (gaz parfait).","tags":"pression-cinetique","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.47 - Théorie cinétique du gaz parfait","type":"formula","recto":"Vitesse quadratique moyenne ?","verso":"v_q = √(<v²>) = √(3·k_B·T/m) = √(3·R·T/M)\nÀ T = 300 K dans l'air : ≈ 500 m·s⁻¹.","tags":"vitesse-quadratique","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.47 - Théorie cinétique du gaz parfait","type":"formula","recto":"Énergie cinétique moyenne d'une molécule ?","verso":"<E_c> = (1/2)·m·<v²> = (3/2)·k_B·T\nÉquipartition : (1/2)·k_B·T par degré de liberté quadratique.","tags":"equipartition","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.47 - Théorie cinétique du gaz parfait","type":"definition","recto":"Théorème d'équipartition ?","verso":"À l'équilibre thermique, chaque degré de liberté quadratique de l'énergie contribue (1/2)·k_B·T.\nGP monoatomique : 3 d.l. → U = (3/2)·n·R·T. Diatomique : 5 d.l. → (5/2)·n·R·T.","tags":"equipartition;principe","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.53 - Diffusion thermique","type":"definition","recto":"Flux thermique conductif ?","verso":"⃗J_Q = −λ·grad(T)\nλ : conductivité thermique (W·m⁻¹·K⁻¹).\nLoi de Fourier (analogie avec Ohm).","tags":"fourier;loi","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.53 - Diffusion thermique","type":"law","recto":"Équation de la diffusion (chaleur) ?","verso":"ρ·c·∂T/∂t = λ·ΔT\nDans un milieu sans source, l'équation devient :\n∂T/∂t = D_T·ΔT  où D_T = λ/(ρ·c) (diffusivité).","tags":"diffusion;equation","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.53 - Diffusion thermique","type":"definition","recto":"Régime stationnaire ?","verso":"∂T/∂t = 0 → ΔT = 0 (équation de Laplace).\nSolution stationnaire : T(x) linéaire en 1D, sans terme source.","tags":"stationnaire","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.53 - Diffusion thermique","type":"formula","recto":"Résistance thermique d'un mur ?","verso":"R_th = e/(λ·S)\ne : épaisseur, S : surface.\nFlux : Φ = (T_chaud − T_froid)/R_th. Analogie totale avec U = R·I.","tags":"resistance-thermique","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.53 - Diffusion thermique","type":"application","recto":"Temps caractéristique de diffusion ?","verso":"τ ~ L²/D_T  (L : longueur caractéristique).\n→ La diffusion est LENTE (proportionnelle à L²).","tags":"diffusion;temps","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.53 - Diffusion thermique","type":"application","recto":"Loi de Newton (transfert convectif) ?","verso":"Φ_conv = h·S·(T_corps − T_fluide)\nh : coefficient de transfert convectif. Souvent dominant aux interfaces.","tags":"newton;convection","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.54-55 - Rayonnement thermique et corps noir","type":"definition","recto":"Rayonnement d'un corps ?","verso":"Tout corps à T > 0 émet un rayonnement EM.\nCaractérisé par son spectre (luminance vs λ) et son émissivité ε.","tags":"rayonnement","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.54-55 - Rayonnement thermique et corps noir","type":"definition","recto":"Corps noir ?","verso":"Idéalisation : absorbe TOUTES les radiations incidentes (α = 1), donc émet le maximum théorique pour sa T (loi de Kirchhoff).","tags":"corps-noir","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.54-55 - Rayonnement thermique et corps noir","type":"law","recto":"Loi de Stefan-Boltzmann ?","verso":"M = σ·T⁴   (W·m⁻²)\nσ ≈ 5,67·10⁻⁸ W·m⁻²·K⁻⁴.\nÉmittance totale d'un corps noir.\nCorps gris : M = ε·σ·T⁴ (ε : émissivité).","tags":"stefan","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.54-55 - Rayonnement thermique et corps noir","type":"law","recto":"Loi du déplacement de Wien ?","verso":"λ_max·T = 2,898·10⁻³ m·K\nDécrit le déplacement du maximum spectral avec T.\nSoleil (T ≈ 5800 K) : λ_max ≈ 500 nm (vert-jaune).","tags":"wien","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.54-55 - Rayonnement thermique et corps noir","type":"formula","recto":"Loi de Planck (densité spectrale, corps noir) ?","verso":"u(λ, T) = (2π·h·c²/λ⁵)·1/(exp(h·c/(λ·k_B·T)) − 1)\nDécrit complètement le spectre. Intégrée sur λ : Stefan-Boltzmann.","tags":"planck","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Thermodynamique avancée","chapitre":"Ch.54-55 - Rayonnement thermique et corps noir","type":"application","recto":"Bilan radiatif Terre-atmosphère (rappel) ?","verso":"À l'équilibre : énergie absorbée = énergie émise.\nT_eq = ((1−a)·P_solaire/(4σ))^(1/4) ≈ 255 K (sans atmosphère).\nEffet de serre : T réelle ≈ 288 K.","tags":"bilan-radiatif","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"definition","recto":"Solide indéformable ?","verso":"Système où la distance entre tout couple de points reste constante.\nCaractérisé par 6 ddl (3 translation + 3 rotation).","tags":"solide","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"definition","recto":"Vecteur rotation ?","verso":"⃗Ω = ω·⃗u  où ⃗u : axe instantané de rotation, ω : vitesse angulaire.\nFormule fondamentale : ⃗v_B = ⃗v_A + ⃗Ω∧⃗AB.","tags":"rotation","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"formula","recto":"Moment cinétique d'un solide en rotation autour d'un axe fixe Δ ?","verso":"L_Δ = J_Δ·ω\nJ_Δ : moment d'inertie par rapport à Δ.\nÉquivalent du « m » en translation.","tags":"moment-cinetique;solide","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"formula","recto":"Moments d'inertie usuels ?","verso":"• Tige homogène (axe ⊥ par G) : J = m·ℓ²/12\n• Disque (axe par G, ⊥ disque) : J = m·R²/2\n• Anneau (axe ⊥) : J = m·R²\n• Sphère (axe diamètre) : J = (2/5)·m·R²","tags":"moments-inertie","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"law","recto":"Théorème de Huygens (parallèle aux axes) ?","verso":"J_Δ = J_(Δ_G) + m·d²\nΔ axe parallèle à Δ_G (passant par G) à distance d.","tags":"huygens","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"law","recto":"Théorème du moment cinétique (axe fixe) ?","verso":"dL_Δ/dt = M_Δ(forces externes)\n→ J·dω/dt = Σ M_Δ.\nÉquivalent rotatif de m·a = ΣF.","tags":"tmc;solide","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"MP Physique — Mécanique des solides","chapitre":"Ch.12-13 - Cinématique et dynamique du solide","type":"formula","recto":"Énergie cinétique d'un solide ?","verso":"Décomposition (König) :\nE_c = (1/2)·m·v_G² + (1/2)·J_(G)·ω²\n→ trans. de G + rotation autour de G.","tags":"ec;solide","niveau":"MP","matiere":"Physique-Chimie"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"definition","recto":"Définition d'une fonction f de ℝ vers ℝ ?","verso":"Une fonction f est un procédé qui associe à tout réel x d'un ensemble D (domaine de définition) un unique réel f(x).\nNotation : f : D → ℝ, x ↦ f(x).","tags":"fonction;definition","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"definition","recto":"Domaine de définition d'une fonction ?","verso":"Ensemble des réels x pour lesquels f(x) existe.\n• Si f(x) = 1/(x-a) → D = ℝ \ {a}\n• Si f(x) = √(x-a) → D = [a; +∞[\n• Polynôme → D = ℝ","tags":"domaine;definition","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"definition","recto":"Courbe représentative d'une fonction ?","verso":"Ensemble des points M(x ; f(x)) pour tout x du domaine de définition.\nNotation : Cf = {(x, y) ∈ ℝ² | y = f(x)}","tags":"courbe;representation","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"definition","recto":"Fonction croissante sur un intervalle I ?","verso":"f est croissante sur I si : pour tous x₁, x₂ ∈ I,\nx₁ < x₂ ⟹ f(x₁) < f(x₂).\nGraphiquement : la courbe monte de gauche à droite.","tags":"croissance;monotonie","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"definition","recto":"Fonction décroissante sur un intervalle I ?","verso":"f est décroissante sur I si : pour tous x₁, x₂ ∈ I,\nx₁ < x₂ ⟹ f(x₁) > f(x₂).\nGraphiquement : la courbe descend de gauche à droite.","tags":"decroissance;monotonie","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"method","recto":"Minimum et maximum d'une fonction ?","verso":"• Maximum en a : f(a) ≥ f(x) pour tout x du domaine\n• Minimum en a : f(a) ≤ f(x) pour tout x du domaine\nGraphiquement : sommet de la courbe (haut = max, bas = min).","tags":"extremum;max;min","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.1 - Fonctions : généralités","type":"definition","recto":"Taux de variation de f entre a et b ?","verso":"t = (f(b) - f(a)) / (b - a)\nRepréente la pente de la droite (AB) où A(a;f(a)) et B(b;f(b)).","tags":"taux;variation;pente","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.2 - Second degré","type":"formula","recto":"Forme canonique de ax² + bx + c ?","verso":"f(x) = a(x - α)² + β\navec α = -b/(2a) et β = f(α) = c - b²/(4a).\nSommet de la parabole : S(α ; β).","tags":"canonique;sommet;parabole","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.2 - Second degré","type":"formula","recto":"Discriminant d'un trinôme ax² + bx + c ?","verso":"Δ = b² - 4ac\n• Δ > 0 : deux racines réelles x₁ = (-b-√Δ)/(2a), x₂ = (-b+√Δ)/(2a)\n• Δ = 0 : une racine double x₀ = -b/(2a)\n• Δ < 0 : pas de racine réelle","tags":"discriminant;racines","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.2 - Second degré","type":"formula","recto":"Signe d'un trinôme ax² + bx + c (a > 0) ?","verso":"• Δ < 0 : f(x) > 0 pour tout x (toujours positif)\n• Δ = 0 : f(x) ≥ 0, nul en x₀\n• Δ > 0 : f(x) < 0 pour x ∈ ]x₁ ; x₂[ et f(x) > 0 ailleurs","tags":"signe;trinome","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.2 - Second degré","type":"formula","recto":"Relations coefficients-racines (Viète) pour ax²+bx+c ?","verso":"Si x₁, x₂ sont les racines :\n• x₁ + x₂ = -b/a\n• x₁ × x₂ = c/a\nFactorisation : ax²+bx+c = a(x-x₁)(x-x₂)","tags":"viete;racines;factorisation","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.3 - Géométrie repérée","type":"formula","recto":"Distance entre deux points A(x_A;y_A) et B(x_B;y_B) ?","verso":"AB = √[(x_B - x_A)² + (y_B - y_A)²]","tags":"distance;points","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.3 - Géométrie repérée","type":"formula","recto":"Coordonnées du milieu M de [AB] ?","verso":"M = ((x_A + x_B)/2 ; (y_A + y_B)/2)","tags":"milieu;segment","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.3 - Géométrie repérée","type":"formula","recto":"Équation d'une droite (forme générale et réduite) ?","verso":"• Forme générale : ax + by + c = 0 (a,b non tous nuls)\n• Forme réduite : y = mx + p\n  – m = pente (coefficient directeur)\n  – p = ordonnée à l'origine","tags":"droite;equation","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.3 - Géométrie repérée","type":"method","recto":"Coefficient directeur d'une droite passant par A et B ?","verso":"m = (y_B - y_A) / (x_B - x_A)\n(si x_A ≠ x_B, sinon la droite est verticale x = x_A)","tags":"pente;directeur","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.3 - Géométrie repérée","type":"definition","recto":"Condition de parallélisme de deux droites y=m₁x+p₁ et y=m₂x+p₂ ?","verso":"Parallèles ⟺ m₁ = m₂ (mêmes pentes)\nPerpendiculaires ⟺ m₁ × m₂ = -1","tags":"parallele;perpendiculaire","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.3 - Géométrie repérée","type":"definition","recto":"Équation d'un cercle de centre Ω(a;b) et rayon r ?","verso":"(x - a)² + (y - b)² = r²\nCercle centré à l'origine : x² + y² = r²","tags":"cercle;equation","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.4 - Vecteurs","type":"definition","recto":"Vecteur AB ? Coordonnées ?","verso":"Vecteur AB = B - A, de direction A→B.\nSi A(x_A;y_A), B(x_B;y_B):\nvect(AB) = (x_B - x_A ; y_B - y_A)","tags":"vecteur;coordonnees","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.4 - Vecteurs","type":"formula","recto":"Norme (longueur) d'un vecteur u⃗(x;y) ?","verso":"||u⃗|| = √(x² + y²)\n= distance entre les deux points extrémités","tags":"norme;vecteur","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.4 - Vecteurs","type":"definition","recto":"Vecteurs colinéaires (critère) ?","verso":"u⃗(a;b) et v⃗(c;d) colinéaires ⟺ ad - bc = 0\n(déterminant nul)\nGéométriquement : même direction (ou l'un est nul).","tags":"colineaire;vecteur","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.5 - Trigonométrie","type":"definition","recto":"Définitions sin θ, cos θ, tan θ dans un triangle rectangle ?","verso":"Dans un triangle rectangle en C, angle θ en A :\n• sin θ = côté opposé / hypoténuse = BC/AB\n• cos θ = côté adjacent / hypoténuse = AC/AB\n• tan θ = côté opposé / adjacent = BC/AC","tags":"sin;cos;tan;triangle","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.5 - Trigonométrie","type":"formula","recto":"Relation fondamentale de trigonométrie ?","verso":"cos²θ + sin²θ = 1\nPour tout angle θ.","tags":"relation;fondamentale;trig","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.5 - Trigonométrie","type":"formula","recto":"Valeurs remarquables de sin et cos ?","verso":"θ    | 0°  | 30°    | 45°    | 60°    | 90°\ncos  | 1   | √3/2   | √2/2   | 1/2    | 0\nsin  | 0   | 1/2    | √2/2   | √3/2   | 1\ntan  | 0   | 1/√3   | 1      | √3     | ∞","tags":"valeurs;remarquables","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.5 - Trigonométrie","type":"formula","recto":"Cercle trigonométrique : lien radians / degrés ?","verso":"π rad = 180°\nConversion : α (rad) = α° × π/180\nExemples : π/6 = 30°, π/4 = 45°, π/3 = 60°, π/2 = 90°","tags":"radians;degres;cercle","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.6 - Statistiques","type":"formula","recto":"Moyenne d'une série statistique ?","verso":"x̄ = (Σ nᵢ xᵢ) / N\n• xᵢ : valeurs, nᵢ : effectifs, N : effectif total\nOu x̄ = (1/N) Σ xᵢ","tags":"moyenne;stats","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.6 - Statistiques","type":"definition","recto":"Médiane d'une série statistique ?","verso":"Valeur M qui partage la série en deux moitiés égales.\n• 50% des valeurs ≤ M et 50% des valeurs ≥ M\nSe lit sur la courbe des fréquences cumulées à 50%.","tags":"mediane;quartile","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.6 - Statistiques","type":"definition","recto":"Écart interquartile (EIQ) ?","verso":"EIQ = Q₃ - Q₁\n• Q₁ : 1er quartile (25% des données en dessous)\n• Q₃ : 3e quartile (75% des données en dessous)\nMesure la dispersion centrale.","tags":"quartile;dispersion","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.6 - Probabilités","type":"definition","recto":"Probabilité d'un événement A (équiprobabilité) ?","verso":"P(A) = (nombre de cas favorables) / (nombre de cas possibles)\nConditions : expérience aléatoire à issues équiprobables.","tags":"probabilite;equiprobabilite","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.6 - Probabilités","type":"formula","recto":"Propriétés des probabilités ?","verso":"• 0 ≤ P(A) ≤ 1\n• P(Ω) = 1, P(∅) = 0\n• P(Ā) = 1 - P(A)  [événement complémentaire]\n• P(A ∪ B) = P(A) + P(B) - P(A ∩ B)","tags":"proprietes;probabilite","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.7 - Suites numériques (intro)","type":"definition","recto":"Suite arithmétique ?","verso":"Suite (uₙ) telle que uₙ₊₁ = uₙ + r (r = raison).\nFormule explicite : uₙ = u₀ + n·r\nSomme : Sₙ = (n+1)(u₀ + uₙ)/2","tags":"arithmetique;suite","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.7 - Suites numériques (intro)","type":"definition","recto":"Suite géométrique ?","verso":"Suite (uₙ) telle que uₙ₊₁ = q·uₙ (q = raison).\nFormule explicite : uₙ = u₀ × qⁿ\nSomme (q ≠ 1) : Sₙ = u₀ × (1 - qⁿ⁺¹)/(1-q)","tags":"geometrique;suite","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.8 - Systèmes d'équations","type":"method","recto":"Méthode de substitution pour résoudre un système 2×2 ?","verso":"1. Exprimer une variable en fonction de l'autre depuis une équation.\n2. Substituer dans l'autre équation.\n3. Résoudre l'équation obtenue.\n4. Remonter pour trouver l'autre variable.","tags":"systeme;substitution","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.8 - Systèmes d'équations","type":"method","recto":"Méthode par combinaison (addition) ?","verso":"1. Multiplier les équations par des constantes pour que les coefficients d'une variable soient opposés.\n2. Additionner les deux équations.\n3. Résoudre l'équation en une variable.\n4. Substituer pour trouver l'autre.","tags":"systeme;combinaison","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.9 - Logique et raisonnement","type":"definition","recto":"Condition nécessaire / condition suffisante ?","verso":"• P ⟹ Q : P est condition suffisante de Q, Q est condition nécessaire de P\n• P ⟺ Q : P est CNS de Q (condition nécessaire et suffisante)\nExemple : ABCD carré ⟹ ABCD rectangle (carré est CS d'être rectangle)","tags":"logique;necessaire;suffisant","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.9 - Logique et raisonnement","type":"definition","recto":"Contraposée d'une implication P ⟹ Q ?","verso":"La contraposée est : non-Q ⟹ non-P\nElles sont logiquement équivalentes :\nP ⟹ Q ⟺ (non Q) ⟹ (non P)","tags":"contraposee;implication","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.9 - Logique et raisonnement","type":"method","recto":"Raisonnement par l'absurde ?","verso":"Pour démontrer P :\n1. Supposer non-P.\n2. Déduire une contradiction (avec des axiomes ou hypothèses).\n3. Conclure que P est vraie.\nExemple classique : démonstration de l'irrationalité de √2.","tags":"absurde;raisonnement","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.10 - Fonctions de référence","type":"formula","recto":"Fonction carré : f(x) = x² — variations et propriétés ?","verso":"• Domaine : ℝ\n• Paire : f(-x) = f(x), symétrie par rapport à l'axe y\n• Décroissante sur ]-∞;0], croissante sur [0;+∞[\n• Minimum en 0 : f(0) = 0","tags":"carre;parabole","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.10 - Fonctions de référence","type":"formula","recto":"Fonction inverse : f(x) = 1/x — variations et propriétés ?","verso":"• Domaine : ℝ* = ℝ \ {0}\n• Impaire : f(-x) = -f(x), symétrie par rapport à l'origine\n• Décroissante sur ]-∞;0[ et décroissante sur ]0;+∞[\n• Asymptotes : x=0 et y=0","tags":"inverse;hyperbole","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.10 - Fonctions de référence","type":"formula","recto":"Fonction racine carrée : f(x) = √x — variations et propriétés ?","verso":"• Domaine : [0;+∞[\n• Croissante sur [0;+∞[\n• f(0)=0, f(1)=1, f(4)=2, f(9)=3\n• La courbe part de l'origine vers la droite et s'aplatit.","tags":"racine;carree","niveau":"Seconde","matiere":"Maths"},{"deck":"Maths Seconde","chapitre":"Ch.11 - Intervalles et inégalités","type":"method","recto":"Résoudre |x - a| < r (valeur absolue) ?","verso":"|x - a| < r ⟺ -r < x - a < r ⟺ a - r < x < a + r\nSolution : x ∈ ]a-r ; a+r[\n\nDe même : |x - a| > r ⟺ x < a-r ou x > a+r","tags":"valeur;absolue;inequation","niveau":"Seconde","matiere":"Maths"},{"deck":"PC Seconde","chapitre":"Ch.1 - Corps purs et mélanges","type":"definition","recto":"Corps pur vs mélange ?","verso":"• Corps pur : une seule espèce chimique (ex: eau distillée, cuivre)\n• Mélange : plusieurs espèces chimiques\n  – Homogène : une seule phase visible (ex: eau salée)\n  – Hétérogène : plusieurs phases visibles (ex: eau + huile)","tags":"corps;pur;melange","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.1 - Corps purs et mélanges","type":"definition","recto":"Techniques de séparation des mélanges ?","verso":"• Filtration : sépare solide/liquide\n• Distillation : sépare selon les températures d'ébullition\n• Cristallisation : sépare par solubilité\n• Chromatographie : sépare selon affinité (CCM)\n• Décantation : sépare selon les densités","tags":"separation;filtration;distillation","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.2 - Atomes et molécules","type":"definition","recto":"Structure d'un atome ?","verso":"Noyau (protons p⁺ + neutrons n⁰) + nuage d'électrons (e⁻)\n• Numéro atomique Z = nombre de protons = nombre d'électrons (atome neutre)\n• Nombre de masse A = Z + N (N = neutrons)\nNotation : ᴬZ X","tags":"atome;noyau;proton","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.2 - Atomes et molécules","type":"definition","recto":"Isotopes d'un élément ?","verso":"Atomes du même élément (même Z) mais différents nombres de neutrons (N différents).\nExemple : ¹²C et ¹⁴C ont Z=6, mais A=12 et A=14.","tags":"isotopes;noyau","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.2 - Atomes et molécules","type":"definition","recto":"Configuration électronique d'un atome (couches K, L, M) ?","verso":"• Couche K (n=1) : max 2 électrons\n• Couche L (n=2) : max 8 électrons\n• Couche M (n=3) : max 18 électrons (simplification lycée : 8)\nRègle : on remplit de l'intérieur vers l'extérieur.","tags":"configuration;electronique;couches","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.2 - Atomes et molécules","type":"definition","recto":"Ion — définition et exemples ?","verso":"Atome (ou groupe d'atomes) ayant gagné ou perdu des électrons.\n• Cation : perte d'e⁻ → charge positive (ex: Na⁺, Ca²⁺)\n• Anion : gain d'e⁻ → charge négative (ex: Cl⁻, O²⁻)","tags":"ion;cation;anion","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.3 - Tableau périodique","type":"definition","recto":"Organisation du tableau périodique ?","verso":"• Lignes = périodes (même nombre de couches électroniques)\n• Colonnes = familles / groupes (même nombre d'électrons de valence → propriétés similaires)\n• Métaux à gauche, non-métaux à droite, gaz nobles (18) à l'extrême droite","tags":"tableau;periodique;organisation","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.3 - Tableau périodique","type":"definition","recto":"Électrons de valence et stabilité de l'octet ?","verso":"Électrons de valence : électrons de la couche externe.\nRègle de l'octet : les atomes tendent à avoir 8 e⁻ en couche externe (2 pour H et He).\nC'est la force motrice de la formation des liaisons chimiques.","tags":"valence;octet;liaison","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.4 - Liaisons chimiques","type":"definition","recto":"Liaison covalente ?","verso":"Partage de 2 électrons entre deux atomes.\n• Liaison simple : 1 doublet partagé (ex: H₂, H-H)\n• Liaison double : 2 doublets (ex: O=O)\n• Liaison triple : 3 doublets (ex: N≡N)\nEntre non-métaux.","tags":"covalente;liaison","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.4 - Liaisons chimiques","type":"definition","recto":"Liaison ionique ?","verso":"Transfert d'électrons d'un métal vers un non-métal → ions de charges opposées s'attirent.\nExemple : NaCl → Na⁺ et Cl⁻\nRéseau cristallin ionique : solide rigide, haut point de fusion.","tags":"ionique;liaison;sel","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.5 - Solutions aqueuses","type":"formula","recto":"Concentration molaire d'une solution ?","verso":"c = n / V\n• c en mol/L\n• n en mol (quantité de matière)\n• V en L (volume de solution)\nSynonymes : concentration molaire, molarité.","tags":"concentration;molaire;solution","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.5 - Solutions aqueuses","type":"formula","recto":"Masse molaire M et quantité de matière n ?","verso":"n = m / M\n• n en mol\n• m en g\n• M en g/mol (somme des masses atomiques des éléments)\nEx : M(H₂O) = 2×1 + 16 = 18 g/mol","tags":"masse;molaire;mole","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.5 - Solutions aqueuses","type":"definition","recto":"Dilution — relation entre concentration mère et fille ?","verso":"c₁V₁ = c₂V₂\n• c₁ : concentration initiale (mère)\n• V₁ : volume prélevé\n• c₂ : concentration finale (fille)\n• V₂ : volume total après dilution\n(Conservation de la quantité de matière soluté)","tags":"dilution;concentration","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.6 - Lumière et couleurs","type":"definition","recto":"Spectre de la lumière visible ?","verso":"Lumière visible : longueurs d'onde λ entre 380 nm (violet) et 780 nm (rouge).\nDécomposition par un prisme : violet, indigo, bleu, vert, jaune, orange, rouge.\nLumière blanche = superposition de toutes ces couleurs.","tags":"spectre;lumiere;visible","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.6 - Lumière et couleurs","type":"formula","recto":"Relation entre longueur d'onde λ, fréquence ν et célérité c ?","verso":"c = λ × ν\n• c ≈ 3×10⁸ m/s dans le vide\n• λ en m (ou nm : 1 nm = 10⁻⁹ m)\n• ν en Hz\nλ = c/ν","tags":"onde;longueur;frequence","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.6 - Lumière et couleurs","type":"definition","recto":"Couleur perçue d'un objet opaque / transparent ?","verso":"• Objet opaque : couleur de la lumière réfléchie (absorbe les autres)\n• Objet transparent coloré : couleur de la lumière transmise\n• Blanc : réfléchit toutes les couleurs\n• Noir : absorbe toutes les couleurs","tags":"couleur;reflexion;absorption","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.7 - Mouvements et forces","type":"definition","recto":"Référentiel — définition ?","verso":"Ensemble de points de référence par rapport auxquels on décrit le mouvement.\nExemples :\n• Référentiel terrestre : lié à la Terre\n• Référentiel géocentrique : centre de la Terre + étoiles lointaines\n• Référentiel héliocentrique : centre du Soleil","tags":"referentiel;mouvement","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.7 - Mouvements et forces","type":"definition","recto":"Vitesse moyenne / instantanée ?","verso":"• Vitesse moyenne : v_moy = d/Δt (distance / durée)\n• Vitesse instantanée : v = lim(Δt→0) Δx/Δt = dérivée de la position\nUnité : m/s (ou km/h : ÷ 3,6)","tags":"vitesse;mouvement","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.7 - Mouvements et forces","type":"definition","recto":"Force — définition et unité ?","verso":"Interaction entre deux objets (contact ou à distance).\nUnité : Newton (N)\nCaractéristiques : point d'application, direction, sens, valeur (norme).\nReprésentation : vecteur force F⃗.","tags":"force;newton;interaction","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.7 - Mouvements et forces","type":"formula","recto":"Poids d'un objet de masse m ?","verso":"P⃗ = m × g⃗\n• m en kg\n• g ≈ 9,8 N/kg (≈ 10 N/kg en simplification)\n• P en N\nDirection : vers le centre de la Terre (vertical, vers le bas).","tags":"poids;masse;gravite","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.7 - Mouvements et forces","type":"definition","recto":"Équilibre d'un objet — condition ?","verso":"Un objet est en équilibre si la somme vectorielle de toutes les forces qui s'exercent sur lui est nulle :\nΣF⃗ = 0⃗\nOu encore : les forces se compensent.","tags":"equilibre;forces;somme","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.8 - Énergie","type":"formula","recto":"Énergie cinétique Ec ?","verso":"Ec = ½ × m × v²\n• m en kg\n• v en m/s\n• Ec en J (joules)\nL'énergie cinétique est toujours positive ou nulle.","tags":"energie;cinetique","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.8 - Énergie","type":"formula","recto":"Énergie potentielle de pesanteur (Ep) ?","verso":"Ep = m × g × h\n• m en kg, g ≈ 9,8 m/s², h en m\n• Ep en J\nConvention : h référence au choix, Ep relative à cette référence.","tags":"energie;potentielle;pesanteur","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.8 - Énergie","type":"definition","recto":"Conservation de l'énergie mécanique ?","verso":"Em = Ec + Ep = constante\n(si les seules forces sont le poids et la réaction normale, sans frottements)\nVariation Ec + Variation Ep = 0\nSi frottements : Em diminue → énergie dissipée en chaleur.","tags":"conservation;energie;mecanique","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.9 - Électricité (bases)","type":"definition","recto":"Intensité du courant électrique ?","verso":"I = Q / t = dq/dt\n• I en ampères (A)\n• Q en coulombs (C) : charge transférée\n• Sens conventionnel du courant : de + vers - (sens inverse des électrons)","tags":"intensite;courant;ampere","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.9 - Électricité (bases)","type":"formula","recto":"Loi d'Ohm ?","verso":"U = R × I\n• U en volts (V) : tension aux bornes du résistor\n• R en ohms (Ω) : résistance\n• I en ampères (A)\nValable pour un conducteur ohmique (résistor).","tags":"ohm;tension;resistance","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.9 - Électricité (bases)","type":"formula","recto":"Lois des circuits (série et dérivation) ?","verso":"Série :\n• I identique partout\n• U_total = U₁ + U₂ + … (tensions s'additionnent)\n• R_eq = R₁ + R₂ + …\n\nDérivation :\n• U identique aux bornes de chaque branche\n• I_total = I₁ + I₂ + … (intensités s'additionnent)\n• 1/R_eq = 1/R₁ + 1/R₂ + …","tags":"serie;derivation;kirchhoff","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"PC Seconde","chapitre":"Ch.9 - Électricité (bases)","type":"formula","recto":"Puissance électrique dissipée dans un résistor ?","verso":"P = U × I = R × I² = U²/R\n• P en watts (W)\n• Énergie dissipée : E = P × t (en joules, t en secondes)","tags":"puissance;electrique;dissipation","niveau":"Seconde","matiere":"Physique-Chimie"},{"deck":"Maths Première Spécialité","chapitre":"Ch.1 - Suites numériques","type":"definition","recto":"Suite définie par récurrence vs explicite ?","verso":"• Récurrence : u_{n+1} = f(u_n), avec u_0 donnée. Ex : u_{n+1} = 2u_n + 1\n• Explicite : u_n = f(n) directement. Ex : u_n = 3n + 2\nUne suite arithmétique ET géométrique peut avoir les deux formes.","tags":"suite;recurrence;explicite","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.1 - Suites numériques","type":"method","recto":"Montrer qu'une suite est arithmétique ?","verso":"Calculer u_{n+1} - u_n et vérifier que c'est une constante r (raison).\nSi u_{n+1} - u_n = r pour tout n, alors la suite est arithmétique de raison r.","tags":"arithmetique;methode","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.1 - Suites numériques","type":"method","recto":"Montrer qu'une suite est géométrique ?","verso":"Calculer u_{n+1} / u_n et vérifier que c'est une constante q (raison).\nSi u_{n+1} / u_n = q pour tout n (et u_n ≠ 0), alors la suite est géométrique de raison q.","tags":"geometrique;methode","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.1 - Suites numériques","type":"formula","recto":"Somme des termes d'une suite arithmétique ?","verso":"S = u_p + u_{p+1} + … + u_n = (n-p+1) × (u_p + u_n) / 2\nCas particulier : 1 + 2 + … + n = n(n+1)/2","tags":"somme;arithmetique","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.1 - Suites numériques","type":"formula","recto":"Somme des termes d'une suite géométrique (q ≠ 1) ?","verso":"S = u_p × (1 - q^{n-p+1}) / (1 - q)\nCas particulier : 1 + q + q² + … + q^n = (1 - q^{n+1}) / (1 - q)","tags":"somme;geometrique","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.1 - Suites numériques","type":"definition","recto":"Suite monotone croissante / décroissante ?","verso":"• Croissante : u_{n+1} - u_n ≥ 0 pour tout n (ou u_{n+1}/u_n ≥ 1 si u_n > 0)\n• Décroissante : u_{n+1} - u_n ≤ 0 pour tout n\n• Suite arithmétique : croissante si r > 0, décroissante si r < 0\n• Suite géométrique (u_0 > 0) : croissante si q > 1, décroissante si 0 < q < 1","tags":"monotone;suite","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.2 - Dérivation","type":"definition","recto":"Nombre dérivé f'(a) — définition ?","verso":"f'(a) = lim_{h→0} [f(a+h) - f(a)] / h\nReprésente la pente de la tangente à Cf au point A(a ; f(a)).\nÉquation de la tangente en A : y = f'(a)(x - a) + f(a)","tags":"derivee;tangente;limite","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.2 - Dérivation","type":"formula","recto":"Tableau des dérivées usuelles ?","verso":"• (x^n)' = n·x^{n-1}\n• (e^x)' = e^x\n• (ln x)' = 1/x\n• (sin x)' = cos x\n• (cos x)' = -sin x\n• (√x)' = 1/(2√x)\n• (1/x)' = -1/x²","tags":"derivee;tableau;usuelle","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.2 - Dérivation","type":"formula","recto":"Règles de dérivation (somme, produit, quotient) ?","verso":"• (u+v)' = u' + v'\n• (ku)' = k·u'\n• (u×v)' = u'v + uv'\n• (u/v)' = (u'v - uv') / v²\n• (u∘v)' = u'(v) × v'  [composition]","tags":"derivee;regles;produit;quotient","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.2 - Dérivation","type":"method","recto":"Lien entre signe de f' et variations de f ?","verso":"• f'(x) > 0 sur I ⟹ f croissante sur I\n• f'(x) < 0 sur I ⟹ f décroissante sur I\n• f'(a) = 0 et changement de signe ⟹ extremum local en a\n• f' ne change pas de signe : pas d'extremum (point d'inflexion possible)","tags":"derivee;variations;extremum","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.3 - Fonction exponentielle","type":"definition","recto":"Définition et propriétés fondamentales de exp ?","verso":"exp est l'unique fonction telle que :\n• f' = f (sa propre dérivée)\n• f(0) = 1\nPropriétés : e^a × e^b = e^{a+b}, e^{-a} = 1/e^a, (e^a)^n = e^{na}","tags":"exponentielle;proprietes","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.3 - Fonction exponentielle","type":"formula","recto":"Variations et limites de exp(x) ?","verso":"• Définie et dérivable sur ℝ\n• Strictement croissante sur ℝ\n• lim_{x→-∞} e^x = 0 (asymptote y=0)\n• lim_{x→+∞} e^x = +∞\n• e^0 = 1, e^1 = e ≈ 2,718","tags":"exponentielle;variations;limites","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.3 - Fonction exponentielle","type":"formula","recto":"Dérivée de e^{u(x)} ?","verso":"[e^{u(x)}]' = u'(x) × e^{u(x)}\nExemples :\n• (e^{2x})' = 2e^{2x}\n• (e^{-x})' = -e^{-x}\n• (e^{x²})' = 2x·e^{x²}","tags":"derivee;exponentielle;composition","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.4 - Trigonométrie","type":"formula","recto":"Formules d'addition pour cos et sin ?","verso":"cos(a+b) = cos a·cos b - sin a·sin b\ncos(a-b) = cos a·cos b + sin a·sin b\nsin(a+b) = sin a·cos b + cos a·sin b\nsin(a-b) = sin a·cos b - cos a·sin b","tags":"addition;cos;sin;formule","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.4 - Trigonométrie","type":"formula","recto":"Formules de duplication (angle double) ?","verso":"sin(2a) = 2 sin a·cos a\ncos(2a) = cos²a - sin²a = 2cos²a - 1 = 1 - 2sin²a\ntan(2a) = 2tan a / (1 - tan²a)","tags":"duplication;double;angle","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.4 - Trigonométrie","type":"formula","recto":"Propriétés de parité de sin et cos ?","verso":"• cos est paire : cos(-x) = cos(x)\n• sin est impaire : sin(-x) = -sin(x)\nPériodicité : sin et cos ont pour période 2π\n• sin(x + 2π) = sin x, cos(x + 2π) = cos x","tags":"parite;periodicite;trig","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.5 - Probabilités conditionnelles","type":"definition","recto":"Probabilité conditionnelle P_B(A) ?","verso":"P_B(A) = P(A ∩ B) / P(B)  (avec P(B) > 0)\nProbabilité que A se réalise, sachant que B s'est réalisé.\nAutre notation : P(A|B)","tags":"conditionnelle;probabilite","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.5 - Probabilités conditionnelles","type":"formula","recto":"Formule des probabilités totales ?","verso":"Si {B₁, B₂, …, Bₙ} partition de Ω :\nP(A) = P(A∩B₁) + P(A∩B₂) + … + P(A∩Bₙ)\n     = P(B₁)P_{B₁}(A) + P(B₂)P_{B₂}(A) + …","tags":"probabilites;totales;partition","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.5 - Probabilités conditionnelles","type":"definition","recto":"Indépendance de deux événements A et B ?","verso":"A et B sont indépendants si :\nP(A ∩ B) = P(A) × P(B)\nÉquivalent : P_B(A) = P(A) (sachant B, la probabilité de A ne change pas).","tags":"independance;evenements","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.5 - Probabilités conditionnelles","type":"formula","recto":"Formule de Bayes ?","verso":"P_A(B) = P_B(A) × P(B) / P(A)\nOu : P(B|A) = P(A|B)P(B) / P(A)\nPermets de «inverser» la conditionnelle.","tags":"bayes;inverse;probabilite","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.6 - Géométrie dans l'espace","type":"definition","recto":"Vecteur normal à un plan ?","verso":"Un vecteur n⃗ est normal au plan (P) si n⃗ est perpendiculaire à tout vecteur directeur de (P).\nÉquation cartésienne du plan : ax + by + cz + d = 0, avec n⃗ = (a;b;c).","tags":"normal;plan;vecteur","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.6 - Géométrie dans l'espace","type":"formula","recto":"Produit scalaire de u⃗(x,y,z) et v⃗(x',y',z') ?","vers":"u⃗·v⃗ = xx' + yy' + zz'\nPropriétés : u⃗·v⃗ = ||u⃗|| ||v⃗|| cos θ\nOrthogonalité : u⃗ ⊥ v⃗ ⟺ u⃗·v⃗ = 0","tags":"scalaire;produit;3D","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.6 - Géométrie dans l'espace","type":"definition","recto":"Droites et plans dans l'espace — positions relatives ?","verso":"Droite / plan :\n• Sécante : 1 point commun\n• Parallèle : 0 point commun, droite dans la direction du plan\n• Incluse : droite entièrement dans le plan\n\nPlan / plan :\n• Sécants : une droite d'intersection\n• Parallèles : aucun point commun","tags":"espace;positions;relatives","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.7 - Continuité","type":"definition","recto":"Fonction continue en a ?","verso":"f est continue en a si lim_{x→a} f(x) = f(a)\n(la limite existe et est égale à la valeur de la fonction)\nToute fonction dérivable est continue (réciproque fausse).","tags":"continuite;limite","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.7 - Continuité","type":"theorem","recto":"Théorème des valeurs intermédiaires (TVI) ?","verso":"Si f est continue sur [a;b] et k est un réel entre f(a) et f(b), alors il existe c ∈ [a;b] tel que f(c) = k.\n\nCorollaire (TVI strict) : si f est continue et strictement monotone sur [a;b], c est unique.","tags":"TVI;valeurs;intermediaires","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.8 - Primitives (intro)","type":"definition","recto":"Primitive d'une fonction f ?","verso":"F est une primitive de f sur I si F'(x) = f(x) pour tout x ∈ I.\nToutes les primitives de f différent d'une constante : F(x) + C.","tags":"primitive;antiderivee","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.8 - Primitives (intro)","type":"formula","recto":"Primitives usuelles ?","verso":"• x^n → x^{n+1}/(n+1) (n ≠ -1)\n• 1/x → ln|x|\n• e^x → e^x\n• cos x → sin x\n• sin x → -cos x\n• 1/√x → 2√x","tags":"primitives;tableau;usuelle","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.9 - Nombres complexes (intro)","type":"definition","recto":"Nombre complexe — définition, forme algébrique ?","verso":"i² = -1 (unité imaginaire)\nTout nombre complexe s'écrit : z = a + ib (a,b ∈ ℝ)\n• a = Re(z) : partie réelle\n• b = Im(z) : partie imaginaire\n|z| = √(a²+b²) : module","tags":"complexe;imaginaire;module","niveau":"Première","matiere":"Maths"},{"deck":"Maths Première Spécialité","chapitre":"Ch.9 - Nombres complexes (intro)","type":"formula","recto":"Conjugué z̄ d'un complexe z = a + ib ?","verso":"z̄ = a - ib\nPropriétés : z + z̄ = 2a (réel), z × z̄ = a² + b² = |z|²\nUtilisation : rationaliser z₁/z₂ en multipliant par z̄₂.","tags":"conjugue;complexe","niveau":"Première","matiere":"Maths"},{"deck":"PC Première Spécialité","chapitre":"Ch.1 - Cinématique","type":"formula","recto":"Vecteur position, vitesse et accélération ?","verso":"x(t) : position\nv(t) = dx/dt = ẋ : vitesse (dérivée de la position)\na(t) = dv/dt = d²x/dt² = ẍ : accélération\nEn vecteurs : r⃗(t), v⃗(t) = dr⃗/dt, a⃗(t) = dv⃗/dt","tags":"cinematique;position;vitesse;acceleration","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.1 - Cinématique","type":"formula","recto":"Équations horaires d'un mouvement uniformément accéléré ?","verso":"a = constante :\n• v(t) = v₀ + at\n• x(t) = x₀ + v₀t + ½at²\n• v² = v₀² + 2a(x - x₀)  [relation de Bélanger]","tags":"MRUA;equations;horaires","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.1 - Cinématique","type":"formula","recto":"Mouvement de projectile (chute avec vitesse initiale horizontale) ?","verso":"Axe x (horizontal) : aₓ = 0, x = v₀t\nAxe y (vertical, positif vers le bas) : aᵧ = g, y = ½gt²\n→ Trajectoire parabolique : y = g·x²/(2v₀²)","tags":"projectile;parabolique;chute","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.2 - Lois de Newton","type":"theorem","recto":"1ère loi de Newton (principe d'inertie) ?","verso":"Dans un référentiel galiléen : si ΣF⃗ = 0⃗, alors le centre de masse est en mouvement rectiligne uniforme (ou au repos).\nRéciproque : MRU ⟹ ΣF⃗ = 0⃗.","tags":"newton;inertie;1ere","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.2 - Lois de Newton","type":"theorem","recto":"2ème loi de Newton (principe fondamental de la dynamique) ?","verso":"ΣF⃗ = m × a⃗\n• ΣF⃗ en N (newtons)\n• m en kg\n• a⃗ en m/s²\nS'applique dans un référentiel galiléen, au centre de masse.","tags":"newton;dynamique;2eme;PFD","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.2 - Lois de Newton","type":"theorem","recto":"3ème loi de Newton (principe des actions réciproques) ?","verso":"Si A exerce une force F⃗_{A/B} sur B, alors B exerce sur A une force F⃗_{B/A} telle que :\nF⃗_{B/A} = -F⃗_{A/B}\n(même droite d'action, même norme, sens opposés)","tags":"newton;3eme;reciproque","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.3 - Énergie en mécanique","type":"theorem","recto":"Théorème de l'énergie cinétique ?","verso":"ΔEc = W(ΣF⃗)\nLa variation d'énergie cinétique est égale au travail de la résultante des forces.\nW(F⃗) = F⃗ · d⃗ = F·d·cos α (force constante, déplacement d, angle α)","tags":"TEC;energie;cinetique;travail","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.3 - Énergie en mécanique","type":"definition","recto":"Travail d'une force F⃗ sur un déplacement d⃗ ?","verso":"W = F⃗·d⃗ = F·d·cos α\n• α : angle entre F⃗ et d⃗\n• W > 0 : force motrice\n• W < 0 : force résistante (frein)\n• W = 0 : force perpendiculaire au déplacement (ex: réaction normale)","tags":"travail;force;deplacement","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.4 - Électricité : circuits RC","type":"formula","recto":"Équation différentielle du circuit RC (charge) ?","verso":"RC·(du_C/dt) + u_C = E\nSolution : u_C(t) = E(1 - e^{-t/RC})\nτ = RC : constante de temps (en secondes si R en Ω, C en F)\nA t = 5τ, le condensateur est considéré chargé à 99%.","tags":"RC;condensateur;constante;temps","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.4 - Électricité : circuits RC","type":"definition","recto":"Condensateur — relation courant-tension ?","verso":"i_C = C × (du_C/dt)\n• C en farads (F)\n• u_C en volts\n• i_C en ampères\nÉnergie stockée : E_C = ½·C·u_C²","tags":"condensateur;capacite;courant","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.4 - Électricité : circuits RL","type":"formula","recto":"Bobine — relation tension-courant et constante de temps RL ?","verso":"u_L = L × (di/dt)\n• L en henrys (H)\nÉnergie stockée : E_L = ½·L·i²\nCircuit RL série : τ = L/R (constante de temps)","tags":"bobine;inductance;RL","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.5 - Transformations chimiques","type":"definition","recto":"Transformation totale vs équilibre ?","verso":"• Totale : réactifs entièrement consommés, réaction dans un seul sens (→)\n• Équilibre : les deux sens coexistent (⇌), taux d'avancement τ < 1\nCritère : comparer Q_r initial avec K° (constante d'équilibre)","tags":"transformation;equilibre;taux","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.5 - Transformations chimiques","type":"definition","recto":"Tableau d'avancement — principe ?","verso":"On note x l'avancement de la réaction.\n• À x=0 : quantités initiales\n• À x : quantités intermédiaires (n_i = n_i0 ± ν_i x)\n• x_max : quand un réactif est épuisé\nTaux d'avancement : τ = x_max / x_final_théorique","tags":"avancement;tableau","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.5 - Acides-bases","type":"definition","recto":"Acide-base selon Brønsted-Lowry ?","verso":"• Acide : espèce capable de céder un proton H⁺\n• Base : espèce capable de capter un proton H⁺\nCouple acide/base conjugué : AH / A⁻\nExemple : CH₃COOH / CH₃COO⁻ (acide acétique / acétate)","tags":"acide;base;bronsted;proton","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.5 - Acides-bases","type":"formula","recto":"pH, pKa et constante d'acidité Ka ?","verso":"pH = -log[H₃O⁺]\nKa = [A⁻][H₃O⁺] / [AH]  (constante d'acidité)\npKa = -log(Ka)\n• Si pH < pKa : forme acide AH prédominante\n• Si pH > pKa : forme basique A⁻ prédominante","tags":"pH;pKa;Ka;acide","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.5 - Acides-bases","type":"definition","recto":"Oxydation / réduction — définition ?","verso":"• Oxydation : perte d'électrons (OILRIG: Oxidation Is Loss)\n• Réduction : gain d'électrons (Reduction Is Gain)\nCouple oxydant/réducteur : Ox/Red\nRéaction redox : Ox₁ + Red₂ → Red₁ + Ox₂","tags":"redox;oxydation;reduction","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.6 - Ondes mécaniques","type":"definition","recto":"Onde transversale vs longitudinale ?","verso":"• Transversale : oscillation perpendiculaire à la propagation (ex: corde, lumière)\n• Longitudinale : oscillation parallèle à la propagation (ex: son, onde de compression)\nLes ondes mécaniques nécessitent un milieu matériel.","tags":"onde;transversale;longitudinale","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.6 - Ondes mécaniques","type":"formula","recto":"Relation entre période T, fréquence f, longueur d'onde λ et célérité v ?","verso":"• f = 1/T (f en Hz, T en s)\n• v = λ × f = λ/T\n• λ = v/f = v×T\nLe son dans l'air : v ≈ 340 m/s, λ = 340/f","tags":"onde;periode;frequence;longueur","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.6 - Ondes mécaniques","type":"definition","recto":"Retard temporel et déphasage ?","verso":"Retard : τ = d/v (d = distance source-récepteur)\nDéphasage : φ = 2π × d/λ = 2πτ/T\n• φ = 2kπ : en phase (interférence constructive)\n• φ = (2k+1)π : en opposition de phase (interférence destructive)","tags":"retard;dephasage;interference","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.7 - Spectroscopie","type":"definition","recto":"Spectre d'absorption vs émission ?","verso":"• Émission : l'atome émet des photons en passant d'un état excité vers un état de plus basse énergie → raies brillantes\n• Absorption : l'atome absorbe des photons → raies sombres sur fond continu\nRelation : ΔE = hν = hc/λ","tags":"spectre;emission;absorption;photon","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"PC Première Spécialité","chapitre":"Ch.7 - Spectroscopie","type":"formula","recto":"Énergie d'un photon ?","verso":"E = hν = hc/λ\n• h = 6,63×10⁻³⁴ J·s (constante de Planck)\n• ν en Hz (fréquence)\n• c ≈ 3×10⁸ m/s\n• λ en m\nConversion : 1 eV = 1,6×10⁻¹⁹ J","tags":"photon;energie;planck","niveau":"Première","matiere":"Physique-Chimie"},{"deck":"Agrégation — Analyse","chapitre":"Topologie de ℝⁿ","type":"definition","recto":"Boule ouverte B(x,r) dans un espace métrique (E,d) ?","verso":"B(x,r) = {y ∈ E | d(x,y) < r}\nBoule fermée : B̄(x,r) = {y | d(x,y) ≤ r}\nSphère : S(x,r) = {y | d(x,y) = r}","tags":"boule;topologie;metrique","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Topologie de ℝⁿ","type":"definition","recto":"Ouvert, fermé, compact dans ℝⁿ ?","verso":"• Ouvert U : ∀x∈U, ∃r>0, B(x,r)⊂U\n• Fermé F : ℝⁿ\F ouvert ⟺ F contient ses valeurs d'adhérence\n• Compact K : tout ouvert recouvrant K admet un sous-recouvrement fini ⟺ fermé et borné dans ℝⁿ (Heine-Borel)","tags":"ouvert;ferme;compact;topologie","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Topologie de ℝⁿ","type":"theorem","recto":"Théorème de Bolzano-Weierstrass ?","verso":"Toute suite bornée de ℝⁿ admet une sous-suite convergente.\nÉquivalent à la compacité des fermés bornés de ℝⁿ.","tags":"bolzano;weierstrass;suite;bornee","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Topologie de ℝⁿ","type":"theorem","recto":"Image d'un compact par une application continue ?","verso":"Si f : E → F est continue et K ⊂ E est compact, alors f(K) est compact.\nCorollaire : f atteint ses bornes sur K (théorème des bornes atteintes).","tags":"compact;continu;image","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Séries numériques","type":"definition","recto":"Convergence d'une série Σuₙ ?","verso":"La série converge si la suite des sommes partielles Sₙ = Σ_{k=0}^{n} uₙ converge.\nCondition nécessaire : uₙ → 0. (Réciproque fausse : série harmonique Σ1/n diverge.)","tags":"serie;convergence;somme","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Séries numériques","type":"theorem","recto":"Critère de d'Alembert (règle du quotient) ?","verso":"Si |u_{n+1}/uₙ| → l :\n• l < 1 : Σuₙ converge absolument\n• l > 1 : Σuₙ diverge\n• l = 1 : test non concluant","tags":"d'alembert;quotient;critere","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Séries numériques","type":"theorem","recto":"Critère de Cauchy (règle de la racine) ?","verso":"Si |uₙ|^{1/n} → l :\n• l < 1 : Σuₙ converge absolument\n• l > 1 : Σuₙ diverge\n• l = 1 : test non concluant\nPlus fort que d'Alembert (impliqué par lui).","tags":"cauchy;racine;critere","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Séries numériques","type":"theorem","recto":"Comparaison par équivalent / règle de Riemann ?","verso":"Σ1/n^α converge ⟺ α > 1 (série de Riemann).\nSi uₙ ~ vₙ avec vₙ ≥ 0 : Σuₙ et Σvₙ même nature.\nComparaison : si 0 ≤ uₙ ≤ vₙ, Σvₙ converge ⟹ Σuₙ converge.","tags":"riemann;comparaison;convergence","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Séries numériques","type":"theorem","recto":"Séries alternées — critère de Leibniz ?","verso":"Si (aₙ) décroissante, aₙ ≥ 0, aₙ → 0, alors Σ(-1)ⁿaₙ converge.\nDe plus : |S - Sₙ| ≤ aₙ₊₁ (majoration du reste par le premier terme négligé).","tags":"alternee;leibniz;critere","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Intégration de Riemann / Lebesgue","type":"theorem","recto":"Théorème fondamental du calcul intégral ?","verso":"Si f continue sur [a,b] et F primitive de f :\n∫_a^b f(x)dx = F(b) - F(a)\n\nRéciproquement, G(x) = ∫_a^x f(t)dt est l'unique primitive de f nulle en a.","tags":"fondamental;calcul;integrale","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Intégration de Riemann / Lebesgue","type":"theorem","recto":"Intégration par parties ?","verso":"∫_a^b u'v dx = [uv]_a^b - ∫_a^b uv' dx\nMnémotechnique : (uv)' = u'v + uv' → intégrer.","tags":"integration;parties;IPP","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Intégration de Lebesgue","type":"theorem","recto":"Théorème de convergence dominée (Lebesgue) ?","verso":"Si fₙ → f p.p. et |fₙ| ≤ g avec g intégrable, alors :\nlim ∫fₙ = ∫f et ∫|fₙ-f| → 0\nPermet d'intervertir limite et intégrale.","tags":"Lebesgue;dominee;convergence","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Intégration de Lebesgue","type":"theorem","recto":"Théorème de Fubini-Tonelli ?","verso":"Si f est mesurable et ∫∫|f(x,y)|dxdy < ∞ :\n∫∫f(x,y)dxdy = ∫(∫f(x,y)dy)dx = ∫(∫f(x,y)dx)dy\nPermet d'intervertir les intégrales dans un produit cartésien.","tags":"Fubini;Tonelli;double;integrale","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Équations différentielles","type":"theorem","recto":"Théorème de Cauchy-Lipschitz (existence et unicité) ?","verso":"Si f(t,y) est continue et lipschitzienne en y sur un ouvert U :\n∀(t₀,y₀)∈U, l'EDO y' = f(t,y) avec y(t₀)=y₀ admet une unique solution maximale.\nConséquence : les courbes intégrales ne se croisent pas.","tags":"cauchy;lipschitz;EDO;existence","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Équations différentielles","type":"method","recto":"Résolution de y'' + py' + qy = 0 (EDO linéaire ordre 2 à coeff. constants) ?","verso":"1. Équation caractéristique : r² + pr + q = 0\n2. Si Δ > 0 : y = Ae^{r₁t} + Be^{r₂t}\n3. Si Δ = 0 : y = (A+Bt)e^{rt}\n4. Si Δ < 0 : y = e^{αt}(A cos βt + B sin βt) avec r = α±iβ","tags":"EDO;ordre2;caracteristique","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Analyse complexe","type":"definition","recto":"Équations de Cauchy-Riemann ?","verso":"f(z) = u(x,y) + iv(x,y) est holomorphe en z₀ ⟺\n∂u/∂x = ∂v/∂y  et  ∂u/∂y = -∂v/∂x\nf'(z) = ∂u/∂x + i∂v/∂x","tags":"cauchy;riemann;holomorphe","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Analyse complexe","type":"theorem","recto":"Formule de Cauchy ?","verso":"Si f holomorphe sur un ouvert U et γ contour simple dans U :\nf(a) = (1/2πi) ∮_γ f(z)/(z-a) dz\nEt : f^{(n)}(a) = (n!/2πi) ∮_γ f(z)/(z-a)^{n+1} dz","tags":"cauchy;formule;contour;integrale","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Analyse complexe","type":"theorem","recto":"Théorème des résidus ?","verso":"∮_γ f(z)dz = 2πi × Σ Res(f, aₖ)\nOù la somme porte sur les singularités isolées aₖ dans γ.\nRésidu en pôle simple : Res(f,a) = lim_{z→a}(z-a)f(z)","tags":"residus;pôle;integrale","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Structures algébriques","type":"definition","recto":"Groupe, anneau, corps — définitions ?","verso":"Groupe (G,·) : associativité, neutre, inverses.\nAnneau (A,+,×) : groupe abélien pour +, associativité et distributivité pour ×.\nCorps (K,+,×) : anneau où tout non-nul est inversible pour ×.","tags":"groupe;anneau;corps;structure","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Algèbre linéaire","type":"theorem","recto":"Théorème du rang ?","verso":"Pour f : E → F application linéaire :\ndim E = dim(Ker f) + dim(Im f)\nOu : rang(f) + nullité(f) = dim(E)","tags":"rang;noyau;image;theoreme","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Algèbre linéaire","type":"theorem","recto":"Diagonalisation d'un endomorphisme ?","verso":"f diagonalisable ⟺ le polynôme minimal est scindé à racines simples ⟺ E = ⊕ E_λ (somme des sous-espaces propres).\nAlgorithme : calculer χ_f, puis les E_λ, vérifier que Σ dim(E_λ) = n.","tags":"diagonalisation;valeurs;propres","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Algèbre linéaire","type":"theorem","recto":"Théorème spectral (endomorphisme symétrique réel) ?","verso":"Tout endomorphisme symétrique d'un espace euclidien est diagonalisable en base orthonormée.\nLes valeurs propres sont réelles, les sous-espaces propres sont deux à deux orthogonaux.","tags":"spectral;symetrique;orthogonal","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Algèbre linéaire","type":"definition","recto":"Déterminant — définition axiale et propriétés ?","verso":"det est l'unique forme n-linéaire alternée normalisée (det(Id)=1).\nPropriétés :\n• det(AB) = det(A)det(B)\n• det(A^T) = det(A)\n• A inversible ⟺ det(A) ≠ 0\n• Développement par cofacteurs : det(A) = Σ_j a_{ij}(-1)^{i+j}M_{ij}","tags":"determinant;multilineaire;inversible","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Probabilités","chapitre":"Probabilités","type":"definition","recto":"Espace probabilisé (Ω, 𝒜, P) ?","verso":"• Ω : espace des événements élémentaires\n• 𝒜 : tribu (σ-algèbre) sur Ω (stable par complémentaire et union dénombrable)\n• P : probabilité (σ-additive, P(Ω)=1)\nVariable aléatoire X : 𝒜-mesurable ℝ-valuée.","tags":"espace;probabilise;tribu;sigma","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Probabilités","chapitre":"Probabilités","type":"theorem","recto":"Loi des grands nombres forte ?","verso":"Si (Xₙ) i.i.d., E[|X₁|] < ∞ :\n(X₁+…+Xₙ)/n →_{p.s.} E[X₁]\nLa moyenne empirique converge presque sûrement vers l'espérance.","tags":"grands;nombres;forte;LGN","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Probabilités","chapitre":"Probabilités","type":"theorem","recto":"Théorème central limite (TCL) ?","verso":"Si (Xₙ) i.i.d., E[X₁]=μ, Var(X₁)=σ² < ∞ :\n√n(X̄ₙ - μ)/σ →_loi 𝒩(0,1)\nLa somme normalisée converge en loi vers une gaussienne.","tags":"TCL;central;limite;gaussienne","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Probabilités","chapitre":"Probabilités","type":"definition","recto":"Espérance, variance, covariance ?","verso":"E[X] = ∫ x dP_X(x)\nVar(X) = E[(X-μ)²] = E[X²] - E[X]²\nCov(X,Y) = E[(X-μ_X)(Y-μ_Y)] = E[XY] - E[X]E[Y]\nCorr(X,Y) = Cov(X,Y) / (σ_X σ_Y)","tags":"esperance;variance;covariance","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Arithmétique","type":"theorem","recto":"Théorème de Bezout et PGCD ?","verso":"PGCD(a,b) = d ⟺ ∃ u,v ∈ ℤ : au + bv = d (relation de Bezout)\na et b premiers entre eux ⟺ ∃ u,v : au + bv = 1 ⟺ PGCD(a,b) = 1.\nAlgorithme d'Euclide : PGCD(a,b) = PGCD(b, a mod b).","tags":"bezout;pgcd;euclide","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Algèbre","chapitre":"Arithmétique","type":"theorem","recto":"Petit théorème de Fermat ?","verso":"Si p premier et p ∤ a, alors a^{p-1} ≡ 1 (mod p).\nÉquivalent : a^p ≡ a (mod p) pour tout a.\nGénéralisation : théorème d'Euler : a^{φ(n)} ≡ 1 (mod n) si PGCD(a,n)=1.","tags":"fermat;petit;modulo;premier","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Géométrie","chapitre":"Géométrie différentielle","type":"definition","recto":"Variété différentielle — définition informelle ?","verso":"Espace localement homéomorphe à ℝⁿ, muni d'un atlas de cartes compatibles C∞.\nExemples : Sⁿ (sphère), GL(n,ℝ), espace projectif ℝPⁿ.\nLa dimension est celle de l'espace ambiant local.","tags":"variete;differentielle;atlas","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Géométrie","chapitre":"Géométrie différentielle","type":"definition","recto":"Courbure de Gauss d'une surface S ?","verso":"K = κ₁ × κ₂ (produit des courbures principales)\n• K > 0 : surface elliptique (sphère)\n• K = 0 : surface développable (cylindre, plan)\n• K < 0 : surface hyperbolique (selle)\nThéorème de Gauss-Bonnet : ∫∫_S K dA = 2π χ(S)","tags":"gauss;courbure;surface","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Transformées","type":"definition","recto":"Transformée de Fourier et ses propriétés clés ?","verso":"f̂(ξ) = ∫_{-∞}^{+∞} f(x) e^{-2πiξx} dx\nPropriétés :\n• Linéarité : F̂(f+g) = f̂+ĝ\n• Translation : F(f(·-a))(ξ) = e^{-2πiaξ}f̂(ξ)\n• Dérivation : F(f')(ξ) = 2πiξ f̂(ξ)\n• Convolution : F(f*g) = f̂·ĝ","tags":"fourier;transformee;convolution","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Analyse","chapitre":"Transformées","type":"theorem","recto":"Inégalité de Parseval / Plancherel ?","verso":"∫|f(x)|² dx = ∫|f̂(ξ)|² dξ\nLa transformée de Fourier est une isométrie de L²(ℝ).\nFormule d'inversion : f(x) = ∫f̂(ξ)e^{2πiξx} dξ (si f et f̂ ∈ L¹)","tags":"parseval;plancherel;L2;fourier","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.1 - Formes sesquilinéaires et espaces hermitiens","type":"definition","recto":"Qu'est-ce qu'une forme sesquilinéaire hermitienne sur ℂ ?","verso":"Une forme sesquilinéaire hermitienne (ou produit scalaire hermitien) sur ℂⁿ est une application φ : E×E → ℂ vérifiant :\n1. Semi-linéarité en 1er argument : φ(λx+y, z) = λ̄φ(x,z) + φ(y,z)\n2. Linéarité en 2e argument : φ(x, λy+z) = λφ(x,y) + φ(x,z)\n3. Hermitianité : φ(x,y) = φ(y,x)̄\n\nSi de plus φ(x,x) > 0 pour x ≠ 0 : c'est un produit scalaire hermitien.","tags":"sesquilinéaire;hermitien;complexe;produit scalaire","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.1 - Formes sesquilinéaires et espaces hermitiens","type":"theorem","recto":"Énoncer l'inégalité de Cauchy-Schwarz dans un espace hermitien.","verso":"Dans un espace hermitien (E, ⟨·,·⟩) :\n\n|⟨x, y⟩|² ≤ ⟨x,x⟩ · ⟨y,y⟩\n\nSoit |⟨x,y⟩| ≤ ‖x‖ · ‖y‖\n\nÉgalité ssi x et y sont colinéaires (l'un est multiple de l'autre).\n\nApplication : définit bien un angle entre vecteurs dans le cas réel (cos θ = ⟨x,y⟩/‖x‖‖y‖).","tags":"Cauchy-Schwarz;hermitien;inégalité;norme","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.2 - Groupes orthogonaux et unitaires","type":"definition","recto":"Définir les groupes O(n), SO(n), U(n) et SU(n).","verso":"O(n) = {M ∈ Mₙ(ℝ) | MᵀM = Iₙ} (matrices orthogonales réelles)\nSO(n) = {M ∈ O(n) | det(M) = +1} (rotations)\n\nU(n) = {M ∈ Mₙ(ℂ) | M*M = Iₙ} (matrices unitaires, M* = M̄ᵀ)\nSU(n) = {M ∈ U(n) | det(M) = +1}\n\nRelations : SO(n) ⊂ O(n), SU(n) ⊂ U(n), O(n) ⊂ U(n)","tags":"O(n);SO(n);U(n);SU(n);groupes;unitaire","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.2 - Groupes orthogonaux et unitaires","type":"theorem","recto":"Quelles sont les propriétés des matrices orthogonales (dans O(n)) ?","verso":"M ∈ O(n) ssi les colonnes de M forment une base orthonormée de ℝⁿ.\n\nÉquivalences :\n- MᵀM = Iₙ ⟺ MMᵀ = Iₙ ⟺ M⁻¹ = Mᵀ\n- ‖Mx‖ = ‖x‖ pour tout x (isométrie)\n- det(M) = ±1\n\nO(n) = rotations (det = +1) ∪ réflexions-rotations (det = -1)","tags":"orthogonale;isométrie;déterminant;propriétés","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.3 - Endomorphismes symétriques et normaux","type":"theorem","recto":"Énoncer le théorème spectral pour les endomorphismes symétriques réels.","verso":"Tout endomorphisme symétrique f d'un espace euclidien (E, ⟨·,·⟩) est diagonalisable dans une base orthonormée.\n\nAutrement dit : il existe une base orthonormée (e₁,...,eₙ) de E et des réels λ₁,...,λₙ tels que :\nf(eᵢ) = λᵢeᵢ\n\nToutes les valeurs propres sont réelles.\n\nVersion matricielle : toute matrice symétrique réelle est orthogonalement diagonalisable : M = PDP⁻¹ avec P orthogonale.","tags":"spectral;symétrique;diagonalisation;base orthonormée","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.3 - Endomorphismes symétriques et normaux","type":"definition","recto":"Qu'est-ce qu'un endomorphisme normal ? Propriétés.","verso":"f est normal si f∘f* = f*∘f (il commute avec son adjoint).\n\nClasse des opérateurs normaux sur ℂ : inclut\n- Les endomorphismes hermitiens (f = f*)\n- Les endomorphismes unitaires (f*f = ff* = Id)\n- Les endomorphismes anti-hermitiens (f* = -f)\n\nThéorème spectral : tout endomorphisme normal d'un espace hermitien est unitairement diagonalisable.","tags":"normal;adjoint;hermitien;diagonalisable","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.3 - Endomorphismes symétriques et normaux","type":"theorem","recto":"Qu'est-ce que la diagonalisation simultanée ? Quand est-elle possible ?","verso":"Deux endomorphismes symétriques f et g sont simultanément diagonalisables (dans une même base orthonormée) si et seulement si ils commutent :\nf∘g = g∘f\n\nDans ce cas, les sous-espaces propres de f sont stables par g, et on peut trouver une base orthonormée de vecteurs propres communs.\n\nApplication : systèmes quantiques, matrices de covariance commutantes.","tags":"simultanée;diagonalisation;commutation;symétrique","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.4 - Décomposition en valeurs singulières (SVD)","type":"theorem","recto":"Énoncer le théorème de décomposition en valeurs singulières (SVD).","verso":"Toute matrice A ∈ Mₘₓₙ(ℝ) admet une décomposition :\n\nA = UΣVᵀ\n\noù U ∈ O(m), V ∈ O(n), Σ matrice diagonale rectangulaire avec des σ₁ ≥ σ₂ ≥ ... ≥ 0 (valeurs singulières).\n\nσᵢ = √λᵢ où λᵢ sont les valeurs propres de AᵀA.\nLe rang de A = nombre de valeurs singulières non nulles.","tags":"SVD;valeurs singulières;décomposition;matrice","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.4 - Décomposition en valeurs singulières (SVD)","type":"method","recto":"Quelles sont les applications de la SVD ?","verso":"1. Compression d'images : garder les r plus grandes valeurs singulières (approximation de rang r)\n2. Pseudoinverse : A⁺ = VΣ⁺Uᵀ (résout au sens des moindres carrés)\n3. Rang et condition d'une matrice : κ(A) = σ₁/σₙ\n4. PCA (analyse en composantes principales) : SVD de la matrice de données centrée\n5. Résolution de systèmes linéaires mal conditionnés","tags":"SVD;applications;compression;pseudoinverse;PCA","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.5 - Produit vectoriel et géométrie de ℝ³","type":"definition","recto":"Définir le produit vectoriel dans ℝ³ et ses propriétés.","verso":"Pour u = (u₁,u₂,u₃) et v = (v₁,v₂,v₃) :\nu ∧ v = (u₂v₃-u₃v₂, u₃v₁-u₁v₃, u₁v₂-u₂v₁)\n\nPropriétés :\n- Antisymétrie : u ∧ v = -(v ∧ u)\n- Bilinéaire\n- ‖u ∧ v‖ = ‖u‖‖v‖|sin θ| (aire du parallélogramme)\n- u ∧ v ⊥ u et u ∧ v ⊥ v\n- u ∧ v = 0 ⟺ u et v colinéaires","tags":"produit vectoriel;ℝ³;antisymétrique;perpendiculaire","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.6 - Coniques et quadriques","type":"definition","recto":"Quelles sont les trois coniques non dégénérées et leurs équations réduites ?","verso":"Ellipse : x²/a² + y²/b² = 1 (a, b > 0, a ≠ b)\nCas particulier : cercle si a = b.\n\nHyperbole : x²/a² - y²/b² = 1\nDeux branches, asymptotes y = ±(b/a)x\n\nParabole : y² = 2px (p > 0)\n\nObtenues par intersection d'un cône et d'un plan (d'où \"coniques\"). Classification par le signe du discriminant de la forme quadratique.","tags":"coniques;ellipse;hyperbole;parabole","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.6 - Coniques et quadriques","type":"method","recto":"Comment classifier une quadrique en dimension 3 ?","verso":"Une quadrique est l'ensemble des points vérifiant Q(x,y,z) + L(x,y,z) + c = 0 où Q est quadratique.\n\nMéthode :\n1. Calculer la matrice symétrique A de la forme quadratique Q\n2. Diagonaliser A orthogonalement : trouver ses valeurs propres λ₁, λ₂, λ₃\n3. Dans la base propre, l'équation réduite révèle le type :\n   - Ellipsoïde, hyperboloïde (1 ou 2 nappes), paraboloïde (elliptique ou hyperbolique), cône...","tags":"quadrique;classification;valeurs propres;diagonalisation","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.7 - Polyèdres réguliers et groupes cristallographiques","type":"definition","recto":"Quels sont les 5 polyèdres réguliers convexes (solides de Platon) ?","verso":"1. Tétraèdre : 4 faces triangulaires équilatérales, 4 sommets, 6 arêtes\n2. Cube (hexaèdre) : 6 faces carrées, 8 sommets, 12 arêtes\n3. Octaèdre : 8 faces triangulaires, 6 sommets, 12 arêtes\n4. Dodécaèdre : 12 faces pentagonales, 20 sommets, 30 arêtes\n5. Icosaèdre : 20 faces triangulaires, 12 sommets, 30 arêtes\n\nFormule d'Euler : S - A + F = 2 (Sommets - Arêtes + Faces = 2)","tags":"Platon;polyèdre;tétraèdre;cube;octaèdre;Euler","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation - Maths","chapitre":"Ch.7 - Polyèdres réguliers et groupes cristallographiques","type":"definition","recto":"Qu'est-ce qu'un groupe cristallographique (groupe d'espace) ?","verso":"Un groupe cristallographique est un groupe discret d'isométries de ℝⁿ dont le quotient par le sous-groupe des translations est fini.\n\nEn dimension 2 : 17 groupes de symétrie de pavages (\"groupes wallpaper\")\nEn dimension 3 : 230 groupes d'espace (classifient toutes les structures cristallines)\n\nIls décrivent les symétries des cristaux : translations, rotations, réflexions, rotations hélicoïdales, plans glissants.","tags":"cristallographique;symétrie;groupe;cristal;pavage","niveau":"Agrégation","matiere":"Maths"},{"deck":"Agrégation — Mécanique","chapitre":"Mécanique analytique","type":"definition","recto":"Lagrangien L et équations de Lagrange ?","verso":"L(q, q̇, t) = T - V  (énergie cinétique - potentielle)\nÉquations d'Euler-Lagrange : d/dt(∂L/∂q̇ᵢ) - ∂L/∂qᵢ = 0\nEquivalent au principe de moindre action (Hamilton).","tags":"lagrangien;euler;Lagrange;analytique","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique","chapitre":"Mécanique analytique","type":"definition","recto":"Hamiltonien H et équations canoniques de Hamilton ?","verso":"H(q, p, t) = Σ pᵢq̇ᵢ - L  (transformée de Legendre de L)\nÉquations de Hamilton :\n• q̇ᵢ = ∂H/∂pᵢ\n• ṗᵢ = -∂H/∂qᵢ\n• dH/dt = ∂H/∂t (H conservé si H ne dépend pas explicitement de t)","tags":"hamiltonien;hamilton;canonique","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique","chapitre":"Mécanique analytique","type":"theorem","recto":"Théorème de Noether ?","verso":"À chaque symétrie continue du lagrangien correspond une quantité conservée.\nExemples :\n• Invariance par translation temporelle ⟹ conservation de l'énergie\n• Invariance par translation spatiale ⟹ conservation de la quantité de mouvement\n• Invariance par rotation ⟹ conservation du moment cinétique","tags":"noether;symetrie;conservation","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique","chapitre":"Mécanique analytique","type":"definition","recto":"Crochets de Poisson ?","verso":"{f, g} = Σ_i (∂f/∂qᵢ ∂g/∂pᵢ - ∂f/∂pᵢ ∂g/∂qᵢ)\nPropriétés : {qᵢ, pⱼ} = δᵢⱼ, {qᵢ, qⱼ} = {pᵢ, pⱼ} = 0\nÉvolution : df/dt = {f, H} + ∂f/∂t","tags":"Poisson;crochets;hamiltonien","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Électromagnétisme","chapitre":"Équations de Maxwell","type":"formula","recto":"Les 4 équations de Maxwell (forme locale) ?","verso":"• ∇·E⃗ = ρ/ε₀  (Gauss électrique)\n• ∇·B⃗ = 0  (Gauss magnétique, pas de monopôle)\n• ∇×E⃗ = -∂B⃗/∂t  (Faraday)\n• ∇×B⃗ = μ₀J⃗ + μ₀ε₀∂E⃗/∂t  (Maxwell-Ampère)","tags":"Maxwell;equations;EM","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Électromagnétisme","chapitre":"Équations de Maxwell","type":"formula","recto":"Équation de propagation des ondes EM dans le vide ?","verso":"□E⃗ = ∂²E⃗/∂t² - c²ΔE⃗ = 0\nAvec c = 1/√(μ₀ε₀) ≈ 3×10⁸ m/s\nDe même pour B⃗.\nSolution plane : E⃗ = E₀ cos(ωt - k⃗·r⃗ + φ) avec k = ω/c","tags":"onde;EM;propagation;Maxwell","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Électromagnétisme","chapitre":"Équations de Maxwell","type":"formula","recto":"Vecteur de Poynting et bilan d'énergie EM ?","verso":"S⃗ = (E⃗ × B⃗) / μ₀  [W/m²]\nÉnergie volumique : u = ε₀E²/2 + B²/(2μ₀)\nÉquation de Poynting : ∂u/∂t + ∇·S⃗ = -J⃗·E⃗\n(conservation de l'énergie EM)","tags":"Poynting;energie;EM;bilan","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Électromagnétisme","chapitre":"Potentiels et jauges","type":"definition","recto":"Potentiels scalaire V et vecteur A⃗ — relations avec E⃗ et B⃗ ?","verso":"B⃗ = ∇×A⃗\nE⃗ = -∇V - ∂A⃗/∂t\nJauge de Lorenz : ∇·A⃗ + (1/c²)∂V/∂t = 0\nJauge de Coulomb : ∇·A⃗ = 0","tags":"potentiels;vecteur;scalaire;jauge","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Thermodynamique","chapitre":"Thermodynamique classique","type":"theorem","recto":"1er et 2e principes de la thermodynamique ?","verso":"1er principe : ΔU = W + Q (conservation de l'énergie)\n• ΔU : variation d'énergie interne\n• W : travail reçu, Q : chaleur reçue\n\n2e principe : ΔS ≥ Q/T (S = entropie)\n• Processus réversible : ΔS = Q/T\n• Processus irréversible : ΔS > Q/T","tags":"principes;thermodynamique;entropie","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Thermodynamique","chapitre":"Thermodynamique classique","type":"formula","recto":"Potentiels thermodynamiques et relations de Maxwell thermo ?","verso":"• F = U - TS (énergie libre de Helmholtz)\n• G = H - TS = U + PV - TS (enthalpie libre)\n• dU = TdS - PdV, dF = -SdT - PdV\n• dG = -SdT + VdP\nRelations de Maxwell : (∂S/∂V)_T = (∂P/∂T)_V, etc.","tags":"potentiels;Maxwell;thermo;Helmholtz","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Thermodynamique","chapitre":"Physique statistique","type":"definition","recto":"Distribution de Boltzmann et partition ?","verso":"P(état i) = e^{-βεᵢ} / Z\navec Z = Σ e^{-βεᵢ} (fonction de partition), β = 1/(k_BT)\nÉnergie moyenne : <E> = -∂ln Z/∂β\nEntropie : S = k_B ln Ω (Boltzmann)","tags":"Boltzmann;partition;statistique","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Thermodynamique","chapitre":"Physique statistique","type":"definition","recto":"Distributions quantiques : Fermi-Dirac vs Bose-Einstein ?","verso":"• Fermi-Dirac (fermions, demi-entier) : <n_i> = 1/(e^{β(εᵢ-μ)}+1)\n  – Exclusion de Pauli : max 1 particule par état\n• Bose-Einstein (bosons, entier) : <n_i> = 1/(e^{β(εᵢ-μ)}-1)\n  – Condensation possible à T bas","tags":"Fermi;Dirac;Bose;Einstein;quantique","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique quantique","chapitre":"Postulats de la mécanique quantique","type":"definition","recto":"Postulats de la mécanique quantique ?","verso":"1. État = vecteur |ψ⟩ dans un espace de Hilbert ℋ\n2. Observables = opérateurs hermitiens\n3. Mesure : résultat = valeur propre ; probabilité ∝ |⟨aₙ|ψ⟩|²\n4. Après mesure : |ψ⟩ → |aₙ⟩ (réduction du paquet d'onde)\n5. Évolution : iℏ ∂|ψ⟩/∂t = Ĥ|ψ⟩ (Schrödinger)","tags":"postulats;quantique;Hilbert","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique quantique","chapitre":"Équation de Schrödinger","type":"formula","recto":"Équation de Schrödinger (dépendante et indépendante du temps) ?","verso":"Dépendante : iℏ ∂ψ/∂t = Ĥψ = (-ℏ²/2m ∇² + V)ψ\nStationnaire : Ĥψ = Eψ  (valeurs propres E)\nSolution : ψ(x,t) = φ(x)e^{-iEt/ℏ} pour un état stationnaire.","tags":"Schrodinger;equatdion;quantique","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique quantique","chapitre":"Principe d'incertitude","type":"theorem","recto":"Relation d'incertitude de Heisenberg ?","verso":"ΔxΔp ≥ ℏ/2\nΔEΔt ≥ ℏ/2\nConséquence du principe de commutation :\n[x̂, p̂] = iℏ\nLimite fondamentale de la précision de mesures simultanées.","tags":"Heisenberg;incertitude;commutation","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique quantique","chapitre":"Opérateurs en MQ","type":"definition","recto":"Représentation de Dirac (bra-ket) ?","verso":"• Ket |ψ⟩ : état quantique\n• Bra ⟨φ| : forme linéaire duale\n• Produit scalaire : ⟨φ|ψ⟩\n• Valeur moyenne : ⟨Â⟩ = ⟨ψ|Â|ψ⟩\n• Décomposition : |ψ⟩ = Σ cₙ|n⟩, cₙ = ⟨n|ψ⟩","tags":"Dirac;bra;ket;representation","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Relativité","chapitre":"Relativité restreinte","type":"definition","recto":"Postulats de la relativité restreinte (Einstein 1905) ?","verso":"1. Les lois de la physique sont identiques dans tous les référentiels galiléens.\n2. La vitesse de la lumière c est constante dans tous les référentiels galiléens.\nConséquences : dilatation du temps, contraction des longueurs, E = mc².","tags":"relativite;Einstein;postulats","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Relativité","chapitre":"Relativité restreinte","type":"formula","recto":"Transformation de Lorentz ?","verso":"t' = γ(t - vx/c²)\nx' = γ(x - vt)\ny' = y, z' = z\navec γ = 1/√(1-v²/c²) (facteur de Lorentz)\nInvariant : s² = c²t² - x² - y² - z² (intervalle espace-temps)","tags":"Lorentz;transformation;relativite","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Relativité","chapitre":"Relativité restreinte","type":"formula","recto":"Quadrivecteur énergie-impulsion, relation masse-énergie ?","verso":"E² = (pc)² + (mc²)²\nE = γmc² (énergie totale)\np = γmv (impulsion relativiste)\nAu repos : E₀ = mc² (énergie de masse)","tags":"energie;impulsion;relativiste;mc2","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Optique","chapitre":"Optique ondulatoire","type":"definition","recto":"Interférences à 2 ondes — condition de franges brillantes/sombres ?","verso":"Δ = d₂ - d₁ (différence de marche)\n• Brillantes (constructives) : Δ = kλ\n• Sombres (destructives) : Δ = (2k+1)λ/2\nInter-frange : i = λD/a (fentes d'Young, D distance, a écartement)","tags":"interference;Young;franges","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Optique","chapitre":"Optique ondulatoire","type":"definition","recto":"Diffraction — critère de Rayleigh ?","verso":"Un obstacle/ouverture de taille a produit une diffraction notable si λ/a ≥ 1.\nTache centrale de diffraction (ouverture circulaire) : θ ≈ 1.22λ/D\nCritère de Rayleigh pour la résolution : deux points résolus si leur séparation angulaire ≥ 1.22λ/D","tags":"diffraction;Rayleigh;resolution","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique des fluides","chapitre":"Mécanique des fluides","type":"formula","recto":"Équation de continuité et équation d'Euler ?","verso":"Continuité (incompressible) : ∇·v⃗ = 0\nEuler (fluide parfait) : ρ(∂v⃗/∂t + (v⃗·∇)v⃗) = -∇P + ρg⃗\nBernoulli (stationnaire, incompressible) : P + ½ρv² + ρgh = cste","tags":"Euler;Bernoulli;fluide;continuite","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Agrégation — Mécanique des fluides","chapitre":"Mécanique des fluides","type":"formula","recto":"Équation de Navier-Stokes ?","verso":"ρ(∂v⃗/∂t + (v⃗·∇)v⃗) = -∇P + η∇²v⃗ + ρg⃗\n• η : viscosité dynamique\nNombre de Reynolds : Re = ρvL/η\n• Re ≪ 1 : régime laminaire\n• Re ≫ 1 : régime turbulent","tags":"Navier;Stokes;viscosite;Reynolds","niveau":"Agrégation","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.1 - Vitesse et mouvement","type":"formula","recto":"Quelle est la formule de la vitesse moyenne ?","verso":"v = d / t\n\noù v est la vitesse (en m/s ou km/h), d la distance parcourue, t la durée du trajet.\n\nExemple : d = 100 m, t = 10 s → v = 10 m/s","tags":"vitesse;mouvement;formule","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.1 - Vitesse et mouvement","type":"definition","recto":"Comment convertir une vitesse de m/s en km/h ?","verso":"Multiplier par 3,6 : v(km/h) = v(m/s) × 3,6\n\nExemple : 10 m/s × 3,6 = 36 km/h\n\nInversement : diviser par 3,6 pour passer de km/h à m/s.","tags":"conversion;vitesse;unités","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.1 - Vitesse et mouvement","type":"definition","recto":"Qu'est-ce qu'un mouvement rectiligne uniforme ?","verso":"Un mouvement est rectiligne uniforme si :\n- La trajectoire est une ligne droite (rectiligne)\n- La vitesse est constante (uniforme)\n\nSur un chronophotogramme : les positions sont équidistantes et alignées.","tags":"mouvement;uniforme;trajectoire","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.1 - Vitesse et mouvement","type":"definition","recto":"Qu'est-ce qu'un mouvement rectiligne accéléré ?","verso":"Un mouvement rectiligne accéléré est un mouvement en ligne droite dont la vitesse augmente au cours du temps.\n\nSur un chronophotogramme : les intervalles entre positions successives sont de plus en plus grands.","tags":"mouvement;accéléré;chronophotogramme","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.1 - Vitesse et mouvement","type":"definition","recto":"Qu'est-ce qu'un mouvement rectiligne ralenti ?","verso":"Un mouvement rectiligne ralenti est un mouvement en ligne droite dont la vitesse diminue au cours du temps.\n\nSur un chronophotogramme : les intervalles entre positions successives sont de plus en plus petits.","tags":"mouvement;ralenti;décélération","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.1 - Vitesse et mouvement","type":"definition","recto":"Qu'est-ce qu'un chronophotogramme ?","verso":"Un chronophotogramme est une image qui montre les positions successives d'un objet en mouvement à intervalles de temps réguliers.\n\nIl permet d'analyser la trajectoire et de déterminer si le mouvement est uniforme, accéléré ou ralenti.","tags":"chronophotogramme;mouvement;analyse","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.2 - Distance d'arrêt","type":"formula","recto":"Quelle est la formule de la distance d'arrêt ?","verso":"dₐ = dᵣ + d_f\n\n- dₐ : distance d'arrêt totale\n- dᵣ : distance de réaction (parcourue pendant le temps de réaction)\n- d_f : distance de freinage\n\nLa distance d'arrêt augmente avec la vitesse et l'état de la route.","tags":"distance arrêt;freinage;sécurité","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.2 - Distance d'arrêt","type":"definition","recto":"Qu'est-ce que le temps de réaction ?","verso":"Le temps de réaction est la durée qui s'écoule entre la perception du danger par le conducteur et le moment où il appuie sur la pédale de frein.\n\nEn moyenne : 1 seconde. Augmente avec la fatigue, l'alcool, les drogues, les distracteurs (téléphone).","tags":"réaction;sécurité;temps","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.2 - Distance d'arrêt","type":"method","recto":"Comment calculer la distance de réaction ?","verso":"dᵣ = v × tᵣ\n\n- v : vitesse du véhicule (en m/s)\n- tᵣ : temps de réaction (en s)\n\nExemple : v = 20 m/s (72 km/h), tᵣ = 1 s → dᵣ = 20 m\n\nLa distance de réaction est proportionnelle à la vitesse.","tags":"réaction;distance;calcul","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Qu'est-ce qu'une interaction ?","verso":"Une interaction est une action réciproque entre deux objets : si A exerce une force sur B, alors B exerce une force sur A (principe des actions réciproques).\n\nL'interaction peut être de contact ou à distance.","tags":"interaction;force;réciprocité","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Quelles sont les deux catégories d'interactions ?","verso":"1. Interactions de contact : nécessitent un contact physique direct (ex : frottement, réaction normale du sol, tension d'un fil)\n\n2. Interactions à distance : s'exercent sans contact (ex : gravitation, force magnétique, force électrique)","tags":"contact;distance;interaction;types","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Qu'est-ce que le diagramme objet-interaction ?","verso":"Le diagramme objet-interaction (DOI) est un schéma qui représente :\n- L'objet étudié (au centre)\n- Tous les objets qui interagissent avec lui\n- Les flèches représentant chaque interaction\n\nIl permet d'identifier toutes les forces s'exerçant sur un objet.","tags":"DOI;diagramme;force;schéma","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Quelles sont les caractéristiques d'une force ?","verso":"Une force est caractérisée par :\n- Sa direction (la droite selon laquelle elle agit)\n- Son sens (le côté de la direction)\n- Sa valeur (son intensité, en Newtons N)\n- Son point d'application\n\nOn la représente par un vecteur (flèche).","tags":"force;vecteur;Newton;caractéristiques","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Qu'est-ce que le poids d'un objet ?","verso":"Le poids est la force d'attraction exercée par la Terre sur un objet.\n- Direction : verticale\n- Sens : vers le bas (vers le centre de la Terre)\n- Valeur : P = m × g\n  - m : masse en kg\n  - g ≈ 9,8 N/kg sur Terre\n\nUnité : Newton (N)","tags":"poids;gravité;masse;Terre","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Quelle est la différence entre masse et poids ?","verso":"Masse (m) :\n- Quantité de matière contenue dans un objet\n- Unité : kilogramme (kg)\n- Ne varie pas selon l'endroit\n\nPoids (P) :\n- Force exercée par la gravité\n- Unité : Newton (N)\n- Varie selon la planète (P = m × g)\n\nSur la Lune : g ≈ 1,6 N/kg, donc P est 6 fois plus faible.","tags":"masse;poids;différence;gravité","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Quand dit-on qu'un objet est en équilibre ?","verso":"Un objet est en équilibre (au repos ou en mouvement rectiligne uniforme) lorsque les forces qui s'exercent sur lui se compensent : leur somme vectorielle est nulle.\n\nExemple : livre posé sur une table → poids ↓ + réaction du support ↑ = équilibre.","tags":"équilibre;forces;compensation","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Qu'est-ce que la force de frottement ?","verso":"La force de frottement s'oppose au mouvement d'un objet. Elle agit dans le sens contraire au déplacement.\n\nExemples :\n- Frottement solide : entre deux surfaces en contact\n- Frottement fluide : résistance de l'air ou de l'eau\n\nElle transforme l'énergie cinétique en chaleur.","tags":"frottement;résistance;mouvement","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 4e - Physique-Chimie","chapitre":"Ch.3 - Forces et interactions","type":"definition","recto":"Qu'est-ce que la poussée d'Archimède ?","verso":"La poussée d'Archimède est une force exercée par un fluide (liquide ou gaz) sur tout objet immergé. Elle est dirigée vers le haut et vaut le poids du fluide déplacé.\n\nSi PA > Poids → l'objet flotte\nSi PA < Poids → l'objet coule","tags":"Archimède;flottaison;poussée;fluide","niveau":"Collège 4e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Qu'est-ce qu'une source primaire de lumière ?","verso":"Une source primaire (ou source lumineuse) est un objet qui produit lui-même de la lumière.\n\nExemples : le Soleil, une bougie, une ampoule allumée, les étoiles, les LED.\n\nÀ ne pas confondre avec les objets qui réfléchissent la lumière (lune, miroir).","tags":"source;lumière;primaire","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Qu'est-ce qu'un objet diffusant ?","verso":"Un objet diffusant reçoit de la lumière et la renvoie dans toutes les directions, ce qui le rend visible.\n\nExemples : la Lune, une feuille de papier, un mur blanc.\n\nIl ne produit pas sa propre lumière : c'est une source secondaire.","tags":"diffusion;lumière;objet","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Comment la lumière se propage-t-elle ?","verso":"La lumière se propage en ligne droite (propagation rectiligne) dans un milieu homogène et transparent.\n\nCela explique :\n- La formation des ombres\n- Les éclipses\n- Le fait qu'on ne voit pas autour des obstacles\n\nVitesse dans le vide : c ≈ 3×10⁸ m/s","tags":"propagation;rectiligne;lumière;vitesse","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Quelle est la différence entre un objet opaque, translucide et transparent ?","verso":"Opaque : ne laisse pas passer la lumière → ombre nette (ex : mur, métal)\n\nTranslucide : laisse passer la lumière de façon diffuse → pas d'image nette (ex : verre dépoli, papier calque)\n\nTransparent : laisse passer la lumière sans la diffuser → image nette (ex : verre clair, eau)","tags":"opaque;transparent;translucide;lumière","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Qu'est-ce qu'un rayon lumineux ? Qu'est-ce qu'un faisceau ?","verso":"Rayon lumineux : modèle représentant la direction de propagation de la lumière par une flèche en ligne droite.\n\nFaisceau lumineux : ensemble de rayons lumineux.\n- Faisceau parallèle (ex : laser)\n- Faisceau convergent (ex : loupe)\n- Faisceau divergent (ex : ampoule)","tags":"rayon;faisceau;lumière;modèle","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Comment se forme une ombre ?","verso":"L'ombre se forme parce que la lumière se propage en ligne droite et ne peut pas contourner les objets opaques.\n\n- Zone d'ombre : zone ne recevant aucun rayon lumineux direct\n- Pénombre : zone ne recevant qu'une partie de la lumière (source étendue)\n\nLa taille de l'ombre dépend de la distance source-objet-écran.","tags":"ombre;pénombre;opaque;lumière","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.1 - La lumière","type":"definition","recto":"Pourquoi voit-on un objet ?","verso":"On voit un objet parce que la lumière qu'il émet (source primaire) ou qu'il diffuse (objet diffusant) entre dans nos yeux.\n\nDans le noir total, sans lumière → on ne voit rien.\n\nL'œil reçoit la lumière mais ne l'émet pas.","tags":"vision;œil;lumière;diffusion","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Quelles sont les caractéristiques du mouvement de la Terre ?","verso":"Rotation sur elle-même :\n- Durée : 24 heures\n- Axe incliné de 23,4° par rapport à la verticale de l'écliptique\n- Cause : alternance jour/nuit\n\nRévolution autour du Soleil :\n- Durée : 365,25 jours (1 an)\n- Cause : alternance des saisons","tags":"Terre;rotation;révolution;saisons","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Pourquoi y a-t-il des saisons sur Terre ?","verso":"Les saisons sont dues à l'inclinaison de l'axe de rotation terrestre (23,4°) par rapport au plan de l'écliptique.\n\nEn été (hémisphère Nord) : le Soleil est plus haut → jours plus longs, rayonnement plus intense.\nEn hiver : le Soleil est plus bas → jours plus courts, rayonnement moins intense.\n\nCe n'est pas dû à la distance Terre-Soleil.","tags":"saisons;inclinaison;hémisphère;Soleil","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Qu'est-ce que les phases de la Lune ?","verso":"Les phases de la Lune correspondent aux différents aspects de la partie éclairée de la Lune visible depuis la Terre.\n\nCycle complet : ≈ 29,5 jours (lunaison)\nPhases principales : Nouvelle Lune → Premier Quartier → Pleine Lune → Dernier Quartier\n\nLa Lune ne produit pas de lumière : elle reflète celle du Soleil.","tags":"Lune;phases;lunaison;éclairage","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Comment se produit une éclipse de Soleil ?","verso":"Une éclipse de Soleil se produit lors d'une nouvelle Lune, quand la Lune se trouve entre la Terre et le Soleil et projette son ombre sur la Terre.\n\n- Éclipse totale : dans la zone d'ombre de la Lune\n- Éclipse partielle : dans la pénombre\n\nElle n'a pas lieu à chaque nouvelle Lune car les orbites sont inclinées.","tags":"éclipse;Soleil;Lune;ombre","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Comment se produit une éclipse de Lune ?","verso":"Une éclipse de Lune se produit lors d'une pleine Lune, quand la Terre est entre le Soleil et la Lune, projetant son ombre sur la Lune.\n\nLa Lune peut prendre une teinte rouge (\"Lune de sang\") car l'atmosphère terrestre dévie la lumière rouge vers la Lune.","tags":"éclipse;Lune;Terre;ombre","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Quelles sont les planètes du système solaire dans l'ordre ?","verso":"Dans l'ordre croissant de distance au Soleil :\n1. Mercure\n2. Vénus\n3. Terre\n4. Mars\n5. Jupiter\n6. Saturne\n7. Uranus\n8. Neptune\n\nMoyen mémo : \"Ma Vieille Terre Ma Jolie Sœur Un Nuage\"","tags":"planètes;système solaire;ordre","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Quelle est la différence entre planètes telluriques et planètes gazeuses ?","verso":"Planètes telluriques (rocheuses) :\nMercure, Vénus, Terre, Mars\n→ Surface solide, petite taille, proches du Soleil\n\nPlanètes gazeuses (joviennes) :\nJupiter, Saturne, Uranus, Neptune\n→ Principalement de gaz (H₂, He), grandes, plus éloignées\n\nSaturne et Jupiter ont des anneaux visibles.","tags":"tellurique;gazeuse;planète;composition","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Qu'est-ce qu'une année-lumière ?","verso":"L'année-lumière est l'unité de distance utilisée en astronomie.\n\nDéfinition : distance parcourue par la lumière en 1 an\n1 a.l. ≈ 9 461 milliards de km (9,461 × 10¹² km)\n\nExemple : l'étoile la plus proche (Proxima Centauri) est à ≈ 4,2 a.l. du Soleil.","tags":"année-lumière;distance;astronomie;unité","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Qu'est-ce qu'une galaxie ? Dans quelle galaxie sommes-nous ?","verso":"Une galaxie est un ensemble immense d'étoiles (des milliards), de gaz, de poussières et de matière noire, lié par la gravitation.\n\nNotre galaxie : la Voie Lactée\n- Environ 200 milliards d'étoiles\n- Diamètre ≈ 100 000 a.l.\n- Forme spirale\n\nGalaxie voisine : Andromède (à ≈ 2,5 millions a.l.)","tags":"galaxie;Voie Lactée;étoiles;univers","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Qu'est-ce qu'un superamas de galaxies ?","verso":"Un superamas de galaxies est un groupement de plusieurs amas de galaxies, formant les plus grandes structures connues de l'Univers.\n\nNotre superamas : Laniakea (\"ciel immense\" en hawaïen)\n- Contient la Voie Lactée et des centaines d'autres galaxies\n- Diamètre ≈ 520 millions d'a.l.","tags":"superamas;galaxies;Laniakea;univers","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Collège 5e - Physique-Chimie","chapitre":"Ch.2 - La Terre dans l'Univers","type":"definition","recto":"Quel est le rôle de l'atmosphère terrestre ?","verso":"L'atmosphère terrestre (couche de gaz entourant la Terre) a plusieurs rôles :\n1. Protection contre les rayons UV du Soleil (couche d'ozone)\n2. Régulation thermique (effet de serre naturel)\n3. Permet la vie (O₂ pour respirer)\n4. Brûle la plupart des météorites\n\nComposition principale : N₂ (78%), O₂ (21%), Ar, CO₂...","tags":"atmosphère;protection;ozone;Terre","niveau":"Collège 5e","matiere":"Physique-Chimie"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.1 - Sommes et produits","type":"formula","recto":"Quelle est la formule de la somme des entiers de 1 à n ?","verso":"5\sum_{k=1}^{n} k = \frac{n(n+1)}{2}5\n\nExemple : 1+2+3+...+100 = 100×101/2 = 5050\n\nDémonstration classique : pair la somme S avec S inversée.","tags":"somme;entiers;formule","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.1 - Sommes et produits","type":"formula","recto":"Quelle est la formule de la somme des carrés de 1 à n ?","verso":"5\sum_{k=1}^{n} k^2 = \frac{n(n+1)(2n+1)}{6}5\n\nExemple : 1²+2²+3²+4² = 4×5×9/6 = 30\n\nSe prouve par récurrence ou par méthode télescopique sur k³.","tags":"somme;carrés;formule;récurrence","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.1 - Sommes et produits","type":"formula","recto":"Quelle est la somme géométrique (suite géométrique de raison q) ?","verso":"5\sum_{k=0}^{n} q^k = \frac{1-q^{n+1}}{1-q} \quad (q \neq 1)5\n\nSi q = 1 : somme = n+1\n\nAstuces : factoriser 1-q^(n+1) = (1-q)(1+q+...+q^n)","tags":"géométrique;suite;somme;formule","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.1 - Sommes et produits","type":"method","recto":"Qu'est-ce qu'une somme télescopique ? Comment la calculer ?","verso":"Une somme télescopique est de la forme Σ(f(k+1) - f(k)) dont la plupart des termes s'annulent.\n\n5\sum_{k=1}^{n}(f(k+1)-f(k)) = f(n+1) - f(1)5\n\nExemple : Σ(1/k - 1/(k+1)) = 1 - 1/(n+1)\n\nTechnique : écrire les premiers et derniers termes pour voir les simplifications.","tags":"télescopique;somme;technique;simplification","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.1 - Sommes et produits","type":"formula","recto":"Quelle est la formule du coefficient binomial C(n,k) ?","verso":"5\binom{n}{k} = \frac{n!}{k!(n-k)!}5\n\nPropriétés :\n- C(n,0) = C(n,n) = 1\n- C(n,k) = C(n,n-k) (symétrie)\n- C(n,k) + C(n,k+1) = C(n+1,k+1) (Pascal)","tags":"binomial;coefficient;Pascal;combinatoire","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.1 - Sommes et produits","type":"theorem","recto":"Énoncer le théorème du binôme de Newton.","verso":"5(a+b)^n = \sum_{k=0}^{n} \binom{n}{k} a^k b^{n-k}5\n\nCas particuliers :\n- (1+x)^n = Σ C(n,k) x^k\n- (a-b)^n = Σ C(n,k) a^k (-b)^(n-k)\n\nEn posant x=1 : 2^n = Σ C(n,k)","tags":"Newton;binôme;développement;formule","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.2 - Logique et raisonnement","type":"definition","recto":"Quelles sont les tables de vérité de ¬, ∧, ∨, ⟹ ?","verso":"Négation ¬P : F si P vrai, V si P faux\n\nConjonction P∧Q : V ssi P et Q tous les deux vrais\n\nDisjonction P∨Q : V ssi au moins l'un est vrai\n\nImplication P⟹Q : FAUSSE seulement si P vrai et Q faux\n(F⟹Q est toujours vraie : \"ex falso quodlibet\")","tags":"logique;connecteurs;table;vérité","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.2 - Logique et raisonnement","type":"definition","recto":"Quelle est la contraposée de P⟹Q ? Quand l'utilise-t-on ?","verso":"La contraposée de (P⟹Q) est (¬Q⟹¬P).\n\nElles sont logiquement équivalentes : P⟹Q ⟺ ¬Q⟹¬P\n\nOn utilise la contraposée quand il est plus facile de montrer ¬Q⟹¬P que P⟹Q directement.\n\nNe pas confondre avec la réciproque (Q⟹P), qui n'est pas équivalente.","tags":"contraposée;implication;équivalence;logique","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.2 - Logique et raisonnement","type":"method","recto":"Quels sont les principaux modes de démonstration en mathématiques ?","verso":"1. Déduction directe : chaîne de raisonnements logiques\n2. Contraposée : montrer ¬Q⟹¬P plutôt que P⟹Q\n3. Absurde : supposer ¬P et en déduire une contradiction\n4. Récurrence : P(0) vrai + P(n)⟹P(n+1)\n5. Contre-exemple : trouver un cas où la propriété est fausse\n6. Cas particuliers : disjonction de cas exhaustive","tags":"démonstration;méthode;récurrence;absurde","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.2 - Logique et raisonnement","type":"method","recto":"Comment fonctionne une démonstration par récurrence ?","verso":"Principe de récurrence : pour démontrer P(n) pour tout n ≥ n₀\n\n1. Initialisation : vérifier P(n₀)\n2. Hérédité : supposer P(n) vraie (hypothèse de récurrence) et démontrer P(n+1)\n3. Conclusion : par le principe de récurrence, P(n) est vraie pour tout n ≥ n₀\n\nVariante : récurrence forte (on suppose P(k) pour tout k ≤ n).","tags":"récurrence;démonstration;initialisation;hérédité","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.2 - Logique et raisonnement","type":"definition","recto":"Quelle est la négation de ∀x, P(x) et de ∃x, P(x) ?","verso":"Négation du quantificateur universel :\n¬(∀x, P(x)) ⟺ ∃x, ¬P(x)\n\nNégation du quantificateur existentiel :\n¬(∃x, P(x)) ⟺ ∀x, ¬P(x)\n\nRègle : la négation échange ∀ et ∃, et nie le prédicat.\n\nExemple : ¬(∀x>0, f(x)>0) ⟺ ∃x>0, f(x)≤0","tags":"quantificateur;négation;logique;universel","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.3 - Nombres complexes","type":"definition","recto":"Quelle est la forme trigonométrique (polaire) d'un nombre complexe ?","verso":"z = r(cos θ + i sin θ) = r e^(iθ)\n\n- r = |z| = √(a²+b²) : module de z\n- θ = arg(z) : argument de z (angle en radians)\n\nFormule d'Euler : e^(iθ) = cos θ + i sin θ\n\nCas particuliers : e^(iπ) = -1, e^(iπ/2) = i","tags":"complexe;polaire;module;argument;Euler","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.3 - Nombres complexes","type":"formula","recto":"Quelles sont les formules de cos θ et sin θ à partir de l'exponentielle complexe ?","verso":"5\cos\theta = \frac{e^{i\theta}+e^{-i\theta}}{2}, \quad \sin\theta = \frac{e^{i\theta}-e^{-i\theta}}{2i}5\n\nFormules de Moivre : (e^(iθ))^n = e^(inθ) = cos(nθ) + i sin(nθ)\n\nUtile pour linéariser cos^n et sin^n.","tags":"Euler;cos;sin;linéarisation;complexe","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.3 - Nombres complexes","type":"method","recto":"Comment trouver les racines n-ièmes de l'unité ?","verso":"Les racines n-ièmes de l'unité sont les solutions de z^n = 1 :\n\nωₖ = e^(2iπk/n) pour k = 0, 1, ..., n-1\n\nElles sont régulièrement espacées sur le cercle unité, toutes séparées de 2π/n.\n\nLeur somme vaut 0 (pour n ≥ 2).\nLeur produit vaut (-1)^(n+1).","tags":"racines;unité;complexe;cercle","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.4 - Arithmétique","type":"theorem","recto":"Énoncer le théorème de Bézout sur le PGCD.","verso":"Théorème de Bézout : si d = pgcd(a, b), il existe des entiers relatifs u, v tels que :\nau + bv = d\n\nCorollaire : a et b sont premiers entre eux (pgcd = 1) si et seulement si il existe u, v tels que au + bv = 1.\n\nOn trouve u, v par l'algorithme d'Euclide étendu.","tags":"Bézout;PGCD;arithmétique;entiers","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.4 - Arithmétique","type":"theorem","recto":"Énoncer le lemme de Gauss.","verso":"Lemme de Gauss : si a divise bc et si pgcd(a, b) = 1, alors a divise c.\n\nAutrement dit : si a est premier avec b, et que a|bc, alors a|c.\n\nCas particulier : si p est premier et p|ab, alors p|a ou p|b.","tags":"Gauss;divisibilité;premier;arithmétique","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.4 - Arithmétique","type":"theorem","recto":"Énoncer le petit théorème de Fermat.","verso":"Si p est un nombre premier et si a est un entier non divisible par p, alors :\naᵖ⁻¹ ≡ 1 (mod p)\n\nÉquivalent : aᵖ ≡ a (mod p) pour tout entier a.\n\nApplication : calcul rapide de a^n mod p (ex : réduire l'exposant mod p-1).","tags":"Fermat;congruence;premier;modulo","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.4 - Arithmétique","type":"definition","recto":"Qu'est-ce qu'une congruence modulo n ? Propriétés.","verso":"a ≡ b (mod n) signifie que n divise (a - b).\n\nPropriétés (compatibilité) :\n- a≡b et c≡d ⟹ a+c ≡ b+d (mod n)\n- a≡b et c≡d ⟹ ac ≡ bd (mod n)\n- a≡b ⟹ aᵏ ≡ bᵏ (mod n)\n\nAttention : on ne peut pas toujours simplifier par division.","tags":"congruence;modulo;arithmétique;propriétés","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.5 - Polynômes","type":"theorem","recto":"Énoncer le théorème de division euclidienne des polynômes.","verso":"Soient A, B ∈ K[X] avec B ≠ 0. Il existe un unique couple (Q, R) tel que :\nA = BQ + R avec deg(R) < deg(B)\n\n- Q : quotient\n- R : reste\n\nSi R = 0, on dit que B divise A.\nCas particulier : si B = X - a, R = A(a) (théorème de Ruffini).","tags":"euclidienne;polynôme;division;reste","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.5 - Polynômes","type":"theorem","recto":"Qu'est-ce qu'une racine d'un polynôme ? Que peut-on dire de sa multiplicité ?","verso":"a est une racine de P si P(a) = 0, ce qui équivaut à (X-a) | P.\n\nMultiplicité m de la racine a : (X-a)^m | P mais (X-a)^(m+1) ∤ P.\n\nCaractérisation : a est racine de multiplicité ≥ m ssi P(a) = P'(a) = ... = P^(m-1)(a) = 0.\n\nUn polynôme de degré n a au plus n racines (comptées avec multiplicité).","tags":"racine;multiplicité;polynôme;factorisation","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.5 - Polynômes","type":"formula","recto":"Quelle est la formule de Taylor pour les polynômes ?","verso":"5P(X) = \sum_{k=0}^{n} \frac{P^{(k)}(a)}{k!}(X-a)^k5\n\noù P^(k) est la dérivée k-ième de P.\n\nC'est le développement de P en puissances de (X-a).\nCas a=0 : développement en puissances de X (forme habituelle).","tags":"Taylor;polynôme;dérivée;développement","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.6 - Applications entre ensembles","type":"definition","recto":"Définir injection, surjection et bijection.","verso":"f : E → F\n\nInjective : ∀x,y∈E, f(x)=f(y) ⟹ x=y (chaque image a au plus un antécédent)\n\nSurjective : ∀y∈F, ∃x∈E, f(x)=y (tout élément de F est atteint)\n\nBijective : injective ET surjective (correspondance parfaite 1-1)\n\nSi f bijective, f admet une réciproque f⁻¹.","tags":"injection;surjection;bijection;application","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.6 - Applications entre ensembles","type":"method","recto":"Comment prouver qu'une fonction est injective ? Surjective ?","verso":"Injectivité : supposer f(x) = f(y) et montrer x = y\nOu montrer la contraposée : x ≠ y ⟹ f(x) ≠ f(y)\n\nSurjectivité : soit y ∈ F, trouver explicitement x ∈ E tel que f(x) = y\n\nBijectivité : montrer les deux, ou construire directement f⁻¹ et vérifier f∘f⁻¹ = Id_F et f⁻¹∘f = Id_E","tags":"preuve;injection;surjection;méthode","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.7 - Fonctions et continuité","type":"theorem","recto":"Énoncer le théorème des valeurs intermédiaires (TVI).","verso":"Si f est continue sur [a, b] et si y est compris entre f(a) et f(b) (i.e. f(a) ≤ y ≤ f(b) ou f(b) ≤ y ≤ f(a)), alors il existe c ∈ [a,b] tel que f(c) = y.\n\nCorollaire : si f est continue sur [a,b] et f(a)×f(b) < 0, alors f s'annule sur ]a,b[ (au moins une racine).","tags":"TVI;valeurs intermédiaires;continuité;racine","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.7 - Fonctions et continuité","type":"theorem","recto":"Énoncer le théorème des bornes (Weierstrass).","verso":"Si f est continue sur un segment [a, b] (compact), alors f est bornée et atteint ses bornes.\n\nAutrement dit : il existe m, M ∈ [a,b] tels que :\n∀x ∈ [a,b], f(m) ≤ f(x) ≤ f(M)\n\nf atteint donc un minimum et un maximum sur [a,b].","tags":"Weierstrass;bornes;compact;minimum;maximum","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.7 - Fonctions et continuité","type":"definition","recto":"Quelles sont les dérivées des fonctions usuelles à connaître ?","verso":"(xⁿ)' = nxⁿ⁻¹\n(eˣ)' = eˣ\n(ln x)' = 1/x (x > 0)\n(sin x)' = cos x\n(cos x)' = -sin x\n(tan x)' = 1/cos²x = 1 + tan²x\n(arcsin x)' = 1/√(1-x²)\n(arccos x)' = -1/√(1-x²)\n(arctan x)' = 1/(1+x²)\n(sh x)' = ch x, (ch x)' = sh x","tags":"dérivées;fonctions;usuelles;formules","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.7 - Fonctions et continuité","type":"definition","recto":"Quelles sont les fonctions hyperboliques sh, ch, th et leurs propriétés ?","verso":"sh x = (eˣ - e⁻ˣ)/2, ch x = (eˣ + e⁻ˣ)/2, th x = sh x / ch x\n\nIdentité fondamentale : ch²x - sh²x = 1\n\nDérivées : sh' = ch, ch' = sh, th' = 1 - th² = 1/ch²\n\nParité : sh impaire, ch paire, th impaire\n\nAnalogue aux trig. avec l'identité hyperbolique plutôt que ch²+sh²=1.","tags":"hyperbolique;sh;ch;th;identité","niveau":"Licence L1","matiere":"Maths"},{"deck":"Licence L1 - Mathématiques","chapitre":"Ch.7 - Fonctions et continuité","type":"method","recto":"Comment calculer une limite par équivalents ou développement limité ?","verso":"Équivalents classiques (x→0) :\nsin x ∼ x, tan x ∼ x, arcsin x ∼ x, arctan x ∼ x\neˣ - 1 ∼ x, ln(1+x) ∼ x\n1 - cos x ∼ x²/2, sh x ∼ x, ch x - 1 ∼ x²/2\n(1+x)^α - 1 ∼ αx\n\nMéthode : remplacer chaque facteur par son équivalent et simplifier.","tags":"limite;équivalent;DL;développement","niveau":"Licence L1","matiere":"Maths"},{"deck":"Anglais — Vocabulaire","chapitre":"Salutations & Présentations","type":"text","recto":"Hello / Hi / Good morning / Good evening","verso":"Bonjour / Salut / Bonjour (matin) / Bonsoir\n\nExemples :\n• Hello! How are you? → Bonjour ! Comment allez-vous ?\n• Hi! Nice to meet you. → Salut ! Enchanté(e).\n• Good morning, everyone! → Bonjour à tous !","tags":"salutation;présentation;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Salutations & Présentations","type":"text","recto":"What is your name? / My name is...","verso":"Comment t'appelles-tu ? / Je m'appelle...\n\nVariantes :\n• What's your name? (informel)\n• My name is Emma. I'm 15 years old.\n• Nice to meet you! → Ravi(e) de te rencontrer !","tags":"prénom;présentation;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Salutations & Présentations","type":"text","recto":"Where are you from? / I'm from France.","verso":"D'où viens-tu ? / Je viens de France.\n\nPays fréquents :\n• France → French\n• Spain → Spanish\n• Germany → German\n• England → English\n• USA → American\n\nI'm French. → Je suis français(e).","tags":"nationalité;pays;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Salutations & Présentations","type":"text","recto":"How old are you? / I am ... years old.","verso":"Quel âge as-tu ? / J'ai ... ans.\n\nExemples :\n• I'm sixteen. → J'ai seize ans.\n• She is twelve years old. → Elle a douze ans.\n• He turns eighteen next month. → Il a 18 ans le mois prochain.","tags":"âge;chiffres;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Famille","type":"text","recto":"La famille en anglais (membres essentiels)","verso":"father / dad → père\nmother / mum → mère\nbrother → frère\nsister → sœur\ngrandfather / grandpa → grand-père\ngrandmother / grandma → grand-mère\nuncle → oncle | aunt → tante\ncousin → cousin(e)\nson → fils | daughter → fille","tags":"famille;parents;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Famille","type":"text","recto":"How many brothers and sisters do you have?","verso":"Combien de frères et sœurs as-tu ?\n\nRéponses :\n• I have one brother and two sisters.\n• I'm an only child. → Je suis enfant unique.\n• I have no siblings. → Je n'ai pas de frères/sœurs.\n\nsibling → frère ou sœur (terme générique)","tags":"famille;fratrie;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Corps humain","type":"text","recto":"Le corps humain (parties principales)","verso":"head → tête | face → visage\neye(s) → œil/yeux | ear(s) → oreille(s)\nnose → nez | mouth → bouche\nneck → cou | shoulder → épaule\narm → bras | hand → main\nleg → jambe | foot/feet → pied/pieds\nheart → cœur | back → dos","tags":"corps;anatomie;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Corps humain","type":"text","recto":"I have a headache. / I feel sick.","verso":"J'ai mal à la tête. / Je me sens malade.\n\nVocabulaire santé :\n• I have a stomachache. → J'ai mal au ventre.\n• I have a cold. → J'ai un rhume.\n• I have a fever. → J'ai de la fièvre.\n• I feel better. → Je me sens mieux.\n• doctor → médecin | hospital → hôpital","tags":"santé;maladie;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"École & Fournitures","type":"text","recto":"L'école en anglais (vocabulaire essentiel)","verso":"school → école | classroom → salle de classe\nteacher → professeur | student → élève\nblackboard → tableau | notebook → cahier\npen → stylo | pencil → crayon\nruler → règle | eraser → gomme\nhomework → devoirs | lesson → leçon\nexam → examen | grade → note","tags":"école;fournitures;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"École & Fournitures","type":"text","recto":"Les matières scolaires en anglais","verso":"maths → mathématiques\nscience → sciences\nhistory → histoire\ngeography → géographie\nEnglish → anglais (cours de)\nFrench → français\nphysics → physique\nchemistry → chimie\nbiology → biologie\nart → arts plastiques\nmusic → musique\nphysical education (P.E.) → sport/EPS","tags":"matières;école;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nourriture & Boissons","type":"text","recto":"La nourriture en anglais (aliments du quotidien)","verso":"bread → pain | butter → beurre\ncheese → fromage | egg → œuf\nmeat → viande | chicken → poulet\nfish → poisson | rice → riz\npasta → pâtes | salad → salade\nfruit → fruit | vegetable → légume\ncake → gâteau | chocolate → chocolat","tags":"nourriture;aliments;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nourriture & Boissons","type":"text","recto":"Les boissons et repas en anglais","verso":"water → eau | juice → jus\nmilk → lait | tea → thé | coffee → café\nbreakfast → petit-déjeuner\nlunch → déjeuner\ndinner → dîner\nI'm hungry. → J'ai faim.\nI'm thirsty. → J'ai soif.\nCan I have...? → Est-ce que je peux avoir... ?","tags":"boissons;repas;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Couleurs & Nombres","type":"text","recto":"Les couleurs en anglais","verso":"red → rouge | blue → bleu\ngreen → vert | yellow → jaune\nblack → noir | white → blanc\ngrey → gris | orange → orange\npink → rose | purple → violet\nbrown → marron | light blue → bleu clair\ndark green → vert foncé","tags":"couleurs;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Couleurs & Nombres","type":"text","recto":"Les nombres en anglais (1–20 + dizaines)","verso":"1 one | 2 two | 3 three | 4 four | 5 five\n6 six | 7 seven | 8 eight | 9 nine | 10 ten\n11 eleven | 12 twelve | 13 thirteen | 14 fourteen\n15 fifteen | 16 sixteen | 17 seventeen | 18 eighteen\n19 nineteen | 20 twenty\n30 thirty | 40 forty | 50 fifty\n60 sixty | 70 seventy | 80 eighty | 90 ninety | 100 one hundred","tags":"nombres;chiffres;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Maison & Mobilier","type":"text","recto":"La maison en anglais (pièces)","verso":"house → maison | flat/apartment → appartement\nliving room → salon | bedroom → chambre\nkitchen → cuisine | bathroom → salle de bain\ntoilet → toilettes | garden → jardin\nstairs → escaliers | floor → étage\nground floor → rez-de-chaussée\nfirst floor → premier étage (en anglais brit.)","tags":"maison;pièces;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Maison & Mobilier","type":"text","recto":"Les meubles et objets de la maison","verso":"bed → lit | table → table | chair → chaise\nsofa/couch → canapé | wardrobe → armoire\nshelf → étagère | window → fenêtre\ndoor → porte | lamp → lampe\ntelevision/TV → télévision\ncomputer → ordinateur | phone → téléphone\nfridge → réfrigérateur | oven → four","tags":"mobilier;maison;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Transports & Voyages","type":"text","recto":"Les transports en anglais","verso":"car → voiture | bus → bus\ntrain → train | plane → avion\nboat → bateau | bike/bicycle → vélo\nmotorbike → moto | taxi → taxi\nunderground/subway → métro\nstation → gare | airport → aéroport\nticket → billet | journey → trajet","tags":"transports;voyages;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Transports & Voyages","type":"text","recto":"Phrases utiles en voyage (anglais)","verso":"Where is the station? → Où est la gare ?\nHow much is a ticket to...? → Combien coûte un billet pour... ?\nCan you help me? → Pouvez-vous m'aider ?\nI'm lost. → Je suis perdu(e).\nTurn left/right. → Tourne à gauche/droite.\nGo straight ahead. → Allez tout droit.\nExcuse me! → Excusez-moi !","tags":"voyage;directions;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Météo & Nature","type":"text","recto":"La météo en anglais","verso":"sunny → ensoleillé | cloudy → nuageux\nrainy → pluvieux | windy → venteux\nsnowy → neigeux | foggy → brumeux\nhot → chaud | cold → froid | warm → tiède\nWhat's the weather like? → Quel temps fait-il ?\nIt's raining. → Il pleut.\nIt's snowing. → Il neige.\nIt's sunny! → Il fait soleil !","tags":"météo;temps;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Temps : jours, mois, saisons","type":"text","recto":"Les jours de la semaine en anglais","verso":"Monday → lundi | Tuesday → mardi\nWednesday → mercredi | Thursday → jeudi\nFriday → vendredi | Saturday → samedi\nSunday → dimanche\n\n⚠️ En anglais, les jours prennent une majuscule.\n\nToday is Monday. → Aujourd'hui, c'est lundi.\nWhat day is it? → Quel jour sommes-nous ?","tags":"jours;semaine;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Temps : jours, mois, saisons","type":"text","recto":"Les mois de l'année en anglais","verso":"January → janvier | February → février\nMarch → mars | April → avril\nMay → mai | June → juin\nJuly → juillet | August → août\nSeptember → septembre | October → octobre\nNovember → novembre | December → décembre\n\nMy birthday is in July. → Mon anniversaire est en juillet.","tags":"mois;année;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Temps : jours, mois, saisons","type":"text","recto":"Les saisons et le temps en anglais","verso":"spring → printemps | summer → été\nautumn/fall → automne | winter → hiver\n\nIn summer, it's hot. → En été, il fait chaud.\nIn winter, it's cold. → En hiver, il fait froid.\nI love autumn! → J'adore l'automne !","tags":"saisons;temps;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Vêtements & Mode","type":"text","recto":"Les vêtements en anglais","verso":"T-shirt → t-shirt | shirt → chemise\njeans → jean | trousers → pantalon\nskirt → jupe | dress → robe\njacket → veste | coat → manteau\nsweater/jumper → pull | shoes → chaussures\nboots → bottes | socks → chaussettes\nhat → chapeau | scarf → écharpe","tags":"vêtements;mode;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Verbes essentiels","type":"text","recto":"Les verbes les plus courants en anglais","verso":"to be → être | to have → avoir\nto go → aller | to come → venir\nto eat → manger | to drink → boire\nto sleep → dormir | to work → travailler\nto study → étudier | to play → jouer\nto like → aimer | to love → adorer\nto want → vouloir | to need → avoir besoin de\nto see → voir | to say → dire","tags":"verbes;courants;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Verbes essentiels","type":"text","recto":"Verbes de mouvement et d'action (anglais)","verso":"to run → courir | to walk → marcher\nto swim → nager | to jump → sauter\nto sit → s'asseoir | to stand → se lever\nto open → ouvrir | to close → fermer\nto give → donner | to take → prendre\nto read → lire | to write → écrire\nto listen → écouter | to speak → parler","tags":"verbes;mouvement;action;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Adjectifs courants","type":"text","recto":"Adjectifs de description (anglais)","verso":"big/large → grand | small/little → petit\nlong → long | short → court/petit\nfast → rapide | slow → lent\nold → vieux/âgé | young → jeune | new → neuf\nbeautiful → beau/belle | ugly → laid(e)\nhappy → heureux | sad → triste\ndifficult/hard → difficile | easy → facile\nexpensive → cher | cheap → bon marché","tags":"adjectifs;description;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Animaux","type":"text","recto":"Les animaux domestiques et de la ferme (anglais)","verso":"dog → chien | cat → chat\nbird → oiseau | fish → poisson\nrabbit → lapin | hamster → hamster\nhorse → cheval | cow → vache\npig → cochon | sheep → mouton\nchicken → poule | duck → canard\nDo you have a pet? → As-tu un animal de compagnie ?","tags":"animaux;domestiques;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Animaux","type":"text","recto":"Les animaux sauvages en anglais","verso":"lion → lion | tiger → tigre\nelephant → éléphant | giraffe → girafe\nmonkey → singe | bear → ours\nwolf → loup | fox → renard\neagle → aigle | snake → serpent\ndolphin → dauphin | shark → requin\nbee → abeille | butterfly → papillon","tags":"animaux;sauvages;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Loisirs & Hobbies","type":"text","recto":"Les loisirs en anglais","verso":"sport → sport | music → musique\nreading → lecture | drawing → dessin\npainting → peinture | dancing → danse\ncooking → cuisine | gaming → jeux vidéo\nswimming → natation | cycling → vélo\nI like playing football. → J'aime jouer au foot.\nWhat do you do in your free time? → Que fais-tu pendant ton temps libre ?","tags":"loisirs;hobbies;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nombres & Maths basiques","type":"text","recto":"Les nombres ordinaux en anglais","verso":"1st → first (premier)\n2nd → second (deuxième)\n3rd → third (troisième)\n4th → fourth | 5th → fifth\n6th → sixth | 7th → seventh\n8th → eighth | 9th → ninth | 10th → tenth\n20th → twentieth | 21st → twenty-first\n\nIt's my first time! → C'est la première fois !","tags":"ordinaux;nombres;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Expressions courantes","type":"text","recto":"Expressions quotidiennes indispensables (anglais)","verso":"Please → S'il vous plaît\nThank you / Thanks → Merci\nYou're welcome → De rien\nSorry / Excuse me → Pardon / Excusez-moi\nOf course! → Bien sûr !\nI don't understand. → Je ne comprends pas.\nCan you repeat? → Pouvez-vous répéter ?\nHow do you say...? → Comment dit-on... ?\nI agree. → Je suis d'accord.","tags":"expressions;politesse;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Professions & Métiers","type":"text","recto":"Les professions (santé & sciences)","verso":"doctor → médecin\nnurse → infirmier/ière\nsurgeon → chirurgien\npharmacist → pharmacien\nscientist → scientifique\nengineer → ingénieur\narchitect → architecte\nchemist → chimiste\nbiologist → biologiste\npsychologist → psychologue\nresearcher → chercheur","tags":"professions;santé;sciences;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Professions & Métiers","type":"text","recto":"Les professions (enseignement & droit)","verso":"teacher → professeur (école)\nprofessor → professeur (université)\nheadteacher → directeur d'école\nlawyer → avocat\njudge → juge\npolice officer → policier\nfireman/firefighter → pompier\nsoldier → soldat\npolitician → homme/femme politique\nminister → ministre\nambassador → ambassadeur","tags":"professions;enseignement;droit;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Professions & Métiers","type":"text","recto":"Les professions (art, médias & sport)","verso":"actor/actress → acteur/actrice\nmusician → musicien\nphotographer → photographe\njournalist → journaliste\npresenter → présentateur\nwriter/author → écrivain/auteur\nartist → artiste\ndesigner → designer\nathlète → athlète\ncoach → entraîneur\nreferee → arbitre","tags":"professions;art;médias;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Professions & Métiers","type":"text","recto":"Les professions (commerce & technologie)","verso":"manager → directeur/manager\naccountant → comptable\nbanker → banquier\nshopkeeper → commerçant\nchef → cuisinier/chef\nwaiter/waitress → serveur/serveuse\ndriver → chauffeur\npilot → pilote\nprogrammer → développeur\nIT specialist → informaticien\nplumber → plombier\nelectrician → électricien","tags":"professions;commerce;tech;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Émotions & Sentiments","type":"text","recto":"Les émotions positives en anglais","verso":"happy → heureux/content\njoyful → joyeux\nexcited → enthousiaste/surexcité\nproud → fier\ngrateful → reconnaissant\nrelaxed → détendu\nconfident → confiant\namused → amusé\nloved → aimé\nhopeful → plein d'espoir\nInspired → inspiré\ncalm → calme","tags":"émotions;positives;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Émotions & Sentiments","type":"text","recto":"Les émotions négatives en anglais","verso":"sad → triste\nannoyed → agacé\nangry → en colère\nfrustrated → frustré\nscared/afraid → effrayé/avoir peur\nanxious → anxieux\nstressed → stressé\nlonely → seul/solitaire\nborned → ennuyé\nashamed → honteux\njealous → jaloux\ndisappointed → déçu","tags":"émotions;négatives;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Émotions & Sentiments","type":"text","recto":"Exprimer ses sentiments en anglais","verso":"I feel... → Je me sens...\nI'm in a good mood. → Je suis de bonne humeur.\nI'm in a bad mood. → Je suis de mauvaise humeur.\nI miss you. → Tu me manques.\nI'm fed up. → J'en ai marre.\nI can't stand it. → Je ne le supporte plus.\nCheer up! → Courage ! / Remonte-toi !\nDon't worry! → Ne t'inquiète pas !","tags":"sentiments;expressions;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Technologie & Internet","type":"text","recto":"Le vocabulaire de l'informatique (anglais)","verso":"computer → ordinateur\nlaptop → ordinateur portable\ntablet → tablette\nsmartphone → smartphone\nscreen → écran\nkeyboard → clavier\nmouse → souris\nprinter → imprimante\nheadphones → écouteurs/casque\ncharger → chargeur\nbattery → batterie\ncable → câble","tags":"informatique;technologie;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Technologie & Internet","type":"text","recto":"Le vocabulaire d'Internet et des réseaux sociaux","verso":"website → site web\nbrowser → navigateur\nsearch engine → moteur de recherche\npassword → mot de passe\nusername → nom d'utilisateur\nto download → télécharger\nto upload → mettre en ligne\nto log in → se connecter\nto log out → se déconnecter\nto follow → suivre\nto share → partager\nto like → liker/aimer","tags":"internet;réseaux sociaux;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Technologie & Internet","type":"text","recto":"Les applications et fonctions numériques","verso":"app → application\ngame → jeu\nchat → messagerie\nvideo call → appel vidéo\ncloud → nuage/cloud\nfile → fichier\nfolder → dossier\nnotification → notification\nupdate → mise à jour\nbug → bug/erreur\nartificial intelligence (AI) → intelligence artificielle","tags":"applications;numérique;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Sports & Activités physiques","type":"text","recto":"Les sports d'équipe en anglais","verso":"football → football\nbasketball → basketball\nvolleyball → volleyball\nrugby → rugby\nhockey → hockey\ncricket → cricket\nbaseball → baseball\nhandball → handball\nwater polo → water-polo\nTo score a goal → marquer un but\nTo win → gagner | to lose → perdre\nTo draw → faire match nul","tags":"sports;équipe;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Sports & Activités physiques","type":"text","recto":"Les sports individuels en anglais","verso":"tennis → tennis\nswimming → natation\ncycling → cyclisme\nrunning → course à pied\ngymnastics → gymnastique\nboxing → boxe\nwrestling → lutte\njudo → judo\nkarate → karaté\nskiing → ski\nsurfing → surf\nclimbing → escalade\ngolf → golf","tags":"sports;individuels;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Sports & Activités physiques","type":"text","recto":"Vocabulaire sportif général (anglais)","verso":"player → joueur\nteam → équipe\ncoach → entraîneur\nreferee → arbitre\nstadium → stade\nmatch/game → match\nchampionship → championnat\nmedal → médaille\nrecord → record\ntraining → entraînement\ninjury → blessure\nto practise → s'entraîner","tags":"sport;vocabulaire;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"La ville & Les lieux","type":"text","recto":"Les lieux en ville (anglais)","verso":"city/town → ville\nvillage → village\nstreet → rue\nsquare → place\npark → parc\nmarket → marché\nsupermarket → supermarché\nshop/store → magasin\nbakery → boulangerie\nbutcher's → boucherie\npharmacy/chemist → pharmacie\nhospital → hôpital\npost office → bureau de poste","tags":"ville;lieux;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"La ville & Les lieux","type":"text","recto":"Les bâtiments publics et culturels (anglais)","verso":"school → école\nuniversity → université\nlibrary → bibliothèque\nmuseum → musée\ntheatre → théâtre\ncinema → cinéma\nchurch → église\nmosque → mosquée\ntown hall → mairie\npolice station → commissariat\nfire station → caserne de pompiers\nbank → banque","tags":"bâtiments;publics;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"La ville & Les lieux","type":"text","recto":"S'orienter dans la ville (anglais)","verso":"map → carte/plan\nstraight ahead → tout droit\nturn left → tourne à gauche\nturn right → tourne à droite\nat the corner → au coin\nopposite → en face de\nnext to → à côté de\nbehind → derrière\nin front of → devant\nbetween → entre\nnearby → près de\nfar from → loin de","tags":"orientation;directions;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nature & Environnement","type":"text","recto":"La nature (paysages et géographie) en anglais","verso":"mountain → montagne\nhill → colline\nvalley → vallée\nforest → forêt\nwood → bois\nfield → champ\nriver → rivière\nlake → lac\nsea → mer\nocean → océan\nbeach → plage\nisland → île\ndesert → désert\nvolcano → volcan","tags":"nature;paysages;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nature & Environnement","type":"text","recto":"Les plantes et arbres en anglais","verso":"tree → arbre\nflower → fleur\ngrass → herbe\nbush → buisson\nleaf → feuille\nroot → racine\noak → chêne\npine → pin\nbirch → bouleau\nrose → rose\ntulip → tulipe\nsunflower → tournesol\ndaisy → marguerite","tags":"plantes;arbres;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nature & Environnement","type":"text","recto":"L'environnement et l'écologie en anglais","verso":"environment → environnement\nclimate → climat\nclimate change → changement climatique\nglobal warming → réchauffement climatique\npollution → pollution\nrecycling → recyclage\nrenewable energy → énergie renouvelable\nsolar panel → panneau solaire\nwind turbine → éolienne\ncarbon footprint → empreinte carbone\nplastic waste → déchets plastiques","tags":"écologie;environnement;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Santé & Médecine","type":"text","recto":"Le corps humain intérieur (anglais)","verso":"brain → cerveau\nlung(s) → poumon(s)\nliver → foie\nkidney → rein\nstomach → estomac\nbladder → vessie\nblood → sang\nbone → os\nmuscle → muscle\nnerve → nerf\nskin → peau\nvein → veine\nartery → artère","tags":"corps;anatomie;médecine;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Santé & Médecine","type":"text","recto":"Les maladies et symptômes (anglais)","verso":"headache → mal de tête\nstomachache → mal de ventre\ntoothache → mal de dents\nsore throat → mal de gorge\nfever → fièvre\ncough → toux\nsneezing → éternuement\ndizziness → vertige\nrash → éruption cutanée\nallergy → allergie\nfracture → fracture\nburn → brûlure","tags":"maladies;symptômes;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Santé & Médecine","type":"text","recto":"Chez le médecin — vocabulaire (anglais)","verso":"appointment → rendez-vous\nprescription → ordonnance\nmedicine/medication → médicament\ntablet/pill → comprimé/pilule\ninjection → piqûre\noperation → opération\nx-ray → radiographie\nblood test → analyse de sang\nwaiting room → salle d'attente\nrecovery → rétablissement\nI'm allergic to... → Je suis allergique à...","tags":"médecin;consultation;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Le présent simple vs présent continu (anglais)","verso":"Présent simple : habitudes, vérités générales\nI eat breakfast every day. → Je prends le petit-déj chaque jour.\nShe works in Paris. → Elle travaille à Paris.\n\nPrésent continu (be + V-ing) : action en cours\nI am eating now. → Je mange en ce moment.\nThey are playing football. → Ils jouent au foot.\n\nRègle : NOT avec stative verbs (know, like, want, have...)","tags":"grammaire;présent;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Le passé simple (Simple Past) en anglais","verso":"Verbes réguliers : + ed\nwork → worked | play → played | stop → stopped\n\nVerbes irréguliers (à mémoriser) :\ngo → went | come → came | eat → ate\nsee → saw | have → had | be → was/were\ndo → did | say → said | get → got\n\nNégation : didn't + base\nQuestion : Did + sujet + base ?\n\nI went to school yesterday.","tags":"grammaire;passé;past simple;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Le Present Perfect en anglais","verso":"Forme : have/has + participe passé\nI have seen this film. → J'ai vu ce film.\nShe has finished her homework. → Elle a fini ses devoirs.\n\nUsages :\n• Expérience de vie (ever/never)\nHave you ever been to London?\n• Résultat présent d'une action passée\nI've lost my keys. (je ne les trouve pas)\n• Avec since/for\nI've lived here for 3 years.","tags":"grammaire;present perfect;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Le futur en anglais : will vs going to","verso":"WILL → décision spontanée, prédiction\nI'll help you! → Je vais t'aider ! (décision immédiate)\nIt will rain tomorrow. → Il pleuvra demain. (prédiction)\n\nGOING TO → intention planifiée, prédiction basée sur preuves\nI'm going to study tonight. → J'ai prévu d'étudier ce soir.\nLook at those clouds — it's going to rain!\n\nWill ne prend pas de -s à la 3e pers. !","tags":"grammaire;futur;will;going to;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Les modaux en anglais (can, must, should, may...)","verso":"can → pouvoir/savoir faire\nmust → devoir (obligation forte)\nshould → devoir (conseil)\nmay/might → peut-être\nwould → conditionnel\ncould → pourrait / was able to\nhave to → devoir (obligation externe)\nneed to → avoir besoin de\n\nExemples :\nYou must wear a helmet. → Tu dois porter un casque.\nYou should eat more vegetables.","tags":"modaux;grammaire;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Les comparatifs et superlatifs en anglais","verso":"Comparatif (+ que) :\nshort adj → + er : taller, faster, older\nlong adj → more + adj : more beautiful, more intelligent\nirréguliers : good → better | bad → worse | far → farther\n\nSuperlatif (le plus...) :\nshort → + est : the tallest, the fastest\nlong → the most + adj : the most beautiful\nirréguliers : good → the best | bad → the worst\n\nShe is taller than me. He is the tallest.","tags":"grammaire;comparatif;superlatif;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Grammaire essentielle","type":"text","recto":"Les pronoms en anglais (sujet, objet, possessif)","verso":"Sujet : I / you / he / she / it / we / they\nObjet : me / you / him / her / it / us / them\nPossessif adj. : my / your / his / her / its / our / their\nPossessif pronom : mine / yours / his / hers / its / ours / theirs\n\nExemples :\nShe loves him. → Elle l'aime.\nThis is my book, not yours.\nThe dog wagged its tail.","tags":"grammaire;pronoms;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Verbes irréguliers","type":"text","recto":"Verbes irréguliers essentiels A-F (base / prétérit / participe passé)","verso":"be → was/were → been\nbecome → became → become\nbring → brought → brought\nbuy → bought → bought\ncome → came → come\ndo → did → done\ndrive → drove → driven\neat → ate → eaten\nfall → fell → fallen\nfeel → felt → felt\nfind → found → found\nforget → forgot → forgotten","tags":"irréguliers;verbes;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Verbes irréguliers","type":"text","recto":"Verbes irréguliers essentiels G-R","verso":"get → got → gotten/got\ngive → gave → given\ngo → went → gone\nhave → had → had\nhear → heard → heard\nkeep → kept → kept\nknow → knew → known\nleave → left → left\nmake → made → made\nput → put → put\nread → read → read (pron. 'red')\nrun → ran → run","tags":"irréguliers;verbes;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Verbes irréguliers","type":"text","recto":"Verbes irréguliers essentiels S-W","verso":"say → said → said\nsee → saw → seen\nsend → sent → sent\nsit → sat → sat\nsleep → slept → slept\nspeak → spoke → spoken\nstand → stood → stood\nswim → swam → swum\ntake → took → taken\nthink → thought → thought\nunderstand → understood → understood\nwrite → wrote → written","tags":"irréguliers;verbes;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Phrasal Verbs essentiels","type":"text","recto":"Phrasal verbs : mouvement et action","verso":"get up → se lever\ngo out → sortir\ncome back → revenir\nrun away → s'enfuir\nfall down → tomber\npick up → ramasser / récupérer\nput down → poser\nhand in → remettre (devoir)\nturn on → allumer\nturn off → éteindre\nplug in → brancher\nlog in → se connecter","tags":"phrasal verbs;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Phrasal Verbs essentiels","type":"text","recto":"Phrasal verbs : communication et relations","verso":"look up → chercher (dans un dico)\nfind out → découvrir/apprendre\ngive up → abandonner\ncatch up → rattraper son retard\nbring up → élever (enfant) / soulever (sujet)\nfall out (with) → se brouiller avec\nmake up → se réconcilier / inventer\nlet down → décevoir\nget on (with) → bien s'entendre avec\nfall for → tomber amoureux de / se faire avoir","tags":"phrasal verbs;communication;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nourriture & Boissons (avancé)","type":"text","recto":"Cuisiner en anglais — vocabulaire","verso":"to cook → cuisiner\nto bake → faire cuire au four\nto fry → frire\nto boil → bouillir\nto grill → griller\nto roast → rôtir\nto steam → cuire à la vapeur\nto chop → hacher\nto slice → trancher\nto mix → mélanger\nrecipe → recette\ningredient → ingrédient","tags":"cuisine;cuisson;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nourriture & Boissons (avancé)","type":"text","recto":"Au restaurant en anglais","verso":"menu → menu\nstarter/appetiser → entrée\nmain course → plat principal\ndessert → dessert\nside dish → accompagnement\nbill/check → addition\ntip → pourboire\nwaiter → serveur\nreservation → réservation\nI'd like... → Je voudrais...\nCan I have the bill? → L'addition, s'il vous plaît.\nIt's delicious! → C'est délicieux !","tags":"restaurant;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nourriture & Boissons (avancé)","type":"text","recto":"Les légumes en anglais","verso":"carrot → carotte\npotato → pomme de terre\ntomato → tomate\nonion → oignon\ngarlic → ail\nleek → poireau\nspinach → épinards\ncucumber → concombre\nzucchini/courgette → courgette\npeppers → poivrons\nmushroom → champignon\ncorn → maïs\nbeans → haricots\npeas → petits pois","tags":"légumes;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Nourriture & Boissons (avancé)","type":"text","recto":"Les fruits en anglais","verso":"apple → pomme\npear → poire\nbanana → banane\norange → orange\nstrawberry → fraise\nraspberry → framboise\npeach → pêche\ngrape → raisin\nwatermelon → pastèque\nmelon → melon\nkiwi → kiwi\npineapple → ananas\ncherry → cerise\nlemon → citron\nlime → citron vert","tags":"fruits;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Achats & Argent","type":"text","recto":"Faire ses courses en anglais","verso":"shop/store → magasin\nshopping centre → centre commercial\nprice → prix\ncost → coût\nreceipt → reçu\ncash → espèces\ncredit card → carte bancaire\nrefund → remboursement\ndiscount/sale → remise/soldes\nto pay → payer\nto buy → acheter\nto spend → dépenser\nto afford → avoir les moyens","tags":"achats;argent;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Achats & Argent","type":"text","recto":"Dialogues au magasin (anglais)","verso":"Can I help you? → Puis-je vous aider ?\nI'm just looking, thanks. → Je regarde, merci.\nHow much does it cost? → Combien ça coûte ?\nIt's too expensive. → C'est trop cher.\nDo you have it in another colour? → L'avez-vous dans une autre couleur ?\nWhat size is this? → C'est quelle taille ?\nI'd like to try this on. → Je voudrais l'essayer.\nI'll take it. → Je le prends.","tags":"achats;dialogues;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Médias & Culture","type":"text","recto":"Les genres de films et séries (anglais)","verso":"comedy → comédie\ndrama → drame\naction film → film d'action\nhorror film → film d'horreur\nscience fiction (sci-fi) → science-fiction\nromantic comedy (rom-com) → comédie romantique\ndocumentary → documentaire\nanimation → dessin animé\nthriller → thriller\nfantasy → fantasy\nhistorical film → film historique","tags":"films;genres;médias;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Médias & Culture","type":"text","recto":"La musique en anglais","verso":"song → chanson\nlyrics → paroles\nmelody → mélodie\nchorus → refrain\nverse → couplet\nband → groupe\nsinger → chanteur\nalbum → album\nconcert → concert\nto play an instrument → jouer d'un instrument\nguitar → guitare\ndrum → batterie\nkeyboard → clavier\nviolin → violon\nflute → flûte","tags":"musique;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Logement & Vie quotidienne","type":"text","recto":"Décrire son logement en anglais","verso":"It's big/small → C'est grand/petit\nIt's cosy → C'est confortable/douillet\nIt's modern/old → C'est moderne/vieux\non the ground floor → au rez-de-chaussée\non the first floor → au premier étage\nnearby → à proximité\nIt has... → Il/elle a...\nthere is/there are → il y a\nneighbour → voisin\nrent → loyer\nlive → habiter\nflat/apartment → appartement","tags":"logement;description;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Logement & Vie quotidienne","type":"text","recto":"Les tâches ménagères en anglais","verso":"to clean → nettoyer\nto tidy up → ranger\nto wash up → faire la vaisselle\nto do the washing → faire la lessive\nto iron → repasser\nto vacuum → passer l'aspirateur\nto mow the lawn → tondre la pelouse\nto cook → cuisiner\nto do the shopping → faire les courses\nto take out the bins → sortir les poubelles","tags":"ménage;tâches;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Voyages (avancé)","type":"text","recto":"À l'hôtel en anglais","verso":"hotel → hôtel\nreception → réception\nreceptionist → réceptionniste\nroom → chambre\nsingle room → chambre simple\ndouble room → chambre double\ncheck-in → enregistrement\ncheck-out → départ\nlift/elevator → ascenseur\nair conditioning → climatisation\nwifi → wifi\nroom service → service en chambre\nkey card → carte magnétique","tags":"hôtel;voyage;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Voyages (avancé)","type":"text","recto":"À l'aéroport en anglais","verso":"passport → passeport\nboarding pass → carte d'embarquement\nluggage/baggage → bagages\nhand luggage → bagage cabine\ncheck-in desk → comptoir d'enregistrement\nsecurity → sécurité\ncustoms → douane\ngate → porte d'embarquement\nflight → vol\ndelay → retard\ndeparture → départ\narrival → arrivée","tags":"aéroport;voyage;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Éducation & Travail","type":"text","recto":"Le système éducatif en anglais (UK/US)","verso":"primary school → école primaire\nsecondary school → collège/lycée\nhigh school → lycée (US)\nuniversity/college → université\ndegree → diplôme universitaire\nbachelor's degree → licence\nmaster's degree → master\nPhD → doctorat\nskill → compétence\nqualification → qualification\nGCSE / A-level → diplômes UK (équivalent brevet/bac)","tags":"éducation;système;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Éducation & Travail","type":"text","recto":"Le monde du travail en anglais","verso":"job/work → travail/emploi\ncareer → carrière\nCV/résumé → CV\ncover letter → lettre de motivation\ninterview → entretien\nto apply for a job → postuler à un emploi\nsalary → salaire\nto be promoted → être promu\nto be fired → être licencié\nstrike → grève\nunion → syndicat\ndeadline → date limite","tags":"travail;emploi;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Expressions idiomatiques","type":"text","recto":"Idiomatic expressions (1) — corps humain","verso":"To cost an arm and a leg → Coûter les yeux de la tête\nTo keep an eye on → Surveiller\nTo pull someone's leg → Faire marcher quelqu'un\nTo give a hand → Donner un coup de main\nTo bite off more than you can chew → Avoir les yeux plus gros que le ventre\nTo have butterflies in your stomach → Avoir l'estomac noué\nTo turn a blind eye → Fermer les yeux sur","tags":"idiomes;expressions;corps;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Expressions idiomatiques","type":"text","recto":"Idiomatic expressions (2) — animaux","verso":"To let the cat out of the bag → Vendre la mèche\nIt's raining cats and dogs → Il pleut des cordes\nTo kill two birds with one stone → Faire d'une pierre deux coups\nOnce in a blue moon → Très rarement\nTo be the black sheep → Être le mouton noir\nTo smell a rat → Sentir quelque chose de louche\nA dark horse → Un candidat surprise","tags":"idiomes;expressions;animaux;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Expressions idiomatiques","type":"text","recto":"Idiomatic expressions (3) — situations quotidiennes","verso":"Under the weather → Ne pas se sentir bien\nHit the nail on the head → Mettre le doigt dessus\nSpill the beans → Révéler le secret\nBreak a leg! → Bonne chance !\nHang in there! → Tiens bon !\nThink outside the box → Penser de façon créative\nThe ball is in your court → C'est à toi de jouer\nBack to square one → Retour à la case départ","tags":"idiomes;expressions;quotidien;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Prépositions & Connecteurs","type":"text","recto":"Les prépositions de lieu en anglais","verso":"in → dans\non → sur\nunder → sous\nnext to → à côté de\nbetween → entre\nopposite → en face de\nin front of → devant\nbehind → derrière\nabove → au-dessus de\nbelow → en dessous de\nnear → près de\nfar from → loin de\ninside → à l'intérieur\noutside → à l'extérieur","tags":"prépositions;lieu;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Prépositions & Connecteurs","type":"text","recto":"Les connecteurs logiques en anglais","verso":"and → et | but → mais\nbecause → parce que\nso → donc / alors\nhowever → cependant\nalthough → bien que\nif → si\nunless → à moins que\nwhile → pendant que\nbefore → avant que\nafter → après que\nfirstly → premièrement\nthen → ensuite\nfinally → enfin\nin conclusion → en conclusion","tags":"connecteurs;logique;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"École & Université (avancé)","type":"text","recto":"Vocabulaire académique en anglais","verso":"essay → dissertation/rédaction\nthesis → thèse\nparagraph → paragraphe\nargument → argument\nevidence → preuve\nsource → source\nreference → référence\nresearch → recherche\nexperiment → expérience\nhypothesis → hypothèse\nconclusion → conclusion\ndebate → débat\npresentation → exposé","tags":"académique;université;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Descriptions & Personnalité","type":"text","recto":"Décrire la personnalité en anglais","verso":"kind → gentil/bienveillant\ngenerous → généreux\nhonest → honnête\npatient → patient\nbrave → courageux\ncreative → créatif\ncurious → curieux\nambitious → ambitieux\nreliable → fiable\nshy → timide\narrogant → arrogant\nlazy → paresseux\nstubborn → têtu\ncheerful → jovial/gai","tags":"personnalité;caractère;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Descriptions & Personnalité","type":"text","recto":"Décrire l'apparence physique en anglais","verso":"tall → grand | short → petit\nslim/thin → mince | overweight → en surpoids\nblond hair → cheveux blonds\nbrown hair → cheveux bruns\nred hair → cheveux roux | grey hair → cheveux gris\ncurly hair → cheveux frisés\nstraight hair → cheveux raides\nblue eyes → yeux bleus | brown eyes → yeux marron\nbeard → barbe | moustache → moustache\nglasses → lunettes","tags":"apparence;physique;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Maths & Sciences en anglais","type":"text","recto":"Les opérations mathématiques en anglais","verso":"addition → addition : 3 + 4 = three plus four\nsubtraction → soustraction : 10 - 3 = ten minus three\nmultiplication → multiplication : 5 × 4 = five times four\ndivision → division : 12 ÷ 4 = twelve divided by four\nequals → égale : = equals\npercentage → pourcentage : 50% = fifty percent\nfraction → fraction : 1/2 = a half | 1/4 = a quarter\nsquare root → racine carrée : √9 = the square root of nine","tags":"maths;opérations;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Pays & Nationalités","type":"text","recto":"Les pays et nationalités en anglais (Europe)","verso":"France → French\nSpain → Spanish\nGermany → German\nItaly → Italian\nPortugal → Portuguese\nPoland → Polish\nRussia → Russian\nGreece → Greek\nSweden → Swedish\nNetherlands → Dutch\nBelgium → Belgian\nSwitzerland → Swiss\nUK → British | England → English","tags":"pays;nationalités;Europe;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Pays & Nationalités","type":"text","recto":"Les pays et nationalités en anglais (monde)","verso":"USA → American\nCanada → Canadian\nMexico → Mexican\nBrazil → Brazilian\nChina → Chinese\nJapan → Japanese\nIndia → Indian\nAustralia → Australian\nMorocco → Moroccan\nAlgeria → Algerian\nEgypt → Egyptian\nSenegal → Senegalese\nSouth Africa → South African","tags":"pays;nationalités;monde;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Transports & Voyages (avancé)","type":"text","recto":"Les panneaux et annonces dans les transports (anglais)","verso":"No entry → Entrée interdite\nNo smoking → Défense de fumer\nPlatform → Quai (train)\nDepartures → Départs\nArrivals → Arrivées\nOut of service → Hors service\nPriority seating → Places prioritaires\nSeat belt → Ceinture de sécurité\nEmergency exit → Sortie de secours\nDelayed → Retardé\nCancelled → Annulé","tags":"transports;panneaux;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Anglais — Vocabulaire","chapitre":"Maison & Quotidien (avancé)","type":"text","recto":"La cuisine et les ustensiles en anglais","verso":"saucepan → casserole\nfrying pan → poêle\nbaking tray → plaque de cuisson\nbowl → bol\nplate → assiette\ncup → tasse\nglass → verre\nfork → fourchette\nknife → couteau\nspoon → cuillère\nchopping board → planche à découper\ncolander → passoire\nmixer → mixeur/batteur","tags":"cuisine;ustensiles;anglais","niveau":"Anglais","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Saludos & Presentaciones","type":"text","recto":"Hola / Buenos días / Buenas tardes / Buenas noches","verso":"Bonjour / Bonjour (matin) / Bon après-midi / Bonne nuit\n\nExemples :\n• ¡Hola! ¿Cómo estás? → Salut ! Comment vas-tu ?\n• Buenos días, señor. → Bonjour, monsieur.\n• ¡Hasta luego! → À bientôt !\n• ¡Hasta mañana! → À demain !","tags":"salutation;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Saludos & Presentaciones","type":"text","recto":"¿Cómo te llamas? / Me llamo...","verso":"Comment t'appelles-tu ? / Je m'appelle...\n\nVocabulaire de présentation :\n• ¿Cuántos años tienes? → Quel âge as-tu ?\n• Tengo quince años. → J'ai quinze ans.\n• ¿De dónde eres? → D'où viens-tu ?\n• Soy francés/francesa. → Je suis français(e).\n• Encantado/a → Enchanté(e).","tags":"présentation;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Familia","type":"text","recto":"La famille en espagnol (vocabulaire)","verso":"padre → père | madre → mère\nhermano → frère | hermana → sœur\nabuelo → grand-père | abuela → grand-mère\ntío → oncle | tía → tante\nprimo/prima → cousin/cousine\nhijo → fils | hija → fille\nmarido/esposo → mari | mujer/esposa → femme","tags":"famille;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Cuerpo humano","type":"text","recto":"Le corps humain en espagnol","verso":"cabeza → tête | cara → visage\nojo(s) → œil/yeux | oreja(s) → oreille(s)\nnariz → nez | boca → bouche\nbrazo → bras | mano → main\npierna → jambe | pie → pied\ncorazón → cœur | espalda → dos\nestómago → estomac | rodilla → genou","tags":"corps;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Escuela & Material","type":"text","recto":"L'école et les fournitures en espagnol","verso":"escuela/colegio → école | clase → classe\nprofesor/a → professeur | alumno/a → élève\nlibro → livre | cuaderno → cahier\nbolígrafo → stylo | lápiz → crayon\ngoma → gomme | regla → règle\ndeberes → devoirs | examen → examen\nnota → note | recreo → récréation","tags":"école;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Escuela & Material","type":"text","recto":"Les matières scolaires en espagnol","verso":"matemáticas → mathématiques\nciencias → sciences\nhistoria → histoire\ngeografía → géographie\nlengua → français (langue)\nfísica → physique | química → chimie\nbiología → biologie\neducación física (EF) → éducation physique\nmúsica → musique\narte → arts plastiques","tags":"matières;école;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Comida & Bebidas","type":"text","recto":"La nourriture en espagnol (aliments courants)","verso":"pan → pain | mantequilla → beurre\nqueso → fromage | huevo → œuf\ncarne → viande | pollo → poulet\npescado → poisson | arroz → riz\npasta → pâtes | ensalada → salade\nfruta → fruit | verdura → légume\ntorta/pastel → gâteau | chocolate → chocolat","tags":"nourriture;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Comida & Bebidas","type":"text","recto":"Les repas et boissons en espagnol","verso":"agua → eau | zumo/jugo → jus\nleche → lait | té → thé | café → café\ndesayuno → petit-déjeuner\nalmuerzo/comida → déjeuner\ncena → dîner\nTengo hambre. → J'ai faim.\nTengo sed. → J'ai soif.\n¡Buen provecho! → Bon appétit !","tags":"repas;boissons;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Colores & Números","type":"text","recto":"Les couleurs en espagnol","verso":"rojo → rouge | azul → bleu\nverde → vert | amarillo → jaune\nnegro → noir | blanco → blanc\ngris → gris | naranja → orange\nrosa → rose | morado/violeta → violet\nmarrón → marron\n\n⚠️ En espagnol, les adjectifs s'accordent :\nEl coche rojo → La voiture rouge","tags":"couleurs;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Colores & Números","type":"text","recto":"Les nombres en espagnol (1–20 + dizaines)","verso":"1 uno | 2 dos | 3 tres | 4 cuatro | 5 cinco\n6 seis | 7 siete | 8 ocho | 9 nueve | 10 diez\n11 once | 12 doce | 13 trece | 14 catorce\n15 quince | 16 dieciséis | 17 diecisiete\n18 dieciocho | 19 diecinueve | 20 veinte\n30 treinta | 40 cuarenta | 50 cincuenta\n60 sesenta | 70 setenta | 80 ochenta | 90 noventa | 100 cien","tags":"nombres;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Casa & Muebles","type":"text","recto":"La maison et les pièces en espagnol","verso":"casa → maison | piso/apartamento → appartement\nsalón → salon | dormitorio → chambre\ncocina → cuisine | baño → salle de bain\nservicio/aseo → toilettes | jardín → jardin\nescalera → escalier | ventana → fenêtre\npuerta → porte | techo → plafond | suelo → sol","tags":"maison;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Transportes & Viajes","type":"text","recto":"Les transports en espagnol","verso":"coche/carro → voiture | autobús → bus\ntren → train | avión → avion\nbarco → bateau | bicicleta → vélo\nmoto → moto | taxi → taxi\nmetro → métro\nestación → gare | aeropuerto → aéroport\nbillete → billet | viaje → voyage","tags":"transports;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Transportes & Viajes","type":"text","recto":"Phrases utiles en voyage (espagnol)","verso":"¿Dónde está la estación? → Où est la gare ?\n¿Cuánto cuesta el billete? → Combien coûte le billet ?\nGira a la izquierda/derecha. → Tourne à gauche/droite.\nSigue recto. → Continue tout droit.\n¡Ayúdame! → Aide-moi !\nEstoy perdido/a. → Je suis perdu(e).\n¿Hablas francés? → Parles-tu français ?","tags":"voyage;directions;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Tiempo & Naturaleza","type":"text","recto":"La météo en espagnol","verso":"soleado → ensoleillé | nublado → nuageux\nlluvioso → pluvieux | ventoso → venteux\nnevado → enneigé | niebla → brouillard\ncalor → chaleur | frío → froid\n¿Qué tiempo hace? → Quel temps fait-il ?\nHace sol. → Il fait soleil.\nEstá lloviendo. → Il pleut.\nEstá nevando. → Il neige.","tags":"météo;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Días, meses, estaciones","type":"text","recto":"Les jours et mois en espagnol","verso":"lunes → lundi | martes → mardi\nmiércoles → mercredi | jueves → jeudi\nviernes → vendredi | sábado → samedi\ndimanche → domingo\n\nenero → janvier | febrero → février\nmarzo → mars | abril → avril | mayo → mai\njunio → juin | julio → juillet | agosto → août\nseptiembre → septembre | octubre → octobre\nnoviembre → novembre | diciembre → décembre","tags":"jours;mois;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Días, meses, estaciones","type":"text","recto":"Les saisons en espagnol","verso":"primavera → printemps\nverano → été\notoño → automne\ninvierno → hiver\n\nEn verano hace calor. → En été il fait chaud.\nEn invierno hace frío. → En hiver il fait froid.\nMe gusta la primavera. → J'aime le printemps.\n\n⚠️ Pas de majuscule aux saisons en espagnol.","tags":"saisons;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Verbos esenciales","type":"text","recto":"Les verbes essentiels en espagnol","verso":"ser/estar → être | tener → avoir\nir → aller | venir → venir\ncomer → manger | beber → boire\ndormir → dormir | trabajar → travailler\nestudiar → étudier | jugar → jouer\ngustar → aimer (plaire) | querer → vouloir/aimer\nver → voir | hablar → parler\nleer → lire | escribir → écrire","tags":"verbes;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Verbos esenciales","type":"text","recto":"SER vs ESTAR — comment choisir ?","verso":"SER → état permanent\n• identité, nationalité, profession\n• Soy francés. Soy estudiante.\n• Es grande. (taille permanente)\n\nESTAR → état temporaire / localisation\n• humeur, position, état passager\n• Estoy cansado. → Je suis fatigué.\n• Está en casa. → Il est à la maison.\n\n⚠️ Différence cruciale en espagnol !","tags":"ser;estar;grammaire;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Adjetivos comunes","type":"text","recto":"Adjectifs de description en espagnol","verso":"grande → grand | pequeño → petit\nlargo → long | corto → court\nrápido → rapide | lento → lent\nviejo → vieux | joven → jeune | nuevo → neuf\nbonito/guapo → beau/joli | feo → laid\nfeliz → heureux | triste → triste\ndifícil → difficile | fácil → facile\ncaro → cher | barato → bon marché","tags":"adjectifs;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Expresiones cotidianas","type":"text","recto":"Expressions quotidiennes en espagnol","verso":"Por favor → S'il vous plaît\nGracias → Merci\nDe nada → De rien\nPerdón / Disculpe → Pardon / Excusez-moi\n¡Claro que sí! → Bien sûr !\nNo entiendo. → Je ne comprends pas.\n¿Puede repetir? → Pouvez-vous répéter ?\n¿Cómo se dice...? → Comment dit-on... ?\n¡Qué bien! → Comme c'est bien ! / Super !","tags":"expressions;politesse;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Ropa & Moda","type":"text","recto":"Les vêtements en espagnol","verso":"camiseta → t-shirt | camisa → chemise\nvaqueros/jeans → jean | pantalón → pantalon\nfalda → jupe | vestido → robe\nchaqueta → veste | abrigo → manteau\njersey/suéter → pull | zapatos → chaussures\nbotas → bottes | calcetines → chaussettes\ngorra → casquette | bufanda → écharpe","tags":"vêtements;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Animales","type":"text","recto":"Les animaux en espagnol","verso":"perro → chien | gato → chat\npájaro → oiseau | pez → poisson\ncaballo → cheval | vaca → vache\ncerdo → cochon | oveja → mouton\nleón → lion | tigre → tigre\nelefante → éléphant | oso → ours\nabeja → abeille | mariposa → papillon","tags":"animaux;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Ocio & Hobbies","type":"text","recto":"Les loisirs en espagnol","verso":"deporte → sport | música → musique\nlectura → lecture | dibujo → dessin\nbaile → danse | cocina → cuisine\nvideojuegos → jeux vidéo\nMe gusta la música. → J'aime la musique.\n¿Qué te gusta hacer? → Qu'est-ce que tu aimes faire ?\nJuego al fútbol. → Je joue au foot.\nToco la guitarra. → Je joue de la guitare.","tags":"loisirs;hobbies;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Profesiones","type":"text","recto":"Las profesiones (salud, ciencia, educación)","verso":"médico/a → médecin\nenfermero/a → infirmier/ière\ncirujano/a → chirurgien\nfarmacéutico/a → pharmacien\ncientífico/a → scientifique\ningenieros/a → ingénieur\narquitecto/a → architecte\nbiólogo/a → biologiste\nprofesor/a (universidad) → professeur\njuez/a → juge\nabogado/a → avocat","tags":"professions;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Profesiones","type":"text","recto":"Las profesiones (arte, deporte, tecnología)","verso":"actor/actriz → acteur/actrice\nmúsico/a → musicien\nperiodista → journaliste\nphotógrafo/a → photographe\nescritro/a → écrivain\ndiseñador/a → designer\ndeportista → sportif/ive\nentrenador/a → entraîneur\nprogramador/a → développeur\ninformático/a → informaticien\nchef/cocinero/a → cuisinier/chef","tags":"professions;art;sport;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Emociones & Sentimientos","type":"text","recto":"Las emociones positivas en español","verso":"feliz/contento → heureux/content\nalegre → joyeux\nemocionado → enthousiaste\norgulloso → fier\nagradecido → reconnaissant\ntranquilo → détendu/calme\nconfiado → confiant\nenamorado → amoureux\nesperanzado → plein d'espoir\nsorprendido → surpris\nentusiasmado → enthousiaste","tags":"émotions;positives;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Emociones & Sentimientos","type":"text","recto":"Las emociones negativas en español","verso":"triste → triste\nenojado/enfadado → en colère\nfrustrado → frustré\nasustado/atemorizado → effrayé\nansioso → anxieux\nestresado → stressé\nsolo → seul\navergonzado → honteux\nceloso → jaloux\ndecepcionado → déçu\naburrido → ennuyé\ncansado → fatigué","tags":"émotions;négatives;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Tecnología & Internet","type":"text","recto":"El vocabulario de informática en español","verso":"ordenador/computadora → ordinateur\nportátil → ordinateur portable\ntableta → tablette\npantalla → écran\nteclado → clavier\nratón → souris\nimpresora → imprimante\nauricolares → écouteurs\ncargador → chargeur\nbatería → batterie\ncable → câble\nmemoria USB → clé USB","tags":"informatique;technologie;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Tecnología & Internet","type":"text","recto":"Internet y redes sociales en español","verso":"sitio web → site web\nbuscador → moteur de recherche\ncontraseña → mot de passe\ndescargar → télécharger\nsubir → mettre en ligne\niniciar sesión → se connecter\ncerrar sesión → se déconnecter\nseguir → suivre\ncompartir → partager\nme gusta → j'aime (like)\nnotificación → notification\nactualización → mise à jour","tags":"internet;réseaux;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Deporte & Actividades físicas","type":"text","recto":"Los deportes en español","verso":"fútbol → football\nbaloncesto → basketball\nbalonmano → handball\nvoleibol → volleyball\nrugby → rugby\nnatación → natation\nciclismo → cyclisme\ncarrera → course à pied\nboxeo → boxe\nesquí → ski\ntennis → tennis\nescalada → escalade\nsurf → surf","tags":"sports;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Deporte & Actividades físicas","type":"text","recto":"Vocabulario deportivo general (español)","verso":"jugador → joueur\nequipo → équipe\nentrenador → entraîneur\nárbitro → arbitre\nestadio → stade\ncampeonato → championnat\nmedalla → médaille\nrecord → record\nentrenamiento → entraînement\nlesión → blessure\nmarcar un gol → marquer un but\nganar → gagner\nperder → perdre\nempatar → faire match nul","tags":"sport;vocabulaire;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Ciudad & Lugares","type":"text","recto":"Los lugares en la ciudad (español)","verso":"ciudad → ville\npueblo → village/bourg\ncalle → rue\nplaza → place\nparque → parc\nmercado → marché\nsupermercado → supermarché\ntienda → magasin\npanadería → boulangerie\ncarnicería → boucherie\nfarmacia → pharmacie\nhospital → hôpital\ncorreos → bureau de poste","tags":"ville;lieux;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Ciudad & Lugares","type":"text","recto":"Edificios públicos y culturales (español)","verso":"escuela → école\nuniversidad → université\nbiblioteca → bibliothèque\nmuseo → musée\nteatro → théâtre\ncine → cinéma\niglesia → église\nmezquita → mosquée\nayuntamiento → mairie\ncomisaría → commissariat\nbanco → banque\nestación de bomberos → caserne de pompiers","tags":"bâtiments;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Naturaleza & Medio ambiente","type":"text","recto":"La naturaleza (paisajes) en español","verso":"montaña → montagne\ncollado/colina → colline\nvalle → vallée\nbosque → forêt\nselva → jungle\ncampo → champ\nrío → rivière\nlago → lac\nmar → mer\nocéano → océan\nplaya → plage\nisla → île\ndesierto → désert\nvolcán → volcan","tags":"nature;paysages;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Naturaleza & Medio ambiente","type":"text","recto":"Medio ambiente y ecología (español)","verso":"medioambiente → environnement\nclima → climat\ncambio climático → changement climatique\ncalentamiento global → réchauffement\ncontaminación → pollution\nreciclaje → recyclage\nenergía renovable → énergie renouvelable\npanel solar → panneau solaire\nhuella de carbono → empreinte carbone\nresiduos plásticos → déchets plastiques","tags":"écologie;environnement;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Salud & Medicina","type":"text","recto":"Enfermedades y síntomas en español","verso":"dolor de cabeza → mal de tête\ndolor de estómago → mal de ventre\ndolor de garganta → mal de gorge\nfiebre → fièvre\ntos → toux\nestornudo → éternuement\nmareo → vertige\nalergia → allergie\nfractura → fracture\nquemadura → brûlure\ngripe → grippe\ncatarro/resfriado → rhume","tags":"maladies;symptômes;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Salud & Medicina","type":"text","recto":"En el médico — vocabulario (español)","verso":"cita médica → rendez-vous médical\nreceta → ordonnance\nmedicamento → médicament\npastilla/comprimido → comprimé\ninyección → piqûre/injection\noperación → opération\nradiografía → radiographie\nanálisis de sangre → analyse de sang\nsala de espera → salle d'attente\nSoy alérgico/a a... → Je suis allergique à...\nMe duele... → J'ai mal à...","tags":"médecin;santé;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Gramática esencial","type":"text","recto":"El presente de indicativo (verbos regulares AR/ER/IR)","verso":"Verbos -AR (hablar) : yo hablo / tú hablas / él habla / nosotros hablamos / vosotros habláis / ellos hablan\n\nVerbos -ER (comer) : yo como / tú comes / él come / nosotros comemos / vosotros coméis / ellos comen\n\nVerbos -IR (vivir) : yo vivo / tú vives / él vive / nosotros vivimos / vosotros vivís / ellos viven","tags":"grammaire;présent;conjugaison;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Gramática esencial","type":"text","recto":"El pretérito indefinido (passé composé espagnol)","verso":"Utilisé pour des actions ponctuelles et achevées dans le passé.\n\nVerbos -AR : hablé / hablaste / habló / hablamos / hablasteis / hablaron\n\nVerbos -ER/-IR : comí / comiste / comió / comimos / comisteis / comieron\n\nIrréguliers fréquents :\nir/ser → fui, fuiste, fue, fuimos...\ntener → tuve | hacer → hice | estar → estuve","tags":"grammaire;passé;pretérito;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Gramática esencial","type":"text","recto":"El pretérito imperfecto — quand l'utiliser ?","verso":"L'imparfait espagnol s'utilise pour :\n1. Description dans le passé\nEra pequeño y tenía el pelo rubio. → Il était petit et avait les cheveux blonds.\n2. Habitude passée\nCada verano íbamos a la playa. → Chaque été nous allions à la plage.\n3. Action en cours interrompue\nLeía cuando llegó. → Je lisais quand il est arrivé.\n\nConjugaison -AR : hablaba, hablabas, hablaba...","tags":"grammaire;imparfait;imperfecto;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Gramática esencial","type":"text","recto":"El futuro de indicativo (futur simple)","verso":"Se forme en ajoutant les terminaisons au verbe entier :\n-é / -ás / -á / -emos / -éis / -án\n\nRégulier : hablar → hablaré, hablarás, hablará...\n\nIrréguliers fréquents :\nhaber → habr- : habrá\npoder → podr- : podrá\nquerer → querr- : querrá\nsaber → sabr- : sabrá\ntener → tendr- : tendrá\nvenir → vendr- : vendrá","tags":"grammaire;futur;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Gramática esencial","type":"text","recto":"El subjuntivo — à quoi ça sert ?","verso":"Le subjonctif s'utilise après des expressions de :\n1. Souhait/désir : quiero que vengas (je veux que tu viennes)\n2. Doute/nécessité : es necesario que estudies\n3. Sentiment : me alegra que estés bien\n4. Expression impersonnelle : es importante que...\n\nFormation : 1re pers. prés. ind. - o + terminaisons\nhablar → hable, hables, hable, hablemos...","tags":"grammaire;subjonctif;subjuntivo;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Frutas y verduras","type":"text","recto":"Las verduras en español","verso":"zanahoria → carotte\npatata → pomme de terre\ntomate → tomate\ncebolla → oignon\najo → ail\npuerro → poireau\nespinacas → épinards\npepino → concombre\ncalabacín → courgette\npimiento → poivron\nchampignon → champignon\nmaíz → maïs\nguisantes → petits pois\njudías verdes → haricots verts","tags":"légumes;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Frutas y verduras","type":"text","recto":"Las frutas en español","verso":"manzana → pomme\npera → poire\nplátano/banana → banane\nnaranja → orange\nfresa → fraise\nframbuesa → framboise\nmelocotón → pêche\nuva → raisin\nsandía → pastèque\nmelón → melon\nkiwi → kiwi\npiña → ananas\ncereza → cerise\nlimón → citron","tags":"fruits;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Compras & Dinero","type":"text","recto":"De compras en español","verso":"tienda → magasin\ncentro comercial → centre commercial\nprecio → prix\noferta/descuento → remise/promotion\nrebajas → soldes\ncaja → caisse\nrecibo → reçu\nefectivo → espèces\ntarjeta de crédito → carte de crédit\n¿Cuánto cuesta? → Combien ça coûte ?\nMe lo llevo. → Je le prends.\nEs muy caro. → C'est trop cher.","tags":"achats;argent;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Expresiones idiomáticas","type":"text","recto":"Expresiones idiomáticas (animales)","verso":"No hay mal que por bien no venga → À quelque chose malheur est bon\nEstar en las nubes → Être dans la lune\nMatar dos pájaros de un tiro → Faire d'une pierre deux coups\nLlover a cántaros → Il pleut des cordes\nNo hay que vender la piel del oso antes de cazarlo → Il ne faut pas vendre la peau de l'ours...\nSer un gallina → Être une poule mouillée","tags":"idiomes;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Expresiones idiomáticas","type":"text","recto":"Expresiones cotidianas (español coloquial)","verso":"¡Qué guay! / ¡Qué chulo! → Super ! / Trop bien !\n¡Venga! → Allez ! / D'accord !\n¡Vamos! → On y va ! / Allez !\nEn serio → Sérieusement\nDe nada → De rien\n¡Anda ya! → Allez donc ! / N'importe quoi !\nTío/tía → Mec/meuf (argot amical)\nMola → C'est cool\nMe apetece → Ça me dit / J'ai envie","tags":"argot;coloquial;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Países & Nacionalidades","type":"text","recto":"Los países hispanohablantes","verso":"México → mexicano\nArgentina → argentino\nColombia → colombiano\nChile → chileno\nPerú → peruano\nVenezuela → venezolano\nCuba → cubano\nEspaña → español\nBolivia → boliviano\nUruguay → uruguayo\nParaguay → paraguayo\nEcuador → ecuatoriano\nGuatemala → guatemalteco","tags":"pays;hispanophones;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Descripción física y de personalidad","type":"text","recto":"La personalidad en español","verso":"amable → aimable/gentil\ngeneroso → généreux\nhonesto → honnête\npaciente → patient\nvaliente → courageux\ncreativo → créatif\ncurioso → curieux\nambicioso → ambitieux\ntímido → timide\nperezoso → paresseux\nterco/testarudo → têtu\nalegre → joyeux/enjoué","tags":"personnalité;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Descripción física y de personalidad","type":"text","recto":"La apariencia física en español","verso":"alto → grand | bajo → petit\ndelgado → mince | gordo → gros\npelo rubio → cheveux blonds\npelo moreno → cheveux bruns\npelo pelirrojo → cheveux roux\npelo rizado → cheveux frisés\npelo liso → cheveux raides\nojos azules → yeux bleus\nojos marrones → yeux marron\nbarba → barbe\ngafas → lunettes","tags":"apparence;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Medios de comunicación","type":"text","recto":"Los géneros de películas y series (español)","verso":"comedia → comédie\ndrama → drame\npelícula de acción → film d'action\nterror/horror → horreur\nciencia ficción → science-fiction\nromántica → romantique\ndocumental → documentaire\nanimación → dessin animé\nthiller → thriller\nfantasía → fantasy\nbiografía → biopic","tags":"films;genres;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Educación & Trabajo","type":"text","recto":"El mundo laboral en español","verso":"trabajo/empleo → travail/emploi\ncarrera → carrière\ncurrículum vitae (CV) → CV\ncarta de presentación → lettre de motivation\nentrevista → entretien\nsueldo/salario → salaire\nser ascendido → être promu\nser despedido → être licencié\nhuelga → grève\nsindicato → syndicat\nplazo/fecha límite → délai/date limite","tags":"travail;emploi;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Conectores & Preposiciones","type":"text","recto":"Los conectores lógicos en español","verso":"y → et | pero → mais\nporque → parce que\npor lo tanto → donc\nsin embargo → cependant\naunque → bien que\nsi → si\nantes de → avant de\ndespués de → après\nprimero → premièrement\nluego/después → ensuite\nfinalmente → enfin\nen conclusión → en conclusion\nademás → de plus/en outre","tags":"connecteurs;logique;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Español — Vocabulario","chapitre":"Casa & Vida cotidiana","type":"text","recto":"Las tareas domésticas en español","verso":"limpiar → nettoyer\nordenar → ranger\nfregar los platos → faire la vaisselle\nhacer la colada → faire la lessive\nplanchar → repasser\npasar la aspiradora → passer l'aspirateur\ncortar el césped → tondre la pelouse\ncocinar → cuisiner\nhacer la compra → faire les courses\nsacar la basura → sortir les poubelles","tags":"ménage;maison;espagnol","niveau":"Espagnol","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Begrüßung & Vorstellung","type":"text","recto":"Hallo / Guten Morgen / Guten Tag / Guten Abend / Tschüss","verso":"Salut / Bonjour (matin) / Bonjour/Bonsoir / Bonne nuit / Au revoir\n\nExemples :\n• Hallo! Wie geht's? → Salut ! Comment ça va ?\n• Guten Morgen, alle! → Bonjour à tous !\n• Auf Wiedersehen! → Au revoir !\n• Bis bald! → À bientôt !\n• Bis morgen! → À demain !","tags":"salutation;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Begrüßung & Vorstellung","type":"text","recto":"Wie heißt du? / Ich heiße...","verso":"Comment t'appelles-tu ? / Je m'appelle...\n\nPrésentation complète :\n• Wie alt bist du? → Quel âge as-tu ?\n• Ich bin fünfzehn Jahre alt. → J'ai quinze ans.\n• Woher kommst du? → D'où viens-tu ?\n• Ich komme aus Frankreich. → Je viens de France.\n• Freut mich! → Enchanté(e) !","tags":"présentation;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Grammaire essentielle","type":"text","recto":"Les articles en allemand : der, die, das","verso":"En allemand, chaque nom a un genre grammatical :\n\nder (masculin) : der Mann (l'homme), der Vater (le père)\ndie (féminin) : die Frau (la femme), die Mutter (la mère)\ndas (neutre) : das Kind (l'enfant), das Haus (la maison)\ndie (pluriel) : die Kinder (les enfants)\n\n⚠️ Le genre doit être appris avec chaque mot !","tags":"articles;grammaire;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Grammaire essentielle","type":"text","recto":"Les articles indéfinis (ein, eine) et la négation (kein, keine)","verso":"Masculin : ein Mann (un homme) / kein Mann (aucun homme)\nFéminin : eine Frau (une femme) / keine Frau\nNeutre : ein Kind (un enfant) / kein Kind\nPluriel : Kinder / keine Kinder\n\nNégation avec kein/keine = pas de, aucun(e)\nIch habe kein Geld. → Je n'ai pas d'argent.\nIch habe keine Zeit. → Je n'ai pas le temps.","tags":"articles;négation;kein;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Familie","type":"text","recto":"La famille en allemand","verso":"der Vater → le père | die Mutter → la mère\nder Bruder → le frère | die Schwester → la sœur\nder Großvater / Opa → le grand-père\ndie Großmutter / Oma → la grand-mère\nder Onkel → l'oncle | die Tante → la tante\nder Cousin → le cousin | die Cousine → la cousine\nder Sohn → le fils | die Tochter → la fille","tags":"famille;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Der Körper","type":"text","recto":"Le corps humain en allemand","verso":"der Kopf → la tête | das Gesicht → le visage\ndas Auge (pl. Augen) → l'œil/les yeux\ndas Ohr (pl. Ohren) → l'oreille\ndie Nase → le nez | der Mund → la bouche\nder Arm → le bras | die Hand → la main\ndas Bein → la jambe | der Fuß → le pied\ndas Herz → le cœur | der Rücken → le dos","tags":"corps;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Schule & Schulmaterial","type":"text","recto":"L'école et les fournitures en allemand","verso":"die Schule → l'école | das Klassenzimmer → la classe\nder Lehrer / die Lehrerin → le/la professeur\nder Schüler / die Schülerin → l'élève\ndas Buch → le livre | das Heft → le cahier\nder Stift → le stylo | der Bleistift → le crayon\nder Radiergummi → la gomme | das Lineal → la règle\ndie Hausaufgaben → les devoirs | die Note → la note","tags":"école;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Schule & Schulmaterial","type":"text","recto":"Les matières scolaires en allemand","verso":"Mathematik (Mathe) → mathématiques\nPhysik → physique | Chemie → chimie\nBiologie → biologie\nGeschichte → histoire | Erdkunde → géographie\nDeutsch → allemand (cours de) | Französisch → français\nEnglisch → anglais\nSport → sport/EPS | Musik → musique\nKunst → arts plastiques","tags":"matières;école;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Essen & Trinken","type":"text","recto":"La nourriture en allemand (aliments courants)","verso":"das Brot → le pain | die Butter → le beurre\nder Käse → le fromage | das Ei → l'œuf\ndas Fleisch → la viande | das Hähnchen → le poulet\nder Fisch → le poisson | der Reis → le riz\ndie Nudeln (pl.) → les pâtes | der Salat → la salade\ndas Obst → les fruits | das Gemüse → les légumes\nder Kuchen → le gâteau | die Schokolade → le chocolat","tags":"nourriture;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Essen & Trinken","type":"text","recto":"Les repas et boissons en allemand","verso":"das Wasser → l'eau | der Saft → le jus\ndie Milch → le lait | der Tee → le thé | der Kaffee → le café\ndas Frühstück → le petit-déjeuner\ndas Mittagessen → le déjeuner\ndas Abendessen → le dîner\nIch habe Hunger. → J'ai faim.\nIch habe Durst. → J'ai soif.\nGuten Appetit! → Bon appétit !","tags":"repas;boissons;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Farben & Zahlen","type":"text","recto":"Les couleurs en allemand","tags":"couleurs;allemand","niveau":"Allemand","matiere":"Langues","verso":"rot → rouge | blau → bleu\ngrün → vert | gelb → jaune\nschwarz → noir | weiß → blanc\ngrau → gris | orange → orange\nrosa → rose | lila/violett → violet\nbraun → marron\n\nDas Auto ist rot. → La voiture est rouge."},{"deck":"Deutsch — Wortschatz","chapitre":"Farben & Zahlen","type":"text","recto":"Les nombres en allemand (1–20 + dizaines)","verso":"1 eins | 2 zwei | 3 drei | 4 vier | 5 fünf\n6 sechs | 7 sieben | 8 acht | 9 neun | 10 zehn\n11 elf | 12 zwölf | 13 dreizehn | 14 vierzehn\n15 fünfzehn | 16 sechzehn | 17 siebzehn\n18 achtzehn | 19 neunzehn | 20 zwanzig\n30 dreißig | 40 vierzig | 50 fünfzig\n60 sechzig | 70 siebzig | 80 achtzig | 90 neunzig | 100 hundert","tags":"nombres;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Das Haus","type":"text","recto":"La maison et les pièces en allemand","verso":"das Haus → la maison | die Wohnung → l'appartement\ndas Wohnzimmer → le salon | das Schlafzimmer → la chambre\ndie Küche → la cuisine | das Badezimmer → la salle de bain\ndie Toilette → les toilettes | der Garten → le jardin\ndie Treppe → l'escalier | das Fenster → la fenêtre\ndie Tür → la porte | die Decke → le plafond","tags":"maison;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Verkehr & Reisen","type":"text","recto":"Les transports en allemand","verso":"das Auto → la voiture | der Bus → le bus\nder Zug → le train | das Flugzeug → l'avion\ndas Schiff → le bateau | das Fahrrad → le vélo\ndas Motorrad → la moto | das Taxi → le taxi\ndie U-Bahn → le métro\nder Bahnhof → la gare | der Flughafen → l'aéroport\ndie Fahrkarte → le billet | die Reise → le voyage","tags":"transports;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Das Wetter","type":"text","recto":"La météo en allemand","verso":"sonnig → ensoleillé | bewölkt → nuageux\nregnerisch → pluvieux | windig → venteux\nschneeig → neigeux | neblig → brumeux\nheiß → chaud | kalt → froid | warm → tiède\nWie ist das Wetter? → Quel temps fait-il ?\nEs ist sonnig. → Il fait soleil.\nEs regnet. → Il pleut.\nEs schneit. → Il neige.","tags":"météo;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Tage, Monate, Jahreszeiten","type":"text","recto":"Les jours et mois en allemand","verso":"Montag → lundi | Dienstag → mardi\nMittwoch → mercredi | Donnerstag → jeudi\nFreitag → vendredi | Samstag → samedi | Sonntag → dimanche\n\nJanuar → janvier | Februar → février | März → mars\nApril → avril | Mai → mai | Juni → juin\nJuli → juillet | August → août | September → septembre\nOktober → octobre | November → novembre | Dezember → décembre","tags":"jours;mois;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Tage, Monate, Jahreszeiten","type":"text","recto":"Les saisons en allemand","verso":"der Frühling → le printemps\nder Sommer → l'été\nder Herbst → l'automne\nder Winter → l'hiver\n\nIm Sommer ist es heiß. → En été il fait chaud.\nIm Winter ist es kalt. → En hiver il fait froid.\nIch liebe den Herbst. → J'adore l'automne.","tags":"saisons;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Wichtige Verben","type":"text","recto":"Les verbes essentiels en allemand","verso":"sein → être | haben → avoir\ngehen → aller | kommen → venir\nessen → manger | trinken → boire\nschlafen → dormir | arbeiten → travailler\nlernen/studieren → apprendre/étudier\nspielen → jouer | mögen → aimer\nsehen → voir | sagen → dire\nlesen → lire | schreiben → écrire\nsprechen → parler | hören → écouter","tags":"verbes;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Adjektive","type":"text","recto":"Adjectifs de description en allemand","verso":"groß → grand | klein → petit\nlang → long | kurz → court\nschnell → rapide | langsam → lent\nalt → vieux/âgé | jung → jeune | neu → neuf\nschön → beau | hässlich → laid\nglücklich → heureux | traurig → triste\nschwierig → difficile | einfach → facile\nteuer → cher | billig → bon marché","tags":"adjectifs;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Alltagsausdrücke","type":"text","recto":"Expressions quotidiennes en allemand","verso":"Bitte → S'il vous plaît / Je vous en prie\nDanke (schön) → Merci (beaucoup)\nBitte sehr → De rien\nEntschuldigung → Pardon / Excusez-moi\nNatürlich! → Bien sûr !\nIch verstehe nicht. → Je ne comprends pas.\nKönnen Sie das wiederholen? → Pouvez-vous répéter ?\nWie sagt man...? → Comment dit-on... ?\nToll! / Super! → Super ! / Génial !","tags":"expressions;politesse;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Kleidung","type":"text","recto":"Les vêtements en allemand","verso":"das T-Shirt → le t-shirt | das Hemd → la chemise\ndie Jeans → le jean | die Hose → le pantalon\nder Rock → la jupe | das Kleid → la robe\ndie Jacke → la veste | der Mantel → le manteau\nder Pullover → le pull | die Schuhe (pl.) → les chaussures\ndie Stiefel (pl.) → les bottes\ndie Socken (pl.) → les chaussettes\nder Hut → le chapeau | der Schal → l'écharpe","tags":"vêtements;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Tiere","type":"text","recto":"Les animaux en allemand","verso":"der Hund → le chien | die Katze → le chat\nder Vogel → l'oiseau | der Fisch → le poisson\ndas Pferd → le cheval | die Kuh → la vache\ndas Schwein → le cochon | das Schaf → le mouton\nder Löwe → le lion | der Tiger → le tigre\nder Elefant → l'éléphant | der Bär → l'ours\ndie Biene → l'abeille | der Schmetterling → le papillon","tags":"animaux;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Freizeit & Hobbys","type":"text","recto":"Les loisirs en allemand","verso":"der Sport → le sport | die Musik → la musique\ndas Lesen → la lecture | das Zeichnen → le dessin\ndas Tanzen → la danse | das Kochen → la cuisine\ndie Videospiele → les jeux vidéo\nIch spiele Fußball. → Je joue au foot.\nIch höre Musik. → J'écoute de la musique.\nWas machst du in deiner Freizeit? → Que fais-tu pendant ton temps libre ?","tags":"loisirs;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Berufe","type":"text","recto":"Die Berufe (Gesundheit, Wissenschaft, Bildung)","verso":"der Arzt / die Ärztin → médecin\nder Krankenpfleger / die Krankenpflegerin → infirmier/ière\nder Chirurg → chirurgien\nder Apotheker → pharmacien\nder Wissenschaftler → scientifique\nder Ingenieur → ingénieur\nder Architekt → architecte\nder Biologe → biologiste\nder Lehrer → professeur (école)\nder Professor → professeur (université)\nder Richter → juge\nder Rechtsanwalt → avocat","tags":"professions;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Berufe","type":"text","recto":"Die Berufe (Kunst, Medien, Technologie)","verso":"der Schauspieler / die Schauspielerin → acteur/actrice\nder Musiker → musicien\nder Journalist → journaliste\nder Fotograf → photographe\nder Schriftsteller → écrivain\nder Designer → designer\nder Sportler → sportif\nder Trainer → entraîneur\nder Programmierer → développeur\nder Informatiker → informaticien\nder Koch / die Köchin → cuisinier/chef","tags":"professions;art;tech;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Gefühle & Emotionen","type":"text","recto":"Positive Emotionen auf Deutsch","verso":"glücklich → heureux\nfröhlich → joyeux\naufgeregt → excité/enthousiaste\nstolz → fier\ndankbar → reconnaissant\nentspannt → détendu\nzufrieden → satisfait/content\nverliebt → amoureux\nhoffnungsvoll → plein d'espoir\nüberrascht → surpris\nbegeistert → enthousiaste","tags":"émotions;positives;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Gefühle & Emotionen","type":"text","recto":"Negative Emotionen auf Deutsch","verso":"traurig → triste\nverärgert → agacé\nwütend → en colère\nfrustiert → frustré\nängstlich → anxieux\ngestresst → stressé\neinsam → seul/solitaire\ngelangweilt → ennuyé\nbeschämt → honteux\neifersüchtig → jaloux\nenttäuscht → déçu\nmüde → fatigué","tags":"émotions;négatives;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Technologie & Internet","type":"text","recto":"Computer-Wortschatz auf Deutsch","verso":"der Computer → l'ordinateur\nder Laptop → l'ordinateur portable\ndas Tablet → la tablette\nder Bildschirm → l'écran\ndie Tastatur → le clavier\ndie Maus → la souris\nder Drucker → l'imprimante\ndie Kopfhörer (pl.) → les écouteurs\ndas Ladegerät → le chargeur\ndie Batterie → la batterie\ndas Kabel → le câble\nder USB-Stick → la clé USB","tags":"informatique;technologie;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Technologie & Internet","type":"text","recto":"Internet und soziale Medien auf Deutsch","verso":"die Webseite → le site web\nder Browser → le navigateur\ndas Passwort → le mot de passe\nder Benutzername → le nom d'utilisateur\nherunterladen → télécharger\nhochladen → mettre en ligne\neinloggen → se connecter\nausloggen → se déconnecter\nfolgen → suivre\nteilen → partager\nliken → liker\ndie Benachrichtigung → la notification","tags":"internet;réseaux;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Sport & Freizeit","type":"text","recto":"Sportarten auf Deutsch","verso":"Fußball → football\nBasketball → basketball\nHandball → handball\nVolleyball → volleyball\nSchwimmen → natation\nRadfahren → cyclisme\nLaufen/Jogging → course à pied\nBoxen → boxe\nSki fahren → ski\nTennis → tennis\nKlettern → escalade\nSurfen → surf","tags":"sports;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Sport & Freizeit","type":"text","recto":"Sport-Wortschatz (allgemein) auf Deutsch","verso":"der Spieler → le joueur\ndie Mannschaft → l'équipe\nder Trainer → l'entraîneur\nder Schiedsrichter → l'arbitre\ndas Stadion → le stade\ndie Meisterschaft → le championnat\ndie Medaille → la médaille\ndas Training → l'entraînement\ndie Verletzung → la blessure\nein Tor schießen → marquer un but\ngewinnen → gagner\nverlieren → perdre","tags":"sport;vocabulaire;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Stadt & Orte","type":"text","recto":"Orte in der Stadt auf Deutsch","verso":"die Stadt → la ville\ndas Dorf → le village\ndie Straße → la rue\nder Platz → la place\nder Park → le parc\nder Markt → le marché\nder Supermarkt → le supermarché\ndas Geschäft/der Laden → le magasin\ndie Bäckerei → la boulangerie\ndie Metzgerei → la boucherie\ndie Apotheke → la pharmacie\ndas Krankenhaus → l'hôpital","tags":"ville;lieux;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Stadt & Orte","type":"text","recto":"Öffentliche Gebäude auf Deutsch","verso":"die Schule → l'école\ndie Universität → l'université\ndie Bibliothek → la bibliothèque\ndas Museum → le musée\ndas Theater → le théâtre\ndas Kino → le cinéma\ndie Kirche → l'église\ndie Moschee → la mosquée\ndas Rathaus → la mairie\ndie Polizei → la police\ndie Bank → la banque\ndas Postamt → le bureau de poste","tags":"bâtiments;publics;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Natur & Umwelt","type":"text","recto":"Die Natur (Landschaften) auf Deutsch","verso":"der Berg → la montagne\nder Hügel → la colline\ndas Tal → la vallée\nder Wald → la forêt\ndas Feld → le champ\nder Fluss → la rivière\nder See → le lac\ndas Meer → la mer\nder Ozean → l'océan\nder Strand → la plage\ndie Insel → l'île\ndie Wüste → le désert\nder Vulkan → le volcan","tags":"nature;paysages;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Natur & Umwelt","type":"text","recto":"Umwelt und Ökologie auf Deutsch","verso":"die Umwelt → l'environnement\ndas Klima → le climat\nder Klimawandel → le changement climatique\ndie Erderwärmung → le réchauffement climatique\ndie Umweltverschmutzung → la pollution\ndas Recycling → le recyclage\nerneuerbare Energie → énergie renouvelable\ndie Solaranlage → le panneau solaire\nder CO₂-Fußabdruck → l'empreinte carbone\nder Plastikmüll → les déchets plastiques","tags":"écologie;environnement;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Gesundheit & Medizin","type":"text","recto":"Krankheiten und Symptome auf Deutsch","verso":"Kopfschmerzen → mal de tête\nMagenschmerzen → mal au ventre\nHalsschmerzen → mal de gorge\nFieber → fièvre\nHusten → toux\nNiesen → éternuement\nSchwindel → vertige\nAllergie → allergie\nBruch/Fraktur → fracture\nVerbrennung → brûlure\nGrippe → grippe\nErkältung → rhume","tags":"maladies;symptômes;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Gesundheit & Medizin","type":"text","recto":"Beim Arzt — Wortschatz auf Deutsch","verso":"der Arzttermin → le rendez-vous médical\ndas Rezept → l'ordonnance\ndas Medikament → le médicament\ndie Tablette → le comprimé\ndie Spritze → la piqûre/injection\ndie Operation → l'opération\ndas Röntgenbild → la radiographie\ndie Blutuntersuchung → l'analyse de sang\ndas Wartezimmer → la salle d'attente\nIch bin allergisch gegen... → Je suis allergique à...","tags":"médecin;santé;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Deutsche Grammatik","type":"text","recto":"Les cas en allemand : Nominatif, Accusatif, Datif","verso":"NOMINATIF (sujet) : Der Mann kommt. → L'homme vient.\nACCUSATIF (objet direct) : Ich sehe den Mann. → Je vois l'homme.\nDATIF (objet indirect / après prépositions) : Ich gebe dem Mann das Buch. → Je donne le livre à l'homme.\n\nArticles définis :\nNom. : der/die/das/die\nAcc. : den/die/das/die\nDat. : dem/der/dem/den","tags":"grammaire;cas;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Deutsche Grammatik","type":"text","recto":"Le pluriel des noms en allemand (règles)","verso":"Il n'y a pas de règle universelle — apprendre avec chaque mot !\n\nGroupes fréquents :\n-e : der Tag → die Tage\n-er : das Kind → die Kinder\n-en : die Frau → die Frauen\n-s : das Auto → die Autos (mots étrangers)\numlaut + e : der Vater → die Väter\nidentique : das Zimmer → die Zimmer\n\n⚠️ Toujours apprendre : der/die/das + pluriel","tags":"grammaire;pluriel;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Deutsche Grammatik","type":"text","recto":"Le passé composé (Perfekt) en allemand","verso":"Perfekt = haben/sein + Partizip II\n\nAvec HABEN (la plupart des verbes) :\nIch habe gegessen. → J'ai mangé.\nEr hat geschlafen. → Il a dormi.\n\nAvec SEIN (mouvement/changement d'état) :\nIch bin gegangen. → Je suis allé.\nSie ist gekommen. → Elle est venue.\n\nPartizip II réguliers : ge- + radical + -t\nmachen → gemacht | spielen → gespielt","tags":"grammaire;passé;Perfekt;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Deutsche Grammatik","type":"text","recto":"Les prépositions avec accusatif vs datif","verso":"Prépositions + ACCUSATIF (mouvement vers) :\ndurch, für, gegen, ohne, um, bis, entlang, wider\nIch gehe durch den Park.\n\nPrépositions + DATIF (position/état) :\naus, bei, mit, nach, seit, von, zu, gegenüber\nIch bin bei meiner Freundin.\n\nPrépositions + les DEUX (deux-voies) :\nan, auf, hinter, in, neben, über, unter, vor, zwischen\nBewegung (Akk.) : Ich lege das Buch auf den Tisch.\nPosition (Dat.) : Das Buch liegt auf dem Tisch.","tags":"grammaire;prépositions;cas;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Deutsche Grammatik","type":"text","recto":"L'ordre des mots en allemand (Satzstellung)","verso":"Règle fondamentale : le verbe conjugué est TOUJOURS en 2e position.\n\nAffirmatif : Sujet + Verbe + ...\nIch esse Brot. → Je mange du pain.\n\nInversion (si adverbe en 1ère position) :\nHeute esse ich Brot. → Aujourd'hui je mange du pain.\n\nSubordonnée : le verbe va en DERNIÈRE position :\nIch weiß, dass er Brot isst.\n→ Je sais qu'il mange du pain.","tags":"grammaire;ordre mots;Satzstellung;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Gemüse & Obst","type":"text","recto":"Das Gemüse auf Deutsch","verso":"die Karotte → la carotte\ndie Kartoffel → la pomme de terre\ndie Tomate → la tomate\ndie Zwiebel → l'oignon\nder Knoblauch → l'ail\nder Lauch → le poireau\nder Spinat → les épinards\ndie Gurke → le concombre\ndie Zucchini → la courgette\ndie Paprika → le poivron\nder Pilz → le champignon\ndie Erbsen (pl.) → les petits pois","tags":"légumes;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Gemüse & Obst","type":"text","recto":"Das Obst auf Deutsch","verso":"der Apfel → la pomme\ndie Birne → la poire\ndie Banane → la banane\ndie Orange/Apfelsine → l'orange\ndie Erdbeere → la fraise\ndie Himbeere → la framboise\nder Pfirsich → la pêche\ndie Traube → le raisin\ndie Wassermelone → la pastèque\ndie Kirsche → la cerise\ndie Zitrone → le citron\ndie Ananas → l'ananas","tags":"fruits;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Einkaufen & Geld","type":"text","recto":"Einkaufen auf Deutsch","verso":"das Geschäft/der Laden → le magasin\ndas Einkaufszentrum → le centre commercial\nder Preis → le prix\ndas Angebot → la promotion/offre\nder Schlussverkauf → les soldes\ndie Kasse → la caisse\nder Kassenbon → le reçu\nbar bezahlen → payer en espèces\nmit Karte bezahlen → payer par carte\nWie viel kostet das? → Combien ça coûte ?\nIch nehme es. → Je le prends.","tags":"achats;argent;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Charakter & Aussehen","type":"text","recto":"Die Persönlichkeit auf Deutsch","verso":"freundlich → aimable/sympa\ngroßzügig → généreux\nehrlich → honnête\ngeduldig → patient\ntapfer → courageux\nkreativ → créatif\nneugierig → curieux\nambitioniert → ambitieux\nschüchtern → timide\nfaul → paresseux\nstur → têtu\nfröhlich → joyeux/enjoué","tags":"personnalité;caractère;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Charakter & Aussehen","type":"text","recto":"Das Aussehen beschreiben auf Deutsch","verso":"groß → grand | klein → petit\nschlank → mince | dick → gros\nblonde Haare → cheveux blonds\ndunkle Haare → cheveux bruns\nrote Haare → cheveux roux\nloclige Haare → cheveux frisés\nglatte Haare → cheveux raides\nblaue Augen → yeux bleus\nbraune Augen → yeux marron\nder Bart → la barbe\ndie Brille → les lunettes","tags":"apparence;physique;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Redewendungen","type":"text","recto":"Deutsche Redewendungen (Sprichwörter)","verso":"Das ist nicht mein Bier. → Ce n'est pas mon problème.\nAlles hat ein Ende, nur die Wurst hat zwei. → Tout a une fin.\nDaumen drücken → Croiser les doigts\nIch verstehe nur Bahnhof. → Je n'y comprends rien. (littéral: je comprends seulement gare)\nKein Bock haben → Avoir la flemme / ne pas avoir envie\nAuf den Punkt kommen → Aller droit au but\nJemandem auf den Nerv gehen → Taper sur les nerfs de quelqu'un","tags":"idiomes;Redewendungen;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Redewendungen","type":"text","recto":"Umgangssprachliche Ausdrücke (argot allemand)","verso":"Cool/Geil! → Cool / Trop bien !\nKrass! → Incroyable / Dingue !\nAlter! → Mec ! (exclamation amicale)\nNa ja... → Bof... / Enfin...\nGenau! → Exactement !\nKlar! → Bien sûr !\nMach's gut! → Prends soin de toi !\nHol's der Teufel! → La barbe ! (expression de frustration)\nDas läuft. → Ça roule.","tags":"argot;expressions;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Länder & Nationalitäten","type":"text","recto":"Deutschsprachige Länder und europäische Länder","verso":"Deutschland → Allemagne → deutsch/Deutscher\nÖsterreich → Autriche → österreichisch\ndie Schweiz → Suisse → schweizerisch\nFrankreich → France → französisch/Franzose\nSpanien → Espagne → spanisch\nItalien → Italie → italienisch\nPolen → Pologne → polnisch\nRussland → Russie → russisch\nGriechenland → Grèce → griechisch\ndie Niederlande → Pays-Bas → niederländisch","tags":"pays;nationalités;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Medien & Kultur","type":"text","recto":"Filmgenres auf Deutsch","verso":"Komödie → comédie\nDrama → drame\nActionfilm → film d'action\nHorrorfilm → film d'horreur\nScience-Fiction (SciFi) → science-fiction\nDokumentation → documentaire\nTrickfilm/Zeichentrick → dessin animé\nThriller → thriller\nFantasyfilm → film fantastique\nHistorienfilm → film historique\nRomantikfilm → film romantique","tags":"films;genres;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Im Restaurant","type":"text","recto":"Im Restaurant auf Deutsch","verso":"die Speisekarte → le menu\ndie Vorspeise → l'entrée\ndas Hauptgericht → le plat principal\ndie Nachspeise/das Dessert → le dessert\ndie Beilage → l'accompagnement\ndie Rechnung → l'addition\ndas Trinkgeld → le pourboire\nder Kellner / die Kellnerin → le serveur/la serveuse\nIch hätte gern... → Je voudrais...\nDie Rechnung, bitte. → L'addition, s'il vous plaît.\nEs ist köstlich! → C'est délicieux !","tags":"restaurant;repas;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"Deutsch — Wortschatz","chapitre":"Beruf & Arbeit","type":"text","recto":"Die Arbeitswelt auf Deutsch","verso":"die Arbeit/der Beruf → le travail\ndie Karriere → la carrière\nder Lebenslauf (CV) → le CV\ndas Bewerbungsschreiben → la lettre de motivation\ndas Vorstellungsgespräch → l'entretien\ndas Gehalt → le salaire\nbefördert werden → être promu\ngekündigt werden → être licencié\nder Streik → la grève\ndie Gewerkschaft → le syndicat\ndie Frist → le délai/date limite","tags":"travail;emploi;allemand","niveau":"Allemand","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الحروف — L'alphabet arabe","type":"text","recto":"L'alphabet arabe — Présentation générale","verso":"L'arabe s'écrit de droite à gauche.\nIl comporte 28 lettres (consonnes + semi-voyelles).\nLes voyelles courtes s'écrivent avec des signes diacritiques (harakat).\n\nLettre + translittération + son :\nا (alif) [a] | ب (ba) [b] | ت (ta) [t] | ث (tha) [th]\nج (jim) [dj] | ح (ha) [h fort] | خ (kha) [kh]\nد (dal) [d] | ذ (dhal) [dh] | ر (ra) [r] | ز (zayn) [z]","tags":"alphabet;arabe;lettres","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الحروف — L'alphabet arabe","type":"text","recto":"Alphabet arabe — suite (lettres sin à ya)","verso":"س (sin) [s] | ش (shin) [ch] | ص (sad) [s emphatique]\nض (dad) [d emphatique] | ط (ta) [t emphatique]\nظ (dha) [dh emphatique] | ع (ain) [son guttural]\nغ (ghain) [gh] | ف (fa) [f] | ق (qaf) [q]\nك (kaf) [k] | ل (lam) [l] | م (mim) [m]\nن (nun) [n] | ه (ha) [h] | و (waw) [w/ou]\nي (ya) [y/i]","tags":"alphabet;arabe;lettres","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"التحيات — Salutations","type":"text","recto":"السلام عليكم / مرحبا","verso":"As-salāmu ʿalaykum → La paix soit sur vous (salutation islamique)\nRéponse : وعليكم السلام (Wa ʿalaykum as-salām)\n\nمرحبا (Marhaba) → Bonjour / Salut\nأهلاً وسهلاً (Ahlan wa-sahlan) → Bienvenue\nصباح الخير (Sabāh al-khayr) → Bonjour (matin)\nمساء الخير (Masāʾ al-khayr) → Bonsoir\nمع السلامة (Maʿ as-salāma) → Au revoir","tags":"salutation;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"التحيات — Salutations","type":"text","recto":"كيف حالك؟ / اسمي... / من أين أنت؟","verso":"كيف حالك؟ (Kayfa hālak?) → Comment vas-tu ?\nبخير، شكراً (Bi-khayr, shukran) → Bien, merci\n\nما اسمك؟ (Mā ismuka?) → Comment t'appelles-tu ?\nاسمي... (Ismī...) → Je m'appelle...\n\nمن أين أنت؟ (Min ayna anta?) → D'où viens-tu ?\nأنا من فرنسا (Anā min Fransā) → Je viens de France","tags":"présentation;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الأرقام — Les nombres","type":"text","recto":"Les nombres en arabe (1–10)","verso":"١ واحد (wāhid) → 1\n٢ اثنان (ithnān) → 2\n٣ ثلاثة (thalātha) → 3\n٤ أربعة (arbaʿa) → 4\n٥ خمسة (khamsa) → 5\n٦ ستة (sitta) → 6\n٧ سبعة (sabʿa) → 7\n٨ ثمانية (thamāniya) → 8\n٩ تسعة (tisʿa) → 9\n١٠ عشرة (ʿashara) → 10","tags":"nombres;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الأرقام — Les nombres","type":"text","recto":"Les nombres en arabe (11–20 + dizaines)","verso":"١١ أحد عشر (ahad ʿashar)\n١٢ اثنا عشر (ithnā ʿashar)\n١٣ ثلاثة عشر (thalāthat ʿashar)\n٢٠ عشرون (ʿishrūn)\n٣٠ ثلاثون (thalāthūn)\n٤٠ أربعون (arbaʿūn)\n٥٠ خمسون (khamsūn)\n١٠٠ مئة (miʾa)\n١٠٠٠ ألف (alf)","tags":"nombres;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"العائلة — La famille","type":"text","recto":"La famille en arabe","verso":"الأب (al-ab) → le père\nالأم (al-umm) → la mère\nالأخ (al-akh) → le frère\nالأخت (al-ukht) → la sœur\nالجد (al-jadd) → le grand-père\nالجدة (al-jadda) → la grand-mère\nالعم (al-ʿamm) → l'oncle paternel\nالخال (al-khāl) → l'oncle maternel\nالابن (al-ibn) → le fils\nالبنت (al-bint) → la fille","tags":"famille;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"جسم الإنسان — Le corps humain","type":"text","recto":"Le corps humain en arabe","verso":"الرأس (ar-raʾs) → la tête\nالوجه (al-wajh) → le visage\nالعين (al-ʿayn) → l'œil | العيون → les yeux\nالأذن (al-udhun) → l'oreille\nالأنف (al-anf) → le nez\nالفم (al-famm) → la bouche\nالذراع (adh-dhirāʿ) → le bras\nاليد (al-yad) → la main\nالقدم (al-qadam) → le pied\nالقلب (al-qalb) → le cœur","tags":"corps;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الألوان — Les couleurs","type":"text","recto":"Les couleurs en arabe","verso":"أحمر (ahmar) → rouge\nأزرق (azraq) → bleu\nأخضر (akhdar) → vert\nأصفر (asfar) → jaune\nأسود (aswad) → noir\nأبيض (abyad) → blanc\nرمادي (ramādī) → gris\nبرتقالي (burtuqālī) → orange\nوردي (wardī) → rose\nبنفسجي (banafsajī) → violet\nبني (bunnī) → marron","tags":"couleurs;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الأيام والشهور — Jours et mois","type":"text","recto":"Les jours de la semaine en arabe","verso":"الأحد (al-ahad) → dimanche\nالاثنين (al-ithnyn) → lundi\nالثلاثاء (ath-thulāthāʾ) → mardi\nالأربعاء (al-arbiʿāʾ) → mercredi\nالخميس (al-khamīs) → jeudi\nالجمعة (al-jumuʿa) → vendredi ⭐ (jour sacré)\nالسبت (as-sabt) → samedi\n\nما هو اليوم؟ (Mā huwa al-yawm?) → Quel jour sommes-nous ?","tags":"jours;semaine;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الأيام والشهور — Jours et mois","type":"text","recto":"Les mois de l'année en arabe (calendrier grégorien)","verso":"يناير (Yanāyir) → janvier\nفبراير (Fibrāyir) → février\nمارس (Mārs) → mars\nأبريل (Abrīl) → avril\nمايو (Māyu) → mai\nyونيو (Yūniyu) → juin\nيوليو (Yūlyu) → juillet\nأغسطس (Ughustus) → août\nسبتمبر (Sibtambir) → septembre\nأكتوبر (Uktūbir) → octobre\nنوفمبر (Nūfambir) → novembre\nديسمبر (Dīsambir) → décembre","tags":"mois;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الطعام والشراب — Nourriture","type":"text","recto":"La nourriture en arabe (aliments courants)","verso":"الخبز (al-khubz) → le pain\nالجبن (al-jubn) → le fromage\nالبيضة (al-bayda) → l'œuf\nاللحم (al-lahm) → la viande\nالدجاج (ad-dajāj) → le poulet\nالسمك (as-samak) → le poisson\nالأرز (al-aruzz) → le riz\nالخضروات (al-khuḍruwāt) → les légumes\nالفاكهة (al-fākiha) → les fruits\nالحلوى (al-halwā) → le gâteau/sucrerie","tags":"nourriture;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الطعام والشراب — Nourriture","type":"text","recto":"Les boissons et expressions liées aux repas (arabe)","verso":"الماء (al-māʾ) → l'eau\nالعصير (al-ʿasīr) → le jus\nالحليب (al-halīb) → le lait\nالشاي (ash-shāy) → le thé\nالقهوة (al-qahwa) → le café\n\nأنا جائع/ة. (Anā jāʾiʿ/a.) → J'ai faim.\nأنا عطشان/ة. (Anā ʿaṭshān/a.) → J'ai soif.\nبالهناء والشفاء (Bil-hanāʾ wash-shifāʾ) → Bon appétit !","tags":"boissons;repas;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"البيت — La maison","type":"text","recto":"La maison et les pièces en arabe","verso":"البيت/المنزل (al-bayt/al-manzil) → la maison\nالشقة (ash-shaqqa) → l'appartement\nغرفة الجلوس (ghurfat al-julūs) → le salon\nغرفة النوم (ghurfat an-nawm) → la chambre\nالمطبخ (al-maṭbakh) → la cuisine\nالحمام (al-hammām) → la salle de bain\nالحديقة (al-hadīqa) → le jardin\nالباب (al-bāb) → la porte\nالنافذة (an-nāfidha) → la fenêtre","tags":"maison;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"أفعال أساسية — Verbes essentiels","type":"text","recto":"Les verbes essentiels en arabe","verso":"كان (kāna) → être (passé)\nيكون (yakūn) → être (présent)\nأكل (akala) → manger\nشرب (shariba) → boire\nذهب (dhahaba) → aller\nجاء (jāʾa) → venir\nnام (nāma) → dormir\nعمل (ʿamila) → travailler\nدرس (darasa) → étudier\nقرأ (qaraʾa) → lire\nكتب (kataba) → écrire\nتكلم (takallama) → parler","tags":"verbes;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"تعابير يومية — Expressions quotidiennes","type":"text","recto":"Expressions quotidiennes en arabe","verso":"من فضلك (Min faḍlak) → S'il vous plaît\nشكراً (Shukran) → Merci\nعفواً (ʿAfwan) → De rien / Pardon\nآسف/آسفة (Āsif/Āsifa) → Désolé(e)\nنعم (Naʿam) → Oui | لا (Lā) → Non\nلا أفهم (Lā afham) → Je ne comprends pas\nكيف تقول...؟ (Kayfa taqūl...?) → Comment dit-on... ?\nبالتوفيق! (Bit-tawfīq!) → Bonne chance !","tags":"expressions;politesse;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"وسائل النقل — Transports","type":"text","recto":"Les transports en arabe","verso":"السيارة (as-sayyāra) → la voiture\nالحافلة (al-hāfila) → le bus\nالقطار (al-qiṭār) → le train\nالطائرة (aṭ-ṭāʾira) → l'avion\nالسفينة (as-safīna) → le bateau\nالدراجة (ad-darrāja) → le vélo\nالمترو (al-mitrū) → le métro\nالمحطة (al-maḥaṭṭa) → la gare/station\nالمطار (al-maṭār) → l'aéroport\nالتذكرة (at-tadhkira) → le billet","tags":"transports;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الطقس والفصول — Météo et saisons","type":"text","recto":"La météo et les saisons en arabe","verso":"الربيع (ar-rabīʿ) → le printemps\nالصيف (aṣ-ṣayf) → l'été\nالخريف (al-kharīf) → l'automne\nالشتاء (ash-shitāʾ) → l'hiver\n\nالجو مشمس. → Il fait soleil.\nالجو بارد. → Il fait froid.\nالجو حار. → Il fait chaud.\nتمطر. (Tumṭir.) → Il pleut.\nتثلج. (Tuthlij.) → Il neige.","tags":"saisons;météo;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الحيوانات — Les animaux","type":"text","recto":"Les animaux en arabe","verso":"الكلب (al-kalb) → le chien\nالقطة (al-qiṭṭa) → le chat\nالحصان (al-hiṣān) → le cheval\nالأسد (al-asad) → le lion\nالفيل (al-fīl) → l'éléphant\nالزرافة (az-zarāfa) → la girafe\nالسمكة (as-samaka) → le poisson\nالطائر (aṭ-ṭāʾir) → l'oiseau\nالنحلة (an-nahla) → l'abeille\nالفراشة (al-farāsha) → le papillon","tags":"animaux;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"المهن — Les professions","type":"text","recto":"المهن (الصحة والعلوم) — Les professions (santé, sciences)","verso":"طبيب/طبيبة (ṭabīb) → médecin\nممرض/ممرضة (mumarriḍ) → infirmier/ière\njراح (jarrāḥ) → chirurgien\nصيدلاني (ṣaydalānī) → pharmacien\nعالِم (ʿālim) → scientifique\nمهندس (muhandis) → ingénieur\nمعمار (miʿmār) → architecte\nمعلم/أستاذ (muʿallim/ustādh) → professeur\nقاضٍ (qāḍin) → juge\nمحامٍ (muḥāmin) → avocat","tags":"professions;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"المهن — Les professions","type":"text","recto":"المهن (الفن والتكنولوجيا) — Professions (art, tech)","verso":"ممثل/ممثلة (mumaththil) → acteur/actrice\nموسيقي (mūsīqī) → musicien\nصحفي (ṣuhufī) → journaliste\nمصور (muṣawwir) → photographe\nكاتب (kātib) → écrivain\nرياضي (riyāḍī) → sportif\nمدرب (mudarrib) → entraîneur\nmبرمج (mubarmij) → développeur\nطاهٍ/طباخ (ṭāhin) → cuisinier\nسائق (sāʾiq) → chauffeur\nطيار (ṭayyār) → pilote","tags":"professions;art;tech;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"المشاعر — Les émotions","type":"text","recto":"المشاعر الإيجابية — Émotions positives","verso":"سعيد/سعيدة (saʿīd) → heureux/heureuse\nفرحان (farḥān) → joyeux\nمتحمس (mutaḥammis) → enthousiaste\nفخور (fakhūr) → fier\nممتن (mumtann) → reconnaissant\nمرتاح (murtāḥ) → détendu\nواثق من نفسه (wāthiq) → confiant\nمحب (muhibb) → aimant\nمتفائل (mutafāʾil) → optimiste\nمندهش (mundahish) → surpris","tags":"émotions;positives;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"المشاعر — Les émotions","type":"text","recto":"المشاعر السلبية — Émotions négatives","verso":"حزين/حزينة (ḥazīn) → triste\nغاضب (ghāḍib) → en colère\nمحبط (muḥbaṭ) → frustré\nخائف (khāʾif) → effrayé\nقلق (qaliq) → anxieux\nمضغوط (maḍghūṭ) → stressé\nوحيد (waḥīd) → seul\nممل (mumill) → ennuyé\nمتعب (mutaʿib) → fatigué\nخائب الأمل (khāʾib) → déçu\nغيور (ghayūr) → jaloux","tags":"émotions;négatives;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"التكنولوجيا والإنترنت","type":"text","recto":"مفردات الحاسوب — Vocabulaire informatique","verso":"حاسوب/كمبيوتر (ḥāsūb) → ordinateur\nحاسوب محمول (maḥmūl) → ordinateur portable\nجهاز لوحي (lawḥī) → tablette\nشاشة (shāsha) → écran\nlوحة المفاتيح (lawḥat al-mafātīḥ) → clavier\nفارة/ماوس (māws) → souris\nطابعة (ṭābiʿa) → imprimante\nسماعات (samāʿāt) → écouteurs\nشاحن (shāḥin) → chargeur\nbطارية (baṭṭāriyya) → batterie","tags":"informatique;tech;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"التكنولوجيا والإنترنت","type":"text","recto":"الإنترنت ووسائل التواصل — Internet et réseaux sociaux","verso":"موقع إلكتروني (mawqiʿ) → site web\nmتصفح (mutaṣaffaḥ) → navigateur\nكلمة المرور (kalima al-murūr) → mot de passe\nاسم المستخدم (ism al-mustakhdim) → nom d'utilisateur\nتنزيل (tanzīl) → télécharger\nرفع (rafʿ) → mettre en ligne\ntسجيل الدخول → connexion/login\nمتابعة (mutābaʿa) → suivre\nمشاركة (mushāraka) → partager\nإشعار (ishʿār) → notification\nتحديث (taḥdīth) → mise à jour","tags":"internet;réseaux;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الرياضة — Le sport","type":"text","recto":"الرياضات المختلفة — Les sports en arabe","verso":"كرة القدم (kurat al-qadam) → football\nكرة السلة (kurat as-salla) → basketball\nكرة اليد (kurat al-yad) → handball\nكرة الطائرة (kurat aṭ-ṭāʾira) → volleyball\nالسباحة (as-sibāḥa) → natation\nالدراجات (ad-darrājāt) → cyclisme\nالجري (al-jarī) → course à pied\nالملاكمة (al-mulākama) → boxe\nالتنس (at-tinis) → tennis\nالتسلق (at-tasalluk) → escalade","tags":"sports;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الرياضة — Le sport","type":"text","recto":"مفردات رياضية عامة — Vocabulaire sportif général","verso":"لاعب (lāʿib) → joueur\nفريق (farīq) → équipe\nمدرب (mudarrib) → entraîneur\nحَكَم (ḥakam) → arbitre\nملعب/استاد (malʿab/ustād) → stade\nbطولة (buṭūla) → championnat\nميدالية (mīdāliyya) → médaille\nتدريب (tadrīb) → entraînement\nإصابة (iṣāba) → blessure\nتسجيل هدف → marquer un but\nفاز/خسر → gagner/perdre","tags":"sport;vocabulaire;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"المدينة — La ville","type":"text","recto":"أماكن في المدينة — Lieux en ville (arabe)","verso":"مدينة (madīna) → ville\nقرية (qarya) → village\nشارع (shāriʿ) → rue\nميدان (maydān) → place\nحديقة عامة (ḥadīqa) → parc\nسوق (sūq) → marché\nسوبرماركت (sūbarmārkit) → supermarché\nمتجر/دكان (matjar) → magasin\nمخبزة (makhbaza) → boulangerie\nجزارة (jazzāra) → boucherie\nصيدلية (ṣaydaliyya) → pharmacie\nمستشفى (mustashfā) → hôpital","tags":"ville;lieux;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"المدينة — La ville","type":"text","recto":"المباني العامة — Bâtiments publics (arabe)","verso":"مدرسة (madrasa) → école\nجامعة (jāmiʿa) → université\nمكتبة (maktaba) → bibliothèque\nمتحف (matḥaf) → musée\nmسرح (masraḥ) → théâtre\nسينما (sīnimā) → cinéma\nكنيسة (kanīsa) → église\nمسجد (masjid) → mosquée\nبلدية (baladiyya) → mairie\nbنك (bank) → banque\nمكتب البريد (maktab al-barīd) → bureau de poste","tags":"bâtiments;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الطبيعة والبيئة","type":"text","recto":"الطبيعة (المناظر الطبيعية) — La nature en arabe","verso":"جبل (jabal) → montagne\nتل (tall) → colline\nوادٍ (wādin) → vallée\nغابة (ghāba) → forêt\nحقل (ḥaql) → champ\nنهر (nahr) → rivière\nبحيرة (buḥayra) → lac\nbحر (baḥr) → mer\nمحيط (muḥīṭ) → océan\nشاطئ (shāṭiʾ) → plage\nجزيرة (jazīra) → île\nصحراء (ṣaḥrāʾ) → désert\nbركان (burkān) → volcan","tags":"nature;paysages;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الصحة والطب","type":"text","recto":"الأمراض والأعراض — Maladies et symptômes (arabe)","verso":"صداع (ṣudāʿ) → mal de tête\nألم في المعدة → mal de ventre\nألم في الحلق → mal de gorge\nحُمّى (ḥummā) → fièvre\nسعال (suʿāl) → toux\nعطس (ʿaṭas) → éternuement\nدوار (dawwār) → vertige\nحساسية (ḥasāsiyya) → allergie\nكسر (kasr) → fracture\nحرق (ḥarq) → brûlure\nإنفلونزا (influwanzā) → grippe\nزكام (zukām) → rhume","tags":"maladies;symptômes;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الخضروات والفواكه","type":"text","recto":"الخضروات — Les légumes en arabe","verso":"جزر (jazar) → carotte\nbطاطا (baṭāṭā) → pomme de terre\nطماطم (ṭamāṭim) → tomate\nbصل (baṣal) → oignon\nثوم (thūm) → ail\nسبانخ (sabānikh) → épinards\nخيار (khiyār) → concombre\nكوسا (kūsā) → courgette\nفلفل (filfil) → poivron\nعيش الغراب → champignon\nذرة (dhura) → maïs\nbازلاء (bāzillāʾ) → petits pois","tags":"légumes;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"الخضروات والفواكه","type":"text","recto":"الفواكه — Les fruits en arabe","verso":"تفاحة (tuffāḥa) → pomme\nإجاصة (ijāṣa) → poire\nموزة (mawza) → banane\nبرتقالة (burtuqāla) → orange\nفراولة (farāwila) → fraise\nخوخة (khawkha) → pêche\nعنب (ʿinab) → raisin\nbطيخ (baṭṭīkh) → pastèque\nشمام (shammām) → melon\nكيوي (kīwī) → kiwi\nأناناس (anānās) → ananas\nكرز (karaz) → cerise\nليمون (laymūn) → citron","tags":"fruits;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"القواعد — Grammaire arabe","type":"text","recto":"المذكر والمؤنث — Genre masculin et féminin en arabe","verso":"En arabe, tout nom est soit masculin (مذكر) soit féminin (مؤنث).\n\nFéminin → souvent terminé en ة (ta marbouta)\nكتاب (kitāb) → livre (masc.)\nمدرسة (madrasa) → école (fém., -a)\n\nAdjectifs s'accordent en genre :\nكبير (kabīr) → grand (masc.)\nكبيرة (kabīra) → grande (fém.)\n\nExceptions : certains mots féminins sans ta marbouta (نار, شمس, أرض...)","tags":"grammaire;genre;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"القواعد — Grammaire arabe","type":"text","recto":"المفرد والجمع — Singulier et pluriel en arabe","verso":"Le pluriel en arabe est complexe — il existe :\n1. Pluriel sain (جمع سالم) : ajout de suffixes\n• Masc. : مدرّس → مدرّسون (enseignants)\n• Fém. : مدرّسة → مدرّسات (enseignantes)\n\n2. Pluriel brisé (جمع تكسير) : changement interne du mot (à mémoriser !)\n• كتاب → كتب (livres)\n• رجل → رجال (hommes)\n• ولد → أولاد (garçons)\n\n⚠️ Il n'y a pas de règle universelle pour le pluriel brisé !","tags":"grammaire;pluriel;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"القواعد — Grammaire arabe","type":"text","recto":"الجملة الاسمية والفعلية — Phrase nominale et verbale","verso":"1. Phrase nominale (جملة اسمية) : Sujet + Prédicat, SANS verbe être au présent\n• البيت كبير (al-bayt kabīr) → La maison [est] grande.\n• محمد طالب → Mohamed [est] étudiant.\n\n2. Phrase verbale (جملة فعلية) : commence par le verbe\n• ذهب محمد إلى المدرسة → Mohamed est allé à l'école.\n\nEn arabe, le verbe s'accorde en genre avec le sujet !","tags":"grammaire;phrase;syntaxe;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"تعابير دينية وثقافية","type":"text","recto":"Expressions religieuses et culturelles arabes","verso":"بسم الله (Bismi-llāh) → Au nom de Dieu (avant de commencer)\nالحمد لله (Al-ḥamdu li-llāh) → Dieu merci / Louange à Dieu\nإن شاء الله (In shāʾ Allāh) → Si Dieu le veut / J'espère\nماشاء الله (Māshāʾ Allāh) → Que Dieu le veuille (admiration)\nيلا! (Yallah!) → Allez ! / En route !\nمبروك! (Mabrūk!) → Félicitations !\nعيد مبارك (ʿĪd mubārak) → Joyeuse fête (Aïd)","tags":"culturel;religieux;expressions;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"أسئلة وإجابات — Questions et réponses","type":"text","recto":"كلمات الاستفهام — Les mots interrogatifs en arabe","verso":"ما / ماذا (mā/mādhā) → quoi / qu'est-ce que\nmَن (man) → qui\nأين (ayna) → où\nمتى (matā) → quand\nكيف (kayfa) → comment\nلماذا (limādhā) → pourquoi\nكَم (kam) → combien\nأيّ (ayy) → quel/quelle\nهل (hal) → est-ce que (question oui/non)\n\nExemple : أين تسكن؟ → Où habites-tu ?","tags":"interrogatifs;questions;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"التسوق والمال","type":"text","recto":"التسوق — Faire ses courses en arabe","verso":"متجر/دكان (matjar) → magasin\nمركز تجاري (markaz tijārī) → centre commercial\nسعر (siʿr) → prix\nتخفيض (takhfīḍ) → réduction/remise\nتسوية (taswiya) → soldes\nصندوق (ṣundūq) → caisse\nإيصال (īṣāl) → reçu\nnقود/كاش → espèces\nbطاقة ائتمانية → carte de crédit\nبكم هذا؟ → Combien ça coûte ?\nسآخذه. → Je le prends.","tags":"achats;argent;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"البلدان — Les pays","type":"text","recto":"الدول العربية — Les pays arabes","verso":"المغرب (al-Maghrib) → le Maroc → مغربي\nالجزائر (al-Jazāʾir) → l'Algérie → جزائري\nتونس (Tūnis) → la Tunisie → تونسي\nمصر (Miṣr) → l'Égypte → مصري\nليبيا (Lībiyā) → la Libye → ليبي\nالسودان (as-Sūdān) → le Soudan → سوداني\nالسعودية (as-Suʿūdiyya) → l'Arabie Saoudite → سعودي\nالإمارات (al-Imārāt) → les Émirats → إماراتي\nسوريا (Sūriyā) → la Syrie → سوري\nلبنان (Lubnān) → le Liban → لبناني","tags":"pays;arabes;arabe","niveau":"Arabe","matiere":"Langues"},{"deck":"العربية — المفردات","chapitre":"البلدان — Les pays","type":"text","recto":"دول عالمية بالعربية — Pays du monde en arabe","verso":"فرنسا (Fransā) → France → فرنسي\nإسبانيا (Isbāniyā) → Espagne → إسباني\nألمانيا (Almāniyā) → Allemagne → ألماني\nإيطاليا (Ītāliyā) → Italie → إيطالي\nالمملكة المتحدة → Royaume-Uni → بريطاني\nالولايات المتحدة → États-Unis → أمريكي\nالصين (aṣ-Ṣīn) → Chine → صيني\nاليابان (al-Yābān) → Japon → ياباني\nالهند (al-Hind) → Inde → هندي\nروسيا (Rūsiyā) → Russie → روسي","tags":"pays;monde;arabe","niveau":"Arabe","matiere":"Langues"}];

// ===== STORAGE =====
const STORE_KEY='fr_store_v2', SETTINGS_KEY='fr_settings_v2';
let store = JSON.parse(localStorage.getItem(STORE_KEY)||'{}');
let settings = {newPerDay:20, maxReviews:150, goalPerDay:50, ...JSON.parse(localStorage.getItem(SETTINGS_KEY)||'{}')};
const save = () => localStorage.setItem(STORE_KEY, JSON.stringify(store));
const saveSettings = () => localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));

// ===== UTILS =====
const $ = id => document.getElementById(id);
const dayKey = ts => {const d=new Date(ts);return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();};
const today = () => dayKey(Date.now());
const todayStart = () => {const d=new Date();d.setHours(0,0,0,0);return d.getTime();};
const shuffle = a => [...a].sort(()=>Math.random()-.5);
const esc = s => (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");

// ===== SRS (SM-2 adapté) =====
function getCardState(idx){
  if(!store.cards) store.cards={};
  if(!store.cards[idx]) store.cards[idx]={reps:0,interval:0,ease:2.5,due:0,lapses:0};
  return store.cards[idx];
}
function rateState(state, rating){
  const now = Date.now();
  if(rating===1){ // Again
    state.lapses++;state.ease=Math.max(1.3,state.ease-.2);
    state.interval=0;state.reps=0;state.due=now+10*60*1000;
  } else if(rating===2){ // Hard
    state.ease=Math.max(1.3,state.ease-.15);
    state.interval=state.interval===0?1:Math.max(1,Math.round(state.interval*1.2));
    state.reps++;state.due=now+state.interval*86400000;
  } else if(rating===3){ // Good
    if(state.interval===0) state.interval=1;
    else if(state.interval===1) state.interval=6;
    else state.interval=Math.round(state.interval*state.ease);
    state.reps++;state.due=now+state.interval*86400000;
  } else { // Easy
    state.ease=state.ease+.15;
    if(state.interval===0) state.interval=4;
    else state.interval=Math.round(state.interval*state.ease*1.3);
    state.reps++;state.due=now+state.interval*86400000;
  }
}
function intervalStr(state, rating){
  const sim={...state};rateState(sim,rating);
  const d=sim.interval;
  if(d===0) return "10min";
  if(d<7) return d+"j";
  if(d<30) return Math.round(d/7)+"sem";
  return Math.round(d/30)+"mois";
}

// ===== STREAK =====
function updateStreak(force){
  if(!store.history) store.history={};
  const k=today();
  store.history[k]=(store.history[k]||0)+1;
  if(!store.dailyStats) store.dailyStats={};
  store.dailyStats[k]=(store.dailyStats[k]||0)+1;
  let streak=0,d=new Date();d.setHours(0,0,0,0);
  while(true){
    const kk=dayKey(d.getTime());
    if(store.history[kk]){streak++;d.setDate(d.getDate()-1);}
    else{if(streak===0&&kk===k)streak=1;break;}
  }
  store.streak=streak;
  store.totalSessions=(store.totalSessions||0)+(force?1:0);
  $("streak-val").textContent=store.streak;
  save();
}

// ===== DUE CARDS =====
function getDue(deckName){
  const now=Date.now();
  let rev=[],nw=[];
  CARDS.forEach((c,i)=>{
    if(deckName&&c.deck!==deckName) return;
    const s=getCardState(i);
    if(s.reps===0) nw.push(i);
    else if(s.due<=now) rev.push(i);
  });
  return {review:rev.slice(0,settings.maxReviews), new:nw.slice(0,settings.newPerDay), allRev:rev.length, allNew:nw.length};
}
function getDueCount(deckName){
  const d=getDue(deckName);
  return d.review.length+d.new.length;
}

// ===== NAVIGATION =====
function showPage(name){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
  $("page-"+name).classList.add("active");
  const tab=document.querySelector(`.tab[data-page="${name}"]`);
  if(tab) tab.classList.add("active");
  const renders={home:renderHome,decks:renderBrowse,modes:renderModes,stats:renderStats,profil:renderProfil};
  if(renders[name]) renders[name]();
}
document.querySelectorAll(".tab").forEach(t=>t.addEventListener("click",()=>showPage(t.dataset.page)));

